#!/bin/sh
set -eu
case "${1:-}" in ""|--check) ;; *) echo "usage: $0 [--check]" >&2; exit 2;; esac
for tool in uv rp; do command -v "$tool" >/dev/null || { echo "Install $tool first" >&2; exit 1; }; done
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
uv run --no-project python "$root/scripts/cockpit.py" --help >/dev/null
printf '%s\n' 'mailbox-review-core ready; run scripts/cockpit.py with the wrapper inputs (no global command links)'
