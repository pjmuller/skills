#!/bin/sh
set -eu
case "${1:-}" in ""|--check) ;; *) echo "usage: $0 [--check]" >&2; exit 2;; esac
command -v uv >/dev/null || { echo "Install uv first" >&2; exit 1; }
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
uv run --project "$root" --no-dev python -c 'import zeep'
uv run --project "$root" --no-dev python "$root/scripts/yuki.py" --help >/dev/null
printf '%s\n' 'yuki-core ready; run scripts/yuki.py --config <wrapper>/yuki.json (no global command links)'
