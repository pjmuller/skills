#!/usr/bin/env bash
# Build + register "T3 Open.app": the t3open://<thread-id> URL handler (macOS only). Idempotent:
# rebuilds only when handler.applescript changed, so the Accessibility grant (tied to the
# ad-hoc signature) survives re-runs.
#
#   url-scheme/install           build if needed, install into ~/Applications, register scheme
#   url-scheme/install --check   verify app + scheme registration
set -euo pipefail

src_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)"
src="$src_dir/handler.applescript"
app="$HOME/Applications/T3 Open.app"
plist="$app/Contents/Info.plist"
stamp="$app/Contents/Resources/source.sha256"
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
want="$(shasum -a 256 "$src" | cut -d' ' -f1)"

if [[ "${1:-}" == --check ]]; then
  status=0
  [[ -f "$stamp" && "$(cat "$stamp")" == "$want" ]] && echo "ok      $app (current)" || { echo "STALE   $app (run url-scheme/install)"; status=1; }
  "$lsregister" -dump URLSchemeBinding 2>/dev/null | grep -q 't3open:.*T3 Open' \
    && echo "ok      t3open:// -> T3 Open" || { echo "MISSING t3open:// registration"; status=1; }
  exit "$status"
fi
[[ "$(uname)" == Darwin ]] || { echo "macOS only" >&2; exit 2; }

if [[ -f "$stamp" && "$(cat "$stamp")" == "$want" ]]; then
  echo "unchanged $app"
else
  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  osacompile -o "$app" "$src"
  pb() { /usr/libexec/PlistBuddy -c "$1" "$plist"; }
  pb "Set :CFBundleIdentifier com.pjmuller.t3open" 2>/dev/null || pb "Add :CFBundleIdentifier string com.pjmuller.t3open"
  pb "Add :LSUIElement bool true"
  pb "Add :CFBundleURLTypes array"
  pb "Add :CFBundleURLTypes:0 dict"
  pb "Add :CFBundleURLTypes:0:CFBundleURLName string 'T3 Open'"
  pb "Add :CFBundleURLTypes:0:CFBundleURLSchemes array"
  pb "Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string t3open"
  echo "$want" > "$stamp"
  codesign --force --deep --sign - "$app" >/dev/null 2>&1
  echo "built   $app (new signature: grant Accessibility to 'T3 Open' on first use)"
fi
"$lsregister" -f "$app"
echo "ok      t3open:// registered"
