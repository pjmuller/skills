#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Fuzzy-find a past T3 Code thread: deterministic FTS narrowing, then LLM judging.

Progressive disclosure - each step costs more context than the last:

    t3-find-thread search --project example-app --since 30d ahoy stats   # ranked candidates
    t3-find-thread peek 2ac7596e,9f12ab30                              # headers + first prompts
    t3-find-thread grep 2ac7596e -k snapshot -k restore                # snippets around hits

Reading a whole thread: the native `t3_thread_read` MCP tool. Reads T3's store read-only
($T3CODE_HOME/userdata/statev2.sqlite, default ~/.t3/...) and keeps a private FTS5 cache at
~/.cache/t3-find-thread/index.sqlite, refreshed incrementally before every command. Sub-agent and
delegated-task threads are skipped unless --subagents. Nothing is ever written back to T3.

Purged threads live on in the backup archive ($T3_ARCHIVE, default ~/.t3/backups/t3-archive.sqlite,
written by t3-purge-threads / t3-thread-archive). `--backup auto` (default) also searches it when the
live store has no hit covering every term, or --since/--until reach before the live store; its hits are
flagged `backup` and peek/grep/read take them from the archive (grep and `read --tools` also see
tool calls there; entry numbers match across the three).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import sqlite3
import sys
from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from difflib import SequenceMatcher, get_close_matches
from pathlib import Path
from urllib.parse import quote

DEFAULT_STORE = Path(os.environ.get("T3CODE_HOME", Path.home() / ".t3")) / "userdata" / "statev2.sqlite"
CACHE_DIR = Path(os.environ.get("T3_FIND_CACHE_DIR", Path.home() / ".cache" / "t3-find-thread"))
CACHE_DB = CACHE_DIR / "index.sqlite"
ARCHIVE = Path(os.environ.get("T3_ARCHIVE", DEFAULT_STORE.parent.parent / "backups" / "t3-archive.sqlite"))
CACHE_VERSION = "2"  # bump on any cache/source schema change: forces one full rebuild

USER_WEIGHT = 3.0
ASSISTANT_WEIGHT = 1.0
TOOL_WEIGHT = 0.5  # archive tool/reasoning evidence ranks below conversation
TERM_COVERAGE_BONUS = 10.0
TITLE_BONUS = 15.0


# --------------------------------------------------------------------------- store access


@contextmanager
def connect_readonly(store: Path) -> Iterator[sqlite3.Connection]:
    """SQLite WAL snapshot read; never blocks (or is blocked by) the running T3 server."""
    if not store.exists():
        sys.exit(f"T3 store not found: {store}\nIs T3 Code installed? Set T3CODE_HOME if it lives elsewhere.")
    connection = sqlite3.connect(f"file:{quote(str(store), safe='/')}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA query_only = ON")
    try:
        yield connection
    finally:
        connection.close()


# Shared with t3-open-thread and t3-maintenance so short ids agree across tools.
_UUID_ID = re.compile(r"(?:mcp:|thread:project:[0-9a-f-]{36}:)?([0-9a-f]{8}-[0-9a-f-]{27})", re.I)


def id_key(thread_id: str) -> str:
    """Stable handle: the thread's own UUID when it has one, else a sha1 of the id."""
    match = _UUID_ID.fullmatch(thread_id)
    return match.group(1).lower() if match else hashlib.sha1(thread_id.encode()).hexdigest()


def short_id(thread_id: str) -> str:
    return id_key(thread_id)[:8]


def thread_link(title: str, thread_id: str) -> str:
    """Native T3 chat link (id as stored, not url-encoded)."""
    label = title.replace("[", "(").replace("]", ")").replace("|", "/")
    return f"[{label}](t3-thread://v1/{thread_id})"


# --------------------------------------------------------------------------- time helpers

RELATIVE = re.compile(r"^(\d+)\s*([dwmy])$", re.I)
UNIT_DAYS = {"d": 1, "w": 7, "m": 30, "y": 365}


def parse_date(value: str) -> datetime:
    raw = value.strip()
    rel = RELATIVE.match(raw)
    if rel:
        return datetime.now(timezone.utc) - timedelta(days=int(rel.group(1)) * UNIT_DAYS[rel.group(2).lower()])
    if len(raw) == 10:
        raw += "T00:00:00+00:00"
    elif raw.endswith("Z"):
        raw = raw[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(raw)
    except ValueError:
        sys.exit(f"cannot parse date {value!r}; use ISO (2026-08-01) or relative (7d, 3w, 2m)")
    return (parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)).astimezone(timezone.utc)


def iso(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def day(stamp: str | None) -> str:
    return (stamp or "")[:10]


def minute(stamp: str | None) -> str:
    return (stamp or "").replace("T", " ")[:16]


# --------------------------------------------------------------------------- index


SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS threads (
  thread_id TEXT PRIMARY KEY,
  id_key TEXT NOT NULL,
  subagent INTEGER NOT NULL DEFAULT 0,
  project_id TEXT NOT NULL,
  project_title TEXT NOT NULL,
  workspace_root TEXT NOT NULL,
  workspace_name TEXT NOT NULL,
  title TEXT NOT NULL,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  archived_at TEXT,
  user_msgs INTEGER NOT NULL DEFAULT 0,
  assistant_msgs INTEGER NOT NULL DEFAULT 0,
  last_msg_at TEXT
);
"""

FTS_SCHEMA = """
CREATE VIRTUAL TABLE IF NOT EXISTS messages_fts USING fts5(
  text, text_plain, thread_id UNINDEXED, role UNINDEXED, created_at UNINDEXED,
  tokenize="unicode61 tokenchars '_'"
);
CREATE VIRTUAL TABLE IF NOT EXISTS vocab USING fts5vocab(messages_fts, 'row');
"""

SEPARATORS = re.compile(r"[_\-/.]+")


def open_cache() -> sqlite3.Connection:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache = sqlite3.connect(CACHE_DB)
    cache.row_factory = sqlite3.Row
    try:
        cache.executescript(SCHEMA + FTS_SCHEMA)
    except sqlite3.OperationalError as error:
        sys.exit(f"this Python's sqlite3 lacks FTS5 ({error}); run via uv")
    return cache


def get_meta(cache: sqlite3.Connection, key: str, default: str = "") -> str:
    row = cache.execute("SELECT value FROM meta WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else default


def set_meta(cache: sqlite3.Connection, key: str, value: str) -> None:
    cache.execute("INSERT INTO meta(key, value) VALUES(?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value", (key, value))


THREADS_SQL = """
SELECT t.thread_id, t.project_id, t.title, t.created_at, t.updated_at, t.archived_at,
       json_extract(t.payload_json, '$.lineage.relationshipToParent') = 'subagent' AS subagent,
       p.title AS project_title, p.workspace_root
  FROM orchestration_v2_projection_threads t JOIN projection_projects p USING (project_id)
 WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL
"""
MESSAGES_SQL = """
SELECT role, coalesce(json_extract(payload_json, '$.text'), '') AS text, created_at, updated_at
  FROM orchestration_v2_projection_messages WHERE thread_id = ? ORDER BY created_at, message_id
"""


def sync_index(store: Path, rebuild: bool = False, verbose: bool = False) -> dict:
    if CACHE_DB.exists():
        with sqlite3.connect(CACHE_DB) as probe:
            try:
                version = probe.execute("SELECT value FROM meta WHERE key = 'version'").fetchone()
            except sqlite3.OperationalError:
                version = None
        if rebuild or not version or version[0] != CACHE_VERSION:
            CACHE_DB.unlink()
    cache = open_cache()
    set_meta(cache, "version", CACHE_VERSION)
    watermark = get_meta(cache, "watermark", "")
    with connect_readonly(store) as src:
        threads = {row["thread_id"]: row for row in src.execute(THREADS_SQL)}
        stale = {tid for tid, row in threads.items() if row["updated_at"] > watermark}
        stale |= {
            row["thread_id"]
            for row in src.execute(
                "SELECT DISTINCT thread_id FROM orchestration_v2_projection_messages WHERE updated_at > ?",
                (watermark,),
            )
            if row["thread_id"] in threads
        }
        max_stamp = watermark
        for row in threads.values():
            max_stamp = max(max_stamp, row["updated_at"])

        # Drop index rows for threads that disappeared (deleted in T3).
        known = {row["thread_id"] for row in cache.execute("SELECT thread_id FROM threads")}
        for gone in known - threads.keys():
            cache.execute("DELETE FROM threads WHERE thread_id = ?", (gone,))
            cache.execute("DELETE FROM messages_fts WHERE thread_id = ?", (gone,))

        for tid in stale:
            row = threads[tid]
            messages = src.execute(MESSAGES_SQL, (tid,)).fetchall()
            for message in messages:
                max_stamp = max(max_stamp, message["updated_at"])
            cache.execute("DELETE FROM threads WHERE thread_id = ?", (tid,))
            cache.execute(
                "INSERT INTO threads VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (
                    tid,
                    id_key(tid),
                    int(bool(row["subagent"])),
                    row["project_id"],
                    row["project_title"],
                    row["workspace_root"],
                    Path(row["workspace_root"]).name,
                    row["title"],
                    row["created_at"],
                    row["updated_at"],
                    row["archived_at"],
                    sum(1 for m in messages if m["role"] == "user"),
                    sum(1 for m in messages if m["role"] == "assistant"),
                    messages[-1]["created_at"] if messages else None,
                ),
            )
            cache.execute("DELETE FROM messages_fts WHERE thread_id = ?", (tid,))
            cache.executemany(
                "INSERT INTO messages_fts(text, text_plain, thread_id, role, created_at) VALUES (?,?,?,?,?)",
                [(m["text"], SEPARATORS.sub(" ", m["text"]), tid, m["role"], m["created_at"]) for m in messages],
            )
    set_meta(cache, "watermark", max_stamp)
    cache.commit()
    total = cache.execute("SELECT COUNT(*) FROM threads").fetchone()[0]
    cache.close()
    stats = {"threads_indexed": total, "threads_refreshed": len(stale), "watermark": max_stamp}
    if verbose:
        print(f"index: {total} threads, {len(stale)} refreshed, watermark {max_stamp}")
    return stats


def ensure_index(args) -> sqlite3.Connection:
    sync_index(Path(args.store))
    return open_cache()


# --------------------------------------------------------------------------- filtering


def fuzzy_project_match(needle: str, *fields: str) -> bool:
    needle = needle.lower()
    for field in fields:
        field = (field or "").lower()
        if not field:
            continue
        if needle in field or SequenceMatcher(None, needle, field).ratio() >= 0.6:
            return True
    return False


def candidate_threads(cache: sqlite3.Connection, args) -> list[sqlite3.Row]:
    rows = list(cache.execute("SELECT * FROM threads"))
    if getattr(args, "project", None):
        rows = [
            r
            for r in rows
            if any(fuzzy_project_match(p, r["project_title"], r["workspace_name"]) for p in args.project)
        ]
    if getattr(args, "since", None):
        since = iso(parse_date(args.since))
        rows = [r for r in rows if max(r["updated_at"], r["last_msg_at"] or "") >= since]
    if getattr(args, "until", None):
        until = iso(parse_date(args.until))
        rows = [r for r in rows if r["created_at"] <= until]
    if not getattr(args, "include_archived", True):
        rows = [r for r in rows if not r["archived_at"]]
    if not getattr(args, "subagents", False):
        rows = [r for r in rows if not r["subagent"]]
    return rows


# --------------------------------------------------------------------------- term matching


def fts_phrase(term: str) -> str:
    return '"' + term.replace('"', '""') + '"'


def expand_term(cache: sqlite3.Connection, term: str, fuzzy: bool) -> list[str]:
    """Exact/prefix always; --fuzzy adds close vocabulary matches for speech-to-text typos."""
    if not fuzzy or " " in term:
        return []
    lowered = term.lower()
    vocabulary = [
        row[0]
        for row in cache.execute("SELECT term FROM vocab")
        if abs(len(row[0]) - len(lowered)) <= 2 and row[0][:1] == lowered[:1]
    ]
    return [w for w in get_close_matches(lowered, vocabulary, n=5, cutoff=0.8) if w != lowered]


def term_hits(cache: sqlite3.Connection, term: str, fuzzy: bool, table: str = "messages_fts") -> dict[str, dict[str, int]]:
    """thread_id -> {'user'|'assistant'|'tool': n} for one term (tool = archive tool/reasoning/event)."""
    hits: dict[str, dict[str, int]] = {}
    clauses = [fts_phrase(term) + ("" if " " in term else "*")]
    clauses += [fts_phrase(word) for word in expand_term(cache, term, fuzzy)]
    try:
        rows = cache.execute(
            f"SELECT thread_id, role, COUNT(*) AS n FROM {table} WHERE {table} MATCH ? GROUP BY thread_id, role",
            (" OR ".join(clauses),),
        ).fetchall()
    except sqlite3.OperationalError as error:
        sys.exit(f"bad search term {term!r}: {error}")
    for row in rows:
        bucket = hits.setdefault(row["thread_id"], {})
        role = row["role"] if row["role"] in ("user", "assistant") else "tool"
        bucket[role] = bucket.get(role, 0) + row["n"]
    return hits


def score_threads(cache: sqlite3.Connection, rows: list[sqlite3.Row], terms: list[str], args, backup: bool = False) -> list[dict]:
    per_term = {}
    if terms and not args.title_only:
        for term in terms:
            per_term[term] = term_hits(cache, term, args.fuzzy, "entries" if backup else "messages_fts")
    keep_roles = {"user", "assistant"} if args.role == "any" else {args.role}
    results = []
    for row in rows:
        title_lower = row["title"].lower()
        matched, user_hits, assistant_hits, score = [], 0, 0, 0.0
        title_hit = False
        for term in terms:
            counts = per_term.get(term, {}).get(row["thread_id"], {})
            user = counts.get("user", 0) if "user" in keep_roles else 0
            assistant = counts.get("assistant", 0) if "assistant" in keep_roles else 0
            tool = counts.get("tool", 0) if "assistant" in keep_roles else 0
            in_title = term.lower() in title_lower
            if not (user or assistant or tool or in_title):
                continue
            matched.append(term)
            user_hits += user
            assistant_hits += assistant + tool
            score += TERM_COVERAGE_BONUS
            if user:
                score += USER_WEIGHT * (1 + math.log(user))
            if assistant:
                score += ASSISTANT_WEIGHT * (1 + math.log(assistant))
            if tool:
                score += TOOL_WEIGHT * (1 + math.log(tool))
            if in_title:
                title_hit = True
        if title_hit:
            score += TITLE_BONUS
        if terms:
            if not matched:
                continue
            if args.all and len(matched) < len(terms):
                continue
        results.append(
            {
                "thread_id": row["thread_id"],
                "short_id": short_id(row["thread_id"]),
                "project_id": row["project_id"],
                "project": row["project_title"],
                "workspace": row["workspace_name"],
                "title": row["title"],
                "created_at": row["created_at"],
                "updated_at": row["updated_at"],
                "archived": bool(row["archived_at"]),
                "backup": backup,
                "user_msgs": row["user_msgs"],
                "assistant_msgs": row["assistant_msgs"],
                "terms_hit": matched,
                "terms_total": len(terms),
                "user_hits": user_hits,
                "assistant_hits": assistant_hits,
                "score": round(score, 2),
                "link": None if backup else thread_link(row["title"], row["thread_id"]),  # purged: no dead link
            }
        )
    return results


def rank(results: list[dict]) -> list[dict]:
    results.sort(key=lambda r: r["updated_at"], reverse=True)  # recency breaks score ties
    results.sort(key=lambda r: r["score"], reverse=True)
    return results


# --------------------------------------------------------------------------- messages (source db)


def open_backup() -> sqlite3.Connection | None:
    """The purge archive, read-only; None when there is none yet."""
    if not ARCHIVE.exists():
        return None
    backup = sqlite3.connect(f"file:{quote(str(ARCHIVE), safe='/')}?mode=ro", uri=True)
    backup.row_factory = sqlite3.Row
    return backup


def lookup(db: sqlite3.Connection, ident: str) -> list[sqlite3.Row]:
    rows = db.execute("SELECT * FROM threads WHERE thread_id = ?", (ident,)).fetchall()
    if rows or len(ident) < 8:
        return rows
    return db.execute("SELECT * FROM threads WHERE substr(id_key, 1, ?) = ?", (len(ident), ident.lower())).fetchall()


def resolve_thread(cache: sqlite3.Connection, ident: str) -> tuple[sqlite3.Row, bool]:
    """(row, from_backup). Exact full id, else a >=8-char prefix of the id_key (see short_id);
    the live store wins, the backup archive answers for purged threads."""
    if len(ident) < 8:
        sys.exit(f"thread id {ident!r} too short; use at least 8 characters")
    rows, from_backup = lookup(cache, ident), False
    if not rows and (backup := open_backup()):
        rows, from_backup = lookup(backup, ident), True
        backup.close()
    if not rows:
        sys.exit(f"no thread matching {ident!r} (try `t3-find-thread index --rebuild`)")
    if len(rows) > 1:
        sys.exit(f"ambiguous thread id {ident!r}: {', '.join(r['id_key'][:12] for r in rows)}")
    return rows[0], from_backup


def thread_messages(store: Path, thread_id: str, from_backup: bool = False, tools: bool = False) -> list[dict]:
    """Messages in order (idx, role, text, created_at); backup threads add tool/reasoning/event entries
    when `tools`, their role then naming the tool. `idx` is stable across peek/grep/read."""
    if not from_backup:
        with connect_readonly(store) as src:
            return [{"idx": i, **dict(m)} for i, m in enumerate(src.execute(MESSAGES_SQL, (thread_id,)))]
    backup = open_backup()
    rows = backup.execute(
        "SELECT seq, role, tool, text, created_at FROM entries WHERE thread_id = ? ORDER BY seq", (thread_id,)
    ).fetchall()
    backup.close()
    return [
        {"idx": r["seq"], "role": r["role"] if r["role"] in ("user", "assistant") else r["tool"] or r["role"],
         "text": r["text"], "created_at": r["created_at"]}
        for r in rows
        if tools or r["role"] in ("user", "assistant")
    ]


def clip(text: str, limit: int) -> str:
    flat = " ".join(text.split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


# --------------------------------------------------------------------------- commands


def cmd_index(args) -> None:
    stats = sync_index(Path(args.store), rebuild=args.rebuild, verbose=not args.json)
    if args.json:
        print(json.dumps(stats, indent=2))


def backup_reason(args, cache: sqlite3.Connection, results: list[dict]) -> str | None:
    """Why the purge archive joins this search, or None."""
    if args.backup == "off":
        return None
    if args.backup == "on":
        return "asked"
    if not results:
        return "no live hit"
    if max(len(r["terms_hit"]) for r in results) < results[0]["terms_total"]:
        return "no live hit has every term"
    oldest = cache.execute("SELECT min(created_at) FROM threads").fetchone()[0] or ""
    for flag in ("since", "until"):
        if getattr(args, flag, None) and iso(parse_date(getattr(args, flag))) < oldest:
            return f"--{flag} predates the live store ({day(oldest)})"
    return None


def gather(args) -> tuple[list[dict], list[str], str | None]:
    cache = ensure_index(args)
    terms = [t for t in (args.terms or []) + (args.keyword or []) if t.strip()]
    results = score_threads(cache, candidate_threads(cache, args), terms, args)
    reason = backup_reason(args, cache, results)
    if reason and (backup := open_backup()):
        live = {row[0] for row in cache.execute("SELECT thread_id FROM threads")}
        rows = [r for r in candidate_threads(backup, args) if r["thread_id"] not in live]
        results += score_threads(backup, rows, terms, args, backup=True)
        backup.close()
    elif reason:
        reason = None  # no archive on this machine
    cache.close()
    return rank(results), terms, reason


def filters_line(args, terms: list[str], total: int, reason: str | None = None) -> str:
    bits = [f"terms={terms or '—'}", f"project={args.project or 'any'}"]
    if args.since:
        bits.append(f"since={day(iso(parse_date(args.since)))}")
    if args.until:
        bits.append(f"until={day(iso(parse_date(args.until)))}")
    bits += [f"role={args.role}", f"match={'all' if args.all else 'any'}"]
    if args.fuzzy:
        bits.append("fuzzy=on")
    if args.title_only:
        bits.append("title-only")
    if reason:
        bits.append(f"+backup ({reason})")
    return f"{total} candidate(s) · " + " · ".join(bits)


def cmd_search(args) -> None:
    results, terms, reason = gather(args)
    shown = results[: args.limit]
    if args.json or args.format == "json":
        print(json.dumps({"filters": filters_line(args, terms, len(results), reason), "results": shown}, indent=2))
        return
    if args.format == "ids":
        print("\n".join(r["short_id"] for r in shown))
        return
    print(filters_line(args, terms, len(results), reason))
    if not shown:
        print("\nNo hits. Widen: drop a term, add --fuzzy, extend --since, or relax --project.")
        return
    print()
    print("| # | created | project | title | terms | hits u/a | id |")
    print("| --- | --- | --- | --- | --- | --- | --- |")
    for rank, r in enumerate(shown, 1):
        # Purged threads no longer open in T3: plain title, no dead link.
        title = (clip(r["title"], 60) + " _(backup)_") if r["backup"] else thread_link(clip(r["title"], 60), r["thread_id"])
        title += " _(archived)_" if r["archived"] else ""
        print(
            f"| {rank} | {day(r['created_at'])} | {clip(r['project'], 22)} | {title} "
            f"| {len(r['terms_hit'])}/{r['terms_total']} | {r['user_hits']}/{r['assistant_hits']} "
            f"| `{r['short_id']}` |"
        )
    if not reason and args.backup == "auto" and ARCHIVE.exists():
        print("\nBackup archive not searched (a live hit has every term); `--backup on` adds purged threads.")
    print(f"\nNext: t3-find-thread peek {','.join(r['short_id'] for r in shown[:3])}")


def cmd_peek(args) -> None:
    cache = ensure_index(args)
    store = Path(args.store)
    payload = []
    for ident in [i for chunk in args.ids for i in chunk.split(",") if i]:
        row, from_backup = resolve_thread(cache, ident)
        messages = thread_messages(store, row["thread_id"], from_backup)
        prompts = [
            {"idx": m["idx"], "time": minute(m["created_at"]), "text": clip(m["text"], 300)}
            for m in messages
            if m["role"] == "user"
        ][: args.prompts]
        outline = [
            {
                "idx": m["idx"],
                "role": m["role"],
                "time": minute(m["created_at"]),
                "chars": len(m["text"]),
                "head": clip(m["text"], 100),
            }
            for m in messages
        ]
        if len(outline) > args.outline:
            half = args.outline // 2
            outline = outline[:half] + [{"idx": None}] + outline[-half:]
        payload.append(
            {
                "thread_id": row["thread_id"],
                "short_id": short_id(row["thread_id"]),
                "title": row["title"],
                "project": row["project_title"],
                "created_at": row["created_at"],
                "updated_at": row["updated_at"],
                "archived": bool(row["archived_at"]),
                "backup": from_backup,
                "user_msgs": row["user_msgs"],
                "assistant_msgs": row["assistant_msgs"],
                "link": row["title"] + " (backup)" if from_backup else thread_link(row["title"], row["thread_id"]),
                "prompts": prompts,
                "outline": outline,
            }
        )
    cache.close()
    if args.json:
        print(json.dumps(payload, indent=2))
        return
    for item in payload:
        print(f"\n## {item['link']}  ({item['short_id']})")
        print(
            f"{item['project']} · {day(item['created_at'])} → {day(item['updated_at'])} · "
            f"{item['user_msgs']}u/{item['assistant_msgs']}a"
            + (" · archived" if item["archived"] else "")
        )
        print("\n**First prompts**")
        for prompt in item["prompts"] or [{"idx": "-", "time": "", "text": "(none)"}]:
            print(f"- #{prompt['idx']} {prompt['time']} — {prompt['text']}")
        print("\n**Outline**")
        for line in item["outline"]:
            if line["idx"] is None:
                print("  …")
                continue
            print(f"  #{line['idx']:<3} {line['role'][:1]} {line['time']} {line['chars']:>6}c  {line['head']}")


def cmd_grep(args) -> None:
    cache = ensure_index(args)
    row, from_backup = resolve_thread(cache, args.id)
    cache.close()
    terms = [t for t in (args.terms or []) + (args.keyword or []) if t.strip()]
    if not terms:
        sys.exit("grep needs at least one term (positional or -k)")
    patterns = [(t, re.compile(re.escape(t), re.I)) for t in terms]
    snippets = []
    for message in thread_messages(Path(args.store), row["thread_id"], from_backup, tools=True):
        for term, pattern in patterns:
            for match in pattern.finditer(message["text"]):
                start = max(0, match.start() - args.context // 2)
                snippets.append(
                    {
                        "idx": message["idx"],
                        "role": message["role"],
                        "time": minute(message["created_at"]),
                        "term": term,
                        "text": clip(message["text"][start : match.end() + args.context // 2], args.context + 40),
                    }
                )
                break  # one snippet per message per term keeps context cheap
        if len(snippets) >= args.limit:
            break
    snippets = snippets[: args.limit]
    if args.json:
        print(json.dumps({"thread_id": row["thread_id"], "title": row["title"], "snippets": snippets}, indent=2))
        return
    heading = row["title"] + " _(backup)_" if from_backup else thread_link(row["title"], row["thread_id"])
    print(f"## {heading}  ({short_id(row['thread_id'])}) — {len(snippets)} snippet(s) for {terms}")
    for s in snippets:
        print(f"\n#{s['idx']} {s['role']} {s['time']} [{s['term']}]\n  …{s['text']}…")
    if not snippets:
        print("\n(no hits in this thread — try other synonyms)")


def cmd_read(args) -> None:
    """The story of a purged thread (T3 can no longer open it): entries in order, full text."""
    cache = ensure_index(args)
    row, from_backup = resolve_thread(cache, args.id)
    cache.close()
    entries = [
        m for m in thread_messages(Path(args.store), row["thread_id"], from_backup, tools=args.tools)
        if m["idx"] >= args.start
    ][: args.limit]
    if args.json:
        print(json.dumps({"thread_id": row["thread_id"], "title": row["title"], "entries": entries}, indent=2))
        return
    heading = row["title"] + " _(backup)_" if from_backup else thread_link(row["title"], row["thread_id"])
    print(f"## {heading}  ({short_id(row['thread_id'])})")
    for m in entries:
        print(f"\n#{m['idx']} {m['role']} {minute(m['created_at'])}\n{m['text']}")
    if len(entries) == args.limit:
        flags = (" --tools" if args.tools else "") + (f" --limit {args.limit}" if args.limit != 30 else "")
        print(f"\nMore: t3-find-thread read {short_id(row['thread_id'])} --from {entries[-1]['idx'] + 1}{flags}")


# --------------------------------------------------------------------------- cli


def add_filters(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("terms", nargs="*", help="keywords (quote phrases)")
    parser.add_argument("-k", "--keyword", action="append", help="extra keyword (repeatable)")
    parser.add_argument("--project", action="append", help="fuzzy project/workspace name (repeatable)")
    parser.add_argument("--since", help="ISO date or relative (7d, 3w, 2m)")
    parser.add_argument("--until", help="ISO date or relative")
    parser.add_argument("--include-archived", dest="include_archived", action="store_true", default=True)
    parser.add_argument("--no-archived", dest="include_archived", action="store_false")
    parser.add_argument("--role", choices=("user", "assistant", "any"), default="any")
    parser.add_argument("--all", action="store_true", help="require every term")
    parser.add_argument("--title-only", action="store_true", help="match thread titles only")
    parser.add_argument("--fuzzy", action="store_true", help="also match close spellings (speech-to-text typos)")
    parser.add_argument("--subagents", action="store_true", help="include sub-agent / delegated-task threads")
    parser.add_argument(
        "--backup", choices=("auto", "on", "off"), default="auto",
        help="also search purged threads in the backup archive (auto: no live hit with every term, or dates before the live store)",
    )
    parser.add_argument("--limit", type=int, default=15)


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        prog="t3-find-thread", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--store", default=str(DEFAULT_STORE), help=argparse.SUPPRESS)
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    subparsers = parser.add_subparsers(dest="command", required=True)

    index_parser = subparsers.add_parser("index", help="build/refresh the FTS cache")
    index_parser.add_argument("--rebuild", action="store_true")
    index_parser.set_defaults(func=cmd_index)

    search_parser = subparsers.add_parser("search", help="ranked candidate threads")
    add_filters(search_parser)
    search_parser.add_argument("--format", choices=("md", "json", "ids"), default="md")
    search_parser.set_defaults(func=cmd_search)

    peek_parser = subparsers.add_parser("peek", help="headers, first prompts, outline")
    peek_parser.add_argument("ids", nargs="+")
    peek_parser.add_argument("--prompts", type=int, default=3)
    peek_parser.add_argument("--outline", type=int, default=40)
    peek_parser.set_defaults(func=cmd_peek)

    read_parser = subparsers.add_parser("read", help="a thread's entries in full (for purged threads)")
    read_parser.add_argument("id")
    read_parser.add_argument("--tools", action="store_true", help="include archived tool calls / reasoning")
    read_parser.add_argument("--from", dest="start", type=int, default=0, help="first entry #")
    read_parser.add_argument("--limit", type=int, default=30)
    read_parser.set_defaults(func=cmd_read)

    grep_parser = subparsers.add_parser("grep", help="snippets around keyword hits in one thread")
    grep_parser.add_argument("id")
    grep_parser.add_argument("terms", nargs="*")
    grep_parser.add_argument("-k", "--keyword", action="append")
    grep_parser.add_argument("--context", type=int, default=200)
    grep_parser.add_argument("--limit", type=int, default=12)
    grep_parser.set_defaults(func=cmd_grep)

    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
