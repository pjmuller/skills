#!/usr/bin/env bash
# Deprecated stub: t3-manage-thread ships t3-find-thread and t3-open-thread now. Installing links nothing
# (always succeeds, so a skills-refresh never rolls back over it); --check verifies the commands work.
set -euo pipefail
script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)"
[[ $# == 0 || ( $# == 1 && ( "$1" == --check || "$1" == --relink ) ) ]] || { echo 'Usage: install [--check|--relink]' >&2; exit 2; }
source "$script_dir/resolve.sh"
if [[ "${1:-}" != --check ]]; then
  echo "t3-find-thread moved into t3-manage-thread: its scripts/install links the commands" >&2
  exit 0
fi
echo "source $script_dir"
status=0
for command_name in t3-find-thread t3-open-thread; do
  if ! dir="$(manage_scripts "$command_name")"; then
    printf 'MISSING %s: install t3-manage-thread, then its scripts/install\n' "$command_name"; status=1
  elif ! command -v "$command_name" >/dev/null; then
    printf 'MISSING %s not on PATH: run %s/install\n' "$command_name" "$dir"; status=1
  elif ! "$command_name" --help >/dev/null 2>&1; then
    printf 'MISSING %s on PATH fails: run %s/install --check\n' "$command_name" "$dir"; status=1
  else
    printf 'ok      %s (t3-manage-thread at %s)\n' "$command_name" "$dir"
  fi
done
exit "$status"
