#!/usr/bin/env bash
# Put t3-find-thread + t3-open-thread on PATH. Idempotent; run once per machine.
#
#   scripts/install            symlink the helpers into ~/.local/bin
#   scripts/install --check    verify deps, the T3 store and the symlinks
#
# Override the target dir with T3_FIND_BIN.
set -euo pipefail

script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)"
bin_dir="${T3_FIND_BIN:-$HOME/.local/bin}"
helpers=(t3-find-thread t3-open-thread)

if [[ "${1-}" == "--check" ]]; then
  status=0
  for dependency in uv python3; do
    if command -v "$dependency" >/dev/null; then
      printf 'ok      %s (%s)\n' "$dependency" "$(command -v "$dependency")"
    else
      printf 'MISSING %s\n' "$dependency"
      status=1
    fi
  done
  store="${T3CODE_HOME:-$HOME/.t3}/userdata/state.sqlite"
  if [[ -f "$store" ]]; then
    printf 'ok      T3 store (%s)\n' "$store"
  else
    printf 'MISSING T3 store at %s\n' "$store"
    status=1
  fi
  for helper in "${helpers[@]}"; do
    if [[ "$(readlink -f "$bin_dir/$helper" 2>/dev/null)" == "$script_dir/$helper" ]]; then
      printf 'ok      %s on PATH (%s)\n' "$helper" "$bin_dir/$helper"
    else
      printf 'MISSING %s is not linked from %s (run scripts/install)\n' "$helper" "$bin_dir"
      status=1
    fi
  done
  exit "$status"
fi
if [[ -n "${1-}" ]]; then
  echo "Usage: install [--check]" >&2
  exit 2
fi

mkdir -p "$bin_dir"
for helper in "${helpers[@]}"; do
  chmod +x "$script_dir/$helper"
  target="$bin_dir/$helper"
  if [[ -e "$target" && ! -L "$target" ]]; then
    echo "SKIP $target (exists and is not a symlink)" >&2
    exit 1
  fi
  ln -sfn "$script_dir/$helper" "$target"
  echo "LINK $target -> $script_dir/$helper"
done
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "note: $bin_dir is not on your PATH; add it to your shell profile." >&2 ;;
esac
