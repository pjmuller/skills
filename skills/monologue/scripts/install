#!/bin/sh
set -eu
case "${1:-}" in ""|--check) ;; *) echo "usage: $0 [--check]" >&2; exit 2;; esac
command -v uv >/dev/null || { echo "Install uv first" >&2; exit 1; }
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
uv run "$root/scripts/monologue_api.py" --help >/dev/null
printf '%s\n' 'Monologue ready; no global command links or credentials installed'
