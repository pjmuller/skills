#!/usr/bin/env -S uv run --script --python 3.12
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Personal Claude Code cloud API experiment; no credential writes or local checkout."""
import argparse
import datetime
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

BASE = "https://api.anthropic.com"
# Observed in Claude CLI 2.1.276; /v1/code needs no anthropic-beta header.
API_VERSION = "2023-06-01"


class Failure(Exception):
    def __init__(self, message, code=1, status=None):
        super().__init__(message)
        self.code = code
        self.status = status


def t3_lib():
    """Profile → Keychain mapping is owned by the t3-manage-thread skill; resolve its
    lib through the installed command so both stay on one hashing rule."""
    command = shutil.which("t3-limits")
    if not command:
        raise Failure("t3-limits not on PATH: install the t3-manage-thread skill "
                      "(its scripts/install), then retry", 2)
    sys.path.insert(0, str(Path(command).resolve().parent / "lib"))
    try:
        from t3_limits import SETTINGS, claude_profiles, keychain_service
    except ImportError:
        raise Failure("t3-limits found but its lib/t3_limits.py is missing or "
                      "incompatible; rerun the t3-manage-thread scripts/install", 2) from None
    return SETTINGS, claude_profiles, keychain_service


def resolve_profile(needle):
    """Return home, Keychain service, default-home flag and provenance."""
    settings, claude_profiles, keychain_service = t3_lib()
    profiles = claude_profiles(settings)
    source = "--profile"
    if needle is None:
        needle = os.environ.get("CLAUDE_CLOUD_PROFILE")
        source = "CLAUDE_CLOUD_PROFILE"
    if needle is not None:
        lowered = needle.casefold()
        matches = [p for p in profiles
                   if lowered in p[0].casefold() or lowered in p[1].casefold()]
        if len(matches) != 1:
            names = ", ".join(f"{label} ({instance})" for instance, label, _ in matches or profiles)
            kind = "Ambiguous" if matches else "Unknown"
            raise Failure(f"{kind} {source} {needle!r}; candidates: {names or 'none'}", 2)
        profile = matches[0]
    elif os.environ.get("CLAUDE_CONFIG_DIR"):
        home = Path(os.environ["CLAUDE_CONFIG_DIR"]).expanduser()
        matches = [p for p in profiles if p[2] and Path(p[2]).expanduser() == home]
        label = f"{matches[0][1]} ({matches[0][0]})" if matches else str(home)
        return home, keychain_service(str(home)), False, f"profile: {label} via CLAUDE_CONFIG_DIR"
    elif len(profiles) == 1:
        profile = profiles[0]
        source = "only profile"
    else:
        names = ", ".join(f"{label} ({instance})" for instance, label, _ in profiles)
        raise Failure("Neither --profile nor CLAUDE_CLOUD_PROFILE set and "
                      f"{len(profiles)} Claude profiles exist ({names}); pass one.", 2)
    instance, label, home_path = profile
    return (Path(home_path).expanduser() if home_path else Path.home() / ".claude",
            keychain_service(home_path), not bool(home_path),
            f"profile: {label} ({instance}) via {source}")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise Failure("Unexpected API redirect; refusing to forward credentials")


class API:
    def __init__(self, profile):
        self.home, self.service, self.default_home, self.resolved = resolve_profile(profile)
        self.refresh_attempted = False
        self.opener = urllib.request.build_opener(NoRedirect())

    def stored_credentials(self):
        # Read afresh: the official CLI may refresh the shared token during wait.
        result = subprocess.run(["security", "find-generic-password", "-s",
                                 self.service, "-w"], capture_output=True, text=True)
        raw = result.stdout if result.returncode == 0 else None
        if raw is None:
            path = self.home / ".credentials.json"
            if path.exists():
                raw = path.read_text()
        if not raw:
            raise Failure(f"No Claude OAuth credentials for {self.home}", 3)
        try:
            credential = json.loads(raw)["claudeAiOauth"]
            token = credential["accessToken"]
            expires = credential.get("expiresAt", 0)
        except (KeyError, TypeError, ValueError):
            raise Failure("Invalid stored Claude OAuth credentials", 3) from None
        return token, expires

    def credentials(self):
        token, expires = self.stored_credentials()
        if expires and expires <= (time.time() + 600) * 1000 and not self.refresh_attempted:
            self.refresh_attempted = True
            env = os.environ.copy()
            for variable in ("CLAUDE_CONFIG_DIR", "ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"):
                env.pop(variable, None)
            if not self.default_home:
                env["CLAUDE_CONFIG_DIR"] = str(self.home)
            print("OAuth expiring: refreshing once with official Claude CLI", file=sys.stderr)
            try:
                with tempfile.TemporaryDirectory(prefix="claude-cloud-refresh-") as scratch:
                    subprocess.run(["claude", "-p", "reply with ok", "--model", "haiku",
                                    "--max-turns", "1"], env=env, cwd=scratch, capture_output=True,
                                   text=True, timeout=120)
            except (OSError, subprocess.TimeoutExpired):
                pass
            token, expires = self.stored_credentials()
        if expires and expires <= time.time() * 1000:
            hint = "the default profile" if self.default_home else f"CLAUDE_CONFIG_DIR={self.home}"
            raise Failure("OAuth expired: refresh/login with the official Claude CLI "
                          f"using {hint}, then retry", 3)
        return token

    def call(self, path, body=None, timeout=30):
        headers = {"Authorization": "Bearer " + self.credentials(),
                   "Content-Type": "application/json", "anthropic-version": API_VERSION,
                   "anthropic-client-platform": "claude_code_cli"}
        if path == "/v1/environment_providers":
            config = (Path.home() / ".claude.json" if self.home.name == ".claude"
                      else self.home / ".claude.json")
            try:
                org = json.loads(config.read_text())["oauthAccount"]["organizationUuid"]
            except (OSError, ValueError, KeyError, TypeError):
                raise Failure(f"Missing organization UUID in {config}", 3) from None
            headers["x-organization-uuid"] = org
        request = urllib.request.Request(BASE + path, headers=headers,
                                         data=None if body is None else json.dumps(body).encode())
        try:
            with self.opener.open(request, timeout=timeout) as response:
                return json.load(response)
        except urllib.error.HTTPError as exc:
            # Never echo bodies: they may reflect credentials or submitted content.
            code = 3 if exc.code in (401, 403) else 4 if exc.code == 404 else 1
            hint = " Check official CLI login/device requirements." if code == 3 else ""
            raise Failure(f"HTTP {exc.code}: {request.get_method()} {path}.{hint}", code, exc.code) from None
        except (urllib.error.URLError, TimeoutError, ValueError) as exc:
            hint = " Outcome unknown; inspect sessions/read before retrying." if body is not None else ""
            raise Failure(f"API {type(exc).__name__}: {request.get_method()} {path}.{hint}") from None

    def environments(self):
        return self.call("/v1/environment_providers")["environments"]

    def session(self, sid, timeout=30):
        result = self.call(f"/v1/code/sessions/{sid}", timeout=timeout)
        return result.get("session") or result["response_shape"]

    def events(self, sid, cursor=None, timeout=30, deadline=None):
        rows = []
        while True:
            if deadline is not None:
                timeout = min(timeout, deadline - time.monotonic())
                if timeout <= 0:
                    raise Failure("Timed out; session was not cancelled", 124)
            query = {"sort_order": "asc"}
            if cursor is not None:
                query["cursor"] = cursor
            page = self.call(f"/v1/code/sessions/{sid}/events?" +
                             urllib.parse.urlencode(query), timeout=timeout)
            rows.extend(page["data"])
            next_cursor = page.get("next_cursor")
            if not next_cursor:
                return rows, str(rows[-1]["sequence_num"]) if rows else cursor
            if str(next_cursor) == str(cursor):
                raise Failure("Events pagination cursor did not advance")
            cursor = next_cursor


def session_id(value):
    if not re.fullmatch(r"(?:session|cse)_[A-Za-z0-9_-]+", value):
        raise argparse.ArgumentTypeError("Expected session_… or cse_… ID")
    return value


def user_event(message, sid=""):
    return {"payload": {"uuid": str(uuid.uuid4()), "session_id": sid, "type": "user",
                        "parent_tool_use_id": None,
                        "message": {"role": "user", "content": message}}}


def real_user(payload):
    if payload.get("type") != "user" or payload.get("parent_tool_use_id") or payload.get("isMeta"):
        return False
    content = payload.get("message", {}).get("content", [])
    return isinstance(content, str) or any(b.get("type") == "text" for b in content)


def markdown(payload):
    kind = payload.get("type")
    if kind not in ("user", "assistant") or payload.get("isMeta"):
        return ""
    content = payload.get("message", {}).get("content", [])
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    lines = []
    for block in content:
        if block.get("type") == "text":
            lines.append(block["text"])
        elif block.get("type") == "tool_use":
            lines.append(f"*Tool: {block['name']}*")
    return f"### {kind.capitalize()}\n\n" + "\n\n".join(lines) + "\n" if lines else ""


def state(session):
    if session.get("status") in ("archived", "failed", "cancelled", "rejected"):
        return session["status"]
    return session.get("worker_status") or session.get("status", "unknown")


def wait(api, sid, timeout, quiet=False):
    deadline = time.monotonic() + timeout
    try:
        wait_turn(api, sid, deadline, quiet=quiet)
    except Failure as exc:
        if exc.code == 1 and time.monotonic() >= deadline:
            raise Failure("Timed out; session was not cancelled", 124) from None
        raise


def wait_turn(api, sid, deadline, quiet=False):
    rows, cursor = api.events(sid, deadline=deadline)
    # Start at the latest user turn, never mistake an earlier result for its reply.
    start = 0
    for i, row in enumerate(rows):
        if real_user(row["payload"]):
            start = i
    rows = rows[start:]
    finished = False
    error = False
    pending_controls = set()
    while True:
        for row in rows:
            payload = row["payload"]
            if real_user(payload):
                finished = error = False
                pending_controls.clear()
            if payload.get("parent_tool_use_id"):
                continue
            kind = payload.get("type")
            if kind == "assistant":
                text = markdown(payload)
                if text and not quiet:
                    print(text, flush=True)
                finished = payload.get("message", {}).get("stop_reason") == "end_turn"
                error |= bool(payload.get("isApiErrorMessage") and not payload.get("apiErrorIsTransient"))
            elif kind == "result":
                finished = True
                error |= bool(payload.get("is_error"))
            elif kind == "control_request" and payload.get("request", {}).get("subtype") == "can_use_tool":
                pending_controls.add(payload["request_id"])
            elif kind == "control_response":
                pending_controls.discard(payload.get("response", {}).get("request_id"))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Failure("Timed out; session was not cancelled", 124)
        current = api.session(sid, timeout=min(30, remaining))
        status = state(current)
        if status in ("failed", "cancelled", "rejected", "archived"):
            raise Failure(f"Session {status}", 5)
        init_error = current.get("external_metadata", {}).get("last_init_error")
        if init_error:
            try:
                age = time.time() - datetime.datetime.fromisoformat(init_error["at"]).timestamp()
            except (KeyError, TypeError, ValueError):
                age = 0
            # CLI 2.1.276 gives recoverable provisioning failures two minutes.
            fatal = str(init_error.get("recoverable")).lower() != "true" or age > 120
            healthy = current.get("worker_status") in ("running", "idle", "requires_action")
            if init_error.get("error_kind") == "environment_deleted" or (fatal and not healthy):
                raise Failure(f"Cloud startup failed; inspect https://claude.ai/code/{sid}", 5)
        if status == "requires_action" or pending_controls:
            raise Failure(f"Session needs interaction: https://claude.ai/code/{sid}", 5)
        if error:
            raise Failure("Cloud turn reported an error; inspect read/session URL", 5)
        if finished:
            print(f"Turn complete ({status})", file=sys.stderr)
            return
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Failure("Timed out; session was not cancelled", 124)
        time.sleep(min(2, remaining))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Failure("Timed out; session was not cancelled", 124)
        rows, cursor = api.events(sid, cursor, deadline=deadline)


def since_time(value):
    if value is None:
        return None
    if re.fullmatch(r"\d+d", value):
        return datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=int(value[:-1]))
    try:
        return datetime.datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        raise Failure("--since expects Nd or YYYY-MM-DD", 2) from None


def session_rows(api, since=None, limit=None):
    cutoff = since_time(since)
    if limit is not None and limit < 1:
        raise Failure("--limit must be positive", 2)
    rows, cursor = [], None
    while True:
        query = {"limit": 50}
        if cursor:
            query["cursor"] = cursor
        page = api.call("/v1/code/sessions?" + urllib.parse.urlencode(query))
        for session in page["data"]:
            # Live lists are not creation-sorted: an old active session can precede newer ones.
            if cutoff and datetime.datetime.fromisoformat(session["created_at"].replace("Z", "+00:00")) < cutoff:
                continue
            config = session.get("config") or {}
            meta = session.get("external_metadata") or {}
            usage = meta.get("usage") or {}
            sources = config.get("sources") or []
            rows.append({
                "id": session["id"], "url": "https://claude.ai/code/" + session["id"],
                "created_at": session.get("created_at"), "last_event_at": session.get("last_event_at"),
                "origin": config.get("origin"), "repo": sources[0].get("url") if sources else None,
                "branches": [branch for outcome in config.get("outcomes", [])
                             for branch in (outcome.get("git_info") or {}).get("branches", [])],
                "title": session.get("title"), "status": state(session),
                "user_message_count": int(session.get("user_message_count") or 0),
                "model": config.get("model") or meta.get("last_served_model"),
                "cost_usd": usage.get("cost_usd"),
                "tokens": {key: value for key, value in usage.items() if "token" in key},
                "task_summary": meta.get("task_summary") or meta.get("post_turn_summary"),
                "cc_version": meta.get("container_cc_version"),
            })
            if limit and len(rows) >= limit:
                return rows
        next_cursor = page.get("next_cursor")
        if not next_cursor:
            return rows
        if str(next_cursor) == str(cursor):
            raise Failure("Sessions pagination cursor did not advance")
        cursor = next_cursor


def content_text(content):
    if isinstance(content, str):
        return content
    return "\n".join(block.get("text", "") for block in (content or [])
                     if block.get("type") == "text")


def review_turns(rows):
    turns, tools = [], {}
    for row in sorted(rows, key=lambda row: int(row.get("sequence_num", 0))):
        payload = row["payload"]
        role = payload.get("type")
        if role not in ("user", "assistant") or payload.get("isMeta"):
            continue
        content = payload.get("message", {}).get("content", [])
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content
        turn = {"role": role, "text": content_text(blocks), "tools": [],
                "ts": row.get("created_at") or payload.get("timestamp")}
        for block in blocks:
            if block.get("type") == "tool_use":
                tool = {"name": block.get("name", "unknown"),
                        "input_summary": json.dumps(block.get("input", {}), ensure_ascii=False)[:120],
                        "is_error": False, "error_excerpt": ""}
                tools[block.get("id")] = tool
                turn["tools"].append(tool)
            elif block.get("type") == "tool_result" and block.get("is_error"):
                tool = tools.get(block.get("tool_use_id"))
                if tool is None:
                    tool = {"name": "unknown", "input_summary": "", "is_error": False, "error_excerpt": ""}
                    turn["tools"].append(tool)
                tool["is_error"] = True
                tool["error_excerpt"] = content_text(block.get("content", ""))[:300]
        if turn["text"] or turn["tools"]:
            turns.append(turn)
    return turns


def review_markdown(turns):
    parts = []
    for turn in turns:
        lines = [turn["text"]] if turn["text"] else []
        for tool in turn["tools"]:
            lines.append(f"*Tool: {tool['name']}*")
            if tool["is_error"]:
                lines.append(f"⚠ tool error ({tool['name']}): {tool['error_excerpt']}")
        parts.append(f"### {turn['role'].capitalize()}\n\n" + "\n\n".join(lines))
    return "\n\n".join(parts) + ("\n" if parts else "")


def redact(value):
    if isinstance(value, str):
        return re.sub(r"(sk-|token|Bearer )\S+", "[REDACTED]", value)
    if isinstance(value, list):
        return [redact(item) for item in value]
    if isinstance(value, dict):
        return {key: redact(item) for key, item in value.items()}
    return value


def write_export(path, text):
    # Private, atomic snapshots: an interrupted write must not become a cache hit.
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as temporary:
        temporary.write(text)
        name = temporary.name
    os.replace(name, path)


def export_sessions(api, since, directory):
    directory = Path(directory).expanduser()
    directory.mkdir(parents=True, exist_ok=True)
    index_path = directory / "index.json"
    index = {row["id"]: row for row in json.loads(index_path.read_text())} if index_path.exists() else {}
    written = skipped = 0
    for session in session_rows(api, since):
        sid = session["id"]
        try:
            session_id(sid)  # Server IDs must also be safe filenames.
        except argparse.ArgumentTypeError:
            raise Failure("Invalid session ID in API response") from None
        path = directory / f"{sid}.md"
        old = index.get(sid, {})
        counts = ("turns", "tool_errors", "first_prompt")
        text = None
        if path.exists() and all(old.get(key) is not None for key in counts):
            session.update({key: old[key] for key in counts})
            skipped += 1
        else:
            rows, _ = api.events(sid)
            turns = review_turns(rows)
            session.update(turns=len(turns),
                           tool_errors=sum(tool["is_error"] for turn in turns for tool in turn["tools"]),
                           first_prompt=next((turn["text"][:300] for turn in turns
                                              if turn["role"] == "user" and turn["text"]), ""))
            text = f"# {session.get('title') or sid}\n\n{session['url']}\n\n" + review_markdown(turns)
            written += 1
        index[sid] = session
        # Checkpoint metadata before the Markdown cache marker; preserve older windows.
        write_export(index_path, json.dumps(redact(list(index.values())), ensure_ascii=False, indent=2) + "\n")
        if text is not None:
            write_export(path, redact(text))
    if not index_path.exists():
        write_export(index_path, "[]\n")
    print(f"Exported {written}; skipped {skipped}; total {len(index)}; index {index_path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", help="T3 Claude profile; then CLAUDE_CLOUD_PROFILE, "
                                          "CLAUDE_CONFIG_DIR, or the only profile")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("envs")
    sessions = commands.add_parser("sessions")
    sessions.add_argument("--since")
    sessions.add_argument("--limit", type=int)
    sessions.add_argument("--json", action="store_true")
    export = commands.add_parser("export")
    export.add_argument("--since", default="7d")
    export.add_argument("--dir", required=True)
    create = commands.add_parser("create")
    create.add_argument("--env")
    create.add_argument("--repo", help="GitHub owner/repo or https://github.com/owner/repo")
    create.add_argument("--branch")
    create.add_argument("--title")
    create.add_argument("--wait", action="store_true")
    create.add_argument("--timeout", type=float, default=1800)
    create.add_argument("prompt")
    for name in ("send", "wait", "read", "archive"):
        sub = commands.add_parser(name)
        sub.add_argument("id", type=session_id)
        if name == "read":
            sub.add_argument("--json", action="store_true")
        if name == "send":
            sub.add_argument("message")
        if name == "wait":
            sub.add_argument("--timeout", type=float, default=1800)
    # Accept profile before or after the subcommand.
    for sub in commands.choices.values():
        sub.add_argument("--profile", default=argparse.SUPPRESS)
    args = parser.parse_args()
    if hasattr(args, "timeout") and (not math.isfinite(args.timeout) or args.timeout <= 0):
        raise Failure("--timeout must be positive", 2)
    api = API(args.profile)
    if args.command != "create":
        print(api.resolved, file=sys.stderr)
    if args.command == "envs":
        for env in api.environments():
            print(f"{env['environment_id']}\t{env['name']}\t{env.get('kind', '')}\t{env.get('state', '')}")
    elif args.command == "sessions":
        rows = session_rows(api, args.since, args.limit)
        if args.json:
            print(json.dumps(rows, ensure_ascii=False, indent=2))
        else:
            print("created\torigin\trepo\tmsgs\tstatus\ttitle")
            for row in rows:
                print("\t".join(str(row.get(key) if row.get(key) is not None else "") for key in
                                ("created_at", "origin", "repo", "user_message_count", "status", "title")))
    elif args.command == "export":
        export_sessions(api, args.since, args.dir)
    elif args.command == "create":
        try:
            environments = api.environments()
        except Failure:
            print(api.resolved, file=sys.stderr)
            raise
        wanted = args.env if args.env is not None else os.environ.get("CLAUDE_CLOUD_ENV")
        source = "--env" if args.env is not None else "CLAUDE_CLOUD_ENV"
        matches = [e for e in environments if wanted in (e["environment_id"], e["name"])] if wanted is not None else environments
        if len(matches) != 1:
            print(api.resolved, file=sys.stderr)
            names = ", ".join(f"{e['name']} ({e['environment_id']})" for e in environments)
            raise Failure(f"Environment must resolve to one entry via --env or CLAUDE_CLOUD_ENV; "
                          f"candidates: {names or 'none'}", 2)
        env = matches[0]
        if wanted is None:
            source = "only environment"
        resolved = [api.resolved, f"env: {env['name']} via {source}"]
        for key, fallback in (("repo", None), ("branch", "main")):
            value = getattr(args, key)
            variable = "CLAUDE_CLOUD_" + key.upper()
            origin = "--" + key
            if value is None:
                value = os.environ.get(variable)
                origin = variable
            if value is None:
                value, origin = fallback, "default"
            setattr(args, key, value)
            resolved.append(f"{key}: {value or '(none)'} via {origin}")
        print(" · ".join(resolved), file=sys.stderr)
        if env.get("kind") != "anthropic_cloud":
            raise Failure("This prototype supports Anthropic-hosted cloud environments only", 2)
        sources = []
        if args.repo:
            repo = args.repo.removeprefix("https://github.com/").removesuffix(".git")
            if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
                raise Failure("Expected GitHub owner/repo or HTTPS repository URL", 2)
            sources = [{"type": "git_repository", "url": "https://github.com/" + repo,
                        "revision": args.branch}]
        body = {"title": args.title if args.title is not None else args.prompt[:120], "environment_id": env["environment_id"],
                "events": [user_event(args.prompt)],
                "config": {"sources": sources, "outcomes": []}}
        created = api.call("/v1/code/sessions", body)["session"]
        print(created["id"], flush=True)
        print("https://claude.ai/code/" + created["id"], flush=True)
        if args.wait:
            wait(api, created["id"], args.timeout, quiet=True)
            rows, _ = api.events(created["id"])
            print(review_markdown(review_turns(rows)))
    elif args.command == "send":
        latest = api.call(f"/v1/code/sessions/{args.id}/events?sort_order=desc&limit=1")["data"]
        cursor = str(latest[0]["sequence_num"]) if latest else None
        event = user_event(args.message, args.id)
        api.call(f"/v1/code/sessions/{args.id}/events", {"events": [event]})
        print(args.id, flush=True)
        print("https://claude.ai/code/" + args.id, flush=True)
        deadline = time.monotonic() + 10
        try:
            while True:
                rows, cursor = api.events(args.id, cursor, deadline=deadline)
                if any(r["payload"].get("uuid") == event["payload"]["uuid"] for r in rows):
                    break
                if time.monotonic() >= deadline:
                    raise Failure("Event visibility deadline")
                time.sleep(max(0, min(1, deadline - time.monotonic())))
        except Failure:
            raise Failure("Send accepted, visibility unconfirmed. Retry read/wait; do not resend.") from None
    elif args.command == "read":
        rows, _ = api.events(args.id)
        turns = review_turns(rows)
        print(json.dumps(turns, ensure_ascii=False, indent=2) if args.json else review_markdown(turns))
    elif args.command == "wait":
        wait(api, args.id, args.timeout)
    elif args.command == "archive":
        try:
            api.call(f"/v1/code/sessions/{args.id}/archive", {})
        except Failure as exc:
            if exc.status != 409 or api.session(args.id).get("status") != "archived":
                raise
        print(f"Archived {args.id}")


if __name__ == "__main__":
    try:
        main()
    except Failure as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(exc.code)
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, KeyError, TypeError, ValueError):
        print("Local I/O or unexpected API schema; inspect CLI compatibility", file=sys.stderr)
        sys.exit(1)
