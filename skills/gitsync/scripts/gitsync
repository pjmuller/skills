#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""gitsync: shared checkouts level with their remote. Finds uncommitted or unpushed leftovers in the repos
you worked in lately; the calling T3 thread delegates one child task per repo that needs judgment.

  survey   select repos (T3 threads + recent commits + --always), fetch, one verdict per repo
  prepare  claim every `worker` repo for --owner (cross-run claim store) and write its brief;
           prints what to pass to delegate_task. Rerun = resume: same claims, same request ids
  record   store the delegate_task taskId / childThreadId on the claim
  status   child state + a strict git re-check per claimed repo -> landed/protected/blocked;
           releases claims whose child finished

Verdicts:
  clean    nothing dirty, level with upstream          ff      clean, only behind (--apply-ff)
  fresh    every dirty path changed < --fresh-minutes  local   no upstream, nothing stale
  owned    another orchestrator holds a live claim     worker  stale dirty paths, ahead/diverged,
                                                               fetch failed or ff refused
Age only filters; it never proves work is finished. Judgment lives in the child: ../worker.md.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
PLAYBOOK = SKILL_DIR / "worker.md"
TITLE_PREFIX = "🧹 gitsync"
FETCH_TIMEOUT = 60
WALK_CAP = 5000  # files scanned per untracked directory before calling it fresh (unknown = protect)
VERDICTS = ["worker", "owned", "fresh", "ff", "local", "clean"]
DISPATCHABLE = ("worker", "owned")
# A claim is held while its owner or child runs, and always for CLAIM_TTL_S after claiming: T3's store can
# show a busy orchestrator as idle between turns, so liveness alone would let a second run steal its repos.
CLAIM_TTL_S = 6 * 3600
INTERACTIVE_KINDS = ("top", "launched")  # tasks/sub-agents inherit their parent's workspace: not activity


def state_dir() -> Path:
    return Path(os.environ.get("GITSYNC_STATE", "~/.local/state/gitsync")).expanduser()


def run(args: list[str], cwd: Path | None = None, timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd, text=True, capture_output=True, timeout=timeout)


def git(cwd: Path, *args: str) -> str:
    p = run(["git", *args], cwd=cwd)
    return p.stdout.strip() if p.returncode == 0 else ""


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def ts(iso: str) -> float:
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def last_line(p: subprocess.CompletedProcess, default: str) -> str:
    return ((p.stderr or p.stdout).strip().splitlines() or [default])[-1]


# ---------------------------------------------------------------- T3 fleet

def fleet(recent: str) -> list[dict]:
    """Every thread incl. delegated tasks and sub-agents. Fails closed: an empty fleet would hide live owners."""
    cmd = ["t3-fleet", "list", "--recent", recent, "--limit", "10000", "--subagents", "--json"]
    try:
        p = run(cmd, timeout=180)
        if p.returncode:
            sys.exit(f"t3-fleet failed ({last_line(p, 'no output')}); refusing to judge ownership blind")
        data = json.loads(p.stdout or "[]")
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError) as exc:
        sys.exit(f"t3-fleet unusable ({type(exc).__name__}); refusing to judge ownership blind")
    return data if isinstance(data, list) else data.get("threads", [])


TERMINAL_TASK = ("completed", "failed", "cancelled", "interrupted", "rolled_back")


def is_live(t: dict | None) -> bool:
    """Running session, or a delegated task not yet terminal (waiting children still own their repo)."""
    if not t:
        return False
    task = t.get("task_status")
    return t.get("session_status") == "running" or (task is not None and task not in TERMINAL_TASK)


def under(path: str, root: Path) -> bool:
    path = os.path.realpath(path) if path else ""
    return path == str(root) or path.startswith(str(root) + "/")


def is_scheduled(t: dict, prefixes: list[str]) -> bool:
    return (t.get("title") or "").startswith(tuple(prefixes))


# ---------------------------------------------------------------- claims (shared by every run)

@contextmanager
def claims_locked():
    """Exclusive read-modify-write of the claim store; keyed by canonical checkout path."""
    d = state_dir()
    d.mkdir(parents=True, exist_ok=True)
    with open(d / ".claims.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        claims = load_json(d / "claims.json", {})
        yield claims
        save_json(d / "claims.json", claims)


def claim_held(c: dict | None, threads: dict, now: float) -> bool:
    if not c or c.get("released_at"):
        return False
    return now - ts(c["claimed_at"]) < CLAIM_TTL_S or any(is_live(threads.get(c.get(k) or "")) for k in ("owner", "child_thread"))


# ---------------------------------------------------------------- selection

def canonical_root(path: Path) -> Path | None:
    """Shared checkout for a path: worktrees collapse onto their main checkout."""
    if not path.is_dir():
        return None
    common = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common:
        return None
    c = Path(common)
    return c.parent if c.name == ".git" else c


def committed_recently(roots: list[Path], days: int) -> set[Path]:
    found: set[Path] = set()
    for base in roots:
        for repo in sorted(base.glob("*/*")):
            if (repo / ".git").exists() and git(repo, "log", "-1", f"--since={days}.days", "--format=%H"):
                found.add(repo)
    return found


def select(threads: list[dict], args) -> tuple[dict[Path, list[str]], list[str]]:
    if args.repos:
        cands = {Path(p).expanduser().resolve(): {"explicit"} for p in args.repos}
    else:
        cands: dict[Path, set[str]] = {}
        for t in threads:
            if t.get("workspace_root"):
                cands.setdefault(Path(t["workspace_root"]), set()).add("t3")
        for r in committed_recently([Path(r).expanduser() for r in args.root or ["~/code"]], args.days):
            cands.setdefault(r, set()).add("commits")
        for r in args.always:
            cands.setdefault(Path(r).expanduser(), set()).add("always")
    repos: dict[Path, set[str]] = {}
    missing = []
    for path, src in cands.items():
        root = canonical_root(path)
        if root is None:
            missing.append(str(path))
        elif not ({str(root), root.name} & set(args.exclude)):
            repos.setdefault(root, set()).update(src)
    return {r: sorted(s) for r, s in sorted(repos.items())}, sorted(missing)


# ---------------------------------------------------------------- per repo

def newest_mtime(path: Path) -> float | None:
    """Newest mtime under path; None when unknown (walk cap hit / unreadable) so callers protect it."""
    try:
        if path.is_symlink() or not path.is_dir():
            return path.lstat().st_mtime
        newest, seen = path.stat().st_mtime, 0
        for base, dirs, files in os.walk(path):
            dirs[:] = [d for d in dirs if d != ".git"]
            for name in files:
                seen += 1
                if seen > WALK_CAP:
                    return None
                try:
                    newest = max(newest, os.lstat(os.path.join(base, name)).st_mtime)
                except OSError:
                    pass
        return newest
    except OSError:
        return None


def dirty_paths(root: Path, fresh_minutes: int, now: float) -> list[dict]:
    """One row per `git status` entry with its age; deletions take their parent directory's mtime."""
    out = run(["git", "status", "--porcelain=v1", "-z"], cwd=root).stdout
    parts = out.split("\0")
    rows, i = [], 0
    while i < len(parts):
        entry = parts[i]
        i += 1
        if len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        if xy[0] in "RC":
            i += 1  # -z puts the rename source in the next field
        target = root / path
        mtime = newest_mtime(target) if os.path.lexists(target) else newest_mtime(target.parent)
        age = None if mtime is None else round((now - mtime) / 60, 1)
        rows.append({"xy": xy, "path": path, "age_min": age,
                     "fresh": age is None or age < fresh_minutes})
    return rows


def ahead_behind(root: Path, upstream: str) -> tuple[int, int]:
    lr = git(root, "rev-list", "--left-right", "--count", f"{upstream}...HEAD")
    if not lr:
        return 0, 0
    behind, ahead = lr.split()
    return int(ahead), int(behind)


def live_in(root: Path, threads: list[dict], ignore: set[str]) -> list[dict]:
    """Running threads in this checkout, minus the caller and its own children."""
    return [t for t in threads if is_live(t) and under(t.get("workspace_root") or "", root)
            and t.get("thread_id") not in ignore and t.get("parent_id") not in ignore]


def check(root: Path, sources: list[str], threads: list[dict], claims: dict, args, now: float) -> dict:
    info: dict = {"repo": str(root), "name": root.name, "sources": sources,
                  "branch": git(root, "rev-parse", "--abbrev-ref", "HEAD")}
    upstream = git(root, "rev-parse", "--abbrev-ref", "@{u}") or None
    info["upstream"] = upstream
    mine = [t for t in threads if t.get("kind") in INTERACTIVE_KINDS and under(t.get("workspace_root") or "", root)]
    sched = sum(is_scheduled(t, args.scheduled_prefix) for t in mine)
    info["activity"] = {"interactive": len(mine) - sched, "scheduled": sched}
    live = live_in(root, threads, set(args.ignore_thread))
    info["live_threads"] = [f"{t.get('short_id')} {t.get('title')}" for t in live]
    by_id = {t.get("thread_id"): t for t in threads}
    claim = claims.get(str(root))
    held = claim_held(claim, by_id, now) and claim["owner"] not in args.ignore_thread
    if held:
        info["claim"] = {k: claim.get(k) for k in ("owner", "claimed_at", "task_id")}
    if upstream and not args.no_fetch:
        try:
            p = run(["git", "fetch", "--quiet", upstream.split("/", 1)[0]], cwd=root, timeout=FETCH_TIMEOUT)
            if p.returncode:
                info["fetch_error"] = last_line(p, "fetch failed")
        except subprocess.TimeoutExpired:
            info["fetch_error"] = "fetch timeout"
    info["ahead"], info["behind"] = ahead_behind(root, upstream) if upstream else (0, 0)
    dirty = dirty_paths(root, args.fresh_minutes, now)
    info["dirty"] = dirty[:200]
    info["dirty_count"] = len(dirty)
    info["stale_count"] = sum(1 for d in dirty if not d["fresh"])
    info["aux_worktrees"] = max(0, git(root, "worktree", "list", "--porcelain").count("worktree ") - 1)
    if held:
        v = "owned"
    elif info["stale_count"] or info["ahead"] or info.get("fetch_error"):
        v = "worker"
    elif not upstream:
        v = "local"
    elif dirty:
        v = "fresh"
    else:
        v = "ff" if info["behind"] else "clean"
    info["verdict"] = v
    return info


def apply_ff(entry: dict) -> None:
    """Fast-forward a clean, behind checkout nobody is working in; recheck right before touching it."""
    root = Path(entry["repo"])
    if entry["live_threads"]:
        entry["ff_skipped"] = "live thread in checkout"
        return
    if run(["git", "status", "--porcelain"], cwd=root).stdout.strip():
        entry.update(verdict="worker", ff_error="dirtied since survey")
        return
    p = run(["git", "pull", "--ff-only", "--quiet"], cwd=root, timeout=FETCH_TIMEOUT)
    if p.returncode == 0:
        entry.update(ff_applied=True, behind=0, verdict="clean")
    else:  # e.g. an untracked file collides with an incoming path
        entry.update(ff_applied=False, verdict="worker", ff_error=last_line(p, "pull failed"))


def note(r: dict) -> str:
    if r.get("ff_applied"):
        return "fast-forwarded"
    if r.get("ff_error") or r.get("fetch_error") or r.get("ff_skipped"):
        return r.get("ff_error") or r.get("fetch_error") or r["ff_skipped"]
    bits = [f"{d['xy'].strip()} {d['path']}" + (" (fresh)" if d["fresh"] else "") for d in r["dirty"][:3]]
    if r.get("claim"):
        bits.append(f"claimed by {r['claim']['owner']}")
    if r["live_threads"]:
        bits.append("live: " + "; ".join(r["live_threads"])[:120])
    return ", ".join(bits)


def survey_markdown(report: dict) -> str:
    rows = sorted(report["repos"], key=lambda r: (VERDICTS.index(r["verdict"]), -r["activity"]["interactive"], r["repo"]))
    out = [f"# gitsync survey {report['at']}", "",
           " · ".join(f"{v} {n}" for v, n in report["counts"].items() if n), "",
           "| repo | verdict | branch | ahead/behind | dirty (stale) | threads i/s | note |",
           "|---|---|---|---|---|---|---|"]
    for r in rows:
        if r["verdict"] == "clean":
            continue
        a = r["activity"]
        out.append(f"| `{r['repo']}` | **{r['verdict']}** | {r['branch']} | {r['ahead']}/{r['behind']} "
                   f"| {r['dirty_count']} ({r['stale_count']}) | {a['interactive']}/{a['scheduled']} "
                   f"| {note(r).replace('|', '/')} |")
    out += ["", "threads i/s = interactive / scheduled T3 threads in the window."]
    if report["missing"]:
        out += ["", "Missing on disk: " + ", ".join(report["missing"])]
    return "\n".join(out) + "\n"


def cmd_survey(args) -> int:
    threads = fleet(f"{args.days}d")
    repos, missing = select(threads, args)
    now = time.time()
    claims = load_json(state_dir() / "claims.json", {})
    entries = [check(r, src, threads, claims, args, now) for r, src in repos.items()]
    if args.apply_ff:
        for e in entries:
            if e["verdict"] == "ff":
                apply_ff(e)
    report = {"at": now_iso(), "days": args.days, "fresh_minutes": args.fresh_minutes,
              "t3_threads_seen": len(threads), "missing": missing, "repos": entries,
              "counts": {v: sum(e["verdict"] == v for e in entries) for v in VERDICTS}}
    if args.out:
        args.out.mkdir(parents=True, exist_ok=True)
        (args.out / "survey.json").write_text(json.dumps(report, indent=1))
        (args.out / "survey.md").write_text(survey_markdown(report))
    print(survey_markdown(report) if args.markdown else json.dumps(report, indent=1))
    return 0


# ---------------------------------------------------------------- prepare / record

def load_json(path: Path, default):
    return json.loads(path.read_text()) if path.exists() else default


def save_json(path: Path, data) -> None:
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=1))
    tmp.replace(path)


def worker_brief(row: dict, run_dir: Path, fresh_minutes: int, extra: str) -> str:
    protect = [d["path"] for d in row["dirty"] if d["fresh"]]
    lines = [
        f"Read and follow {PLAYBOOK} for the checkout {row['repo']}.",
        "You run as a delegate_task child: your working directory is the parent's checkout, not this repo. "
        f"Use `git -C {row['repo']}` or cd there for every command.",
        f"Survey ({run_dir / 'survey.json'}): branch {row['branch']}, upstream {row['upstream'] or 'none'}, "
        f"ahead {row['ahead']}, behind {row['behind']}, {row['dirty_count']} dirty ({row['stale_count']} stale).",
        f"Fresh threshold for this run: {fresh_minutes} minutes. A path modified more recently is protected.",
    ]
    if protect:
        lines.append("Fresh at survey time, leave untouched unless they age out and pass every check: "
                     + ", ".join(protect[:20]))
    if row["live_threads"]:
        lines.append("Live threads in this checkout at survey time: " + "; ".join(row["live_threads"]))
    if row.get("fetch_error") or row.get("ff_error"):
        lines.append(f"Git error: {row.get('fetch_error') or row.get('ff_error')}")
    if extra:
        lines.append(extra)
    return "\n".join(lines) + "\n"


def still_needs_worker(row: dict, fresh_minutes: int) -> bool:
    root = Path(row["repo"])
    if not root.is_dir():
        return False
    stale = [d for d in dirty_paths(root, fresh_minutes, time.time()) if not d["fresh"]]
    ahead = ahead_behind(root, row["upstream"])[0] if row["upstream"] else 0
    return bool(stale or ahead or row.get("fetch_error") or row.get("ff_error"))


def handoff(repo: str, c: dict) -> dict:
    return {"repo": repo, "title": c["title"], "task": f"Read and execute {c['brief']}",
            "clientRequestId": c["client_request_id"], "taskId": c.get("task_id")}


def cmd_prepare(args) -> int:
    run_dir = args.run_dir.expanduser().resolve()
    survey = load_json(run_dir / "survey.json", None)
    if survey is None:
        sys.exit(f"no survey.json in {run_dir}; run `survey --out {run_dir}` first")
    threads = {t["thread_id"]: t for t in fleet(f"{args.days}d")}
    now, todo, held, skipped = time.time(), [], [], []
    (run_dir / "briefs").mkdir(exist_ok=True)
    with claims_locked() as claims:
        for row in survey["repos"]:
            repo = row["repo"]
            if row["verdict"] not in DISPATCHABLE:
                continue
            c = claims.get(repo)
            if c and c["owner"] == args.owner and not c.get("released_at"):
                todo.append(handoff(repo, c))  # resume: same brief, same request id, maybe a task already
                continue
            if claim_held(c, threads, now):
                held.append({"repo": repo, "owner": c["owner"], "task_id": c.get("task_id")})
                continue
            if not still_needs_worker(row, survey["fresh_minutes"]):
                skipped.append({"repo": repo, "reason": "nothing stale left"})
                continue
            key = hashlib.sha1(repo.encode()).hexdigest()[:8]
            brief = run_dir / "briefs" / f"{Path(repo).name}-{key}.md"
            brief.write_text(worker_brief(row, run_dir, survey["fresh_minutes"], args.extra))
            claims[repo] = {"owner": args.owner, "run_dir": str(run_dir), "claimed_at": now_iso(),
                            "title": f"{TITLE_PREFIX} {Path(repo).name}", "brief": str(brief),
                            # once per claim: a later claim on the same repo must not replay a finished task
                            "client_request_id": f"gitsync:{run_dir.name}:{key}:{args.owner[-8:]}:{int(now)}"}
            todo.append(handoff(repo, claims[repo]))
    print(json.dumps({"delegate": todo, "held_elsewhere": held, "skipped": skipped}, indent=1, ensure_ascii=False))
    return 0


def cmd_record(args) -> int:
    repo = str(Path(args.repo).expanduser().resolve())
    with claims_locked() as claims:
        c = claims.get(repo)
        if not c or c["owner"] != args.owner or c.get("released_at"):
            sys.exit(f"{repo}: no open claim of {args.owner}; run `prepare` first")
        c.update(task_id=args.task_id, child_thread=args.child_thread, delegated_at=now_iso())
    return 0


# ---------------------------------------------------------------- status

def verify(root: Path, fresh_minutes: int, now: float, fetch: bool) -> dict:
    """Strict re-read; any git failure is an error, never a clean result."""
    try:
        if not root.is_dir():
            return {"error": "repo missing"}
        upstream = git(root, "rev-parse", "--abbrev-ref", "@{u}") or None
        if upstream and fetch:
            p = run(["git", "fetch", "--quiet", upstream.split("/", 1)[0]], cwd=root, timeout=FETCH_TIMEOUT)
            if p.returncode:
                return {"error": "fetch: " + last_line(p, "failed")}
        if run(["git", "status", "--porcelain"], cwd=root).returncode:
            return {"error": "git status failed"}
        ahead = behind = 0
        if upstream:
            p = run(["git", "rev-list", "--left-right", "--count", f"{upstream}...HEAD"], cwd=root)
            if p.returncode:
                return {"error": "rev-list failed"}
            behind, ahead = map(int, p.stdout.split())
        return {"upstream": upstream, "ahead": ahead, "behind": behind,
                "dirty": dirty_paths(root, fresh_minutes, now)}
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        return {"error": f"{type(exc).__name__}: {exc}"}


def outcome_of(c: dict, child: dict | None, g: dict, live: list[dict]) -> tuple[str, str]:
    """(outcome, reason). `landed` needs an upstream, nothing ahead and no stale dirt; whatever
    remains is `protected` only with a named reason (fresh paths, live thread), else `blocked`."""
    if g.get("error"):
        return "unverified", g["error"]
    if not c.get("task_id"):
        return "pending", "claimed, not delegated yet"
    if is_live(child):
        return "running", ""
    if child is None:
        return "unknown-child", "child thread not in the fleet window"
    stale = [d["path"] for d in g["dirty"] if not d["fresh"]]
    fresh = [d["path"] for d in g["dirty"] if d["fresh"]]
    if not g["upstream"]:
        return "local", "no upstream: committed locally at best"
    if g["ahead"]:
        return "blocked", f"{g['ahead']} commit(s) not pushed"
    owners = "; ".join(f"{t.get('short_id')} {t.get('title')}" for t in live)[:160]
    if stale:
        return ("protected", f"live: {owners}; stale: {', '.join(stale[:4])}") if live else \
               ("blocked", "stale: " + ", ".join(stale[:4]))
    if fresh or (g["behind"] and live):
        return "protected", "; ".join(filter(None, [("fresh: " + ", ".join(fresh[:4])) if fresh else "",
                                                     f"live: {owners}" if live else ""]))
    if g["behind"]:
        return "blocked", f"checkout {g['behind']} behind, nobody in it"
    return "landed", ""


def cmd_status(args) -> int:
    run_dir = args.run_dir.expanduser().resolve()
    survey = load_json(run_dir / "survey.json", {"fresh_minutes": 60})
    fleet_rows = fleet(f"{args.days}d")
    threads = {t["thread_id"]: t for t in fleet_rows}
    rows, now = [], time.time()
    with claims_locked() as claims:
        for repo, c in claims.items():
            if c.get("run_dir") != str(run_dir):
                continue
            g = verify(Path(repo), survey["fresh_minutes"], now, not args.no_fetch)
            child = threads.get(c.get("child_thread") or "")
            live = live_in(Path(repo), fleet_rows, {c["owner"]} | set(args.ignore_thread))
            outcome, reason = outcome_of(c, child, g, live)
            if outcome in ("landed", "protected", "blocked", "local"):
                c.update(released_at=c.get("released_at") or now_iso(), outcome=outcome)
            rows.append({"repo": repo, "outcome": outcome, "reason": reason, "task_id": c.get("task_id"),
                         "child_thread": c.get("child_thread"), "last_text": (child or {}).get("last_text", "")[:200]})
    order = ["blocked", "unverified", "unknown-child", "running", "pending", "local", "protected", "landed"]
    rows.sort(key=lambda r: (order.index(r["outcome"]), r["repo"]))
    counts = {o: sum(r["outcome"] == o for r in rows) for o in order}
    report = {"at": now_iso(), "counts": counts, "survey_counts": survey.get("counts"), "repos": rows}
    md = [f"# gitsync status {report['at']}", "",
          " · ".join(f"{o} {n}" for o, n in counts.items() if n) or "no claimed repos", ""]
    md += [f"- **{r['outcome']}** `{r['repo']}` {r['reason']}".rstrip() for r in rows]
    save_json(run_dir / "status.json", report)
    (run_dir / "status.md").write_text("\n".join(md) + "\n")
    print("\n".join(md) if args.markdown else json.dumps(report, indent=1))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("survey", help="pick active repos and give each a verdict")
    s.add_argument("repos", nargs="*", help="explicit repo paths (skips auto-selection)")
    s.add_argument("--root", action="append", default=[], help="scan <root>/*/* for recent commits (repeatable; default ~/code)")
    s.add_argument("--always", action="append", default=[], help="always include this repo (repeatable)")
    s.add_argument("--exclude", action="append", default=[], help="repo name or path to leave out")
    s.add_argument("--ignore-thread", action="append", default=[], help="the caller's thread id: neither live nor an owner")
    s.add_argument("--scheduled-prefix", action="append", default=None,
                   help="title prefix of scheduled-job threads, counted apart from interactive ones (default ⏰)")
    s.add_argument("--days", type=int, default=14)
    s.add_argument("--fresh-minutes", type=int, default=60)
    s.add_argument("--no-fetch", action="store_true")
    s.add_argument("--apply-ff", action="store_true", help="fast-forward `ff` repos without a live thread (only mutation)")
    s.add_argument("--out", type=Path, help="run dir: writes survey.json + survey.md")
    s.add_argument("--markdown", action="store_true")
    s.set_defaults(fn=cmd_survey)

    p = sub.add_parser("prepare", help="claim `worker` repos for --owner and write their briefs (JSON for delegate_task)")
    p.add_argument("run_dir", type=Path)
    p.add_argument("--owner", required=True, help="the orchestrating thread's id (t3_thread_list currentThreadId)")
    p.add_argument("--extra", default="", help="extra line appended to every brief")
    p.add_argument("--days", type=int, default=3, help="fleet window for claim liveness")
    p.set_defaults(fn=cmd_prepare)

    r = sub.add_parser("record", help="store the delegate_task ids on a claim")
    r.add_argument("repo")
    r.add_argument("--owner", required=True)
    r.add_argument("--task-id", required=True)
    r.add_argument("--child-thread", required=True)
    r.set_defaults(fn=cmd_record)

    st = sub.add_parser("status", help="outcome per claimed repo; writes status.json + status.md")
    st.add_argument("run_dir", type=Path)
    st.add_argument("--days", type=int, default=3)
    st.add_argument("--ignore-thread", action="append", default=[])
    st.add_argument("--no-fetch", action="store_true")
    st.add_argument("--markdown", action="store_true")
    st.set_defaults(fn=cmd_status)

    args = ap.parse_args()
    if getattr(args, "scheduled_prefix", ...) is None:
        args.scheduled_prefix = ["⏰"]
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
