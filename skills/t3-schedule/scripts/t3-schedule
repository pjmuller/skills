#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Recurring or one-shot T3 Code threads on a wall-clock schedule, via macOS launchd or Linux/WSL systemd user timers.

Each job = one LaunchAgent / systemd timer `com.t3-skills.t3-schedule.<name>` whose runner waits for
T3 Code, then `t3-schedule fire <name>`: `t3-relay launch` (new thread) or `t3-relay send`
(continuation, `--resume-thread`). T3 is only reached through t3-relay / t3-pick-instance /
t3-list-profiles; its store is read only to validate `--resume-thread`.

Recurring jobs are versioned in their project repo (`<project>/.agents/schedules/<name>.{json,prompt.md}`,
incl. `machines` + `adopted_by` registration); the runtime dir holds a machine-local pointer (`source`,
`profile`), generated artefacts and state. One-shots and continuations stay machine-local.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import plistlib
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import time
import uuid
from datetime import date, datetime, timedelta
from pathlib import Path

LABEL_PREFIX = "com.t3-skills.t3-schedule"
CATCH_UP = "catch-up"                 # job name reserved for the poller
CATCH_UP_INTERVAL = 900               # seconds between catch-up ticks
CATCH_UP_GRACE_HOURS = 10             # a missed/failed slot is retried until slot+10h (same day)
ONCE_DEADLINE = (23, 0)               # once-jobs have no tomorrow: retried until 23:00 that day
DEFAULT_WAIT_MAX = 10                 # minutes the runner waits for T3 Code; catch-up retries later
SCHEDULE_PATH = "$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
RUNTIME_JSON = ".t3/userdata/server-runtime.json"
LAST_ORIGIN = ".t3/userdata/last-server-origin"
HEALTH_PATH = "/.well-known/t3/environment"
DAYS = {"sun": 0, "mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6}
DAY_NAMES = {v: k for k, v in DAYS.items()}
WEEKDAYS = [1, 2, 3, 4, 5]
SCHEDULES_DIR = ".agents/schedules"    # versioned job definitions inside the project repo
# Portable job fields committed to the repo (→ default when unset); name = file stem, project = the
# repo. Profile (an account label) and everything else stay in the machine-local pointer.
REPO_KEYS = {"at": None, "days": None, "title": None, "model": None, "thinking": None,
             "allow_small_model": False, "settle_when_done": False, "notify": True, "wait_max": DEFAULT_WAIT_MAX,
             "machines": "one", "adopted_by": None, "paused": False, "pause_until": None,
             "pre_command": None}  # [] = nobody (skips)
# Armed before allow_small_model existed; refusing them would stop the updater that brings the fix.
LEGACY_SMALL_JOBS = {"skills-refresh"}
MACHINES = ("one", "many")             # one = a single primary machine (takeover needs confirmation)
OWNER_SKIP_EXIT = 5                    # `t3-schedule owner-check` → runner: another machine owns this job, skip
PAUSED_SKIP_EXIT = 6                   # `t3-schedule pause-check` → runner: repo job is paused, skip
PENDING_EXIT = 3                       # fire → runner: relay accepted, launch not yet confirmed (= t3-relay --wait)
CONFIRM_WAIT = 120                     # seconds fire waits for t3-relay to confirm the thread/message exists
PENDING_ALERT = 30 * 60                # unconfirmed this long → notify once; never re-fired (could duplicate)


# --- paths --------------------------------------------------------------------
def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def label_for(name: str) -> str:
    return f"{LABEL_PREFIX}.{name}"


def systemd() -> bool:
    return sys.platform.startswith("linux")


def os_notify(msg: str) -> None:
    """macOS notification; under WSL a Windows tray balloon (no module needed); else nothing (the log stays)."""
    if not systemd():
        subprocess.run(["osascript", "-e", f'display notification "{msg}" with title "t3-schedule"'], capture_output=True)
    elif ps := shutil.which("powershell.exe") or next(  # runners get SCHEDULE_PATH, without Windows dirs
            (p for p in ("/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",) if os.access(p, os.X_OK)), None):
        text = msg.replace("'", "''")
        script = ("Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; "
                  "$n.Icon = [System.Drawing.SystemIcons]::Warning; $n.Visible = $true; "
                  f"$n.ShowBalloonTip(15000, 't3-schedule', '{text}', 'Warning'); Start-Sleep 15; $n.Dispose()")
        subprocess.Popen([ps, "-NoProfile", "-WindowStyle", "Hidden", "-Command", script], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def paths(name: str) -> dict[str, Path]:
    base = home() / ".t3/userdata/scheduled/t3-schedule"
    return {
        "plist": (home() / ".config/systemd/user" / f"{label_for(name)}.timer" if systemd()
                  else home() / "Library/LaunchAgents" / f"{label_for(name)}.plist"),
        "service": home() / ".config/systemd/user" / f"{label_for(name)}.service",
        "spec": base / f"{name}.json",
        "prompt": base / f"{name}.prompt.md",
        "sh": base / f"{name}.sh",
        "last": base / f"{name}.last",
        "failed": base / f"{name}.failed",
        "pending": base / f"{name}.pending",  # "<day> <relay rid> <epoch>": accepted, not yet confirmed
        "fire_lock": base / f"{name}.fire.lock",  # one `fire` at a time (launchd run + run-now --foreground)
        "log": home() / ".t3/userdata/logs" / f"t3-schedule.{name}.log",
    }


def runtime_dir() -> Path:
    return home() / ".t3/userdata/scheduled/t3-schedule"


def identity_path() -> Path:
    # Subdirectory: `specs()` globs the runtime dir's *.json as jobs (and a job may be named `machine`).
    return runtime_dir() / "meta" / "machine.json"


def repo_files(project: Path, name: str) -> tuple[Path, Path]:
    return project / SCHEDULES_DIR / f"{name}.json", project / SCHEDULES_DIR / f"{name}.prompt.md"


def repo_spec_problem(repo: object, prompt: Path) -> str | None:
    """Why a pulled definition cannot run, or None. Checked on every load: a colleague's hand edit
    must never crash `list`/catch-up for the other jobs, nor keep a doomed job 'due'."""
    if not isinstance(repo, dict):
        return "invalid (not a JSON object)"
    at, days = repo.get("at"), repo.get("days")
    try:
        if not isinstance(at, str):
            raise SystemExit(f"at must be \"HH:MM\", got {at!r}")
        parse_at(at)
        if days is not None and not (isinstance(days, list) and days and all(
                type(d) is int and 0 <= d <= 6 for d in days) and len(set(days)) == len(days)):
            raise SystemExit(f"days must be null or a list of launchd weekdays 0-6 (0=Sun), got {days!r}")
        if repo.get("model") is not None:
            if not isinstance(repo["model"], str):
                raise SystemExit(f"model must be a string, got {repo['model']!r}")
            valid_models(repo["model"])
            if problem := small_model_problem(repo["model"], repo.get("allow_small_model") is True):
                raise SystemExit(problem)
        for key in ("title", "thinking"):
            if repo.get(key) is not None and not isinstance(repo[key], str):
                raise SystemExit(f"{key} must be a string, got {repo[key]!r}")
        for key in ("settle_when_done", "notify", "allow_small_model"):
            if repo.get(key) is not None and not isinstance(repo[key], bool):
                raise SystemExit(f"{key} must be true/false, got {repo[key]!r}")
        if repo.get("paused") is not None and not isinstance(repo["paused"], bool):
            raise SystemExit(f"paused must be true/false, got {repo['paused']!r}")
        until = repo.get("pause_until")
        if until is not None:
            if not isinstance(until, str) or date.fromisoformat(until).isoformat() != until:
                raise SystemExit(f"pause_until must be YYYY-MM-DD, got {until!r}")
            if not repo.get("paused"):
                raise SystemExit("pause_until requires paused=true")
        wait = repo.get("wait_max")
        if wait is not None and not (type(wait) is int and wait > 0):
            raise SystemExit(f"wait_max must be a positive integer, got {wait!r}")
        if repo.get("machines") is not None and repo["machines"] not in MACHINES:
            raise SystemExit(f"machines must be one of {'/'.join(MACHINES)}, got {repo['machines']!r}")
        owners = repo.get("adopted_by")
        if owners is not None:
            if not isinstance(owners, list) or not all(
                    isinstance(o, dict) and all(isinstance(o.get(k), str) and o[k] for k in ("id", "machine", "since"))
                    and (o.get("user") is None or isinstance(o["user"], str)) for o in owners):
                raise SystemExit("adopted_by must be a list of {machine, user, since, id}")
            if len({o["id"] for o in owners}) != len(owners):
                raise SystemExit("adopted_by lists a machine id twice")
            if (repo.get("machines") or "one") == "one" and len(owners) > 1:
                raise SystemExit(f"machines=one but {len(owners)} adopters (keep one, or set machines: many)")
    except (SystemExit, ValueError) as exc:
        return f"invalid ({str(exc)[:120]})"
    try:
        if not prompt.read_text().strip():
            return f"prompt empty ({prompt.name})"
    except OSError as exc:
        return f"prompt {'not found' if isinstance(exc, FileNotFoundError) else 'unreadable'} ({prompt.name})"
    return None


def merge_pointer(local: dict) -> dict:
    """Pointer + its repo spec; project = the repo holding it. An absent, malformed or prompt-less repo
    spec (repo moved, conflict markers after a pull, bad hand edit) sets `missing`: that job is skipped,
    the others run."""
    source = Path(local["source"])
    project = source.parents[2]
    merged = {**local, "project": str(project), "prompt_path": str(repo_files(project, local["name"])[1])}
    try:
        repo = json.loads(source.read_text())
    except (OSError, ValueError) as exc:
        return {**merged, "missing": "not found" if isinstance(exc, FileNotFoundError) else f"invalid ({exc!r:.80})"}
    if local["name"] in LEGACY_SMALL_JOBS and isinstance(repo, dict) and repo.get("allow_small_model") is None:
        repo["allow_small_model"] = True
    if problem := repo_spec_problem(repo, Path(merged["prompt_path"])):
        return {**merged, "missing": problem}
    spec = {**repo, **{k: d for k, d in REPO_KEYS.items() if repo.get(k) is None}, **merged}
    return {**spec, "displaced": owner_problem(spec, machine_identity())}


def load_spec(local: Path) -> dict:
    """An unreadable local spec marks only that job `missing`: catch-up and list keep serving the others."""
    try:
        spec = json.loads(local.read_text())
        if not isinstance(spec, dict) or not isinstance(spec.get("name"), str):
            raise ValueError("not a job object")
    except (OSError, ValueError) as exc:
        return {"name": local.stem, "missing": f"local spec unreadable ({exc!r:.80})"}
    return merge_pointer(spec) if spec.get("source") else spec


def write_atomic(path: Path, text: str) -> None:
    """tmp + rename: a crash mid-write never leaves a truncated spec or marker behind."""
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text)
    tmp.replace(path)


def prompt_path(spec: dict) -> Path:
    return Path(spec.get("prompt_path") or paths(spec["name"])["prompt"])


def versionable(spec: dict) -> bool:
    """Recurring launches are versioned; one-shots and continuations are ephemeral."""
    return not spec.get("once") and not spec.get("resume_thread")


def pause_label(spec: dict, today: date | None = None) -> str | None:
    """A deadline resumes the job at local midnight on that date, without rewriting the spec."""
    if not spec.get("paused"):
        return None
    until = spec.get("pause_until")
    if until and (today or date.today()) >= date.fromisoformat(until):
        return None
    return f"paused until {until}" if until else "paused"


def write_repo_job(project: Path, name: str, spec: dict, prompt: str) -> Path:
    src, prompt_file = repo_files(project, name)
    src.parent.mkdir(parents=True, exist_ok=True)
    fields = {k: default if spec.get(k) is None else spec[k] for k, default in REPO_KEYS.items()
              if k != "pre_command" or spec.get(k)}  # optional: absent in jobs that never set it
    src.write_text(json.dumps(fields, indent=2, ensure_ascii=False) + "\n")
    prompt_file.write_text(prompt)
    return src


def pointer(name: str, source: Path, profile: str | None) -> dict:
    return {"name": name, "source": str(source), "profile": profile}


# --- machine registration (`machines`, `adopted_by` in the repo spec) ----------------
def machine_identity() -> dict | None:
    """This machine's registration identity, read-only (list/refresh/runner never create one).
    A random id, never hardware/host/user data: the record may land in a public repo."""
    try:
        me = json.loads(identity_path().read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(me, dict) and all(isinstance(me.get(k), str) and me[k] for k in ("id", "label"))
    return me if ok else None


def ensure_identity() -> dict:
    """Identity for an explicit add/adopt: created when absent (saved by `save_identity` once
    the caller mutates), never silently replaced when unreadable (that would displace this machine everywhere)."""
    if me := machine_identity():
        return me
    if identity_path().exists():
        raise SystemExit(f"{identity_path()} is unreadable; fix it (keys id, label) or delete it, then adopt --takeover")
    uid = str(uuid.uuid4())
    return {"id": uid, "label": f"machine-{uid[:8]}"}


def save_identity(me: dict) -> None:
    if machine_identity() == me:
        return
    identity_path().parent.mkdir(parents=True, exist_ok=True)
    identity_path().write_text(json.dumps(me, indent=2) + "\n")


def git_user(project: Path) -> str | None:
    """Attribution as the repo's commits already carry it; never the OS user or an email."""
    out = subprocess.run(["git", "-C", str(project), "config", "user.name"], capture_output=True, text=True)
    return out.stdout.strip() or None


def describe_owner(owner: dict, me: dict | None = None) -> str:
    this = " = this machine" if me and owner["id"] == me["id"] else ""
    return f"{owner['machine']} ({owner.get('user') or 'unknown user'}, since {owner['since']}{this})"


def describe_registration(spec: dict) -> str:
    me, owners = machine_identity(), spec.get("adopted_by")
    listed = ("; ".join(describe_owner(o, me) for o in owners) or "nobody (removed; adopt to run it)") if owners is not None \
        else "not recorded yet (re-run adopt to record this machine)"
    return f"{spec.get('machines') or 'one'} machine{'s' if spec.get('machines') == 'many' else ''}: {listed}"


def owner_problem(spec: dict, me: dict | None) -> str | None:
    """Why this machine must skip a one-machine job another machine is registered for, or None.
    Pre-registration specs (no `adopted_by` key) and many-machine jobs always run. An empty list means
    its last machine removed it: a machine displaced earlier must not resume firing on that pull."""
    owners = spec.get("adopted_by")
    if (spec.get("machines") or "one") == "many" or owners is None:
        return None
    takeover = f"t3-schedule remove {spec['name']}, or adopt {spec['source']} --takeover"
    if not owners:
        return f"no machine registered (its last one removed it): t3-schedule adopt {spec['source']}, or remove {spec['name']}"
    if me is None:
        return f"machine identity missing ({identity_path()}); job registered to {describe_owner(owners[0])}: {takeover}"
    if owners[0]["id"] == me["id"]:
        return None
    return f"displaced: registered to {describe_owner(owners[0])}: {takeover}"


def registration(owners: list, machines: str, me: dict, user: str | None) -> tuple[list, list]:
    """(new adopted_by, machines this takes the job away from). Re-adopting keeps `since`."""
    owners = owners or []
    mine = next((o for o in owners if o.get("id") == me["id"]), None)
    entry = {"machine": me["label"], "user": user, "since": (mine or {}).get("since") or date.today().isoformat(),
             "id": me["id"]}
    if machines == "many":
        return [entry if o is mine else o for o in owners] + ([] if mine else [entry]), []
    return [entry], [o for o in owners if o is not mine]


def confirm_takeover(name: str, others: list, takeover: bool) -> None:
    """A one-machine job registered elsewhere: explicit --takeover, or a y at a terminal. `--force` never implies it."""
    if not others or takeover:
        return
    who = "; ".join(map(describe_owner, others))
    if not sys.stdin.isatty():
        raise SystemExit(f"{name}: one-machine job registered to {who}. Make sure it no longer runs there, then "
                         "rerun with --takeover (this machine becomes its only machine)")
    answer = input(f"{name}: one-machine job registered to {who}.\n"
                   "Confirm it no longer runs there and this machine becomes its primary? [y/N] ")
    if answer.strip().lower() not in ("y", "yes"):
        raise SystemExit(f"{name}: not taken over")


def write_registration(src: Path, machines: str, owners: list) -> bool:
    """Rewrite only the registration fields of a repo spec; False when nothing changed (no dirty diff)."""
    stored = json.loads(src.read_text())
    if stored.get("machines") == machines and stored.get("adopted_by") == owners:
        return False
    stored.update(machines=machines, adopted_by=owners)
    src.write_text(json.dumps(stored, indent=2, ensure_ascii=False) + "\n")
    return True


def existing_owners(src: Path) -> list:
    """Registration of a repo spec about to be overwritten (add --force); unreadable → none."""
    try:
        owners = json.loads(src.read_text()).get("adopted_by")
    except (OSError, ValueError, AttributeError):
        return []
    return owners if isinstance(owners, list) else []


def registry_note(src: Path, machines: str, owners: list) -> str:
    me = machine_identity()
    return (f"registry {src.name}: machines={machines} · " + ("; ".join(describe_owner(o, me) for o in owners) or "none")
            + " (commit + push it; other machines see it after they pull)")


def git_state(spec: dict) -> str | None:
    """None = committed and clean; else why the repo spec is not (yet) versioned."""
    if spec.get("missing"):
        return f"MISSING {spec['source']}: {spec['missing']}"
    files = [spec["source"], spec["prompt_path"]]
    repo = spec["project"]
    git = lambda *a: subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True)
    if git("rev-parse", "--git-dir").returncode:
        return "not in git"
    if git("ls-files", "--error-unmatch", "--", *files).returncode:
        return f"untracked (commit {SCHEDULES_DIR}/{spec['name']}.*)"
    if git("status", "--porcelain", "--", *files).stdout.strip():
        return f"uncommitted (commit {SCHEDULES_DIR}/{spec['name']}.*)"
    return None


def artefacts(spec: dict) -> tuple[str, bytes]:
    p = paths(spec["name"])
    hour, minute = parse_at(spec["at"])
    body = timer_body(spec) if systemd() else plist_body(spec["name"], hour, minute, spec["days"], p["sh"], spec.get("once"))
    return runner_script(spec, p), body


def job_flag(spec: dict) -> str | None:
    """What `list` warns about: unversioned/dirty repo spec, stale runner."""
    if spec.get("retired"):
        return None
    state = git_state(spec) if spec.get("source") else None
    if spec.get("missing"):
        return state if spec.get("source") else spec["missing"]
    p = paths(spec["name"])
    try:
        sh, plist = artefacts({"wait_max": DEFAULT_WAIT_MAX, **spec})
        stale = not p["sh"].exists() or p["sh"].read_text() != sh or p["plist"].read_bytes() != plist
        if systemd():
            stale = stale or p["service"].read_text() != service_body(spec["name"])
    except (OSError, KeyError, SystemExit):
        stale = True
    flags = [f for f in (spec.get("displaced"), state, "stale runner (t3-schedule refresh)" if stale else None) if f]
    return " · ".join(flags) or None


# --- parsing ------------------------------------------------------------------
def parse_at(value: str) -> tuple[int, int]:
    try:
        hour, minute = (int(part) for part in value.split(":", 1))
        if not (0 <= hour < 24 and 0 <= minute < 60):
            raise ValueError
    except ValueError:
        raise SystemExit(f"--at expects HH:MM, got {value!r}")
    return hour, minute


def parse_days(args: argparse.Namespace) -> list[int] | None:
    """None = every day. Otherwise sorted launchd Weekday numbers (0=Sun)."""
    if args.weekdays:
        return WEEKDAYS
    if not args.days:
        return None
    days: set[int] = set()
    for token in args.days.lower().split(","):
        token = token.strip()[:3]
        if token not in DAYS:
            raise SystemExit(f"--days: unknown day {token!r} (use mon,tue,...)")
        days.add(DAYS[token])
    return sorted(days)


def parse_once(value: str, hour: int, minute: int, now: datetime) -> str:
    try:
        day = date.fromisoformat(value)
    except ValueError:
        raise SystemExit(f"--once expects YYYY-MM-DD, got {value!r}")
    if datetime(day.year, day.month, day.day, hour, minute) <= now:
        raise SystemExit(f"--once {day} {hour:02d}:{minute:02d} is in the past")
    return day.isoformat()


def describe_days(days: list[int] | None) -> str:
    if days is None:
        return "daily"
    if days == WEEKDAYS:
        return "weekdays"
    return ",".join(DAY_NAMES[d] for d in days)


def describe_when(spec: dict) -> str:
    once = spec.get("once")
    if not once:
        return describe_days(spec["days"])
    return f"once {once} ({DAY_NAMES[(date.fromisoformat(once).weekday() + 1) % 7]})"


def valid_models(value: str | None) -> str | None:
    """Ordered comma list; `fire` launches the first candidate t3-pick-instance can route."""
    if value is None:
        return None
    tokens = value.split(",")
    if not all(t and all(c.isalnum() or c in "._-" for c in t) for t in tokens):
        raise SystemExit(f"--model expects a comma list of [A-Za-z0-9._-]+ (e.g. opus,sol), got {value!r}")
    return value


def small_model_problem(models: str | None, allowed: bool) -> str | None:
    """t3-relay refuses a standalone thread on a small model; fail at `add` instead of at fire time."""
    small = [m for m in (models or "").split(",") if any(s in m for s in ("haiku", "luna"))]
    if small and not allowed:
        return (f"--model {','.join(small)}: standalone threads run on a frontier model (opus/astra) that uses "
                "small models as sub-agents; pass --allow-small-model if orchestration is already done")
    return None


def describe_models(spec: dict) -> str:
    return spec.get("model") or ("thread's own" if spec.get("resume_thread") else "opus,astra (default)")


def valid_name(name: str) -> str:
    if not name or not all(c.isalnum() or c in "-_" for c in name):
        raise SystemExit("--name must be [A-Za-z0-9_-]+ (it becomes part of the launchd label)")
    if name == CATCH_UP:
        raise SystemExit(f"{CATCH_UP!r} is reserved for the catch-up poller")
    return name


# --- artefacts -----------------------------------------------------------------
def plist_body(name: str, hour: int, minute: int, days: list[int] | None, sh: Path, once: str | None = None) -> bytes:
    if once:
        day = date.fromisoformat(once)
        interval: object = {"Month": day.month, "Day": day.day, "Hour": hour, "Minute": minute}
    elif days is None:
        interval = {"Hour": hour, "Minute": minute}
    else:
        interval = [{"Hour": hour, "Minute": minute, "Weekday": d} for d in days]
    return plistlib.dumps(
        {
            "Label": label_for(name),
            "ProgramArguments": ["/bin/zsh", "-lc", str(sh)],
            "StartCalendarInterval": interval,
            "RunAtLoad": False,
            "ProcessType": "Interactive",  # Standard still gets a utility clamp: t3 CLI 15-25s per call vs <1s (A/B 2026-09-09)
        }
    )


def runner_script(spec: dict, p: dict[str, Path]) -> str:
    name = spec["name"]
    qname = shlex.quote(name)
    last = shlex.quote(str(p["last"]))
    if spec.get("once"):
        guard = f"""  today=$(date +%F)
  # launchd has no Year: the plist re-fires yearly until the catch-up poller retires it.
  if [[ -s {last} ]]; then
    echo "-- already fired once ($(cat {last})), skipping"
    exit 0
  fi
  if [[ "$today" != "{spec["once"]}" && "$T3_SCHEDULE_FORCE" != 1 ]]; then
    echo "-- once-job for {spec["once"]}, not today, skipping"
    exit 0
  fi"""
    else:
        guard = f"""  # At most one fire per calendar day: launchd replays a missed StartCalendarInterval once at
  # wake, and a wake just before the slot would otherwise fire twice within minutes.
  today=$(date +%F)
  if [[ "$(cat {last} 2>/dev/null)" == "$today" ]]; then
    echo "-- already fired today ($today), skipping"
    exit 0
  fi"""
    if spec.get("source"):
        checks = f"""  # Read the repo spec each time: pause/resume needs no runner refresh. Registration (repo spec
  # `adopted_by`): a one-machine job registered to another machine skips. Checked before the T3
  # wait and again right before the fire (a pull may land in between).
  pause_check() {{
    reason=$(t3-schedule pause-check {qname} 2>&1)
    rc=$?
    (( rc == 0 )) && return 0
    (( rc == {PAUSED_SKIP_EXIT} )) || fail "{name}: pause-check FAILED (exit $rc) - see log"
    echo "-- {name}: skipping, $reason"
    exit 0
  }}
  owner_check() {{
    reason=$(t3-schedule owner-check {qname} 2>&1)
    rc=$?
    (( rc == 0 )) && return 0
    (( rc == {OWNER_SKIP_EXIT} )) || fail "{name}: owner-check FAILED (exit $rc) - see log"
    echo "-- {name}: skipping, $reason"
    osascript -e "display notification \\"{name} skipped: registered to another machine (t3-schedule list)\\" with title \\"t3-schedule\\"" || true
    exit 0
  }}
  pause_check
  owner_check
"""
        checks_again = "  pause_check\n  owner_check\n"
    else:
        checks = checks_again = ""
    linux_preamble = f"""# Linux: notifications go to Windows under WSL (t3-schedule notify), else only the log.
if [[ "$(uname -s)" == Linux ]]; then
  osascript() {{ local m="${{2#display notification \\"}}"; t3-schedule notify "${{m%%\\" with title*}}"; }}
  exec 9> {shlex.quote(str(p["sh"].with_suffix(".lock")))}
  flock -n 9 || exit 0
fi
# Persistent timers must respect the same bounded catch-up window as the poller.
if [[ "$T3_SCHEDULE_AUTOMATIC" == 1 && "$T3_SCHEDULE_FORCE" != 1 ]]; then
  t3-schedule due-check {qname} || exit 0
fi
""" if systemd() else ""
    pre = f"""  # --pre-command runs without T3: the skills updater must still land when T3 or t3-relay is broken.
  echo "-- pre-command:" {shlex.quote(spec['pre_command'])}
  ( {spec['pre_command']} ) 2>&1 | sed 's/^/   /'
  pre_rc=${{pipestatus[1]}}
  (( pre_rc == 0 )) || alert "{name}: pre-command FAILED (exit $pre_rc) - see log"
""" if spec.get("pre_command") else ""
    return f"""#!/bin/zsh
# {'one-shot' if spec.get('once') else 'recurring'} T3 job armed by `t3-schedule add {qname}`; edit via t3-schedule, not here
export PATH="{SCHEDULE_PATH}"
{linux_preamble}mkdir -p {shlex.quote(str(p["log"].parent))}
{{
  echo "=== $(date '+%Y-%m-%d %H:%M:%S %Z')  {label_for(name)}"
{guard}
  # T3 Code must be up to accept the relay request; the Mac may have just woken (launchd runs
  # missed StartCalendarInterval jobs at the next wake), so wait for it.
  t3_up() {{
    origin=$(jq -r ' .origin // empty' "$HOME/{RUNTIME_JSON}" 2>/dev/null)
    [[ -n "$origin" ]] || origin=$(cat "$HOME/{LAST_ORIGIN}" 2>/dev/null)  # file vanished, server alive
    [[ -n "$origin" ]] && curl -sf --max-time 5 "$origin{HEALTH_PATH}" >/dev/null
  }}
  # Failures notify once per day: the catch-up poller retries every {CATCH_UP_INTERVAL // 60} min until
  # slot+{CATCH_UP_GRACE_HOURS}h, so a flapping T3 must not spam the notification center.
  alert() {{
    echo "-- $1"
    if [[ "$(cat {shlex.quote(str(p["failed"]))} 2>/dev/null)" != "$today" ]]; then
      echo "$today" > {shlex.quote(str(p["failed"]))}
      osascript -e "display notification \\"$1 (catch-up retries until {'23:00' if spec.get('once') else f'slot+{CATCH_UP_GRACE_HOURS}h'})\\" with title \\"t3-schedule\\"" || true
    fi
  }}
  fail() {{ alert "$1"; exit 1; }}
  notify() {{
    echo "-- $1"
    {'' if spec.get("notify", True) else '# --no-notify: the thread itself decides whether the user must look\n    : '}osascript -e "display notification \\"$1\\" with title \\"t3-schedule\\"" || true
  }}
{checks}{pre}  waited=0
  until t3_up; do
    if (( waited >= {spec["wait_max"]} )); then
      fail "{name}: T3 Code unreachable for ${{waited}}m, NOT fired"
    fi
    echo "-- waiting for T3 Code (${{waited}}m)"
    sleep 60
    waited=$((waited+1))
  done
{checks_again}  out=$(t3-schedule fire {qname} 2>&1)
  rc=$?
  echo "$out" | sed 's/^/   /'
  if (( rc == {PENDING_EXIT} )); then
    echo "-- {name}: relay accepted, not yet confirmed; catch-up re-checks"
    exit 0
  fi
  (( rc == 0 )) || fail "{name}: fire FAILED (exit $rc) - see log"
  echo "$today" > {last}.tmp && mv -f {last}.tmp {last}
  rm -f {shlex.quote(str(p["failed"]))}
  notify "{name}: $(echo "$out" | tail -1)"
}} >> {shlex.quote(str(p["log"]))} 2>&1
"""


# --- service managers ---------------------------------------------------------
def launchctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


def systemctl(*args: str) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)
    except FileNotFoundError:
        raise SystemExit("systemctl missing: Linux/WSL scheduling requires systemd with a running user manager") from None


def checked_systemctl(*args: str) -> None:
    result = systemctl(*args)
    if result.returncode:
        raise SystemExit(f"systemctl --user {' '.join(args)} failed: {result.stderr.strip()}")


def domain() -> str:
    return f"gui/{os.getuid()}"


def loaded(name: str) -> bool:
    if systemd():
        return systemctl("is-active", "--quiet", f"{label_for(name)}.timer").returncode == 0
    return launchctl("print", f"{domain()}/{label_for(name)}").returncode == 0


def running(name: str) -> bool:
    if systemd():
        # oneshot services are 'activating' throughout ExecStart, not 'active'.
        state = systemctl("show", "--property=ActiveState", "--value", f"{label_for(name)}.service").stdout.strip()
        if state in ("activating", "active", "deactivating", "reloading"):
            return True
        manual = systemctl("show", "--property=ActiveState", "--value", f"{label_for(name)}.manual.service").stdout.strip()
        return manual in ("activating", "active", "deactivating", "reloading")
    out = launchctl("print", f"{domain()}/{label_for(name)}").stdout
    return any(line.strip().startswith("pid = ") for line in out.splitlines())


def bootout(name: str) -> None:
    if systemd():
        if paths(name)["plist"].exists():
            checked_systemctl("disable", "--now", f"{label_for(name)}.timer")
        elif systemctl("show", "--property=LoadState", "--value", f"{label_for(name)}.timer").stdout.strip() == "loaded":
            checked_systemctl("stop", f"{label_for(name)}.timer")
        # Missing service is possible after an interrupted install. Existing services must stop.
        if paths(name)["service"].exists():
            checked_systemctl("stop", f"{label_for(name)}.service")
        if systemctl("show", "--property=LoadState", "--value", f"{label_for(name)}.manual.service").stdout.strip() == "loaded":
            checked_systemctl("stop", f"{label_for(name)}.manual.service")
    else:
        launchctl("bootout", f"{domain()}/{label_for(name)}")


def bootstrap(plist: Path) -> None:
    if systemd():
        checked_systemctl("daemon-reload")
        checked_systemctl("enable", "--now", plist.name)
        return
    result = launchctl("bootstrap", domain(), str(plist))
    if result.returncode != 0:
        fallback = launchctl("load", str(plist))
        if fallback.returncode != 0:
            raise SystemExit(f"launchctl bootstrap failed: {result.stderr.strip()} / {fallback.stderr.strip()}")


def kickstart(name: str) -> subprocess.CompletedProcess:
    if systemd():
        return systemctl("start", "--no-block", f"{label_for(name)}.service")
    return launchctl("kickstart", f"{domain()}/{label_for(name)}")


def unit_arg(value: str) -> str:
    # systemd parses its own quoting, percent specifiers and (ExecStart only) dollar expansion.
    return json.dumps(value.replace("%", "%%").replace("$", "$$"), ensure_ascii=False)


def service_body(name: str) -> str:
    runner = unit_arg(str(paths(name)["sh"]))
    return f"""[Unit]
Description=T3 scheduled job {name}

[Service]
Type=oneshot
ExecStart=/bin/zsh {runner}
Environment=T3_SCHEDULE_AUTOMATIC=1
TimeoutStartSec=infinity
"""


def timer_body(spec: dict) -> bytes:
    if spec.get("once"):
        calendar = f"{spec['once']} {spec['at']}:00"
    else:
        days = spec.get("days")
        prefix = ",".join(DAY_NAMES[d].title() for d in days) + " " if days else ""
        calendar = f"{prefix}*-*-* {spec['at']}:00"
    return f"""[Unit]
Description=T3 scheduled job {spec['name']}

[Timer]
OnCalendar={calendar}
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
""".encode()


def scheduler_check() -> None:
    if systemd():
        checked_systemctl("show-environment")  # exit status, never print secrets
    elif sys.platform == "darwin":
        if launchctl("print", domain()).returncode:
            raise SystemExit("launchd GUI domain unavailable; log into the macOS desktop session")
    else:
        raise SystemExit("supported schedulers: macOS launchd, Linux/WSL systemd user manager (run inside WSL)")
    if not Path("/bin/zsh").exists():
        raise SystemExit("missing /bin/zsh: install zsh for the scheduled runners")


# --- commands -----------------------------------------------------------------
def read_prompt(args: argparse.Namespace) -> str:
    if args.prompt_file:
        return Path(args.prompt_file).expanduser().read_text()
    if args.prompt:
        return " ".join(args.prompt)
    if not sys.stdin.isatty():
        return sys.stdin.read()
    raise SystemExit("prompt required: `-- \"<prompt>\"`, --prompt-file, or stdin")


# --- fire: the runner's single T3 step, through t3-relay ------------------------
def resume_message(prompt: str, name: str, day: str) -> str:
    return f"Scheduled follow-up ({day}, t3-schedule job {name}), as agreed earlier in this thread:\n\n{prompt}"


def helper(*argv: str) -> subprocess.CompletedProcess:
    """t3-manage-thread helper; its stderr (routing decisions) lands in the job log."""
    result = subprocess.run(list(argv), capture_output=True, text=True)
    if result.stderr.strip():
        print(result.stderr.strip())
    return result


def profile_instances(profile: str, model_id: str) -> list[str]:
    """`profile` = an instance id or a t3-list-profiles label (e.g. dentai), narrowed to the model's ecosystem."""
    rows = json.loads(helper("t3-list-profiles", "--json").stdout or "[]")
    eco = "Claude" if model_id.startswith("claude-") else "OpenAI" if model_id.startswith("gpt-") else None
    return [r["instance_id"] for r in rows
            if profile in (r["instance_id"], r.get("profile")) and (eco is None or r.get("ecosystem") == eco)]


def pick(spec: dict) -> tuple[str, str] | None:
    """(instanceId, modelId) of the first model candidate with a routable account; None = none has capacity."""
    for candidate in spec["model"].split(","):
        print(f"probe model {candidate}")
        allowed = ""
        if spec.get("profile"):
            model_id = helper("t3-pick-instance", "--resolve", candidate).stdout.strip() or candidate
            allowed = ",".join(profile_instances(spec["profile"], model_id))
            if not allowed:
                print(f"profile {spec['profile']} has no account for {model_id}")
                continue
        out = helper("t3-pick-instance", candidate, *([allowed] if allowed else []))
        fields = out.stdout.split()
        if out.returncode == 0 and len(fields) == 3:
            return fields[0], fields[1]
    return None


def resolve_pending(name: str) -> tuple[str | None, str]:
    """(outcome, occurrence day) of an earlier accepted-but-unconfirmed fire, any day: 'ok' (landed),
    'pending', 'stale' (pending > PENDING_ALERT), or None (no marker, or it failed: fire anew).
    A marker outlives midnight: only t3-relay's verdict retires it, so a late launch never doubles."""
    p = paths(name)["pending"]
    if not p.exists():
        return None, ""
    try:
        day, rid, since = p.read_text().split()
        float(since)
    except (OSError, ValueError):
        print(f"unreadable pending marker {p}; never re-fired (could duplicate): check the thread, then remove it")
        return "stale", ""
    result = helper("t3-relay", "status", rid)
    print(f"relay {rid} ({day}): {result.stdout.strip() or 'status failed'}")
    if result.returncode == 0:
        mark_fired(name, day)  # record before dropping the marker: a failed write keeps the proof it already ran
        p.unlink()
        return "ok", day
    if relay_failed(result) or (result.returncode == 2 and day < date.today().isoformat()):
        p.unlink()  # failed, or an earlier day's record t3-relay no longer keeps: nothing left to wait for
        return None, day
    # pending, or the lookup itself broke: the request may still run, so never re-fire it
    return ("stale" if datetime.now().timestamp() - float(since) > PENDING_ALERT else "pending"), day


def mark_fired(name: str, day: str) -> None:
    """`.last` = the occurrence that fired; a late confirmation never moves it backwards."""
    if (last_fire(name) or "") < day:
        write_atomic(paths(name)["last"], f"{day}\n")


def relay_failed(result: subprocess.CompletedProcess) -> bool:
    """Only t3-relay's explicit verdict proves an accepted request will not run."""
    return result.returncode == 1 and bool(re.search(r"^failed ", result.stdout, re.M))


def cmd_fire(args: argparse.Namespace) -> int:
    """Runner step: hand the job to t3-relay and wait for the thread/message to exist.
    Exit 0 = confirmed, PENDING_EXIT = accepted but unconfirmed (marker; catch-up re-checks), 1 = failed."""
    p = require_spec(args.name)
    spec = load_spec(p["spec"])
    if spec.get("missing"):
        print(f"MISSING {spec.get('source') or p['spec']}: {spec['missing']}")
        return 1
    p["fire_lock"].parent.mkdir(parents=True, exist_ok=True)
    with p["fire_lock"].open("a") as lock:
        # The Linux runner flocks itself; on macOS a launchd run and `run-now --foreground` can overlap.
        # Serialised here, the second one sees the first one's `.last` or pending marker.
        fcntl.flock(lock, fcntl.LOCK_EX)
        return fire_locked(spec)


def fire_locked(spec: dict) -> int:
    name = spec["name"]
    today = date.today().isoformat()
    if last_unreadable(name):
        print(f"UNREADABLE {paths(name)['last']}: not firing until it is fixed or removed")
        return 1
    last = last_fire(name)
    if last and (spec.get("once") or last == today):
        print(f"already fired ({last}); not firing again")
        return 0
    state, day = resolve_pending(name)
    if state == "ok":
        if day == today or spec.get("once"):
            print(f"confirmed: the earlier fire ({day}) landed")
            return 0
        print(f"the {day} fire landed late; firing today's")
    if state == "pending":
        print(f"earlier fire ({day}) not yet confirmed; not firing again")
        return PENDING_EXIT
    if state == "stale":
        print(f"earlier fire unconfirmed for >{PENDING_ALERT // 60} min; not firing again (it may still land)")
        return 1
    prompt = prompt_path(spec).read_text().strip()
    if spec.get("resume_thread"):
        argv = ["t3-relay", "send", "--thread", spec["resume_thread"], "--wait", str(CONFIRM_WAIT), "--",
                resume_message(prompt, spec["name"], today)]
        done = f"sent follow-up to thread {spec['resume_thread']}"
    else:
        title = spec["title"].replace("{date}", today)
        argv = ["t3-relay", "launch", "--project", spec["project"], "--title", title]
        if spec.get("settle_when_done"):
            argv.append("--settle-when-done")  # the footer lives once, in settle-thread.md
        if spec.get("allow_small_model"):
            argv.append("--allow-small-model")
        if spec.get("model"):
            chosen = pick(spec)
            if not chosen:
                print(f"no model candidate available ({spec['model']})")
                return 1
            argv += ["--model", chosen[1], "--instance", chosen[0]]
        if spec.get("thinking"):
            argv += ["--effort", spec["thinking"]]
        argv += ["--wait", str(CONFIRM_WAIT), "--", prompt]
        done = f"launched {title}"
    relay = helper(*argv)
    print(relay.stdout.strip())
    accepted = re.search(r"^accepted: relay (\w+)", relay.stdout, re.M)
    if relay.returncode and accepted and not relay_failed(relay):  # pending or confirmation broke
        write_atomic(paths(name)["pending"], f"{today} {accepted[1]} {datetime.now().timestamp():.0f}\n")
        print("relay accepted, not yet confirmed; catch-up re-checks")
        return PENDING_EXIT
    if relay.returncode:
        print(f"t3-relay FAILED (exit {relay.returncode})")
        return 1
    mark_fired(name, today)
    print(done)
    return 0


def describe_resume(spec: dict) -> str:
    return f" · resumes {spec['resume_thread']}" if spec.get("resume_thread") else ""


def thread_exists(thread_id: str) -> bool:
    """Read-only lookup in T3's V2 store (ids look like uuid, mcp:…, thread:project:…)."""
    db = Path.home() / ".t3/userdata/statev2.sqlite"
    if not db.exists():
        return False
    with sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10) as con:
        return con.execute("select 1 from orchestration_v2_projection_threads where thread_id = ? "
                           "and deleted_at is null", (thread_id,)).fetchone() is not None


def cmd_add(args: argparse.Namespace) -> int:
    name = valid_name(args.name)
    p = paths(name)
    if p["spec"].exists() and not args.force:
        raise SystemExit(f"{name} already exists; `t3-schedule remove {name}` or add --force to replace")
    hour, minute = parse_at(args.at)
    once = parse_once(args.once, hour, minute, datetime.now()) if args.once else None
    days = None if once else parse_days(args)
    if args.profile and not args.model:
        raise SystemExit("--profile needs --model (the account is picked per model ecosystem)")
    if problem := small_model_problem(args.model, args.allow_small_model):
        raise SystemExit(problem)
    resume = args.resume_thread
    if resume:
        if not thread_exists(resume):
            raise SystemExit(f"--resume-thread: no T3 thread {resume!r}; inside T3 pass your own "
                             "(t3_thread_list → currentThreadId), a launchd job cannot resolve 'self'")
        if args.settle_when_done or args.model or args.thinking or args.title:
            raise SystemExit("--resume-thread sends a turn to an existing thread: drop --settle-when-done/--model/"
                             "--profile/--thinking/--title (say lifecycle wishes in the prompt)")
    elif not args.project:
        raise SystemExit("--project is required (except with --resume-thread)")
    project = Path(args.project).expanduser().resolve() if args.project else None
    if project and not project.is_dir():
        raise SystemExit(f"--project is not a directory: {project}")
    existing = [f for f in repo_files(project, name) if f.exists()] if project else []
    if existing and not once and not resume and not args.force:
        raise SystemExit(f"{existing[0]} already defines {name} (committed or someone's WIP): "
                         f"`t3-schedule adopt {existing[0].with_name(name + '.json')}` to arm it, or add --force to overwrite")
    prompt = read_prompt(args).strip() + "\n"
    if not prompt.strip():
        raise SystemExit("empty prompt")
    spec = {
        "name": name,
        "project": str(project) if project else None,
        "profile": args.profile,
        "model": valid_models(args.model),
        "thinking": args.thinking,
        "allow_small_model": args.allow_small_model,
        "settle_when_done": args.settle_when_done,
        "notify": not args.no_notify,
        "title": args.title or f"⏰ {name} {{date}}",
        "at": f"{hour:02d}:{minute:02d}",
        "days": days,
        "once": once,
        "wait_max": args.wait_max,
        "resume_thread": resume,
        "pre_command": args.pre_command,
        "created": datetime.now().astimezone().isoformat(timespec="minutes"),
    }
    versioned = versionable(spec)
    if args.many_machines and not versioned:
        raise SystemExit("--many-machines applies to recurring repo jobs only (one-shots/continuations are machine-local)")
    others: list = []
    if versioned:  # the repo holds the definition; the runtime dir only a pointer
        src = repo_files(project, name)[0]
        if src.exists():
            try:
                previous = json.loads(src.read_text())
            except (OSError, ValueError):
                previous = {}
            if not isinstance(previous, dict):
                previous = {}
            spec.update(paused=previous.get("paused", False), pause_until=previous.get("pause_until"))
        me = ensure_identity()
        machines = "many" if args.many_machines else "one"
        owners, others = registration(existing_owners(src), machines, me, git_user(project))
        spec.update(prompt_path=str(repo_files(project, name)[1]), source=str(src), machines=machines, adopted_by=owners)
    body, plist = artefacts(spec)
    if args.dry_run:
        print(f"--- {p['plist']}\n{plist.decode()}--- {p['sh']}\n{body}--- {prompt_path(spec)}\n{prompt}")
        if systemd():
            print(f"--- {p['service']}\n{service_body(name)}")
        return 0
    scheduler_check()
    confirm_takeover(name, others, args.takeover)
    if running(name):
        raise SystemExit(f"{name}: runner active; wait for completion before replacing the job")
    if versioned:
        save_identity(me)  # the id recorded in adopted_by
    for path in p.values():
        path.parent.mkdir(parents=True, exist_ok=True)
    if loaded(name):
        bootout(name)
    if once:  # a re-armed once-job must not look fired already
        p["last"].unlink(missing_ok=True)
    if versioned:
        source = write_repo_job(project, name, spec, prompt)
        write_atomic(p["spec"], json.dumps(pointer(name, source, args.profile), indent=2) + "\n")
        p["prompt"].unlink(missing_ok=True)
    else:
        write_atomic(p["spec"], json.dumps(spec, indent=2) + "\n")
        p["prompt"].write_text(prompt)
    write_artefacts(spec)
    bootstrap(p["plist"])
    arm_catch_up()
    print(f"armed    {label_for(name)}\nfires    {describe_when(spec)} at {spec['at']} (missed/failed → catch-up until {'23:00' if once else f'+{CATCH_UP_GRACE_HOURS}h'})")
    if resume:
        print(f"resumes  {resume} (t3-relay send)")
    else:
        print(f"launches {project} · profile={args.profile or 'auto (capacity routing)'} model={describe_models(spec)}")
    print(f"log      {p['log']}\nrun now  t3-schedule run-now {name}")
    if versioned:
        print(registry_note(source, spec["machines"], spec["adopted_by"]))
        print(f"commit   git -C {shlex.quote(str(project))} add {SCHEDULES_DIR}/{name}.json {SCHEDULES_DIR}/{name}.prompt.md "
              f"(definition lives in the repo; other machines opt in with `t3-schedule adopt {project}`)")
    return 0


def last_run(log: Path) -> str:
    if not log.exists():
        return "never"
    lines = log.read_text().splitlines()
    stamp = next((l for l in reversed(lines) if l.startswith("=== ")), None)
    result = next((l for l in reversed(lines) if l.startswith("-- ")), "")
    if not stamp:
        return "never"
    return f"{stamp[4:20]} {result[3:]}".strip()


def specs() -> list[dict]:
    base = runtime_dir()
    return [load_spec(path) for path in sorted(base.glob("*.json"))] if base.exists() else []


def cmd_list(args: argparse.Namespace) -> int:
    rows = specs()
    if args.json:
        for spec in rows:
            spec["loaded"] = loaded(spec["name"])
            spec["pause_status"] = pause_label(spec)
            spec["last_run"] = last_run(paths(spec["name"])["log"])
            spec["flag"] = job_flag(spec)
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("No scheduled jobs.")
        return 0
    me = machine_identity()
    print(f"catch-up poller: {'loaded' if loaded(CATCH_UP) else 'NOT loaded (t3-schedule refresh)'} · every {CATCH_UP_INTERVAL // 60} min, retries until slot+{CATCH_UP_GRACE_HOURS}h")
    print(f"this machine: {me['label']} ({me['id'][:8]})\n" if me else "this machine: no identity yet (add/adopt creates one)\n")
    if args.markdown:
        print("| job | when | project | profile / model | runs on | status | loaded | last run | flag | prompt |")
        print("|---|---|---|---|---|---|---|---|---|---|")
        for spec in rows:
            name = spec["name"]
            if spec.get("missing"):
                print(f"| {name} | | {Path(spec.get('project') or '').name} | | | | | | {job_flag(spec)} | |")
                continue
            prompt = prompt_path(spec).read_text().strip().replace("\n", " ").replace("|", "\\|")
            print(
                f"| {name} | {describe_when(spec)} {spec['at']} | {Path(spec.get('project') or '').name}{describe_resume(spec)} "
                f"| {spec.get('profile') or 'auto'} / {describe_models(spec)} "
                f"| {describe_registration(spec) if spec.get('source') else 'this machine (local)'} "
                f"| {pause_label(spec) or 'active'} | {spec.get('retired') or ('yes' if loaded(name) else 'NO')} | {last_run(paths(name)['log'])} "
                f"| {job_flag(spec) or ('repo' if spec.get('source') else 'local')} | {prompt[:120]}{'…' if len(prompt) > 120 else ''} |"
            )
        return 0
    for spec in rows:
        name = spec["name"]
        if spec.get("missing"):
            print(f"{name:<28} ! {job_flag(spec)}")
            continue
        state = pause_label(spec) or spec.get("retired") or ("loaded" if loaded(name) else "NOT loaded")
        print(
            f"{name:<28} {describe_when(spec):<9} {spec['at']}  {state:<10} "
            f"{spec.get('profile') or '-'}/{describe_models(spec)}  {spec.get('project') or '-'}"
        )
        if spec.get("resume_thread"):
            print(f"{'':<28}{describe_resume(spec)}")
        if spec.get("source"):
            print(f"{'':<28} runs on: {describe_registration(spec)}")
        if flag := job_flag(spec):
            print(f"{'':<28} ! {flag}")
        print(f"{'':<28} last: {last_run(paths(name)['log'])}")
    return 0


def require_spec(name: str) -> dict[str, Path]:
    p = paths(name)
    if not p["spec"].exists():
        raise SystemExit(f"no such job: {name} (t3-schedule list)")
    return p


def cmd_remove(args: argparse.Namespace) -> int:
    p = require_spec(args.name)
    spec = load_spec(p["spec"])
    bootout(args.name)
    for key in ("plist", "service", "spec", "prompt", "sh", "last", "failed", "pending", "fire_lock"):
        p[key].unlink(missing_ok=True)
    if systemd():
        checked_systemctl("daemon-reload")
    print(f"removed  {label_for(args.name)} from this machine (log kept: {p['log']})")
    me = machine_identity()
    if spec.get("source") and me:
        src = Path(spec["source"])
        try:  # disarmed either way; a stale registration only misleads `list` and takeover prompts elsewhere
            stored = json.loads(src.read_text())
            owners = stored.get("adopted_by") or []
            if any(isinstance(o, dict) and o.get("id") == me["id"] for o in owners):
                write_registration(src, stored.get("machines") or "one", [o for o in owners if o.get("id") != me["id"]])
                print(f"registry dropped {me['label']} from {src} (commit + push it)")
        except (OSError, ValueError, AttributeError) as exc:
            print(f"registry NOT updated ({src}: {exc!r:.80}); this machine may still be listed in adopted_by")
    if spec.get("source"):
        print(f"repo     definition kept; to drop it for everyone: git -C {shlex.quote(spec['project'])} rm "
              f"{SCHEDULES_DIR}/{args.name}.json {SCHEDULES_DIR}/{args.name}.prompt.md")
    return 0


def cmd_run_now(args: argparse.Namespace) -> int:
    """Default: launchctl kickstart / systemd-run (same env as the scheduled run), then tail the
    log until the runner reports. Once-jobs need T3_SCHEDULE_FORCE, which kickstart cannot pass:
    they run the script directly, as --foreground does."""
    p = require_spec(args.name)
    spec = load_spec(p["spec"])
    if spec.get("retired"):
        raise SystemExit(f"{args.name} is retired ({spec['retired']}); re-arm with add --force")
    before = p["log"].stat().st_size if p["log"].exists() else 0
    env = {**os.environ, "T3_SCHEDULE_FORCE": "1"} if spec.get("once") else None
    finished = False
    if args.foreground or (spec.get("once") and not systemd()):
        status = subprocess.run(["/bin/zsh", "-lc", str(p["sh"])], env=env).returncode
        finished = True
    elif systemd():
        # A transient user service keeps parent process ancestry out of the thread and allows
        # an explicit early run without changing the persistent timer's environment.
        result = subprocess.run(["systemd-run", "--user", "--collect", "--no-block",
                                 f"--unit={label_for(args.name)}.manual", "--setenv=T3_SCHEDULE_FORCE=1",
                                 "/bin/zsh", str(p["sh"])], capture_output=True, text=True)
        if result.returncode:
            raise SystemExit(f"run-now failed: {result.stderr.strip()}")
        status = 0
    else:
        result = kickstart(args.name)
        if result.returncode != 0:
            raise SystemExit(f"kickstart failed: {result.stderr.strip()}")
        status = 0
    deadline = time.time() + args.timeout
    printed = before
    done = False
    while not done and (time.time() < deadline or finished):
        if p["log"].exists() and p["log"].stat().st_size > printed:
            with p["log"].open() as fh:
                fh.seek(printed)
                chunk = fh.read()
            printed += len(chunk.encode())
            print(chunk, end="")
            done = any(
                l.startswith("-- ") and any(k in l for k in ("launched", "sent follow-up", "FAILED", "NOT fired", "skipping"))
                for l in chunk.splitlines()
            )
            if "FAILED" in chunk or "NOT fired" in chunk:
                status = 1
        done = done or finished
        if not done:
            time.sleep(1)
    if not done:
        print(f"(no result within {args.timeout}s; tail -f {p['log']})")
        status = status or 2
    return status


# --- catch-up poller ----------------------------------------------------------
# launchd only replays a missed StartCalendarInterval once at wake (never after a reboot), and a
# runner that failed (T3 down, auth 401, provider hiccup) would otherwise wait for tomorrow. One
# poller every CATCH_UP_INTERVAL re-kicks any job whose slot passed today without a fire.
def write_artefacts(spec: dict) -> None:
    p = paths(spec["name"])
    sh, plist = artefacts(spec)
    p["sh"].parent.mkdir(parents=True, exist_ok=True)
    p["plist"].parent.mkdir(parents=True, exist_ok=True)
    p["sh"].write_text(sh)
    p["sh"].chmod(0o755)
    p["plist"].write_bytes(plist)
    if systemd():
        p["service"].write_text(service_body(spec["name"]))


def rearm(spec: dict) -> bool:
    """Regenerate runner + plist and reload the LaunchAgent; False (untouched) while a runner is active:
    bootout would kill a fire in flight, and zsh reads its script lazily."""
    name = spec["name"]
    if running(name):
        print(f"skipped   {label_for(name)} (runner active; rerun refresh later)")
        return False
    if loaded(name):
        bootout(name)
    write_artefacts({"wait_max": DEFAULT_WAIT_MAX, **spec})
    if spec.get("source"):
        paths(name)["prompt"].unlink(missing_ok=True)  # pre-migration copy; the runner reads the repo prompt
    bootstrap(paths(name)["plist"])
    return True


def window(at: str, day: datetime, once: bool = False) -> tuple[datetime, datetime]:
    hour, minute = parse_at(at)
    slot = day.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if once:
        deadline = slot.replace(hour=ONCE_DEADLINE[0], minute=ONCE_DEADLINE[1])
        # A late slot needs a real firing window; systemd starts after the exact microsecond.
        return slot, deadline if slot < deadline else slot.replace(hour=23, minute=59, second=59, microsecond=999999)
    end = slot + timedelta(hours=CATCH_UP_GRACE_HOURS)
    return slot, min(end, slot.replace(hour=23, minute=59, second=59))  # same calendar day only


def due_now(spec: dict, now: datetime, last: str | None) -> bool:
    """Slot passed today, still inside the grace window, and nothing fired today
    (once-jobs: today is their date and they never fired)."""
    if spec.get("retired") or spec.get("missing") or spec.get("displaced") or pause_label(spec, now.date()):
        return False
    if spec.get("once"):
        if last or spec["once"] != now.strftime("%Y-%m-%d"):
            return False
    elif last == now.strftime("%Y-%m-%d"):
        return False
    days = spec.get("days")
    if days is not None and (now.weekday() + 1) % 7 not in days:  # launchd: 0=Sun
        return False
    slot, end = window(spec["at"], now, bool(spec.get("once")))
    return slot <= now <= end


def retire_status(spec: dict, now: datetime, last: str | None) -> str | None:
    """Once-jobs leave launchd after firing or once their window closed (the plist would
    re-fire next year); a runner cannot bootout itself, so the poller does it."""
    if not spec.get("once") or spec.get("retired"):
        return None
    if last:
        return f"fired {last}"
    if window(spec["at"], datetime.fromisoformat(spec["once"]), once=True)[1] < now:
        return "expired (never fired)"
    return None


def last_fire(name: str) -> str | None:
    try:
        return paths(name)["last"].read_text().strip() or None
    except (OSError, UnicodeError):
        return None


def last_unreadable(name: str) -> bool:
    """A `.last` that exists but cannot be read: firing would launch, then fail to record it, on every retry."""
    try:
        paths(name)["last"].read_text()
    except FileNotFoundError:
        return False
    except (OSError, UnicodeError):
        return True
    return False


def pending_resumes(now: datetime) -> list[dict]:
    """Continuations that will still wake their thread: recurring (paused too), or once-jobs not yet fired,
    retired or expired. Spec files + `.last` only (no launchctl): `t3-purge-threads` calls this to spare them."""
    return [
        spec for spec in specs()
        if spec.get("resume_thread") and not spec.get("missing")
        and not (spec.get("once") and (spec.get("retired") or retire_status(spec, now, last_fire(spec["name"]))))
    ]


def cmd_pending_resumes(_args) -> int:
    for spec in pending_resumes(datetime.now()):
        print(f"{spec['resume_thread']}\t{spec['name']}\t{describe_when(spec)} {spec['at']}")
    return 0


def arm_catch_up() -> None:
    if systemd():
        p = paths(CATCH_UP)
        p["plist"].parent.mkdir(parents=True, exist_ok=True)
        p["sh"].parent.mkdir(parents=True, exist_ok=True)
        p["sh"].write_text(f'#!/bin/zsh\nexport PATH="{SCHEDULE_PATH}"\nexec t3-schedule catch-up\n')
        p["sh"].chmod(0o755)
        p["service"].write_text(service_body(CATCH_UP))
        p["plist"].write_text(f"[Unit]\nDescription=T3 schedule catch-up\n\n[Timer]\nOnStartupSec=1min\nOnUnitActiveSec={CATCH_UP_INTERVAL}s\nAccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n")
        bootstrap(p["plist"])
        return
    plist = paths(CATCH_UP)["plist"]
    body = plistlib.dumps(
        {
            "Label": label_for(CATCH_UP),
            "ProgramArguments": ["/bin/zsh", "-lc", f'export PATH="{SCHEDULE_PATH}"; t3-schedule {CATCH_UP}'],
            "StartInterval": CATCH_UP_INTERVAL,
            "RunAtLoad": True,
            "ProcessType": "Interactive",  # Standard still gets a utility clamp: t3 CLI 15-25s per call vs <1s (A/B 2026-09-09)
        }
    )
    if plist.exists() and plist.read_bytes() == body and loaded(CATCH_UP):
        return
    if loaded(CATCH_UP):
        bootout(CATCH_UP)
    plist.write_bytes(body)
    bootstrap(plist)


def cmd_catch_up(args: argparse.Namespace) -> int:
    now = datetime.now()
    log = home() / ".t3/userdata/logs" / f"t3-schedule.{CATCH_UP}.log"
    kicked = []
    # An accepted-but-unconfirmed fire is re-checked first (a status read, no runner): landed →
    # mark its occurrence fired; failed → due again below; still pending → never re-fired (could
    # duplicate), and a once-job is not retired as "never fired" meanwhile.
    for spec in specs():
        name = spec["name"]
        if args.dry_run or running(name) or not paths(name)["pending"].exists():
            continue
        if last_unreadable(name):  # isolate this job: confirming it would fail to record, the others still run
            kicked.append(f"{name} UNREADABLE {paths(name)['last'].name}")
            continue
        state, day = resolve_pending(name)
        if state == "ok":
            paths(name)["failed"].unlink(missing_ok=True)
            kicked.append(f"{name} confirmed ({day})")
        elif state == "stale":
            failed = paths(name)["failed"]
            if failed.exists() and failed.read_text().strip() == f"{now:%Y-%m-%d}":
                continue
            failed.write_text(f"{now:%Y-%m-%d}\n")
            kicked.append(f"{name} UNCONFIRMED")
            os_notify(f"{name}: relay accepted but launch unconfirmed for {PENDING_ALERT // 60}+ min")
    for spec in specs():
        name = spec["name"]
        status = retire_status(spec, now, last_fire(name))
        if not status or running(name) or paths(name)["pending"].exists():
            continue
        kicked.append(f"retire {name} ({status})")
        if args.dry_run:
            continue
        bootout(name)
        paths(name)["plist"].unlink(missing_ok=True)
        if systemd():
            paths(name)["service"].unlink(missing_ok=True)
            checked_systemctl("daemon-reload")
        paths(name)["sh"].unlink(missing_ok=True)
        spec["retired"] = status
        write_atomic(paths(name)["spec"], json.dumps(spec, indent=2) + "\n")
        if status.startswith("expired"):
            os_notify(f"{name}: once-job for {spec['once']} {spec['at']} never fired, retired")
    # One job per tick, earliest slot first: after a long power-off several slots are due at
    # once, and firing them together would make every launch route to the same profile from
    # the same limits snapshot. Spacing them by one tick re-reads the limits between jobs.
    due = sorted(
        (spec for spec in specs() if due_now(spec, now, last_fire(spec["name"]))
         and not paths(spec["name"])["pending"].exists()),
        key=lambda spec: spec["at"],
    )
    if any(running(spec["name"]) for spec in specs()):
        due = []  # a runner is still firing; let it finish before adding load
    for spec in due[:1]:
        name = spec["name"]
        if args.dry_run:
            kicked.append(f"{name} (dry-run; also due: {', '.join(s['name'] for s in due[1:]) or 'none'})")
            continue
        result = kickstart(name)
        kicked.append(name if result.returncode == 0 else f"{name} FAILED: {result.stderr.strip()}")
    if kicked:
        line = f"{now:%Y-%m-%d %H:%M:%S}  catch-up: {', '.join(kicked)}"
        print(line)
        if not args.dry_run:
            log.parent.mkdir(parents=True, exist_ok=True)
            with log.open("a") as fh:
                fh.write(line + "\n")
    elif args.dry_run:
        print("nothing due")
    return 0


def cmd_refresh(args: argparse.Namespace) -> int:
    """Regenerate every runner + plist from its spec (after a template change) and re-arm catch-up."""
    scheduler_check()
    for spec in specs():
        name = spec["name"]
        if spec.get("retired"):
            continue  # never re-arm a spent once-job
        if spec.get("missing"):
            print(f"skipped   {label_for(name)} (MISSING {spec.get('source') or 'local spec'}: {spec['missing']}; fix it or `t3-schedule remove {name}`)")
            continue
        if rearm(spec):
            print(f"refreshed {label_for(name)}")
    arm_catch_up()
    print(f"armed     {label_for(CATCH_UP)} (every {CATCH_UP_INTERVAL // 60} min + at login)")
    return 0


def cmd_set_at(args: argparse.Namespace) -> int:
    """Move a job's slot without re-typing the prompt: rewrites spec + plist, keeps everything else."""
    p = require_spec(args.name)
    spec = load_spec(p["spec"])
    if spec.get("retired"):
        raise SystemExit(f"{args.name} is retired ({spec['retired']}); re-arm with add --force")
    hour, minute = parse_at(args.at)
    spec["at"] = f"{hour:02d}:{minute:02d}"
    target = Path(spec["source"]) if spec.get("source") else p["spec"]
    stored = json.loads(target.read_text())
    stored["at"] = spec["at"]
    target.write_text(json.dumps(stored, indent=2, ensure_ascii=False) + "\n")
    rearm(spec)
    print(f"moved    {label_for(args.name)} → {describe_when(spec)} at {spec['at']}")
    if spec.get("source"):
        print(f"commit   {target}")
    return 0


def adopt_sources(target: Path) -> list[Path]:
    """A spec file, a project repo, or its schedules dir → the repo specs it names."""
    if target.is_file():
        found = [target]
    else:
        found = sorted((target / SCHEDULES_DIR if (target / SCHEDULES_DIR).is_dir() else target).glob("*.json"))
    for src in found:
        if src.parent.parts[-2:] != tuple(SCHEDULES_DIR.split("/")):
            raise SystemExit(f"{src}: not a repo job spec (expected <project>/{SCHEDULES_DIR}/<name>.json)")
        if not repo_files(src.parents[2], src.stem)[1].exists():
            raise SystemExit(f"{src}: prompt {src.stem}.prompt.md missing")
    if not found:
        raise SystemExit(f"no job specs in {target} (looked for {SCHEDULES_DIR}/*.json)")
    return found


def cmd_adopt(args: argparse.Namespace) -> int:
    """Opt this machine into jobs committed to a repo. Never implicit: a clone alone arms nothing.
    Every spec is checked (and every takeover confirmed) before anything is written."""
    scheduler_check()
    me = ensure_identity()
    plans = []
    for src in adopt_sources(Path(args.path).expanduser().resolve()):
        name = valid_name(src.stem)
        p = paths(name)
        old = json.loads(p["spec"].read_text()) if p["spec"].exists() else None
        if old and old.get("source") != str(src) and not args.force:
            raise SystemExit(f"{name} already exists ({old.get('source') or 'machine-local'}); add --force to replace it")
        profile = args.profile if args.profile is not None else (old or {}).get("profile")
        local = pointer(name, src, profile)
        spec = merge_pointer(local)
        if spec.get("missing"):
            raise SystemExit(f"{src}: {spec['missing']}")
        owners, others = registration(spec["adopted_by"], spec["machines"], me, git_user(src.parents[2]))
        plans.append((name, src, local, spec["machines"], owners, others))
    for name, _, _, _, _, others in plans:
        confirm_takeover(name, others, args.takeover)
    save_identity(me)
    for name, src, local, machines, owners, others in plans:
        p = paths(name)
        p["spec"].parent.mkdir(parents=True, exist_ok=True)
        p["plist"].parent.mkdir(parents=True, exist_ok=True)
        changed = write_registration(src, machines, owners)
        write_atomic(p["spec"], json.dumps(local, indent=2) + "\n")
        spec = merge_pointer(local)
        if rearm(spec):
            print(f"adopted  {label_for(name)} · {describe_when(spec)} {spec['at']} · profile={local['profile'] or 'auto'}")
        if changed:
            print(registry_note(src, machines, owners))
        if others:
            print(f"takeover {name}: {'; '.join(map(describe_owner, others))} keeps firing until its checkout pulls this commit")
    arm_catch_up()
    return 0


def cmd_owner_check(args: argparse.Namespace) -> int:
    """Runner step of a repo job: 0 = fire, OWNER_SKIP_EXIT = registered to another machine (reason printed)."""
    spec = load_spec(require_spec(args.name)["spec"])
    if spec.get("missing"):
        print(f"MISSING {spec['source']}: {spec['missing']}")
        return 1
    if spec.get("displaced"):
        print(spec["displaced"])
        return OWNER_SKIP_EXIT
    return 0


def cmd_pause_check(args: argparse.Namespace) -> int:
    spec = load_spec(require_spec(args.name)["spec"])
    if spec.get("missing"):
        print(f"MISSING {spec['source']}: {spec['missing']}")
        return 1
    if label := pause_label(spec):
        print(label)
        return PAUSED_SKIP_EXIT
    return 0


def cmd_pause(args: argparse.Namespace) -> int:
    spec = load_spec(require_spec(args.name)["spec"])
    if not spec.get("source"):
        raise SystemExit("pause applies to recurring repo jobs only")
    if spec.get("missing"):
        raise SystemExit(f"{args.name}: {spec['missing']}")
    until = None
    if args.until:
        try:
            until = date.fromisoformat(args.until)
            if until.isoformat() != args.until:
                raise ValueError
        except ValueError:
            raise SystemExit("--until must be YYYY-MM-DD") from None
        if until <= date.today():
            raise SystemExit("--until must be after today (job resumes at local midnight on that date)")
    src = Path(spec["source"])
    stored = json.loads(src.read_text())
    stored.update(paused=True, pause_until=until.isoformat() if until else None)
    src.write_text(json.dumps(stored, indent=2, ensure_ascii=False) + "\n")
    print(f"{args.name}: {pause_label(stored)} (commit {src})")
    return 0


def cmd_unpause(args: argparse.Namespace) -> int:
    spec = load_spec(require_spec(args.name)["spec"])
    if not spec.get("source"):
        raise SystemExit("resume applies to recurring repo jobs only")
    if spec.get("missing"):
        raise SystemExit(f"{args.name}: {spec['missing']}")
    src = Path(spec["source"])
    stored = json.loads(src.read_text())
    stored.update(paused=False, pause_until=None)
    src.write_text(json.dumps(stored, indent=2, ensure_ascii=False) + "\n")
    print(f"{args.name}: active (commit {src})")
    return 0


def cmd_machine(args: argparse.Namespace) -> int:
    """Show (or label) the identity add/adopt record in `adopted_by`. A new label reaches a repo at its next adopt."""
    me = machine_identity()
    if args.label:
        me = {**ensure_identity(), "label": args.label}
        save_identity(me)
    print(json.dumps(me, indent=2) if me else f"no identity yet ({identity_path()}); add/adopt creates one")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    p = require_spec(args.name)
    spec = load_spec(p["spec"])
    spec["pause_status"] = pause_label(spec) or "active"
    print(json.dumps(spec, indent=2, ensure_ascii=False))
    print(f"--- prompt ({prompt_path(spec)})\n{prompt_path(spec).read_text()}", end="")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="t3-schedule",
        description="Recurring or one-shot T3 Code threads on a wall-clock schedule (macOS launchd / Linux and WSL systemd user timers).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="arm a job: t3-schedule add --name X --at 07:30 --weekdays --project P -- \"prompt\" "
                         f"(recurring: definition written to P/{SCHEDULES_DIR}, you commit it)")
    add.add_argument("--name", required=True, help="job id → com.t3-skills.t3-schedule.<name>")
    add.add_argument("--at", required=True, help="HH:MM, machine-local time")
    when = add.add_mutually_exclusive_group()
    when.add_argument("--weekdays", action="store_true", help="Mon-Fri")
    when.add_argument("--days", help="comma list mon,tue,... (default: every day)")
    when.add_argument("--once", metavar="YYYY-MM-DD", help="fire once on this date, then the catch-up poller retires the job")
    add.add_argument("--project", help="repo path the new thread runs in (not needed with --resume-thread)")
    add.add_argument("--resume-thread", metavar="THREAD_ID", help="continuation: send the prompt as a turn to this thread "
                     "(inside T3: your own t3_thread_list currentThreadId) instead of launching a new one")
    add.add_argument("--profile", help="account label or instance id (t3-list-profiles; machine-local, needs --model); omit → capacity routing at fire time")
    add.add_argument("--model", help="ordered comma list, first with a routable account wins: opus,astra · fable · MODEL (omit → opus, else astra)")
    add.add_argument("--thinking", help="effort, e.g. low|medium|high (omit → model's house default)")
    add.add_argument("--allow-small-model", action="store_true",
                     help="permit haiku/luna as the launched thread's model (refused by default)")
    add.add_argument("--settle-when-done", action="store_true", help="append the self-settle footer (clean outcome only)")
    add.add_argument("--pre-command", metavar="CMD", help="shell command the runner runs first, without T3 "
                     "(e.g. `skills-refresh --apply`); nonzero exit notifies once per day, the fire still follows")
    add.add_argument("--no-notify", action="store_true", help="no macOS notification on launch (failures still notify once per day)")
    add.add_argument("--title", help="thread title; {date} → YYYY-MM-DD. Default: '⏰ <name> {date}'")
    add.add_argument("--prompt-file", help="read the prompt from a file instead of the argument")
    add.add_argument("--wait-max", type=int, default=DEFAULT_WAIT_MAX, help=f"minutes to wait for T3 Code before giving up (default {DEFAULT_WAIT_MAX}; catch-up retries)")
    add.add_argument("--force", action="store_true", help="replace an existing job")
    add.add_argument("--many-machines", action="store_true", help="recurring job may run on several machines at once "
                     "(default: one machine; adopting it elsewhere needs a takeover)")
    add.add_argument("--takeover", action="store_true", help="with --force over a one-machine job registered to another "
                     "machine: confirm it no longer runs there")
    add.add_argument("--dry-run", action="store_true", help="print scheduler units + runner + prompt, write nothing")
    add.add_argument("prompt", nargs="*", help='-- "<prompt>"')
    add.set_defaults(func=cmd_add)

    ls = sub.add_parser("list", help="jobs, loaded state, last run")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--markdown", action="store_true", help="one markdown table (for agents reporting to the user)")
    ls.set_defaults(func=cmd_list)

    rm = sub.add_parser("remove", help="bootout + delete a job")
    rm.add_argument("name")
    rm.set_defaults(func=cmd_remove)

    run = sub.add_parser("run-now", help="fire now via the native service manager and print the result")
    run.add_argument("name")
    run.add_argument("--foreground", action="store_true", help="run the script directly instead of launchctl kickstart")
    run.add_argument("--timeout", type=int, default=120, help="seconds to wait for the runner's result line")
    run.set_defaults(func=cmd_run_now)


    catch = sub.add_parser(CATCH_UP, help="re-kick jobs whose slot passed today without a fire (the poller's tick)")
    catch.add_argument("--dry-run", action="store_true", help="print what would be kicked")
    catch.set_defaults(func=cmd_catch_up)

    refresh = sub.add_parser("refresh", help="regenerate all runners/scheduler units from their specs and re-arm the catch-up poller")
    refresh.set_defaults(func=cmd_refresh)

    at = sub.add_parser("set-at", help="move a job to another HH:MM (keeps prompt/profile/model)")
    at.add_argument("name")
    at.add_argument("at")
    at.set_defaults(func=cmd_set_at)

    pause = sub.add_parser("pause", help="pause a recurring repo job on every machine, keeping its registration")
    pause.add_argument("name")
    pause.add_argument("--until", metavar="YYYY-MM-DD", help="resume at local midnight on this date")
    pause.set_defaults(func=cmd_pause)

    resume = sub.add_parser("resume", help="resume a paused recurring repo job")
    resume.add_argument("name")
    resume.set_defaults(func=cmd_unpause)

    adopt = sub.add_parser("adopt", help=f"arm the jobs committed to a repo on this machine (<repo>, <repo>/{SCHEDULES_DIR} or one <name>.json)")
    adopt.add_argument("path")
    adopt.add_argument("--profile", help="machine-local T3 provider instance for these jobs; omit → capacity routing")
    adopt.add_argument("--force", action="store_true", help="replace a same-named job defined elsewhere (does not imply --takeover)")
    adopt.add_argument("--takeover", action="store_true", help="a one-machine job registered to another machine: you confirmed it "
                       "no longer runs there; this machine becomes its only one (required when not at a terminal)")
    adopt.set_defaults(func=cmd_adopt)

    fire = sub.add_parser("fire", help="(runner-internal) hand the job to t3-relay now; use run-now instead")
    fire.add_argument("name")
    fire.set_defaults(func=cmd_fire)

    owner = sub.add_parser("owner-check", help=f"(runner-internal) exit {OWNER_SKIP_EXIT} when a one-machine job is registered elsewhere")
    owner.add_argument("name")
    owner.set_defaults(func=cmd_owner_check)

    paused = sub.add_parser("pause-check", help=f"(runner-internal) exit {PAUSED_SKIP_EXIT} while a repo job is paused")
    paused.add_argument("name")
    paused.set_defaults(func=cmd_pause_check)

    machine = sub.add_parser("machine", help="this machine's registration identity (random id + label recorded in adopted_by)")
    machine.add_argument("--label", help="set a readable label (default machine-<id>); no host/user names in public repos")
    machine.set_defaults(func=cmd_machine)

    pending = sub.add_parser("pending-resumes", help="THREAD_ID<TAB>name<TAB>when per continuation that will still wake its thread")
    pending.set_defaults(func=cmd_pending_resumes)

    show = sub.add_parser("show", help="spec + prompt")
    show.add_argument("name")
    show.set_defaults(func=cmd_show)

    check = sub.add_parser("check", help="verify the platform service manager is reachable")
    check.set_defaults(func=cmd_check)

    due = sub.add_parser("due-check", help="(runner-internal) check the bounded catch-up window")
    due.add_argument("name")
    due.set_defaults(func=cmd_due_check)

    notify = sub.add_parser("notify", help="(runner-internal) OS notification: macOS, or Windows under WSL")
    notify.add_argument("message")
    notify.set_defaults(func=lambda a: os_notify(a.message) or 0)

    runner_path = sub.add_parser("runner-path", help="print the PATH scheduled runners get (used by install --check)")
    runner_path.set_defaults(func=cmd_runner_path)
    return parser


def cmd_check(_args) -> int:
    scheduler_check()
    print("ok      systemd user manager" if systemd() else "ok      launchd GUI domain")
    return 0


def cmd_due_check(args) -> int:
    spec = load_spec(require_spec(args.name)["spec"])
    return 0 if due_now(spec, datetime.now(), last_fire(args.name)) else 1


def cmd_runner_path(_args) -> int:
    print(os.path.expandvars(SCHEDULE_PATH))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
