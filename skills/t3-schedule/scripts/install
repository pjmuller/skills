#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
install_dir="${T3_SCHEDULE_INSTALL_DIR:-$HOME/.local/bin}"
target="$install_dir/t3-schedule"
[[ $# == 0 || ( $# == 1 && ( "$1" == --check || "$1" == --relink ) ) ]] || { echo 'Usage: install [--check|--relink]' >&2; exit 2; }
[[ "${1:-}" != --check ]] || echo "source $script_dir"
if [[ "${1:-}" == "--check" ]]; then
  [[ -L "$target" && "$(readlink -f "$target")" == "$script_dir/t3-schedule" ]] || { echo "missing or stale: $target" >&2; exit 1; }
  remedy='skills add pjmuller/skills -s t3-manage-thread -g && ~/.agents/skills/t3-manage-thread/scripts/install'
  for helper in t3-spawn-thread t3-limits; do
    command -v "$helper" >/dev/null || { echo "missing $helper; run: $remedy" >&2; exit 1; }
    echo "ok      $helper ($(command -v "$helper"))"
  done
  spawn="$(readlink -f "$(command -v t3-spawn-thread)")"
  [[ -r "$(dirname "$spawn")/lib/t3-common.sh" ]] || { echo "missing lib/t3-common.sh; run: $remedy" >&2; exit 1; }
  echo 'ok      lib/t3-common.sh'
  # launchd runners get SCHEDULE_PATH, not your interactive PATH: check the tools there.
  schedule_path="$("$script_dir/t3-schedule" runner-path)"
  for tool in pnpm uv jq sqlite3; do
    resolved="$(PATH="$schedule_path" bash -c "command -v $tool" || true)"
    [[ -n "$resolved" ]] || { echo "missing $tool on the launchd runner PATH ($schedule_path)" >&2; exit 1; }
    echo "ok      $tool ($resolved, runner PATH)"
  done
  echo "ok      t3-schedule ($target)"; exit 0
fi
# Preflight every link before changing any command.
project_copy=false
case "$script_dir" in
  "$HOME"/.agents/skills/*|"$HOME"/.claude/skills/*) ;;
  */.agents/skills/*|*/.claude/skills/*) project_copy=true ;;
esac
warn_project=false
[[ ! -d "$HOME/.agents/skills/t3-schedule" ]] || warn_project=true
for command_name in t3-schedule; do
  existing="$(readlink -f "$install_dir/$command_name" 2>/dev/null || true)"
  if [[ -n "$existing" && -e "$existing" && "$(dirname "$existing")" != "$script_dir" ]]; then
    warn_project=true
    if [[ "${1:-}" != --relink ]]; then
      echo "refusing checkout change: $existing -> $script_dir/$command_name; re-run from the checkout you want to be canonical, or pass --relink" >&2
      exit 1
    fi
  fi
done
if $project_copy && $warn_project; then
  echo "warning: project copy $script_dir is being made global" >&2
fi

mkdir -p "$install_dir"
ln -sfn "$script_dir/t3-schedule" "$target"
echo "installed $target"
