#!/usr/bin/env bash
set -euo pipefail
# No PATH commands: this skill runs its versioned helper directly.
case "${1:-}" in ''|--check) ;; *) echo 'usage: install [--check]' >&2; exit 2 ;; esac
command -v uv >/dev/null
uv run "$(dirname "$0")/sync_codex.py" --help >/dev/null
uv run "$(dirname "$0")/merge_claude.py" --help >/dev/null
echo 'OK auto-mode-policy (uv + isolated TOML dependency; no command links)'
