#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["google-genai>=1.30", "numpy>=1.26"]
# ///
"""Transcribe/narrate one recording with the Gemini API: plain model call, no agent, no clipboard.

Key/backend, first match wins (Gemini Developer API; files over 20 MB go through the File API):
  VIDEO_GEMINI_API_KEY         one key per machine for video work, from the env or from
                               ~/.config/transcribe-gemini/env (`VIDEO_GEMINI_API_KEY=...`, chmod 600).
                               Its own name, so it never collides with apps reading GEMINI_API_KEY.
  GEMINI_API_KEY in the env    a project's generic key.
  else GOOGLE_CLOUD_PROJECT    Vertex AI (GOOGLE_CLOUD_LOCATION, default global; regional is +10%)
                               with GOOGLE_APPLICATION_CREDENTIALS or ADC; inline upload.

Audio files (.ogg/.opus/.m4a/.aac/.mp3/.wav/.flac) are sent as audio; anything else as video/mp4.

--ranges <name>.screenshare.json (from detect-screenshare; {"method", "ranges": [{"start", "end"}]}) sends
the full audio but frames only inside those ranges: each range is cut locally into its own silent clip, so
frames outside them (webcam faces) are never uploaded; the rest costs audio tokens only. "ranges": [] means
audio only; method "full-fallback" sends the whole video as without --ranges.
Several audio tracks (CleanShot/QuickTime: system audio + microphone) are mixed into one; otherwise only the
first track (the remote side) would be heard.

Writes OUT (the model's markdown) and OUT with .usage.json (tokens per modality, latency, USD at list).
Measured 2026-10-08, 2-min 480p clip, 11.2k input tokens (video 66/frame at default resolution, audio
25/s): thinking low $0.016/20 s (drops visual steps), medium $0.023/34 s, high $0.03-0.06/95 s.
--ranges with 65 of 120 s shared: video tokens 7.9k -> 4.3k, speech unchanged.
Frames default to media resolution high (~264 tokens/frame, 4x low): on a 4-min Meet demo (2026-10-12) it
read 0.76 of 25 small UI facts where low read 0.08 (0.88 with shrink-video --crop) for 2.4x the cost.
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

from google import genai
from google.genai import types

# IPv4 first, IPv6 as fallback: Python has no happy-eyeballs, so broken IPv6 hangs every call (Oct 2026).
_getaddrinfo = socket.getaddrinfo
socket.getaddrinfo = lambda *a, **k: sorted(_getaddrinfo(*a, **k), key=lambda r: r[0] != socket.AF_INET)

INLINE_MAX = 20 * 1024 * 1024
# Audio-only input (e.g. WhatsApp voice notes from whatsapp-bridge); anything else goes as video/mp4.
AUDIO_MIME = {".ogg": "audio/ogg", ".opus": "audio/ogg", ".m4a": "audio/mp4", ".aac": "audio/aac",
              ".mp3": "audio/mpeg", ".wav": "audio/wav", ".flac": "audio/flac"}
MACHINE_ENV = Path.home() / ".config/transcribe-gemini/env"
# detect-screenshare's frame test, so the upload check and the detector cannot drift apart.
_loader = SourceFileLoader("detect_screenshare", str(Path(__file__).resolve().with_name("detect-screenshare")))
DETECT = module_from_spec(spec_from_loader("detect_screenshare", _loader))
_loader.exec_module(DETECT)
UPLOADED: list[str] = []  # File API names, deleted after the call (otherwise kept 48 h in the key's project)
# USD per 1M tokens (input, output incl. thinking), ai.google.dev/gemini-api/docs/pricing, 2026-10-08.
# 3.7/3.8 Flash list price doubles on 2027-01-01.
PRICES = {"gemini-3.8-flash": (0.75, 3.75), "gemini-3.7-flash": (0.75, 3.75), "gemini-3.1-pro-preview": (2.00, 12.00)}


def clock(seconds: float) -> str:
    seconds = int(seconds)
    return f"{seconds // 3600:02d}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"


def machine_key() -> str | None:
    if MACHINE_ENV.exists():
        for line in MACHINE_ENV.read_text().splitlines():
            if line.startswith("VIDEO_GEMINI_API_KEY="):
                return line.split("=", 1)[1].strip().strip("'\"") or None
    return None


def client_and_backend() -> tuple[genai.Client, str]:
    key = os.environ.get("VIDEO_GEMINI_API_KEY") or machine_key() or os.environ.get("GEMINI_API_KEY")
    if key:
        # vertexai=False: GOOGLE_GENAI_USE_VERTEXAI=true in the env would otherwise silently route to Vertex.
        return genai.Client(api_key=key, vertexai=False), "developer-api"
    if os.environ.get("GOOGLE_CLOUD_PROJECT"):
        location = os.environ.get("GOOGLE_CLOUD_LOCATION", "global")
        return genai.Client(vertexai=True, project=os.environ["GOOGLE_CLOUD_PROJECT"], location=location), f"vertex/{location}"
    sys.exit(f"no Gemini key: write VIDEO_GEMINI_API_KEY=... to {MACHINE_ENV} (chmod 600), or set GEMINI_API_KEY / "
             "GOOGLE_CLOUD_PROJECT + credentials (Vertex)")


def media_part(client: genai.Client, backend: str, path: Path, mime: str) -> types.Part:
    # Developer API: File API above 20 MB. Vertex: inline (38 MB accepted 2026-10-08); its own limit errors.
    if backend != "developer-api" or path.stat().st_size <= INLINE_MAX:
        return types.Part.from_bytes(data=path.read_bytes(), mime_type=mime)
    uploaded = client.files.upload(file=path, config={"mime_type": mime})
    UPLOADED.append(uploaded.name)
    while uploaded.state and uploaded.state.name == "PROCESSING":
        time.sleep(3)
        uploaded = client.files.get(name=uploaded.name)
    if uploaded.state and uploaded.state.name == "FAILED":
        sys.exit(f"File API processing failed for {path}")
    return types.Part.from_uri(file_uri=uploaded.uri, mime_type=mime)


def ffmpeg(*args: str) -> None:
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *args], check=True)


def audio_streams(video: Path) -> int:
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "a", "-show_entries", "stream=index",
                          "-of", "csv=p=0", str(video)], capture_output=True, text=True).stdout
    return len(out.split())


def audio_args(video: Path) -> list[str]:
    """ffmpeg output args for one mono speech track: all input audio tracks mixed (local + remote side)."""
    n = audio_streams(video)
    if n <= 1:
        return ["-map", "0:a:0?", "-ac", "1"]
    inputs = "".join(f"[0:a:{i}]" for i in range(n))
    # normalize=0: amix would otherwise divide every track by n, and the remote side is already quiet.
    return ["-filter_complex", f"{inputs}amix=inputs={n}:duration=longest:normalize=0[a]", "-map", "[a]", "-ac", "1"]


def mixed_copy(video: Path, tmp: Path) -> Path:
    """The video itself, or a copy whose several audio tracks are mixed into one (video stream copied)."""
    if audio_streams(video) <= 1:
        return video
    out = tmp / f"mixed{video.suffix or '.mp4'}"
    ffmpeg("-i", str(video), "-map", "0:v?", "-c:v", "copy", *audio_args(video), "-c:a", "aac", "-b:a", "48k", str(out))
    return out


def blank_webcam_frames(clip: Path) -> int:
    """Black out every 1 fps frame of a desktop clip that the desktop rule does not call a screen (webcams, dimmed
    webcams, uncertain): a gallery flashed between the detector's samples never reaches the upload. Returns frames blanked."""
    import numpy as np

    w, h = DETECT.W, DETECT.H
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", str(clip), "-vf", f"scale={w}:{h}", "-f", "rawvideo",
                          "-pix_fmt", "rgb24", "pipe:"], check=True, capture_output=True).stdout
    frames = np.frombuffer(raw, np.uint8).reshape(-1, h, w, 3)
    bad = [k for k, f in enumerate(frames) if not DETECT.screen_frame(f)]
    if bad:
        enable = "+".join(f"between(n,{k},{k})" for k in bad)
        fixed = clip.with_name(clip.stem + ".checked.mp4")
        ffmpeg("-i", str(clip), "-vf", f"drawbox=x=0:y=0:w=iw:h=ih:color=black:t=fill:enable='{enable}'", "-c:v", "libx264",
               "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", str(fixed))
        fixed.replace(clip)
        print(f"{clip.name}: blanked {len(bad)} non-screen frame(s)", file=sys.stderr)
    return len(bad)


def ranged_parts(client: genai.Client, backend: str, video: Path, ranges: list[dict], tmp: Path,
                 checked: bool = False) -> list:
    """Full audio track + one silent clip per range, cut locally and labelled with its absolute time."""
    parts = ["The recording has no audio track."]
    if audio_streams(video):
        audio = tmp / "audio.m4a"
        ffmpeg("-i", str(video), "-vn", *audio_args(video), "-c:a", "aac", "-b:a", "48k", str(audio))
        parts = ["Full audio of the recording follows. Its timeline is the recording timeline.",
                 media_part(client, backend, audio, "audio/mp4")]
    parts += ["Video was sent only for these ranges (screen sharing). Outside them there is audio only: "
             "do not describe visuals there." if ranges else "No screen was detected: audio only, no visual section."]
    for i, r in enumerate(ranges):
        # Re-encoded, not stream-copied: a copy starts at the previous keyframe and would carry webcam frames.
        # 1 fps = Gemini's sampling; desktop clips then get every frame checked (detection samples only 1/s).
        clip = tmp / f"clip{i:02d}.mp4"
        ffmpeg("-ss", f"{r['start']:.2f}", "-i", str(video), "-t", f"{r['end'] - r['start']:.2f}", "-an", "-vf", "fps=1",
               "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", str(clip))
        if checked:
            blank_webcam_frames(clip)
        parts.append(f"Video clip {clock(r['start'])}-{clock(r['end'])} (recording timeline; the clip's own "
                     f"timestamps start at 00:00:00: add {clock(r['start'])}).")
        parts.append(media_part(client, backend, clip, "video/mp4"))
    return parts


def provenance_header(video: Path, prompt: Path, model: str, thinking: str, resolution: str, plan: dict,
                      when: str) -> str:
    """Header prepended to the transcript so a downstream agent knows this text already IS the
    audiovisual pass and must not re-run it (the raw vendor ASR beside it says the opposite)."""
    ranges = plan.get("ranges") or []
    frames = ("none, audio file" if video.suffix.lower() in AUDIO_MIME
              else f"{len(ranges)} screen-share ranges" if plan.get("method") != "full-fallback" and ranges
              else "whole video")
    return "\n".join([
        "<!-- provenance: Gemini audiovisual pass -->",
        # The verifier replaces "none yet" with `Checked: <times → frame/whisper paths>; corrections applied; gaps: …`.
        f"- Gemini draft of: {video.resolve()} (frames: {frames}; audio throughout). Verification: none yet.",
        f"- Pass: {model} · thinking {thinking} · media resolution {resolution} · {when}",
        f"- Prompt (speakers, vocabulary, context files): {prompt.resolve()}",
        "- Work from this text. Do not re-run the video pass; re-open the video only to check one timestamp "
        "(source frames via video-frames-for-vision).",
        "", ""])


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("video", type=Path, help="<name>.gemini.mp4 from shrink-video (any video/audio ffmpeg reads)")
    parser.add_argument("--prompt", type=Path, required=True, help="session.gemini-prompt.md from build-prompt")
    parser.add_argument("--out", type=Path, help="default <video stem>.transcript.md beside the video")
    parser.add_argument("--model", default="gemini-3.8-flash")
    parser.add_argument("--thinking", default="medium", choices=["minimal", "low", "medium", "high"])
    parser.add_argument("--media-resolution", choices=["low", "medium", "high"], default="high",
                        help="high (default, ~264 tokens/frame) reads screen text; low/medium (66) cost 4x less "
                             "video tokens but invent most small text: only for long videos where the screen doesn't matter")
    parser.add_argument("--ranges", type=Path, help="JSON with ranges [{start,end}] that get frames; audio covers all")
    parser.add_argument("--dry-run", type=Path, metavar="DIR",
                        help="write exactly what would be uploaded (audio.m4a, clipNN.mp4) to DIR and stop: no key, no call")
    args = parser.parse_args()

    if args.dry_run:  # inspect the payload (faces?) before paying for it
        args.dry_run.mkdir(parents=True, exist_ok=True)
        plan = json.loads(args.ranges.read_text()) if args.ranges else {"method": "full-fallback"}
        if plan.get("method") == "full-fallback":
            sys.exit("dry run: no --ranges (or full-fallback): the whole video would be sent")
        ranged_parts(None, "dry-run", args.video, plan["ranges"], args.dry_run, plan.get("method") == "desktop")
        for f in sorted(args.dry_run.glob("*.m4a")) + sorted(args.dry_run.glob("clip*.mp4")):
            print(f"{f}  {f.stat().st_size} bytes")
        return

    # meeting.gemini.part01.mp4 -> meeting.part01.transcript.md: keep version/part suffixes distinct.
    out = args.out or args.video.with_name(args.video.stem.replace(".gemini", "", 1) + ".transcript.md")
    client, backend = client_and_backend()
    prompt = args.prompt.read_text(encoding="utf-8")
    config = types.GenerateContentConfig(
        thinking_config=types.ThinkingConfig(thinking_level=args.thinking),
        # The reply is the file (agent routes get their file-writing instructions from agy-route.md, not the template).
        system_instruction="Reply with the complete markdown document itself.")
    config.media_resolution = f"MEDIA_RESOLUTION_{args.media_resolution.upper()}"

    with tempfile.TemporaryDirectory() as tmp:
        try:
            plan = json.loads(args.ranges.read_text()) if args.ranges else {"method": "full-fallback"}
            if plan.get("method") != "full-fallback":  # detect-screenshare could not tell: send every frame
                parts = ranged_parts(client, backend, args.video, plan["ranges"], Path(tmp), plan.get("method") == "desktop")
            else:
                mime = AUDIO_MIME.get(args.video.suffix.lower(), "video/mp4")
                parts = [media_part(client, backend, mixed_copy(args.video, Path(tmp)), mime)]
            started = time.time()
            for attempt in range(3):
                try:
                    response = client.models.generate_content(model=args.model, contents=[*parts, prompt], config=config)
                    break
                except genai.errors.ServerError as error:  # 5xx: retry; 4xx (quota, auth, bad request) fails fast
                    if attempt == 2:
                        raise
                    print(f"retrying after {error.code}", file=sys.stderr)
                    time.sleep(10 * (attempt + 1))
        finally:
            for name in UPLOADED:  # best effort: a failed delete must not lose the paid output
                try:
                    client.files.delete(name=name)
                except Exception as error:
                    print(f"warning: could not delete {name} (expires in 48 h): {error}", file=sys.stderr)
    elapsed = round(time.time() - started, 1)

    text = response.text or ""
    if not text.strip():
        sys.exit(f"empty response (finish reason {response.candidates[0].finish_reason if response.candidates else '?'})")
    header = provenance_header(args.video, args.prompt, response.model_version or args.model, args.thinking,
                               args.media_resolution, plan, time.strftime("%Y-%m-%d %H:%M %Z"))
    out.write_text(header + text, encoding="utf-8")
    usage = response.usage_metadata
    output_tokens = (usage.candidates_token_count or 0) + (usage.thoughts_token_count or 0)
    price = PRICES.get(args.model)
    report = {
        "model": response.model_version or args.model, "backend": backend, "elapsed_s": elapsed,
        "input_tokens": usage.prompt_token_count,
        "input_by_modality": {d.modality.name: d.token_count for d in usage.prompt_tokens_details or []},
        "output_tokens": usage.candidates_token_count, "thinking_tokens": usage.thoughts_token_count,
        "usd_at_list": round(usage.prompt_token_count * price[0] / 1e6 + output_tokens * price[1] / 1e6, 4) if price else None,
    }
    out.with_suffix(".usage.json").write_text(json.dumps(report, indent=2) + "\n")
    print(f"{out}: {len(text.split())} words · {usage.prompt_token_count} in / {output_tokens} out · "
          f"{elapsed}s · ${report['usd_at_list']} ({backend})")


if __name__ == "__main__":
    main()
