#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
install_dir="${HOME}/.local/bin"
if [[ "${1:-}" == "--check" ]]; then
  for dependency in ffmpeg ffprobe uv yt-dlp; do
    command -v "$dependency" >/dev/null || { echo "missing $dependency; install this prerequisite with your package manager, then rerun scripts/install --check" >&2; exit 1; }
    echo "ok      $dependency ($(command -v "$dependency"))"
  done
  # mlx_whisper only powers the optional local ASR route; absence must not fail readiness.
  if command -v mlx_whisper >/dev/null; then
    echo "ok      mlx_whisper ($(command -v mlx_whisper))"
  else
    echo "warn    mlx_whisper missing (optional; uv tool install mlx-whisper)"
  fi
  for helper in shrink-video build-prompt download-fathom transcribe-local scene-frames; do
    [[ "$(readlink -f "$install_dir/$helper")" == "$script_dir/$helper" ]] || { echo "missing or stale $helper; run $script_dir/install" >&2; exit 1; }
    echo "ok      $helper"
  done
  exit 0
fi
[[ $# == 0 ]] || { echo 'Usage: install [--check]' >&2; exit 2; }
mkdir -p "$install_dir"
for helper in shrink-video build-prompt download-fathom transcribe-local scene-frames; do
  ln -sfn "$script_dir/$helper" "$install_dir/$helper"
  echo "installed $install_dir/$helper"
done
