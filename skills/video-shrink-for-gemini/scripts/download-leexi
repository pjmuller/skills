#!/usr/bin/env -S uv run python
"""Retrieve a Leexi call transcript, summary and follow-up tasks, and optionally its recording."""
import argparse
from base64 import b64encode
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
from urllib.parse import urlparse
from urllib.request import Request, urlopen

API = "https://public-api.leexi.ai/v1"
# Leexi's edge returns 403 for Python's default User-Agent; any descriptive agent passes.
HEADERS = {"User-Agent": "download-leexi/1.0", "Accept": "application/json"}
UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


def call_uuid(target):
    parsed = urlparse(target)
    if parsed.scheme and parsed.hostname != "app.leexi.ai":
        raise ValueError("Expected an https://app.leexi.ai call URL or a bare call UUID")
    match = UUID.search(target)
    if not match:
        raise ValueError("No call UUID found in the argument")
    return match[0].lower()


def auth_header():
    key_id, secret = os.environ.get("LEEXI_KEY_ID", "").strip(), os.environ.get("LEEXI_KEY_SECRET", "").strip()
    if not key_id or not secret:
        raise ValueError("LEEXI_KEY_ID / LEEXI_KEY_SECRET missing; load the project's existing Leexi environment")
    return "Basic " + b64encode(f"{key_id}:{secret}".encode()).decode()


def fetch_call(uuid):
    request = Request(f"{API}/calls/{uuid}", headers={**HEADERS, "Authorization": auth_header()})
    with urlopen(request, timeout=60) as response:
        payload = json.load(response)
    return payload.get("data", payload)


def clock(seconds):
    total = int(float(seconds or 0))
    hours, rest = divmod(total, 3600)
    minutes, secs = divmod(rest, 60)
    return f"{hours}:{minutes:02d}:{secs:02d}" if hours else f"{minutes:02d}:{secs:02d}"


def render(call, source_url):
    speakers = {s.get("index"): s.get("name") or f"Speaker {s.get('index')}" for s in call.get("speakers") or []}
    lines = [f"# Leexi transcript: {call.get('title') or call.get('uuid')}", "",
             f"Source: {source_url}", f"Performed: {call.get('performed_at', '')} · duration {clock(call.get('duration'))} · locale {call.get('locale', '')}",
             "Raw Leexi ASR with Leexi speaker attribution; not verified against audio or video. "
             "Summary and tasks below are Leexi's own generated notes, not evidence.", ""]
    if call.get("summary"):
        lines += ["## Leexi summary", "", call["summary"].strip(), ""]
    tasks = [t for t in call.get("tasks") or [] if t.get("active", True)]
    if tasks:
        lines += ["## Leexi follow-up tasks", ""]
        lines += [f"- {t.get('subject', '').strip()} — {(t.get('owner') or {}).get('name', 'unassigned')}" + (f": {t['description'].strip()}" if t.get("description") else "") for t in tasks]
        lines.append("")
    lines += ["## Transcript", ""]
    paragraphs = call.get("transcript") or []
    for para in paragraphs:
        words = " ".join((item.get("content") or "").strip() for item in para.get("items") or []).strip()
        lines += [f"{clock(para.get('start_time'))} {speakers.get(para.get('speaker_index'), 'Speaker ?')}: {words}", ""]
    if not paragraphs:
        lines += [(call.get("simple_transcript") or "").strip() or "_(transcript unavailable)_", ""]
    return "\n".join(lines).rstrip() + "\n"


def download(url, target):
    with urlopen(Request(url, headers={"User-Agent": HEADERS["User-Agent"]}), timeout=120) as response, open(target, "wb") as handle:
        shutil.copyfileobj(response, handle, 1 << 20)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", help="https://app.leexi.ai/.../calls/UUID or bare UUID")
    parser.add_argument("--out", type=Path, required=True, help="Private output directory; must be ignored when inside git")
    parser.add_argument("--resolve-only", action="store_true", help="Save call metadata without transcript or media")
    parser.add_argument("--transcript-only", action="store_true", help="Save raw call JSON and readable Markdown; no media download")
    args = parser.parse_args()
    out = args.out.expanduser().resolve()
    os.umask(0o077)
    out.mkdir(mode=0o700, parents=True, exist_ok=True)
    in_git = subprocess.run(["git", "rev-parse", "--git-dir"], cwd=out, capture_output=True).returncode == 0
    if in_git and subprocess.run(["git", "check-ignore", "-q", str(out / "source.json")], cwd=out).returncode:
        parser.error("Output must be git-ignored; add the run directory to .gitignore or info/exclude first")
    try:
        uuid = call_uuid(args.target)
        call = fetch_call(uuid)
        recording = call.get("recording_url") or ""
        source = {"source_url": args.target, "uuid": uuid, "leexi_url": call.get("leexi_url"), "title": call.get("title"),
                  "performed_at": call.get("performed_at"), "duration_seconds": float(call.get("duration") or 0),
                  "locale": call.get("locale"), "is_video": call.get("is_video"), "has_recording_url": bool(recording),
                  "speakers": [s.get("name") for s in call.get("speakers") or []]}
        (out / "source.json").write_text(json.dumps(source, indent=2, ensure_ascii=False) + "\n")
        if args.resolve_only:
            print(f"Saved call metadata in {out}")
            return
        (out / "leexi-call.json").write_text(json.dumps(call, indent=2, ensure_ascii=False) + "\n")
        (out / "transcript.md").write_text(render(call, args.target))
        if not args.transcript_only:
            if not recording:
                raise ValueError("Leexi returned no recording_url (archived or audio-less call); transcript saved")
            ext = Path(urlparse(recording).path).suffix.lstrip(".") or "webm"
            target = out / f"source.{ext}"
            if not target.exists():
                download(recording, target)
        print(f"Saved Leexi artifacts in {out}")
    except (ValueError, OSError) as exc:
        parser.exit(1, f"Leexi download failed: {exc}\n")


if __name__ == "__main__":
    main()
