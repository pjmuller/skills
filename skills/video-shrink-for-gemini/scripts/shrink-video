#!/usr/bin/env bash
# Shrink a screen recording so Gemini swallows it whole while speech stays transcribable.
# Usage: shrink-video [--preset normal|heavy|extreme] [--out DIR] FILE...
#   FILE may be a bare name; it is looked up in ~/screenshots and ~/Downloads.
# Output: <name>.gemini.mp4 next to the source (or in --out DIR).
set -euo pipefail

preset=normal; outdir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --preset) preset=$2; shift 2 ;;
    --out) outdir=$2; shift 2 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[[ $# -gt 0 ]] || { echo "no input files" >&2; exit 1; }

# fps / width / crf per preset. Audio is identical everywhere: speech is the payload.
# Width is a *cap*: never upscale, and never drop below the source unless the preset says so —
# on-screen text must stay readable. Bytes are cheap (Gemini takes 2 GB/file); tokens are not.
case "$preset" in
  normal)  fps=0.5;  width=1280; crf=24 ;;  # code/UI/slides matter: 1 frame / 2 s, near-source quality
  heavy)   fps=0.25; width=1280; crf=26 ;;  # talking + occasional screen: 1 frame / 4 s
  extreme) fps=0.2;  width=854;  crf=30 ;;  # picture only for orientation
  *) echo "unknown preset: $preset" >&2; exit 1 ;;
esac

resolve() {
  local f=$1
  [[ -f $f ]] && { echo "$f"; return; }
  for d in "$HOME/screenshots" "$HOME/Downloads"; do
    [[ -f "$d/$f" ]] && { echo "$d/$f"; return; }
  done
  echo "not found: $f" >&2; return 1
}

for arg in "$@"; do
  in=$(resolve "$arg")
  base=$(basename "${in%.*}")
  dir=${outdir:-$(dirname "$in")}
  out="$dir/$base.gemini.mp4"
  echo "→ $in  [$preset: ${fps}fps ${width}w crf$crf]"
  ffmpeg -hide_banner -loglevel error -stats -y \
    -hwaccel videotoolbox -i "$in" \
    -vf "fps=$fps,scale='min($width,iw)':-2:flags=lanczos" \
    -c:v libx264 -preset veryfast -tune stillimage -crf "$crf" -pix_fmt yuv420p \
    -g 60 -movflags +faststart \
    -ac 1 -ar 16000 -c:a aac -b:a 48k \
    "$out"
  printf '   %s → %s  (%s)\n' "$(du -h "$in" | cut -f1)" "$(du -h "$out" | cut -f1)" "$out"
done
