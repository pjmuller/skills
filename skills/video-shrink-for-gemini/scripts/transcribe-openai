#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests>=2.32"]
# ///
"""Second-opinion speech transcript through OpenAI's transcription API (no local models).

Two modes, one output shape (`seconds speaker: verbatim text`, one line per turn):

  align  --align leexi-call.json   cut the audio per vendor paragraph, transcribe each with a
                                   vocabulary hint and the previous turn as context; keep the vendor's
                                   speakers and timestamps, take OpenAI's words. Best quality.
  chunk  (default)                 fixed --chunk-seconds windows; speakers unknown ("?") unless
                                   --diarize (gpt-4o-transcribe-diarize: speakers A/B, no hint allowed).

Needs OPENAI_API_KEY and ffmpeg. Codex CLI cannot read audio itself (verified 2026-09-25), so this
runs as a tool from the agent. Measured on Flemish meeting audio: gpt-transcribe + a 20-word hint
fixed Leexi's product-name errors (Klink→ClickDoc, Dent. admin→DentAdmin, Denti een
mintgroep→Dentius en Mint Groep); rare names still fail (Digora→"die Nora"). gpt-audio chat models
produced fluent but partly invented lines and speaker swaps: never use them as the speech layer.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import requests

API = "https://api.openai.com/v1/audio/transcriptions"


def cut(source: Path, start: float, end: float, target: Path) -> Path:
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-ss", f"{start:.2f}", "-to", f"{end:.2f}",
                    "-i", str(source), "-vn", "-ac", "1", "-ar", "16000", "-c:a", "libmp3lame", "-b:a", "48k", str(target)],
                   check=True)
    return target


def transcribe(path: Path, model: str, language: str, prompt: str | None, diarize: bool) -> dict:
    data = {"model": model, "language": language}
    if diarize:
        data.update(response_format="diarized_json", chunking_strategy="auto")
    else:
        data["response_format"] = "json"
        if prompt:
            data["prompt"] = prompt[-800:]  # the API keeps roughly the last 224 tokens
    for attempt in range(3):
        with open(path, "rb") as handle:
            response = requests.post(API, headers={"Authorization": "Bearer " + os.environ["OPENAI_API_KEY"]},
                                     data=data, files={"file": handle}, timeout=120)
        if response.status_code < 500:
            break
    if response.status_code != 200:
        raise SystemExit(f"OpenAI {response.status_code}: {response.text[:300]}")
    return response.json()


def clock(seconds: float) -> str:
    total = int(seconds)
    return f"{total // 60:02d}:{total % 60:02d}"


def align_turns(call: dict, start: float, end: float) -> list[tuple[float, float, str, str]]:
    """(start, end, speaker, vendor words) per vendor paragraph overlapping [start, end)."""
    speakers = {s.get("index"): s.get("name") or f"Speaker {s.get('index')}" for s in call.get("speakers") or []}
    paras = call.get("transcript") or []
    turns = []
    for i, para in enumerate(paras):
        t0 = float(para.get("start_time") or 0)
        t1 = float(paras[i + 1].get("start_time")) if i + 1 < len(paras) else end
        if t1 <= start or t0 >= end:
            continue
        words = " ".join((item.get("content") or "").strip() for item in para.get("items") or []).strip()
        turns.append((max(t0, start), min(t1, end), speakers.get(para.get("speaker_index"), "Speaker ?"), words))
    return turns


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("media", type=Path, help="audio or video file (ffmpeg extracts the audio)")
    parser.add_argument("--align", type=Path, help="vendor call JSON with transcript paragraphs (Leexi leexi-call.json)")
    parser.add_argument("--hint", default="", help="vocabulary hint: names, products, language variety (≤ 20 words)")
    parser.add_argument("--language", default="nl")
    parser.add_argument("--model", default="gpt-transcribe")
    parser.add_argument("--diarize", action="store_true", help="chunk mode with gpt-4o-transcribe-diarize (speakers, no hint)")
    parser.add_argument("--chunk-seconds", type=float, default=60.0)
    parser.add_argument("--from", dest="start", type=float, default=0.0, help="start second (slice for experiments)")
    parser.add_argument("--to", dest="end", type=float, help="end second")
    parser.add_argument("--workers", type=int, default=6)
    parser.add_argument("--out", type=Path, help="default <media>.openai.md")
    args = parser.parse_args()
    if not os.environ.get("OPENAI_API_KEY"):
        # Enrichment, not a dependency: callers continue on the vendor transcript alone.
        print("skipped: OPENAI_API_KEY not set (second-opinion transcript is optional; continue with the vendor transcript)")
        return
    media = args.media.expanduser().resolve()
    probe = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(media)],
                           check=True, capture_output=True, text=True).stdout.strip()
    end = args.end or float(probe)
    out = args.out or media.with_name(media.stem + ".openai.md")

    if args.align:
        call = json.loads(args.align.read_text(encoding="utf-8"))
        call = call.get("data", call)
        turns = align_turns(call, args.start, end)
        mode = f"aligned to {args.align.name} ({len(turns)} turns)"
    else:
        turns = []
        t = args.start
        while t < end:
            turns.append((t, min(t + args.chunk_seconds, end), "?", ""))
            t += args.chunk_seconds
        mode = f"{args.chunk_seconds:g}s chunks" + (" diarized" if args.diarize else "")
    model = "gpt-4o-transcribe-diarize" if args.diarize else args.model

    lines: list[str] = []
    with tempfile.TemporaryDirectory() as tmp:
        def job(i: int):
            t0, t1, who, _ = turns[i]
            if t1 - t0 < 0.3:
                return []
            clip = cut(media, t0, t1, Path(tmp) / f"{i:05d}.mp3")
            # The previous vendor turn as context steers names and spelling across turn boundaries.
            previous = turns[i - 1][3] if i > 0 else ""
            prompt = (args.hint + " " + previous).strip() or None
            result = transcribe(clip, model, args.language, prompt, args.diarize)
            if args.diarize and "segments" in result:
                return [(t0 + float(s.get("start", 0)), s.get("speaker", "?"), s.get("text", "").strip()) for s in result["segments"]]
            return [(t0, who, (result.get("text") or "").strip())]

        with ThreadPoolExecutor(max_workers=args.workers) as pool:
            results = list(pool.map(job, range(len(turns))))
    for chunk in results:
        for t, who, text in chunk:
            if text:
                lines.append(f"{int(t)} {who}: {text}")

    header = (f"# OpenAI transcript ({model}, {mode})\n\nSource: {media.name}; language {args.language}; "
              f"hint: {args.hint or '-'}\nSecond-opinion ASR, not verified against audio; speakers and timestamps "
              + ("come from the vendor transcript." if args.align else "are approximate.") + "\n\n")
    out.write_text(header + "\n".join(lines) + "\n", encoding="utf-8")
    print(f"{out}: {len(lines)} lines, {clock(args.start)}-{clock(end)}")


if __name__ == "__main__":
    main()
