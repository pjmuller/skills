#!/usr/bin/env bash
# Sample one full-resolution JPEG per scene change, so an image-capable coding agent can read a
# recording without video input. Extract from the ORIGINAL file: shrunk frames lose small text.
# Usage: scene-frames [--threshold 0.1] [--out DIR] FILE
#   FILE may be a bare name; it is looked up in ~/screenshots and ~/Downloads.
# Output: DIR (default <name>.frames/) with <seconds>.jpg + manifest.tsv.
set -euo pipefail

threshold=0.1; outdir=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --threshold) threshold=$2; shift 2 ;;
    --out) outdir=$2; shift 2 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[[ $# == 1 ]] || { echo "usage: scene-frames [--threshold 0.1] [--out DIR] FILE" >&2; exit 1; }

resolve() {
  local f=$1
  [[ -f $f ]] && { echo "$f"; return; }
  for d in "$HOME/screenshots" "$HOME/Downloads"; do
    [[ -f "$d/$f" ]] && { echo "$d/$f"; return; }
  done
  echo "not found: $f" >&2; return 1
}

in=$(resolve "$1")
base=$(basename "${in%.*}")
dir=${outdir:-"$(dirname "$in")/$base.frames"}
mkdir -p "$dir"

size=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$in" | head -1)
w=${size%x*}; h=${size#*x}
[[ -n $w && -n $h ]] || { echo "no video stream in $in" >&2; exit 1; }

# One showinfo pass collects scene-change times; seeking per timestamp then yields untouched
# original-resolution stills (a single filtergraph pass would re-time and rename them).
times=$( { ffmpeg -hide_banner -nostats -i "$in" \
    -vf "select='gt(scene,$threshold)',showinfo" -an -f null - 2>&1 || true; } \
  | sed -n 's/.*pts_time:\([0-9.]*\).*/\1/p' )

seconds=$(printf '0\n%s\n' "$times" | awk 'NF { printf "%d\n", $1 + 0.5 }' | sort -n -u)

: > "$dir/manifest.tsv"
count=0
for s in $seconds; do
  name=$(printf '%05d.jpg' "$s")
  ffmpeg -hide_banner -loglevel error -y -ss "$s" -i "$in" -frames:v 1 -q:v 3 "$dir/$name"
  printf '%s\t%s\n' "$s" "$name" >> "$dir/manifest.tsv"
  count=$((count + 1))
done

# Claude counts an image as roughly (width/28)*(height/28) tokens; 1280x720 ≈ 1196 per frame.
per=$(( ((w + 27) / 28) * ((h + 27) / 28) ))
printf '%s: %d frames at %dx%d (threshold %s)\n' "$dir" "$count" "$w" "$h" "$threshold"
printf 'estimated Claude visual cost: %d x %d = %d tokens (estimate, excludes prompt/system overhead)\n' \
  "$count" "$per" "$((count * per))"
