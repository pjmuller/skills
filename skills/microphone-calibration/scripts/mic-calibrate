#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Find the best input gain for a microphone: the same sentence at several gains, measured and transcribed.

  devices                     list inputs: channels, settable gain, current gain
  gain [--device D] [VALUE]   read or set input gain (0.0-1.0)
  run [--device D] ...        one take per --levels (a beep, then speech; ends when the speaker stops),
                              then optional --knob takes at the picked gain (Enter between: the speaker
                              turns the hardware knob), then report.md. Original gain restored unless
                              --apply-recommended. --keep-gain: no gain sweep. Without a TTY (agents)
                              the capture opens in Terminal.app; the speaker presses Enter to start
  capture SESSION_DIR         the recording half of run (what the Terminal window executes)
  report SESSION_DIR          re-analyse an existing session (metrics, STT, recommendation)
  restore SESSION_DIR         put back the gain saved in session.json (after a killed run)

Device: --device > MIC_DEVICE_NAME > system default input (case-insensitive substring of the name).
macOS only (CoreAudio, avfoundation). STT: `transcribe-local` (video-shrink-for-gemini) when on PATH.
"""
from __future__ import annotations

import argparse
import array
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import analysis  # noqa: E402

DEFAULT_LEVELS = "0.25,0.5,0.75,1.0"
DEFAULT_SENTENCE = "The quick brown fox jumps over the lazy dog, then naps in the warm sun."
# One beep (start, length) at the analysis' beep tone, so takes exclude it. A tuple: more beeps would
# stay in rhythm because one player call plays them all (afplay starts 0.4-1.2 s late).
COUNTDOWN = ((0.0, 0.2),)
PLAYER_SLACK = 1.5    # worst afplay start latency
LIVE_RATE = 16000     # the speech-end detector's copy of the stream; the WAV keeps the native format
SETTLE_SECONDS = 0.3
START_TIMEOUT = 8.0   # seconds without audio before a take fails
ENTER_TIMEOUT = 900
KNOB_PROMPT_SECONDS = 120  # per knob take: time to turn the knob and press Enter
CANCEL_FILE = "cancel"  # written by the agent side when it stops waiting; checked before every take


def fail(message: str, code: int = 1):
    print(f"mic-calibrate: {message}", file=sys.stderr)
    raise SystemExit(code)


def coreaudio():
    if sys.platform != "darwin":
        fail("macOS only (CoreAudio input gain, avfoundation capture)")
    import coreaudio as module
    return module


def resolve_device(wanted: str | None):
    ca = coreaudio()
    wanted = (wanted or os.environ.get("MIC_DEVICE_NAME") or "").strip()
    if not wanted:
        return ca.default_input()
    devices = ca.input_devices()
    exact = [d for d in devices if d.name.lower() == wanted.lower()]
    matches = exact or [d for d in devices if wanted.lower() in d.name.lower()]
    if len(matches) == 1:
        return matches[0]
    listing = "\n".join(f"  - {d.name}" for d in devices) or "  (none)"
    fail(f"{'ambiguous' if matches else 'no'} input device matching {wanted!r}; inputs:\n{listing}")


def ffmpeg_index(name: str) -> str:
    listing = subprocess.run(["ffmpeg", "-hide_banner", "-f", "avfoundation", "-list_devices", "true", "-i", ""],
                             capture_output=True, text=True).stderr
    audio = listing.split("AVFoundation audio devices:", 1)[-1]
    found = [index for index, label in re.findall(r"\] \[(\d+)\] (.+)", audio) if label.strip() == name]
    if len(found) != 1:
        fail(f"avfoundation lists {len(found)} audio devices named {name!r}:\n{audio.strip()}")
    return found[0]


def write_json(path: Path, data: dict) -> None:
    # Atomic: the agent side polls session.json while the Terminal side writes it.
    partial = path.with_suffix(".partial")
    partial.write_text(json.dumps(data, indent=2) + "\n")
    partial.replace(path)


def stop(process: subprocess.Popen, drain=None) -> None:
    """SIGINT lets ffmpeg finish the WAV header; keep draining its pipe so it never blocks on a write."""
    if process.poll() is None:
        process.send_signal(signal.SIGINT)
        deadline = time.monotonic() + 5
        while process.poll() is None and time.monotonic() < deadline:
            if drain is not None and select.select([drain], [], [], 0.1)[0]:
                os.read(drain, 65536)
            else:
                time.sleep(0.05)
        if process.poll() is None:
            process.kill()
            process.wait()


def record_take(index: str, path: Path, countdown: Path, max_seconds: float) -> dict:
    """Beep, then speech; ends 0.8 s after the speaker stops, or max_seconds after the beep."""
    command = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y", "-f", "avfoundation",
               "-i", f":{index}", "-t", f"{PLAYER_SLACK + COUNTDOWN[-1][0] + max_seconds + 2:.2f}",
               "-map", "0:a", "-c:a", "pcm_s24le", str(path),
               "-map", "0:a", "-ac", "1", "-ar", str(LIVE_RATE), "-f", "f32le", "-c:a", "pcm_f32le", "pipe:1"]
    errors = tempfile.TemporaryFile()  # a file, not a pipe: reading it never blocks, writing never stalls ffmpeg
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors)
    out, frame = process.stdout.fileno(), int(analysis.FRAME_SECONDS * LIVE_RATE) * 4
    detector, buffer, player, countdown_end, ended = analysis.SpeechEnd(LIVE_RATE), bytearray(), None, None, "limit"
    cancel, started = path.parent / CANCEL_FILE, time.monotonic()
    hard_stop = started + START_TIMEOUT + PLAYER_SLACK + COUNTDOWN[-1][0] + max_seconds + 5  # even if afplay or ffmpeg stall

    def stderr_text() -> str:
        errors.seek(0)
        return errors.read().decode(errors="replace").strip()

    try:
        while True:
            now = time.monotonic()
            if cancel.exists():
                raise KeyboardInterrupt("cancelled by the waiting agent")
            if countdown_end is None and player is not None and player.poll() is not None:
                countdown_end = now
                detector.restart()
            if player is None and now - started > START_TIMEOUT:
                raise RuntimeError(f"capture did not start: {stderr_text() or 'no audio from the device'}")
            if (countdown_end is not None and now - countdown_end > max_seconds) or now > hard_stop:
                break
            if not select.select([out], [], [], 0.2)[0]:
                continue
            chunk = os.read(out, 65536)
            if not chunk:
                break  # ffmpeg reached its -t limit
            if player is None:  # samples flowing = capture running: start the countdown
                player = subprocess.Popen(["afplay", str(countdown)])
            buffer += chunk
            while len(buffer) >= frame:
                detector.feed(array.array("f", bytes(buffer[:frame])))
                del buffer[:frame]
            if countdown_end is not None and detector.finished:
                ended = "speaker stopped"
                break
    finally:
        if player is not None and player.poll() is None:
            player.kill()
        stop(process, out)
    if process.returncode not in (0, 255, -signal.SIGINT):  # 255: ffmpeg's exit code after SIGINT
        raise RuntimeError(f"ffmpeg failed ({process.returncode}): {stderr_text()}")
    return {"ended": ended, "speech_seconds_live": round(detector.speech, 2)}


def make_countdown(path: Path) -> None:
    beeps = "+".join(f"between(t\\,{start}\\,{start + length})" for start, length in COUNTDOWN)  # lavfi: escaped commas
    length = COUNTDOWN[-1][0] + COUNTDOWN[-1][1]
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i",
                    f"aevalsrc=0.5*sin(2*PI*{analysis.BEEP_HZ:.0f}*t)*({beeps}):s=48000:d={length}", str(path)],
                   check=True)


def interrupted(signum, _frame):
    raise KeyboardInterrupt(f"signal {signum}")


def gain_pick(folder: Path, takes: list[dict]):
    """Between the phases: pick from the gain takes by levels alone (no STT yet)."""
    measured = [{**take, "metrics": analysis.measure(*analysis.read_wav(folder / take["file"])), "wer": None}
                for take in takes]
    return analysis.recommend(measured)


def record_session(device, session: dict, folder: Path, record, ask=lambda _text: "") -> None:
    """record(path) → take fields; ask(prompt) → typed line, None cancels, "r" redoes the previous knob
    take (a slip). Gain phase, then knob phase at the picked gain. The original gain comes back whatever
    happens, unless the session keeps the pick."""
    levels, knob = session["levels"], session.get("knob") or []
    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGTERM, signal.SIGHUP)}
    if levels and device.gain_supported:
        session["original_gains"] = {str(k): v for k, v in device.gains().items()}
        session["original_gain"] = round(device.gain(), 4)
    session["status"] = "recording"
    write_json(folder / "session.json", session)
    steps = [("gain", level) for level in levels] + [(session.get("knob_phase", "knob"), label) for label in knob]
    keep = False
    try:
        number, confirmed = 0, not (steps and steps[-1][0] == "knob")
        while number < len(steps) or not confirmed:
            redo = f"  ·  r Enter: redo take {number}" if number and steps[number - 1][0] == "knob" else ""
            if number == len(steps):  # after the last knob take: one chance to redo it
                if (answer := ask(f"Done? Enter{redo}")) is None:
                    raise KeyboardInterrupt("cancelled during the knob takes")
                if answer.lower() == "r":
                    (folder / session["takes"].pop()["file"]).unlink(missing_ok=True)
                    write_json(folder / "session.json", session)
                    number -= 1
                else:
                    confirmed = True
                continue
            phase, setting = steps[number]
            number += 1
            if (folder / CANCEL_FILE).exists():
                raise KeyboardInterrupt("cancelled by the waiting agent")
            if phase != "gain" and number == len(levels) + 1 and levels:
                pick = gain_pick(folder, [t for t in session["takes"] if t["phase"] == "gain"])
                if pick.take:
                    device.set_gain(pick.setting)
                session["gain_pick"] = pick.setting
                print(f"\nGain sweep done: {'gain ' + format(pick.setting, '.2f') if pick.take else pick.reason}"
                      " stays set for the next takes.")
            if phase == "knob":
                answer = ask(f"Take {number - len(levels)}/{len(knob)}: {setting}, then Enter{redo}")
                if answer is None:
                    raise KeyboardInterrupt("cancelled during the knob takes")
                if answer.lower() == "r" and redo:
                    (folder / session["takes"].pop()["file"]).unlink(missing_ok=True)
                    write_json(folder / "session.json", session)
                    number -= 2
                    continue
            take = {"index": number, "phase": phase}
            if phase == "gain":
                take["gain"] = round(device.set_gain(setting), 4)
                take["setting"] = take["gain"]
                time.sleep(SETTLE_SECONDS)
            else:
                take["gain"] = round(device.gain(), 4) if device.gain_supported else None
                take["setting"] = setting
            take["gain_db"] = device.gain_db() if device.gain_supported else None
            slug = re.sub(r"[^a-z0-9]+", "", str(setting).lower().replace("-", "minus").replace("+", "plus"))
            take["file"] = f"take-{number}-{phase}-{slug or 'asis'}.wav"
            print(f"take {number}/{len(steps)}  {phase} {setting}", flush=True)
            take.update(record(folder / take["file"]))
            session["takes"].append(take)
            write_json(folder / "session.json", session)
        session["status"] = "recorded"
        keep = session.get("keep_pick") and session.get("gain_pick") is not None
    except BaseException as error:
        session["status"] = f"interrupted: {str(error) or type(error).__name__}"
        raise
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        if session.get("original_gains") and not keep:
            device.set_gains({int(k): v for k, v in session["original_gains"].items()})
            session["restored_gain"] = round(device.gain(), 4)
            print(f"restored gain {session['restored_gain']}", flush=True)
        elif keep:
            print(f"gain left at the pick {session['gain_pick']:.2f}", flush=True)
        write_json(folder / "session.json", session)


def wait_for_enter(deadline: float, cancel: Path, prompt: str = "Press Enter to start") -> str | None:
    """The typed line ("" for plain Enter); None at the deadline (wall clock) or on the agent's cancel."""
    print(f"{prompt} (Ctrl-C cancels; gives up at {datetime.fromtimestamp(deadline):%H:%M}) ", end="", flush=True)
    while time.time() < deadline and not cancel.exists():
        ready, _, _ = select.select([sys.stdin], [], [], 1)
        if ready:
            return sys.stdin.readline().strip()
    return None


def capture(folder: Path, confirm: bool) -> dict:
    """The recording half; runs where the microphone is allowed (a terminal), never unbounded."""
    session = json.loads((folder / "session.json").read_text())
    device = coreaudio().by_uid(session["device"]["uid"])
    index = ffmpeg_index(device.name)
    levels, knob = session["levels"], session.get("knob") or []
    plan = [f"gains {', '.join(map(str, levels))}"] if levels else []
    if knob:
        plan.append(f"{len(knob)} manual setups, Enter before each" if session.get("knob_phase", "knob") == "knob"
                    else f"{len(knob)} takes at the current level")
    print(f"\n{device.name}: {' then '.join(plan) or 'current level'}.\n"
          f"After the beep, at your normal distance and loudness, say:\n\n    {session['sentence']}\n")
    signal.signal(signal.SIGHUP, interrupted)  # closing the window must not leave the agent waiting
    deadline = session.get("enter_deadline") or time.time() + ENTER_TIMEOUT
    cancel = folder / CANCEL_FILE
    try:
        ready = not confirm or wait_for_enter(deadline, cancel) is not None
    except KeyboardInterrupt:
        ready = False
    if not ready:
        session["status"] = "cancelled before recording"
        write_json(folder / "session.json", session)
        fail(session["status"])
    countdown = folder / "countdown.wav"
    make_countdown(countdown)
    try:
        record_session(device, session, folder, lambda path: record_take(index, path, countdown, session["seconds"]),
                       ask=lambda prompt: wait_for_enter(time.time() + KNOB_PROMPT_SECONDS, cancel, prompt))
    except KeyboardInterrupt:
        fail(f"interrupted; partial session in {folder}", 130)
    except RuntimeError as error:
        fail(f"{error}; partial session in {folder}")
    finally:
        countdown.unlink(missing_ok=True)
    return session


def capture_in_terminal(folder: Path, enter_window: float, reserve: float, step: float) -> dict:
    """Agent shells have no TTY, and their host app may lack microphone access (silent zeros): the
    capture runs in a Terminal.app window where the speaker presses Enter when ready. This side waits
    for the Enter window plus the planned session (`reserve`), and `step` past every session.json
    write: redos add takes, so it never gives up on a capture that is still progressing."""
    session = json.loads((folder / "session.json").read_text())
    session["enter_deadline"] = time.time() + enter_window
    write_json(folder / "session.json", session)
    wait = enter_window + reserve
    script = folder / "capture.command"
    script.write_text(f"#!/bin/sh\nexec '{sys.executable}' '{Path(__file__).resolve()}' capture '{folder}'\n")
    script.chmod(0o755)
    subprocess.run(["open", "-a", "Terminal", str(script)], check=True)
    print(f"capture window opened in Terminal; waiting up to {wait:.0f}s for the speaker", flush=True)
    deadline = time.time() + wait
    while time.time() < deadline:
        session = json.loads((folder / "session.json").read_text())
        if session.get("status") not in ("ready", "recording"):
            return session
        if session.get("status") == "recording":
            deadline = max(deadline, (folder / "session.json").stat().st_mtime + step)
        time.sleep(1)
    # Never leave a capture running unsupervised: ask it to stop and wait for the gain restore.
    (folder / CANCEL_FILE).touch()
    for _ in range(30):
        session = json.loads((folder / "session.json").read_text())
        if session.get("status") not in ("ready", "recording"):
            fail(f"no result after {wait:.0f}s; capture {session['status']}"
                 + (f", gain restored to {session['restored_gain']}" if "restored_gain" in session else ""), 4)
        time.sleep(1)
    fail(f"capture window unresponsive after cancel; check the gain: mic-calibrate restore {folder}", 4)


def transcribe(folder: Path, files: list[str], language: str | None) -> dict[str, str]:
    helper = shutil.which("transcribe-local")
    if not helper:
        return {}
    out = folder / "stt"
    done = subprocess.run([helper, "--out", str(out), *(["--language", language] if language else []),
                           *[str(folder / name) for name in files]], stdout=subprocess.DEVNULL)
    if done.returncode:
        print(f"transcribe-local failed ({done.returncode}); report without transcripts", file=sys.stderr)
    result = {}
    for name in files:
        text = out / f"{Path(name).stem}.whisper.txt"
        if text.exists():
            result[name] = " ".join(text.read_text().split())
    return result


def row(*cells) -> str:
    return "| " + " | ".join(str(cell) for cell in cells) + " |"


def recommendation_lines(title: str, rec: analysis.Recommendation, unit: str) -> list[str]:
    if rec.take:
        shown = f"{rec.setting:.2f}" if isinstance(rec.setting, float) else rec.setting
        lines = ["> [!IMPORTANT]", f"> {title}: **{unit}{shown}**: {rec.reason}."]
    else:
        lines = ["> [!IMPORTANT]", f"> {title}: none, {rec.reason}."]
    return lines + ([f"> Next: {rec.next_step}."] if rec.next_step else []) + [""]


def report(folder: Path, stt: bool) -> tuple[Path, analysis.Recommendation | None]:
    folder = folder.resolve()
    session = json.loads((folder / "session.json").read_text())
    takes = []
    for take in session["takes"]:
        metrics = analysis.measure(*analysis.read_wav(folder / take["file"]))
        takes.append({"phase": "gain", "setting": take.get("gain"), **take, "metrics": metrics,
                      "wer": None, "transcript": None})
    if stt:
        texts = transcribe(folder, [take["file"] for take in takes], session.get("language"))
        for take in takes:
            if take["file"] in texts:
                take["transcript"] = texts[take["file"]]
                take["wer"] = round(analysis.word_error_rate(session["sentence"], take["transcript"]), 3)
                take["slip"] = analysis.is_slip(session["sentence"], take["transcript"])
    gain_takes = [t for t in takes if t["phase"] == "gain"]
    knob_takes = [t for t in takes if t["phase"] != "gain"]
    rec = analysis.recommend(gain_takes) if gain_takes else None
    knob_rec = analysis.recommend(knob_takes) if knob_takes else None
    warning = analysis.gain_tracking_warning(gain_takes)
    device = session["device"]
    original = session.get("original_gain")

    end = (f"restored {session['restored_gain']}" if session.get("restored_gain") is not None
           else f"left at the pick {session['gain_pick']}" if session.get("gain_pick") is not None else "")
    lines = [f"# Microphone calibration: {device['name']}", "",
             f"{session['started']} · {device['channels']} ch · "
             + (f"original gain {original}" if original is not None else "gain left untouched")
             + (f" ({end})" if end else ""), ""]
    if rec:
        lines += recommendation_lines("Input gain", rec, "")
    if knob_rec:
        at = session.get("gain_pick")
        title = "Manual setup" if knob_takes[0]["phase"] == "knob" else "Best take"
        lines += recommendation_lines(f"{title} (at gain {at})" if at is not None else title, knob_rec, "")
    if knob_rec and knob_takes[0]["phase"] == "knob":
        lines += ["A knob and the software gain multiply: if the manual pick turned the knob, a short gain sweep "
                  "at that knob position confirms the pair.", ""]
    if warning:
        lines += ["> [!WARNING]", f"> {warning}.", ""]
    if takes and all(t["metrics"].peak_dbfs <= -119 for t in takes):
        lines += ["> [!WARNING]", "> Digital silence in every take: microphone permission for this app, "
                  "or a muted device.", ""]
    lines += [row("Take", "Phase", "Setting", "Gain", "Peak dBFS", "Clipped", "Noise dBFS", "Speech dBFS", "SNR dB",
                  "Speech s", "WER", "Verdict"),
              row(*["---"] * 12)]
    for t in takes:
        m = t["metrics"]
        lines.append(row(t["index"], t["phase"], t["setting"], t["gain"] if t["gain"] is not None else "fixed",
                         m.peak_dbfs, m.clipped_samples, m.noise_dbfs, m.speech_dbfs, m.snr_db, m.speech_seconds,
                         (f"{t['wer']:.0%}" + (" (slip?)" if t.get("slip") else "")) if t["wer"] is not None else "–",
                         analysis.verdict(m)))
    lines += ["", "## Listen", ""]
    lines += [f"![take {t['index']} {t['phase']} {t['setting']}]({folder / t['file']})" for t in takes]
    lines += ["", "## Transcripts", "", f"Reference (spoken, never sent to STT): “{session['sentence']}”", ""]
    if any(t["transcript"] is not None for t in takes):
        lines += [f"{t['index']}. {t['phase']} {t['setting']}: “{t['transcript']}”" for t in takes]
        lines += ["", "Local Whisper (`transcribe-local`), same settings per take, no hint. Equal transcripts "
                  "do not mean equal audio; your dictation engine may differ. “slip?” = words only left out, "
                  "likely the speaker: that WER does not rank the take."]
    else:
        lines.append("Not transcribed (`--no-stt`, or `transcribe-local` not on PATH).")
    lines += ["", "<details><summary>Method and limits</summary>", "",
              f"- Noise floor: the quietest {analysis.NOISE_PERCENTILE:.0%} of {analysis.FRAME_SECONDS * 1000:.0f} ms "
              f"frames (waiting, tail); speech: frames more than {analysis.ACTIVE_ABOVE_NOISE_DB:.0f} dB "
              "above it, on the loudest channel; peaks and clipping across all channels; the beep excluded "
              "by its tone.",
              f"- Pick: no clipping, peak ≤ {analysis.HOT_PEAK_DB:.0f} dBFS, SNR within {analysis.SNR_TIE_DB:.0f} dB "
              f"of the best, then peak closest to {analysis.TARGET_PEAK_DB:.0f} dBFS. Only tested settings are "
              "recommended. The knob takes use the gain picked from levels alone (before STT).",
              "- Input gain usually raises voice and room noise together, so SNR barely moves; the main risks are "
              "clipping (too high) and a weak signal (too low). An analog knob before the converter can lift a "
              "quiet signal above converter noise; software gain after it cannot.",
              "- One sentence per setting: louder or softer delivery, distance and onboard AGC shift the numbers. "
              "Not a global optimum; confirm by listening and one dictation at the pick.",
              "- Originals are unnormalized 24-bit WAV; nothing here amplifies after capture.", "", "</details>", ""]
    path = folder / "report.md"
    path.write_text("\n".join(lines))
    results = {"gain": rec.setting if rec else None, "knob": knob_rec.setting if knob_rec else None,
               "warning": warning,
               "takes": [{**{k: v for k, v in t.items() if k != "metrics"}, "metrics": analysis.as_dict(t["metrics"])}
                         for t in takes]}
    write_json(folder / "results.json", results)
    return path, rec


def parse_levels(text: str) -> list[float]:
    try:
        levels = [float(part) for part in text.split(",") if part.strip()]
    except ValueError:
        fail(f"--levels must be comma-separated numbers: {text!r}", 2)
    if not levels or any(not 0.0 <= level <= 1.0 for level in levels):
        fail("--levels must be between 0.0 and 1.0", 2)
    return levels


def cmd_devices(_args) -> None:
    ca = coreaudio()
    default = ca.default_input().uid
    for d in ca.input_devices():
        level = d.gain_db() if d.gain_supported else None
        gain = (f"gain {d.gain():.4f}" + (f" ({level:.1f} dB)" if level is not None else "")) if d.gain_supported \
            else "gain not software-controllable"
        print(f"{'*' if d.uid == default else ' '} {d.name} · {d.channels} ch · {gain}")


def cmd_gain(args) -> None:
    device = resolve_device(args.device)
    if not device.gain_supported:
        fail(f"{device.name}: input gain is not software-controllable (hardware knob or fixed level)", 3)
    if args.value is not None:
        if not 0.0 <= args.value <= 1.0:
            fail("gain must be between 0.0 and 1.0", 2)
        device.set_gain(args.value)
    print(f"{device.gain():.4f}")
    print(f"device={device.name}", file=sys.stderr)


def cmd_run(args) -> None:
    for tool in ("ffmpeg", "ffprobe", "afplay"):
        if not shutil.which(tool):
            fail(f"missing {tool}")
    if not 1 <= args.seconds <= 30:
        fail("--seconds must be between 1 and 30 (bounded takes)", 2)
    device = resolve_device(args.device)
    knob = [label.strip() for label in (args.knob or "").split(",") if label.strip()]
    if args.keep_gain:
        levels: list[float] = []
        knob = knob or [f"fixed {n}" for n in range(1, args.takes + 1)]
    elif not device.gain_supported:
        fail(f"{device.name}: input gain is not software-controllable. Use --keep-gain --knob 'as is,-50%,+50%' "
             "(the speaker turns the hardware knob between takes), or pick another --device.", 3)
    else:
        levels = parse_levels(args.levels)
    takes = len(levels) + len(knob)
    seconds = takes * (SETTLE_SECONDS + PLAYER_SLACK + 5)  # typical: a 4 s sentence
    worst_take = SETTLE_SECONDS + START_TIMEOUT + PLAYER_SLACK + sum(COUNTDOWN[-1]) + args.seconds + 5 + 5  # start, stop limits
    prompts = (len(knob) + 1) * KNOB_PROMPT_SECONDS if args.knob else 0  # Enter per knob take + Done
    reserve = takes * worst_take + prompts + 60  # + gain pick analysis and slack
    step = worst_take + (KNOB_PROMPT_SECONDS if args.knob else 0) + 30  # per take, redos included
    print(f"device={device.name}  gain={device.gain() if device.gain_supported else 'fixed'}  "
          f"levels={levels}  knob={knob}  ≈{seconds:.0f}s of recording")
    if args.dry_run:
        print(f"ffmpeg index {ffmpeg_index(device.name)} · dry run, nothing recorded or changed")
        return
    slug = re.sub(r"[^a-z0-9]+", "-", device.name.lower()).strip("-")
    folder = (Path(args.out).expanduser() / f"{datetime.now():%Y%m%d-%H%M%S}-{slug}").resolve()
    folder.mkdir(parents=True)
    # With a knob phase the takes were made at the gain pick: keeping it is what --apply-recommended means.
    session = {"started": f"{datetime.now():%Y-%m-%d %H:%M}", "status": "ready",
               "device": {"name": device.name, "uid": device.uid, "channels": device.channels},
               "levels": levels, "knob": knob, "knob_phase": "fixed" if args.keep_gain and not args.knob else "knob",
               "keep_pick": bool(args.apply_recommended and levels and knob),
               "sentence": args.sentence, "language": args.language, "seconds": args.seconds, "takes": []}
    write_json(folder / "session.json", session)
    print(f"session={folder}", flush=True)
    session = capture(folder, confirm=True) if sys.stdin.isatty() else capture_in_terminal(folder, args.wait, reserve, step)
    if session["status"] != "recorded":
        fail(f"capture {session['status']}; session {folder}", 1)
    path, rec = report(folder, stt=not args.no_stt)
    if args.apply_recommended and rec and rec.take and not session.get("keep_pick"):
        device.set_gain(rec.setting)
        print(f"applied recommended gain {rec.setting:.2f}")
    print(f"report={path}")


def cmd_capture(args) -> None:
    capture(Path(args.session).resolve(), confirm=sys.stdin.isatty())
    print("\nDone: you can close this window.")


def cmd_report(args) -> None:
    path, _ = report(Path(args.session), stt=not args.no_stt)
    print(f"report={path}")


def cmd_restore(args) -> None:
    session = json.loads((Path(args.session) / "session.json").read_text())
    if not session.get("original_gains"):
        fail("session has no saved gain (fixed-level session or never started)", 3)
    device = coreaudio().by_uid(session["device"]["uid"])
    device.set_gains({int(k): v for k, v in session["original_gains"].items()})
    print(f"restored {device.name} gain {device.gain():.4f}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("devices").set_defaults(func=cmd_devices)
    gain = sub.add_parser("gain")
    gain.add_argument("--device")
    gain.add_argument("value", nargs="?", type=float)
    gain.set_defaults(func=cmd_gain)
    run = sub.add_parser("run", help="record and report")
    run.add_argument("--device")
    run.add_argument("--levels", default=DEFAULT_LEVELS, help=f"gains to test, default {DEFAULT_LEVELS}")
    run.add_argument("--manual", "--knob", dest="knob", help="after the gain sweep (or alone with --keep-gain): "
                     "one take per comma-separated setup the speaker makes by hand (knob, distance, voice), Enter "
                     "before each, e.g. 'knob as is,knob -50%%,knob +50%%'")
    run.add_argument("--keep-gain", action="store_true", help="no gain sweep: --knob takes, or --takes at the current level")
    run.add_argument("--takes", type=int, default=1, help="with --keep-gain and no --knob (default 1)")
    run.add_argument("--sentence", default=DEFAULT_SENTENCE, help="what the speaker says (reference for WER only)")
    run.add_argument("--language", default="en", help="STT language code, '' = auto-detect")
    run.add_argument("--seconds", type=float, default=8.0, help="longest speech after the countdown; a take "
                     "ends sooner, once the speaker stops")
    run.add_argument("--out", default=os.environ.get("MIC_CALIBRATION_DIR", "~/Downloads/microphone-calibration"))
    run.add_argument("--wait", type=float, default=540, help="seconds the speaker has to press Enter in the Terminal "
                     "window (no TTY); the session's worst-case duration is added on top")
    run.add_argument("--no-stt", action="store_true")
    run.add_argument("--apply-recommended", action="store_true", help="leave the recommended gain set "
                     "(with --knob: the gain the knob takes used)")
    run.add_argument("--dry-run", action="store_true", help="resolve device and plan only")
    run.set_defaults(func=cmd_run)
    for name, func in (("capture", cmd_capture), ("report", cmd_report), ("restore", cmd_restore)):
        command = sub.add_parser(name)
        command.add_argument("session")
        if name == "report":
            command.add_argument("--no-stt", action="store_true")
        command.set_defaults(func=func)
    args = parser.parse_args()
    if getattr(args, "language", None) == "":
        args.language = None
    args.func(args)


if __name__ == "__main__":
    main()
