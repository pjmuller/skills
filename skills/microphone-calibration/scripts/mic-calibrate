#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Find the best input gain for a microphone: the same sentence at several gains, measured and transcribed.

  devices                     list inputs: channels, settable gain, current gain
  gain [--device D] [VALUE]   read or set input gain (0.0-1.0)
  run [--device D] ...        one take per --levels (beep before each), original gain restored, then
                              report.md; --keep-gain records --takes at the current level. Without a
                              TTY (agents) the capture opens in Terminal.app; the speaker presses Enter
  capture SESSION_DIR         the recording half of run (what the Terminal window executes)
  report SESSION_DIR          re-analyse an existing session (metrics, STT, recommendation)
  restore SESSION_DIR         put back the gain saved in session.json (after a killed run)

Device: --device > MIC_DEVICE_NAME > system default input (case-insensitive substring of the name).
macOS only (CoreAudio, avfoundation). STT: `transcribe-local` (video-shrink-for-gemini) when on PATH.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import analysis  # noqa: E402

DEFAULT_LEVELS = "0.25,0.5,0.75,1.0"
DEFAULT_SENTENCE = "The quick brown fox jumps over the lazy dog, then naps in the warm sun."
PRE_QUIET = 1.2      # seconds of waiting before the beep: the noise-floor window
BEEP_SECONDS = 0.15
PLAYER_SLACK = 1.5    # afplay needs 0.4-1.2 s to start; the beep is excluded by its tone, not by time
SETTLE_SECONDS = 0.3
ENTER_TIMEOUT = 900
CANCEL_FILE = "cancel"  # written by the agent side when it stops waiting; checked before every take


def fail(message: str, code: int = 1):
    print(f"mic-calibrate: {message}", file=sys.stderr)
    raise SystemExit(code)


def coreaudio():
    if sys.platform != "darwin":
        fail("macOS only (CoreAudio input gain, avfoundation capture)")
    import coreaudio as module
    return module


def resolve_device(wanted: str | None):
    ca = coreaudio()
    wanted = (wanted or os.environ.get("MIC_DEVICE_NAME") or "").strip()
    if not wanted:
        return ca.default_input()
    devices = ca.input_devices()
    exact = [d for d in devices if d.name.lower() == wanted.lower()]
    matches = exact or [d for d in devices if wanted.lower() in d.name.lower()]
    if len(matches) == 1:
        return matches[0]
    listing = "\n".join(f"  - {d.name}" for d in devices) or "  (none)"
    fail(f"{'ambiguous' if matches else 'no'} input device matching {wanted!r}; inputs:\n{listing}")


def ffmpeg_index(name: str) -> str:
    listing = subprocess.run(["ffmpeg", "-hide_banner", "-f", "avfoundation", "-list_devices", "true", "-i", ""],
                             capture_output=True, text=True).stderr
    audio = listing.split("AVFoundation audio devices:", 1)[-1]
    found = [index for index, label in re.findall(r"\] \[(\d+)\] (.+)", audio) if label.strip() == name]
    if len(found) != 1:
        fail(f"avfoundation lists {len(found)} audio devices named {name!r}:\n{audio.strip()}")
    return found[0]


def speak(text: str) -> None:
    subprocess.run(["say", text], check=False)


def write_json(path: Path, data: dict) -> None:
    # Atomic: the agent side polls session.json while the Terminal side writes it.
    partial = path.with_suffix(".partial")
    partial.write_text(json.dumps(data, indent=2) + "\n")
    partial.replace(path)


def record_take(index: str, path: Path, beep: Path, seconds: float) -> dict:
    """Bounded capture: quiet wait → beep → speech. Windows are seconds into the file."""
    total = PRE_QUIET + PLAYER_SLACK + seconds
    process = subprocess.Popen(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y",
                                "-f", "avfoundation", "-i", f":{index}", "-t", f"{total:.2f}",
                                "-c:a", "pcm_s24le", str(path)], stderr=subprocess.PIPE, text=True)
    try:
        deadline = time.monotonic() + 8
        # Samples flowing = capture started. The file lags capture, so the beep lands later in the file
        # than measured here: the noise window, which ends before the player starts, stays beep-free.
        while not (path.exists() and path.stat().st_size > 8192):
            if process.poll() is not None or time.monotonic() > deadline:
                process.kill()
                raise RuntimeError(f"capture did not start: {(process.stderr.read() or 'timeout').strip()}")
            time.sleep(0.01)
        started = time.monotonic()
        time.sleep(PRE_QUIET)
        beep_at = time.monotonic() - started
        subprocess.run(["afplay", str(beep)], check=False)
        beep_end = time.monotonic() - started
        cancel, deadline = path.parent / CANCEL_FILE, time.monotonic() + total + 10
        while process.poll() is None:  # the agent side may cancel mid-take; finally stops ffmpeg
            if cancel.exists():
                raise KeyboardInterrupt("cancelled by the waiting agent")
            if time.monotonic() > deadline:
                raise RuntimeError("ffmpeg did not stop at its -t limit")
            time.sleep(0.1)
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
    if process.returncode:
        raise RuntimeError(f"ffmpeg failed: {process.stderr.read().strip()}")
    noise_end = round(max(0.35, beep_at - 0.1), 3)
    return {"noise_window": [0.25, noise_end], "speech_start": noise_end, "beep_played": [round(beep_at, 3), round(beep_end, 3)]}


def make_beep(path: Path) -> None:
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i",
                    f"sine=frequency=1000:duration={BEEP_SECONDS}", "-af", "volume=0.5", str(path)], check=True)


def interrupted(signum, _frame):
    raise KeyboardInterrupt(f"signal {signum}")


def record_session(device, session: dict, folder: Path, record, say=speak) -> None:
    """record(path) → windows. One take per level; the original gain comes back whatever happens."""
    levels = session["levels"]

    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGTERM, signal.SIGHUP)}
    if any(level is not None for level in levels):
        session["original_gains"] = {str(k): v for k, v in device.gains().items()}
        session["original_gain"] = round(device.gain(), 4)
    session["status"] = "recording"
    write_json(folder / "session.json", session)
    try:
        say(f"Microphone calibration, {len(levels)} takes. After each beep, say your sentence.")
        for number, level in enumerate(levels, 1):
            if (folder / CANCEL_FILE).exists():
                raise KeyboardInterrupt("cancelled by the waiting agent")
            take = {"index": number}
            if level is not None:
                take["gain_requested"] = level
                take["gain"] = round(device.set_gain(level), 4)
                time.sleep(SETTLE_SECONDS)
            else:
                take["gain"] = round(device.gain(), 4) if device.gain_supported else None
            take["gain_db"] = device.gain_db() if device.gain_supported else None
            take["file"] = f"take-{number}" + (f"-gain-{take['gain']:.2f}" if take["gain"] is not None else "") + ".wav"
            say(f"Take {number} of {len(levels)}.")
            print(f"take {number}/{len(levels)}  gain={take['gain']}", flush=True)
            take.update(record(folder / take["file"]))
            session["takes"].append(take)
            write_json(folder / "session.json", session)
        say("Done.")
        session["status"] = "recorded"
    except BaseException as error:
        session["status"] = f"interrupted: {str(error) or type(error).__name__}"
        raise
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        if session.get("original_gains"):
            device.set_gains({int(k): v for k, v in session["original_gains"].items()})
            session["restored_gain"] = round(device.gain(), 4)
            print(f"restored gain {session['restored_gain']}", flush=True)
        write_json(folder / "session.json", session)


def wait_for_enter(deadline: float, cancel: Path) -> bool:
    """Enter → True; deadline (wall clock) or a cancel request from the agent side → False."""
    print(f"Press Enter to start (Ctrl-C cancels; gives up at {datetime.fromtimestamp(deadline):%H:%M}) ",
          end="", flush=True)
    while time.time() < deadline and not cancel.exists():
        ready, _, _ = select.select([sys.stdin], [], [], 1)
        if ready:
            sys.stdin.readline()
            return True
    return False


def capture(folder: Path, confirm: bool) -> dict:
    """The recording half; runs where the microphone is allowed (a terminal), never unbounded."""
    session = json.loads((folder / "session.json").read_text())
    device = coreaudio().by_uid(session["device"]["uid"])
    index = ffmpeg_index(device.name)
    levels = session["levels"]
    print(f"\n{device.name}: {len(levels)} takes"
          + (f" at gains {', '.join(str(level) for level in levels)}" if levels[0] is not None else " at the current level")
          + f".\nAfter each beep, say at your normal distance and loudness:\n\n    {session['sentence']}\n")
    signal.signal(signal.SIGHUP, interrupted)  # closing the window must not leave the agent waiting
    try:
        deadline = session.get("enter_deadline") or time.time() + ENTER_TIMEOUT
        ready = not confirm or wait_for_enter(deadline, folder / CANCEL_FILE)
    except KeyboardInterrupt:
        ready = False
    if not ready:
        session["status"] = "cancelled before recording"
        write_json(folder / "session.json", session)
        fail(session["status"])
    beep = folder / "beep.wav"
    make_beep(beep)
    try:
        record_session(device, session, folder, lambda path: record_take(index, path, beep, session["seconds"]))
    except KeyboardInterrupt:
        fail(f"interrupted; partial session in {folder}", 130)
    except RuntimeError as error:
        fail(f"{error}; partial session in {folder}")
    finally:
        beep.unlink(missing_ok=True)
    return session


def capture_in_terminal(folder: Path, wait: float, recording_seconds: float) -> dict:
    """Agent shells have no TTY, and their host app may lack microphone access (silent zeros): the
    capture runs in a Terminal.app window where the speaker presses Enter when ready. The window
    stops waiting for Enter early enough that the recording finishes inside this side's wait."""
    session = json.loads((folder / "session.json").read_text())
    session["enter_deadline"] = time.time() + max(60.0, wait - recording_seconds - 30)
    write_json(folder / "session.json", session)
    script = folder / "capture.command"
    script.write_text(f"#!/bin/sh\nexec '{sys.executable}' '{Path(__file__).resolve()}' capture '{folder}'\n")
    script.chmod(0o755)
    subprocess.run(["open", "-a", "Terminal", str(script)], check=True)
    print(f"capture window opened in Terminal; waiting up to {wait:.0f}s for the speaker", flush=True)
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        session = json.loads((folder / "session.json").read_text())
        if session.get("status") not in ("ready", "recording"):
            return session
        time.sleep(1)
    # Never leave a capture running unsupervised: ask it to stop and wait for the gain restore.
    (folder / CANCEL_FILE).touch()
    for _ in range(30):
        session = json.loads((folder / "session.json").read_text())
        if session.get("status") not in ("ready", "recording"):
            fail(f"no result after {wait:.0f}s; capture {session['status']}"
                 + (f", gain restored to {session['restored_gain']}" if "restored_gain" in session else ""), 4)
        time.sleep(1)
    fail(f"capture window unresponsive after cancel; check the gain: mic-calibrate restore {folder}", 4)


def transcribe(folder: Path, files: list[str], language: str | None) -> dict[str, str]:
    helper = shutil.which("transcribe-local")
    if not helper:
        return {}
    out = folder / "stt"
    done = subprocess.run([helper, "--out", str(out), *(["--language", language] if language else []),
                           *[str(folder / name) for name in files]], stdout=subprocess.DEVNULL)
    if done.returncode:
        print(f"transcribe-local failed ({done.returncode}); report without transcripts", file=sys.stderr)
    result = {}
    for name in files:
        text = out / f"{Path(name).stem}.whisper.txt"
        if text.exists():
            result[name] = " ".join(text.read_text().split())
    return result


def row(*cells) -> str:
    return "| " + " | ".join(str(cell) for cell in cells) + " |"


def report(folder: Path, stt: bool) -> tuple[Path, analysis.Recommendation | None]:
    folder = folder.resolve()
    session = json.loads((folder / "session.json").read_text())
    takes = []
    for take in session["takes"]:
        channels, rate = analysis.read_wav(folder / take["file"])
        metrics = analysis.measure(channels, rate, tuple(take["noise_window"]), take["speech_start"])
        takes.append({**take, "metrics": metrics, "wer": None, "transcript": None})
    if stt:
        texts = transcribe(folder, [take["file"] for take in takes], session.get("language"))
        for take in takes:
            if take["file"] in texts:
                take["transcript"] = texts[take["file"]]
                take["wer"] = round(analysis.word_error_rate(session["sentence"], take["transcript"]), 3)
    sweep = session.get("mode") == "sweep"
    rec = analysis.recommend(takes) if sweep else None
    warning = analysis.gain_tracking_warning(takes) if sweep else ""
    device = session["device"]
    original = session.get("original_gain")

    lines = [f"# Microphone calibration: {device['name']}", "",
             f"{session['started']} · {device['channels']} ch · "
             + (f"original gain {original}" if original is not None else "gain left untouched")
             + (f" (restored {session['restored_gain']})" if session.get("restored_gain") is not None else ""), ""]
    if rec:
        if rec.gain is not None:
            lines += ["> [!IMPORTANT]", f"> Recommended input gain **{rec.gain:.2f}**: {rec.reason}."]
        else:
            lines += ["> [!IMPORTANT]", f"> No recommendation: {rec.reason}."]
        if rec.next_step:
            lines.append(f"> Next: {rec.next_step}.")
        lines.append("")
    if warning:
        lines += ["> [!WARNING]", f"> {warning}.", ""]
    if all(t["metrics"].peak_dbfs <= -119 for t in takes):
        lines += ["> [!WARNING]", "> Digital silence in every take: microphone permission for this app, "
                  "or a muted device.", ""]
    lines += [row("Take", "Gain", "Device dB", "Peak dBFS", "Clipped", "Noise dBFS", "Speech dBFS", "SNR dB",
                  "Speech s", "WER", "Verdict"),
              row(*["---"] * 11)]
    for t in takes:
        m = t["metrics"]
        lines.append(row(t["index"], t["gain"] if t["gain"] is not None else "fixed",
                         f"{t['gain_db']:.1f}" if t.get("gain_db") is not None else "–",
                         m.peak_dbfs, m.clipped_samples, m.noise_dbfs, m.speech_dbfs, m.snr_db, m.speech_seconds,
                         f"{t['wer']:.0%}" if t["wer"] is not None else "–", analysis.verdict(m)))
    lines += ["", "## Listen", ""]
    lines += [f"![take {t['index']} gain {t['gain']}]({folder / t['file']})" for t in takes]
    lines += ["", "## Transcripts", "", f"Reference (spoken, never sent to STT): “{session['sentence']}”", ""]
    if any(t["transcript"] is not None for t in takes):
        lines += [f"{t['index']}. gain {t['gain']}: “{t['transcript']}”" for t in takes]
        lines += ["", "Local Whisper (`transcribe-local`), same settings per take, no hint. Equal transcripts "
                  "do not mean equal audio; your dictation engine may differ."]
    else:
        lines.append("Not transcribed (`--no-stt`, or `transcribe-local` not on PATH).")
    lines += ["", "<details><summary>Method and limits</summary>", "",
              f"- Noise floor: RMS of the quiet wait before each beep; speech: {analysis.FRAME_SECONDS * 1000:.0f} ms "
              f"frames more than {analysis.ACTIVE_ABOVE_NOISE_DB:.0f} dB above it, on the loudest channel; "
              "peaks and clipping across all channels, beep excluded.",
              f"- Pick: no clipping, peak ≤ {analysis.HOT_PEAK_DB:.0f} dBFS, SNR within {analysis.SNR_TIE_DB:.0f} dB "
              f"of the best, then peak closest to {analysis.TARGET_PEAK_DB:.0f} dBFS. Only tested levels are recommended.",
              "- Input gain usually raises voice and room noise together, so SNR barely moves; the main risks are "
              "clipping (too high) and a weak signal (too low).",
              "- One sentence per level: louder or softer delivery, distance and onboard AGC shift the numbers. "
              "Not a global optimum; confirm by listening and one dictation at the picked level.",
              "- Originals are unnormalized 24-bit WAV; nothing here amplifies after capture.", "", "</details>", ""]
    path = folder / "report.md"
    path.write_text("\n".join(lines))
    results = {"recommendation": vars(rec) if rec else None, "warning": warning,
               "takes": [{**{k: v for k, v in t.items() if k != "metrics"}, "metrics": analysis.as_dict(t["metrics"])}
                         for t in takes]}
    write_json(folder / "results.json", results)
    return path, rec


def parse_levels(text: str) -> list[float]:
    try:
        levels = [float(part) for part in text.split(",") if part.strip()]
    except ValueError:
        fail(f"--levels must be comma-separated numbers: {text!r}", 2)
    if not levels or any(not 0.0 <= level <= 1.0 for level in levels):
        fail("--levels must be between 0.0 and 1.0", 2)
    return levels


def cmd_devices(_args) -> None:
    ca = coreaudio()
    default = ca.default_input().uid
    for d in ca.input_devices():
        level = d.gain_db() if d.gain_supported else None
        gain = (f"gain {d.gain():.4f}" + (f" ({level:.1f} dB)" if level is not None else "")) if d.gain_supported \
            else "gain not software-controllable"
        print(f"{'*' if d.uid == default else ' '} {d.name} · {d.channels} ch · {gain}")


def cmd_gain(args) -> None:
    device = resolve_device(args.device)
    if not device.gain_supported:
        fail(f"{device.name}: input gain is not software-controllable (hardware knob or fixed level)", 3)
    if args.value is not None:
        if not 0.0 <= args.value <= 1.0:
            fail("gain must be between 0.0 and 1.0", 2)
        device.set_gain(args.value)
    print(f"{device.gain():.4f}")
    print(f"device={device.name}", file=sys.stderr)


def cmd_run(args) -> None:
    for tool in ("ffmpeg", "ffprobe", "say", "afplay"):
        if not shutil.which(tool):
            fail(f"missing {tool}")
    if not 1 <= args.seconds <= 30:
        fail("--seconds must be between 1 and 30 (bounded takes)", 2)
    device = resolve_device(args.device)
    if args.keep_gain:
        levels: list[float | None] = [None] * args.takes
    elif not device.gain_supported:
        fail(f"{device.name}: input gain is not software-controllable. Set the hardware knob yourself and use "
             "--keep-gain (one session per knob position), or pick another --device.", 3)
    else:
        levels = parse_levels(args.levels)
    seconds = len(levels) * (2.5 + PRE_QUIET + PLAYER_SLACK + args.seconds) + 4
    print(f"device={device.name}  gain={device.gain() if device.gain_supported else 'fixed'}  "
          f"levels={levels}  ≈{seconds:.0f}s of recording")
    if args.dry_run:
        print(f"ffmpeg index {ffmpeg_index(device.name)} · dry run, nothing recorded or changed")
        return
    slug = re.sub(r"[^a-z0-9]+", "-", device.name.lower()).strip("-")
    folder = (Path(args.out).expanduser() / f"{datetime.now():%Y%m%d-%H%M%S}-{slug}").resolve()
    folder.mkdir(parents=True)
    session = {"started": f"{datetime.now():%Y-%m-%d %H:%M}", "mode": "fixed" if args.keep_gain else "sweep",
               "status": "ready", "device": {"name": device.name, "uid": device.uid, "channels": device.channels},
               "levels": levels, "sentence": args.sentence, "language": args.language, "seconds": args.seconds,
               "takes": []}
    write_json(folder / "session.json", session)
    print(f"session={folder}", flush=True)
    session = capture(folder, confirm=True) if sys.stdin.isatty() else capture_in_terminal(folder, args.wait, seconds)
    if session["status"] != "recorded":
        fail(f"capture {session['status']}; session {folder}", 1)
    path, rec = report(folder, stt=not args.no_stt)
    if args.apply_recommended and rec and rec.gain is not None:
        device.set_gain(rec.gain)
        print(f"applied recommended gain {rec.gain:.2f}")
    print(f"report={path}")


def cmd_capture(args) -> None:
    capture(Path(args.session).resolve(), confirm=sys.stdin.isatty())
    print("\nDone: you can close this window.")


def cmd_report(args) -> None:
    path, _ = report(Path(args.session), stt=not args.no_stt)
    print(f"report={path}")


def cmd_restore(args) -> None:
    session = json.loads((Path(args.session) / "session.json").read_text())
    if not session.get("original_gains"):
        fail("session has no saved gain (fixed-level session or never started)", 3)
    device = coreaudio().by_uid(session["device"]["uid"])
    device.set_gains({int(k): v for k, v in session["original_gains"].items()})
    print(f"restored {device.name} gain {device.gain():.4f}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("devices").set_defaults(func=cmd_devices)
    gain = sub.add_parser("gain")
    gain.add_argument("--device")
    gain.add_argument("value", nargs="?", type=float)
    gain.set_defaults(func=cmd_gain)
    run = sub.add_parser("run", help="record and report")
    run.add_argument("--device")
    run.add_argument("--levels", default=DEFAULT_LEVELS, help=f"gains to test, default {DEFAULT_LEVELS}")
    run.add_argument("--keep-gain", action="store_true", help="do not touch gain; record --takes at the current level")
    run.add_argument("--takes", type=int, default=1, help="with --keep-gain (default 1)")
    run.add_argument("--sentence", default=DEFAULT_SENTENCE, help="what the speaker says (reference for WER only)")
    run.add_argument("--language", default="en", help="STT language code, '' = auto-detect")
    run.add_argument("--seconds", type=float, default=6.0, help="speech window after each beep")
    run.add_argument("--out", default=os.environ.get("MIC_CALIBRATION_DIR", "~/Downloads/microphone-calibration"))
    run.add_argument("--wait", type=float, default=540, help="seconds to wait for the Terminal capture (no TTY)")
    run.add_argument("--no-stt", action="store_true")
    run.add_argument("--apply-recommended", action="store_true", help="leave the recommended gain set")
    run.add_argument("--dry-run", action="store_true", help="resolve device and plan only")
    run.set_defaults(func=cmd_run)
    for name, func in (("capture", cmd_capture), ("report", cmd_report), ("restore", cmd_restore)):
        command = sub.add_parser(name)
        command.add_argument("session")
        if name == "report":
            command.add_argument("--no-stt", action="store_true")
        command.set_defaults(func=func)
    args = parser.parse_args()
    if getattr(args, "language", None) == "":
        args.language = None
    args.func(args)


if __name__ == "__main__":
    main()
