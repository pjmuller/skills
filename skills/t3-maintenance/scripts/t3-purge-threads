#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Purge old T3 threads from this machine: transcripts hold secrets.

Every env var, token and pasted secret that crossed a turn sits in T3's store
(`statev2.sqlite`, including the 0.0.x tables it copied on upgrade) and in the
provider's own transcript files. T3 has no hard delete, so:

  list        dry run (default): cohort, rows, files that would go
  apply --yes delete the rows (every thread-keyed table) + transcripts,
              provider logs and attachments. Refuses unless T3 Code is
              fully closed: a live server keeps writing the same streams.
  drop-v1     the frozen 0.0.x `state.sqlite` (T3 0.1 only seeds from it
              once; all history now lives in statev2). Dry run unless --yes.

Candidates are top-level threads; their sub-agent and delegated-task
descendants (lineage 'subagent' edges only, never forks) go with them. Never purged: pinned, running, or awaiting approval,
and threads a wake-up still targets (enabled native scheduled task,
`t3-schedule pending-resumes`, `t3-mail-link list --thread-ids`). A failing
helper aborts: no protected set, no purge.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import uuid
from collections import defaultdict
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from t3_store import (
    DEFAULT_STORE,
    LIVE_RUN,
    USERDATA,
    connect_readonly,
    iso,
    maybe_time,
    short_id,
)

SETTINGS = USERDATA / "settings.json"
ATTACHMENTS = USERDATA / "attachments"
PROVIDER_LOGS = USERDATA / "logs" / "provider"
SERVER_RUNTIME = USERDATA / "server-runtime.json"
V1_STORE = USERDATA / "state.sqlite"
BACKUP_DIR = USERDATA.parent / "backups"
CODEX_SESSIONS = Path.home() / ".codex" / "sessions"
LOG_DIR = Path(
    os.environ.get(
        "T3_MAINTENANCE_STATE_DIR",
        Path.home() / ".local" / "state" / "t3-maintenance" / "actions",
    )
)
DURATION_UNITS = {"h": 3600, "d": 86400}
UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
# Columns besides `thread_id` that name a thread; scheduled tasks are T3's config, kept.
EXTRA_THREAD_COLUMNS = {
    "orchestration_events": ("stream_id",),
    "orchestration_command_receipts": ("aggregate_id",),
    "orchestration_v2_projection_context_transfers": ("source_thread_id", "target_thread_id"),
    "orchestration_v2_projection_subagents": ("child_thread_id",),
}
KEEP_TABLES = {"scheduled_tasks"}
BACKUP_TABLES = ("orchestration_v2_projection_threads", "orchestration_v2_projection_messages")
TITLE_CHARS = 44
PROJECT_CHARS = 16


def parse_duration(value: str) -> timedelta:
    match = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([hd])", value.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError(f"expected a duration like 12h or 3d; got {value!r}")
    return timedelta(seconds=float(match.group(1)) * DURATION_UNITS[match.group(2)])


def one_line(text: str, limit: int) -> str:
    flat = " ".join((text or "").split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


def mb(byte_count: int) -> float:
    return round(byte_count / 1_048_576, 1)


@dataclass
class Thread:
    thread_id: str
    project: str
    workspace_root: str
    title: str
    updated_at: str
    age_seconds: float
    top_level: bool
    parent_id: str | None
    archived: bool
    deleted: bool
    settled: bool
    pinned: bool
    busy: bool
    instance_id: str | None
    messages: int = 0
    descendants: list[str] = field(default_factory=list)
    session_ids: set[str] = field(default_factory=set)
    attachment_ids: set[str] = field(default_factory=set)
    files: list[Path] = field(default_factory=list)

    @property
    def state(self) -> str:
        for name in ("deleted", "archived", "settled"):
            if getattr(self, name):
                return name
        return "active"

    def as_dict(self) -> dict[str, object]:
        return {
            "thread_id": self.thread_id,
            "short_id": short_id(self.thread_id),
            "project": self.project,
            "title": self.title,
            "updated_at": self.updated_at,
            "age_days": round(self.age_seconds / 86400, 1),
            "state": self.state,
            "profile": self.instance_id,
            "messages": self.messages,
            "descendants": self.descendants,
            "files": [str(path) for path in self.files],
            "transcript_resolved": bool(self.session_ids),
        }


# --- loading -----------------------------------------------------------------


def load_threads(store: Path, now: datetime) -> dict[str, Thread]:
    threads: dict[str, Thread] = {}
    with connect_readonly(store) as db:
        for row in db.execute("""
            SELECT t.thread_id, t.title, t.updated_at, t.created_at, t.archived_at, t.deleted_at,
                   t.provider_instance_id, t.payload_json, p.title AS project, p.workspace_root
            FROM orchestration_v2_projection_threads t
            LEFT JOIN projection_projects p ON p.project_id = t.project_id
        """):
            payload = json.loads(row["payload_json"] or "{}")
            lineage = payload.get("lineage") or {}
            moment = maybe_time(row["updated_at"]) or maybe_time(row["created_at"]) or now
            tid = row["thread_id"]
            threads[tid] = Thread(
                thread_id=tid,
                project=row["project"] or "?",
                workspace_root=row["workspace_root"] or "",
                title=row["title"],
                updated_at=iso(moment),
                age_seconds=(now - moment).total_seconds(),
                # Forks also carry a parentThreadId but are independent threads.
                top_level=lineage.get("relationshipToParent") != "subagent",
                parent_id=lineage.get("parentThreadId"),
                archived=row["archived_at"] is not None,
                deleted=row["deleted_at"] is not None,
                settled=payload.get("settledOverride") == "settled",
                pinned=payload.get("pinnedAt") is not None,
                busy=False,
                instance_id=row["provider_instance_id"],
            )
        for row in db.execute("""
            SELECT thread_id FROM orchestration_v2_projection_runs WHERE status IN ({})
            UNION SELECT thread_id FROM orchestration_v2_projection_runtime_requests
                  WHERE status = 'pending'
        """.format(",".join("?" * len(LIVE_RUN))), tuple(LIVE_RUN)):
            if row["thread_id"] in threads:
                threads[row["thread_id"]].busy = True
        for row in db.execute("""
            SELECT m.thread_id, COUNT(*) AS n,
                   group_concat(a.value ->> '$.id', ' ') AS attachments
            FROM orchestration_v2_projection_messages m
            LEFT JOIN json_each(m.payload_json, '$.attachments') a
            GROUP BY m.thread_id
        """):
            if thread := threads.get(row["thread_id"]):
                thread.messages = row["n"]
                thread.attachment_ids |= set((row["attachments"] or "").split())
        # Provider-native session ids: V2 provider threads, plus the resume cursor of
        # history imported from 0.0.x (legacy table copied into statev2).
        for row in db.execute("""
            SELECT thread_id, json_extract(payload_json, '$.nativeThreadRef.nativeId') AS native
            FROM orchestration_v2_projection_provider_threads
        """):
            if (thread := threads.get(row["thread_id"])) and row["native"]:
                thread.session_ids.add(row["native"])
        if table_exists(db, "provider_session_runtime"):
            for row in db.execute(
                "SELECT thread_id, resume_cursor_json FROM provider_session_runtime"
            ):
                if thread := threads.get(row["thread_id"]):
                    thread.session_ids |= cursor_session_ids(row["resume_cursor_json"], row["thread_id"])
    children: dict[str, list[str]] = defaultdict(list)
    for thread in threads.values():
        if not thread.top_level and thread.parent_id in threads:
            children[thread.parent_id].append(thread.thread_id)
    for thread in threads.values():
        if thread.top_level:
            stack = list(children[thread.thread_id])
            while stack:
                child = stack.pop()
                thread.descendants.append(child)
                stack += children[child]
    return threads


def table_exists(db: sqlite3.Connection, name: str) -> bool:
    return db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)).fetchone() is not None


def cursor_session_ids(raw: str | None, t3_thread_id: str) -> set[str]:
    """Claude cursors carry `resume`/`resumeSessionAt`; Codex its thread under `threadId`
    (Claude cursors also carry T3's own id there, which must be ignored)."""
    try:
        cursor = json.loads(raw or "{}")
    except ValueError:
        return set()
    if not isinstance(cursor, dict):
        return set()
    return {
        value
        for key in ("resume", "resumeSessionAt", "threadId")
        if isinstance(value := cursor.get(key), str) and UUID.fullmatch(value) and value != t3_thread_id
    }


def claude_homes() -> list[Path]:
    """~/.claude plus every claudeAgent instance `homePath`: transcripts are found by
    session UUID across all homes, never by cwd slug."""
    try:
        instances = json.loads(SETTINGS.read_text()).get("providerInstances", {})
    except (OSError, ValueError):
        instances = {}
    homes = [Path.home() / ".claude"]
    for instance in instances.values() if isinstance(instances, dict) else instances:
        home = (((instance or {}).get("config") or {}).get("homePath") or "").strip()
        if home and (path := Path(home).expanduser()) not in homes:
            homes.append(path)
    return homes


def provider_log(thread_id: str) -> Path:
    """T3 names it events.<lowercased id, non [a-z0-9-] as '-', first 80 chars>.log."""
    return PROVIDER_LOGS / f"events.{re.sub(r'[^a-z0-9-]', '-', thread_id.lower())[:80]}.log"


def thread_files(thread: Thread, homes: list[Path], by_stem: dict[str, list[Path]]) -> list[Path]:
    files: list[Path] = []
    for session in sorted(thread.session_ids):
        files += sorted(CODEX_SESSIONS.glob(f"*/*/*/rollout-*-{session}.jsonl"))
        for home in homes:
            files += sorted((home / "projects").glob(f"*/{session}.jsonl"))
    for attachment in sorted(thread.attachment_ids):
        files += by_stem.get(attachment, [])
    files.append(provider_log(thread.thread_id))
    return [path for path in files if path.is_file()]


def attach_files(rows: list[Thread], threads: dict[str, Thread]) -> None:
    """Files of each root's whole family: descendants have their own sessions and logs."""
    homes = claude_homes()
    by_stem: dict[str, list[Path]] = defaultdict(list)
    if ATTACHMENTS.is_dir():
        for path in ATTACHMENTS.iterdir():
            by_stem[path.stem].append(path)
    for root in rows:
        for member in [root, *(threads[tid] for tid in root.descendants)]:
            root.files += [p for p in thread_files(member, homes, by_stem) if p not in root.files]


def pending_wakes(store: Path) -> dict[str, str]:
    """thread_id -> why it will be woken again. A helper absent from PATH holds no
    wakes; one that fails leaves the protected set unknown, so refuse (fail closed)."""
    wakes: dict[str, list[str]] = defaultdict(list)
    with connect_readonly(store) as db:
        for row in db.execute(
            "SELECT thread_id, title FROM scheduled_tasks WHERE enabled = 1 AND thread_id IS NOT NULL"
        ):
            wakes[row["thread_id"]].append(f"scheduled task {row['title']}")
    for command, reason in (
        (["t3-schedule", "pending-resumes"], lambda f: f"t3-schedule resume {f[1]} ({f[2]})"),
        (["t3-mail-link", "list", "--thread-ids"], lambda f: "mail link"),
    ):
        helper = shutil.which(command[0])
        if not helper:
            continue
        result = subprocess.run([helper, *command[1:]], text=True, capture_output=True, check=False)
        if result.returncode != 0:
            raise SystemExit(
                f"refusing: `{' '.join(command)}` failed (exit {result.returncode}), so threads "
                f"with a pending wake-up are unknown: {one_line(result.stderr, 300)}"
            )
        for line in result.stdout.splitlines():
            fields = line.split("\t")
            if fields[0].strip():
                wakes[fields[0].strip()].append(reason(fields + ["?", "?"]))
    return {tid: "; ".join(reasons) for tid, reasons in wakes.items()}


def select(
    args: argparse.Namespace, threads: dict[str, Thread], wakes: dict[str, str]
) -> tuple[list[Thread], list[tuple[Thread, str]]]:
    """(purge cohort, matching threads a wake-up keeps). A family goes as one."""
    cohorts = [name for name in ("archived", "settled", "deleted") if getattr(args, name)]
    if not cohorts:
        raise SystemExit("pick at least one cohort: --archived / --settled / --deleted")
    cutoff = args.older_than.total_seconds()
    needle = (args.project or "").casefold()
    rows, kept = [], []
    for thread in threads.values():
        if not thread.top_level or not any(getattr(thread, name) for name in cohorts):
            continue
        if thread.age_seconds < cutoff or (needle and needle not in f"{thread.project} {thread.workspace_root}".casefold()):
            continue
        family = [thread] + [threads[tid] for tid in thread.descendants]
        if any(member.pinned or member.busy for member in family):
            continue
        woken = [wakes[m.thread_id] for m in family if m.thread_id in wakes]
        if woken:
            kept.append((thread, "; ".join(woken)))
        else:
            rows.append(thread)
    return sorted(rows, key=lambda t: t.updated_at), kept


def family_ids(rows: list[Thread]) -> list[str]:
    return [tid for thread in rows for tid in (thread.thread_id, *thread.descendants)]


# --- list --------------------------------------------------------------------


def cmd_list(args: argparse.Namespace, rows: list[Thread], kept: list[tuple[Thread, str]]) -> int:
    if args.json:
        print(json.dumps(
            {
                "threads": [t.as_dict() for t in rows],
                "kept_pending_wake": [
                    {"thread_id": t.thread_id, "title": t.title, "reason": r} for t, r in kept
                ],
            },
            ensure_ascii=False,
            indent=2,
        ))
        return 0
    for t in rows:
        extra = f" +{len(t.descendants)} sub" if t.descendants else ""
        print(
            f"{t.updated_at[:16]}  {t.state:<8}  {one_line(t.instance_id or '-', 18):<18}  "
            f"{one_line(t.project, PROJECT_CHARS):<{PROJECT_CHARS}}  "
            f"{one_line(t.title, TITLE_CHARS):<{TITLE_CHARS}}  {t.messages:>5} msg  "
            f"{len(t.files):>3} files{extra}"
        )
    for t, reason in kept:
        print(f"kept {short_id(t.thread_id)} {one_line(t.title, TITLE_CHARS)}: {reason}")
    unresolved = sum(1 for t in rows if not t.session_ids)
    print(
        f"\n{len(rows)} threads (+{len(family_ids(rows)) - len(rows)} descendants) · "
        f"{sum(len(t.files) for t in rows)} files · {unresolved} without a known transcript\n"
        "Dry run. `apply --yes` with T3 Code fully closed purges rows and files."
    )
    return 0


# --- apply -------------------------------------------------------------------


def t3_is_running() -> str | None:
    """Reason T3 looks alive, or None when it is safe to write the store."""
    try:
        origin = json.loads(SERVER_RUNTIME.read_text()).get("origin")
    except (OSError, ValueError):
        origin = None
    if origin:
        probe = subprocess.run(
            ["curl", "-fsS", "-m", "3", f"{origin}/.well-known/t3/environment"],
            capture_output=True, check=False,
        )
        if probe.returncode == 0:
            return f"T3 server is reachable at {origin}"
    process = subprocess.run(["pgrep", "-f", "T3 Code"], capture_output=True, text=True, check=False)
    if process.returncode == 0 and process.stdout.strip():
        return f"a 'T3 Code' process is running (pid {process.stdout.split()[0]})"
    return None


def thread_columns(db: sqlite3.Connection) -> list[tuple[str, str]]:
    """(table, column) pairs that hold a thread id, discovered from the live schema."""
    pairs = []
    for (table,) in db.execute("SELECT name FROM sqlite_master WHERE type='table'"):
        if table in KEEP_TABLES or table.startswith("sqlite_"):
            continue
        columns = {row[1] for row in db.execute(f'PRAGMA table_info("{table}")')}
        for column in ("thread_id", *EXTRA_THREAD_COLUMNS.get(table, ())):
            if column in columns:
                pairs.append((table, column))
    return pairs


def make_backup(db: sqlite3.Connection, ids: list[tuple[str]], full: bool) -> Path:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    if full:
        backup = BACKUP_DIR / f"statev2-before-purge-{stamp}.sqlite"
        db.execute("VACUUM INTO ?", (str(backup),))
    else:
        backup = BACKUP_DIR / f"purged-threads-{stamp}.sqlite"
        db.execute("ATTACH DATABASE ? AS backup", (str(backup),))
        try:
            with db:
                db.execute("CREATE TEMP TABLE purge_ids (thread_id TEXT PRIMARY KEY)")
                db.executemany("INSERT INTO purge_ids VALUES (?)", ids)
                for table in BACKUP_TABLES:
                    db.execute(
                        f"CREATE TABLE backup.{table} AS SELECT * FROM main.{table} "
                        "WHERE thread_id IN (SELECT thread_id FROM purge_ids)"
                    )
                db.execute("DROP TABLE purge_ids")
        finally:
            db.execute("DETACH DATABASE backup")
    print(f"backup {backup} ({mb(backup.stat().st_size)} MB{'' if full else ', slim: threads + messages'})")
    return backup


def offer_backup_cleanup(current: Path, ask=input) -> None:
    """The fresh backup supersedes every earlier one: list them, delete on Y."""
    stale = sorted(p for p in BACKUP_DIR.glob("*.sqlite") if p.is_file() and p != current)
    if not stale:
        return
    total = sum(p.stat().st_size for p in stale)
    print(f"\n{len(stale)} older backups ({mb(total)} MB) superseded by {current.name}:")
    for path in stale:
        print(f"  {mb(path.stat().st_size):>8} MB  {path.name}")
    if not sys.stdin.isatty():
        print("Not a terminal; delete them yourself when ready.")
        return
    if ask("Delete them? [Y/n] ").strip().lower() in ("", "y", "yes"):
        for path in stale:
            path.unlink()
        print(f"deleted {len(stale)} backups (-{mb(total)} MB)")


def refuse_while_running(yes: bool) -> None:
    if blocker := t3_is_running():
        raise SystemExit(
            f"Refusing: {blocker}. Quit T3 Code entirely (a live server keeps writing "
            "the store), then retry."
        )
    if not yes:
        raise SystemExit("Refusing without --yes.")


def cmd_apply(args: argparse.Namespace, rows: list[Thread], kept: list[tuple[Thread, str]]) -> int:
    if kept:
        print(f"Keeping {len(kept)} matching threads with a pending wake-up (see `list`).")
    if not rows:
        print("No matching threads.")
        return 0
    if len(rows) > args.max:
        print(f"Batch: oldest {args.max} of {len(rows)} matching threads (--max).")
        rows = rows[: args.max]
    refuse_while_running(args.yes)
    store = Path(args.store)
    before = store.stat().st_size
    ids = [(tid,) for tid in family_ids(rows)]
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"{datetime.now(UTC):%Y%m%dT%H%M%SZ}-purge-{uuid.uuid4().hex[:8]}.json"
    log_path.write_text(json.dumps(
        {"store": str(store), "threads": [t.as_dict() for t in rows]}, ensure_ascii=False, indent=2
    ))
    db = sqlite3.connect(str(store))
    try:
        backup = make_backup(db, ids, full=args.full_backup)
        with db:
            for table, column in thread_columns(db):
                db.executemany(f'DELETE FROM "{table}" WHERE "{column}" = ?', ids)
        removed = 0
        for thread in rows:
            for path in thread.files:
                try:
                    path.unlink()
                    removed += 1
                except OSError as error:
                    print(f"keep {path}: {error}")
        db.execute("VACUUM")
    finally:
        db.close()
    after = store.stat().st_size
    print(
        f"{len(rows)} threads (+{len(ids) - len(rows)} descendants) purged · {removed} files · "
        f"store {mb(before)} → {mb(after)} MB · log {log_path}"
    )
    offer_backup_cleanup(backup)
    return 0


def cmd_drop_v1(args: argparse.Namespace) -> int:
    files = [p for p in (V1_STORE, *(V1_STORE.with_name(V1_STORE.name + s) for s in ("-wal", "-shm"))) if p.exists()]
    if not files:
        print(f"No frozen 0.0.x store at {V1_STORE}.")
        return 0
    if not Path(args.store).exists():
        raise SystemExit(f"Refusing: {args.store} missing; T3 would re-seed from {V1_STORE}.")
    total = sum(p.stat().st_size for p in files)
    for path in files:
        print(f"{mb(path.stat().st_size):>9} MB  {path}")
    if not args.yes:
        print(f"Dry run: {mb(total)} MB. T3 0.1 copied it into statev2 once; repeat with --yes "
              "(T3 closed) to delete.")
        return 0
    refuse_while_running(args.yes)
    for path in files:
        path.unlink()
    print(f"deleted {len(files)} files (-{mb(total)} MB)")
    return 0


# --- cli ---------------------------------------------------------------------


def add_filters(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--archived", action="store_true", help="cohort: archived")
    parser.add_argument("--settled", action="store_true", help="cohort: settled")
    parser.add_argument("--deleted", action="store_true", help="cohort: soft-deleted")
    parser.add_argument(
        "--older-than", type=parse_duration, default=parse_duration("3d"),
        help="minimum age of updated_at, e.g. 3d or 12h (default 3d)",
    )
    parser.add_argument("--project", help="project name or workspace-root substring")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command")
    listing = sub.add_parser("list", help="dry run (default)")
    add_filters(listing)
    listing.add_argument("--json", action="store_true")
    apply_parser = sub.add_parser("apply", help="hard purge rows + files (T3 closed)")
    add_filters(apply_parser)
    apply_parser.add_argument("--max", type=int, default=50, help="oldest N of the matches (default 50)")
    apply_parser.add_argument("--yes", action="store_true", help="required")
    apply_parser.add_argument(
        "--full-backup", action="store_true",
        help="VACUUM INTO a full store copy first (minutes, GBs) instead of the slim "
        "backup (purged threads + messages, seconds, MBs)",
    )
    drop = sub.add_parser("drop-v1", help="delete the frozen 0.0.x state.sqlite (dry run unless --yes)")
    drop.add_argument("--yes", action="store_true")
    for command in (listing, apply_parser, drop):
        command.add_argument("--store", type=Path, default=DEFAULT_STORE, help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # `list` is the default verb, so bare filters work: `t3-purge-threads --settled`.
    if not argv or argv[0] not in ("list", "apply", "drop-v1", "-h", "--help"):
        argv.insert(0, "list")
    args = build_parser().parse_args(argv)
    if args.command == "drop-v1":
        return cmd_drop_v1(args)
    threads = load_threads(args.store, datetime.now(UTC))
    rows, kept = select(args, threads, pending_wakes(args.store))
    attach_files(rows, threads)
    return (cmd_list if args.command == "list" else cmd_apply)(args, rows, kept)


if __name__ == "__main__":
    raise SystemExit(main())
