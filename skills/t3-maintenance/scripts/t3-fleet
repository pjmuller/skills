#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Read-only fleet view over T3 Code threads (T3 >= 0.1), one line per thread.

Kinds: `top` (user thread), `launched` (started by another thread via
t3_thread_launch / t3-relay; parent = sender of its first message), `task`
(delegate_task child) and `subagent` (provider-native sub-agent). Tasks and
subagents are not top-level: shown with --subagents, --parent or --stalled.

Stalled (--stalled): a `task` still marked running whose child run has ended
(`stuck`), or whose finished result never reached its parent (`undelivered`).
Launched (📤) threads owe no report back. Act with the native tools
(task_status / t3_thread_send / t3_thread_organize), not from here.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from t3_store import (
    DEFAULT_STORE,
    LIVE_RUN,
    connect_readonly,
    iso,
    maybe_time,
    resolve_id,
    short_id,
)

DURATION_UNITS = {"m": 60, "h": 3600, "d": 86400, "w": 604800}
STUCK_AFTER = timedelta(minutes=10)
PREVIEW_CHARS = 80
TITLE_CHARS = 40
PROJECT_CHARS = 18


def parse_duration(value: str) -> timedelta:
    match = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([mhdw])", value.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError(
            f"expected a duration like 90m, 12h, 3d, 2w; got {value!r}"
        )
    return timedelta(seconds=float(match.group(1)) * DURATION_UNITS[match.group(2)])


def fmt_age(seconds: float) -> str:
    minutes = int(max(0.0, seconds) // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours}h{minutes:02d}m"
    days, hours = divmod(hours, 24)
    return f"{days}d{hours:02d}h"


def one_line(text: str, limit: int) -> str:
    flat = " ".join((text or "").split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


@dataclass
class Thread:
    thread_id: str
    project: str
    workspace_root: str
    title: str
    kind: str
    parent_id: str | None
    settled: bool
    pinned: bool
    run_status: str | None
    deleted: bool
    archived: bool
    created_at: str
    last_activity_at: str
    age_seconds: float
    last_role: str | None
    last_text: str
    task_status: str | None = None
    stall_state: str | None = None
    children: list[str] = field(default_factory=list)

    @property
    def live(self) -> bool:
        return self.run_status in LIVE_RUN

    def as_dict(self) -> dict[str, object]:
        # Shape consumed by t3-git-leftovers: keep these keys stable.
        return {
            "thread_id": self.thread_id,
            "short_id": short_id(self.thread_id),
            "project": self.project,
            "workspace_root": self.workspace_root,
            "title": self.title,
            "kind": self.kind,
            "parent_id": self.parent_id,
            "settled": self.settled,
            "pinned": self.pinned,
            "session_status": "running" if self.live else "idle",
            "run_status": self.run_status,
            "task_status": self.task_status,
            "created_at": self.created_at,
            "last_activity_at": self.last_activity_at,
            "age": fmt_age(self.age_seconds),
            "age_seconds": round(self.age_seconds),
            "last_role": self.last_role,
            "last_text": one_line(self.last_text, 400),
            "stalled": self.stall_state is not None,
            "stall_state": self.stall_state,
            "children": self.children,
            "deleted": self.deleted,
            "archived": self.archived,
        }


def load_fleet(store: Path, now: datetime) -> dict[str, Thread]:
    with connect_readonly(store) as db:
        rows = db.execute("""
            SELECT t.thread_id, t.title, t.created_at, t.updated_at, t.deleted_at, t.archived_at,
                   json_extract(t.payload_json, '$.settledOverride') AS settled_override,
                   json_extract(t.payload_json, '$.pinnedAt') AS pinned_at,
                   json_extract(t.payload_json, '$.lineage.parentThreadId') AS lineage_parent,
                   p.title AS project, p.workspace_root
            FROM orchestration_v2_projection_threads t
            LEFT JOIN projection_projects p ON p.project_id = t.project_id
        """).fetchall()
        runs = {
            row["thread_id"]: row["status"]
            for row in db.execute("""
                SELECT thread_id, status FROM (
                  SELECT thread_id, status,
                         ROW_NUMBER() OVER (PARTITION BY thread_id ORDER BY ordinal DESC) AS n
                  FROM orchestration_v2_projection_runs) WHERE n = 1
            """)
        }
        last: dict[str, tuple[str, str, str]] = {}
        first: dict[str, str | None] = {}
        for row in db.execute("""
            SELECT thread_id, role, created_at,
                   substr(json_extract(payload_json, '$.text'), 1, 400) AS text,
                   json_extract(payload_json, '$.senderThreadId') AS sender
            FROM orchestration_v2_projection_messages
            ORDER BY thread_id, created_at, message_id
        """):
            tid = row["thread_id"]
            last[tid] = (row["created_at"], row["role"], row["text"] or "")
            if row["role"] == "user":
                first.setdefault(tid, row["sender"])
        tasks = {
            row["child_thread_id"]: row
            for row in db.execute("""
                SELECT child_thread_id, thread_id AS parent, origin, status,
                       json_extract(payload_json, '$.completionDelivery.state') AS delivery
                FROM orchestration_v2_projection_subagents WHERE child_thread_id IS NOT NULL
            """)
        }

    threads: dict[str, Thread] = {}
    for row in rows:
        tid = row["thread_id"]
        last_at, last_role, last_text = last.get(tid, (row["created_at"], None, ""))
        moment = maybe_time(last_at) or maybe_time(row["updated_at"]) or now
        task = tasks.get(tid)
        sender = first.get(tid)
        if task is not None:
            kind = "task" if task["origin"] == "app_owned" else "subagent"
            parent = task["parent"]
        elif row["lineage_parent"]:
            kind, parent = "subagent", row["lineage_parent"]
        elif sender and sender != tid:
            kind, parent = "launched", sender
        else:
            kind, parent = "top", None
        thread = Thread(
            thread_id=tid,
            project=row["project"] or "?",
            workspace_root=row["workspace_root"] or "",
            title=row["title"],
            kind=kind,
            parent_id=parent,
            settled=row["settled_override"] == "settled",
            pinned=row["pinned_at"] is not None,
            run_status=runs.get(tid),
            deleted=row["deleted_at"] is not None,
            archived=row["archived_at"] is not None,
            created_at=row["created_at"],
            last_activity_at=iso(moment),
            age_seconds=(now - moment).total_seconds(),
            last_role=last_role,
            last_text=last_text,
            task_status=task["status"] if task is not None else None,
        )
        thread.stall_state = stall_state(thread, task)
        threads[tid] = thread
    for thread in threads.values():
        if thread.parent_id in threads:
            threads[thread.parent_id].children.append(thread.thread_id)
    return threads


def stall_state(thread: Thread, task) -> str | None:
    if thread.kind != "task" or thread.live:
        return None
    if thread.age_seconds < STUCK_AFTER.total_seconds():
        return None
    if task["status"] in ("running", "waiting"):
        return "stuck"
    if task["status"] == "completed" and task["delivery"] in ("pending", "claimed"):
        return "undelivered"
    return None


def git_root() -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        raise SystemExit("--here requires the current directory to be in a git repo")
    return result.stdout.strip()


def select(args: argparse.Namespace, threads: dict[str, Thread]) -> list[Thread]:
    rows = list(threads.values())
    if not args.all:
        rows = [t for t in rows if not t.deleted and not t.archived]
    if not (args.subagents or args.parent or args.stalled):
        rows = [t for t in rows if t.kind in ("top", "launched")]
    if args.recent is not None:
        rows = [t for t in rows if t.age_seconds <= args.recent.total_seconds()]
    if args.older_than is not None:
        rows = [t for t in rows if t.age_seconds >= args.older_than.total_seconds()]
    if args.title_prefix:
        rows = [t for t in rows if t.title.strip().startswith(args.title_prefix)]
    needle = git_root() if args.here else args.project
    if needle:
        low = needle.casefold()
        rows = [
            t
            for t in rows
            if low in t.project.casefold() or low in t.workspace_root.casefold()
        ]
    if args.parent:
        parent = resolve_id(threads, args.parent)
        rows = [t for t in rows if t.parent_id == parent]
    if args.status:
        rows = [t for t in rows if (t.run_status or "idle") == args.status]
    if args.settled is not None:
        rows = [t for t in rows if t.settled is args.settled]
    if args.stalled:
        rows = [t for t in rows if t.stall_state]
    return sorted(rows, key=lambda t: (t.age_seconds, t.thread_id))


def cmd_list(args: argparse.Namespace, threads: dict[str, Thread]) -> int:
    rows = select(args, threads)
    shown = rows[: args.limit]
    if args.json:
        print(json.dumps([t.as_dict() for t in shown], ensure_ascii=False, indent=2))
        return 0
    if not shown:
        print("No matching threads.")
        return 0
    for t in shown:
        state = t.stall_state or t.run_status or "idle"
        print(
            f"{short_id(t.thread_id)}  {t.kind[:8]:<8}  {one_line(t.project, PROJECT_CHARS):<{PROJECT_CHARS}}  "
            f"{one_line(t.title, TITLE_CHARS):<{TITLE_CHARS}}  {state[:11]:<11}  "
            f"{'✓' if t.settled else '·'}  {fmt_age(t.age_seconds):>7}  "
            f"{(t.last_role or '-')[:9]}: {one_line(t.last_text, PREVIEW_CHARS)}"
        )
    if len(rows) > len(shown):
        print(f"... {len(rows) - len(shown)} more (raise --limit)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--store", type=Path, default=DEFAULT_STORE, help=argparse.SUPPRESS
    )
    sub = parser.add_subparsers(dest="command", required=True)
    listing = sub.add_parser("list", help="one line per thread, newest activity first")
    listing.add_argument(
        "--recent", type=parse_duration, help="max age, e.g. 12h or 3d"
    )
    listing.add_argument("--older-than", type=parse_duration, help="min age, e.g. 30d")
    listing.add_argument("--title-prefix", help="literal title prefix, e.g. 📤")
    listing.add_argument("--project", help="project name or workspace-root substring")
    listing.add_argument(
        "--here", action="store_true", help="only the current git root"
    )
    listing.add_argument(
        "--parent", help="children (tasks, sub-agents, launches) of this id"
    )
    listing.add_argument(
        "--subagents", action="store_true", help="include tasks and sub-agents"
    )
    listing.add_argument(
        "--status", help="latest run status: running|completed|failed|idle|…"
    )
    listing.add_argument("--settled", dest="settled", action="store_true", default=None)
    listing.add_argument("--unsettled", dest="settled", action="store_false")
    listing.add_argument(
        "--stalled",
        action="store_true",
        help="stuck or undelivered delegate_task children",
    )
    listing.add_argument("--all", action="store_true", help="include deleted/archived")
    listing.add_argument("--limit", type=int, default=50)
    listing.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return cmd_list(args, load_fleet(args.store, datetime.now(UTC)))


if __name__ == "__main__":
    raise SystemExit(main())
