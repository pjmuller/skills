#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Read-only fleet view over T3 Code threads (T3 >= 0.1), one line per thread.

Kinds: `top` (user thread), `launched` (started by another thread via
t3_thread_launch / t3-relay; parent = sender of its first message), `task`
(delegate_task child) and `subagent` (provider-native sub-agent). Tasks and
subagents are not top-level: shown with --subagents, --parent or --stalled.

Stalled (--stalled): a `task` still marked running whose child run has ended
(`stuck`), or whose finished result never reached its parent (`undelivered`).
Launched (📤) threads owe no report back. Act with the native tools
(task_status / t3_thread_send / t3_thread_organize), not from here.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from t3_store import (
    DEFAULT_STORE,
    LIVE_RUN,
    connect_readonly,
    iso,
    maybe_time,
    resolve_id,
    short_id,
)

DURATION_UNITS = {"m": 60, "h": 3600, "d": 86400, "w": 604800}
STUCK_AFTER = timedelta(minutes=10)
PREVIEW_CHARS = 80
TITLE_CHARS = 40
PROJECT_CHARS = 18
LIMIT_TEXT = re.compile(
    r"(?:you(?:['’]ve| have) (?:hit|reached) (?:your |the )?(?:usage |rate |session )?limit|"
    r"(?:usage|rate)[ _-]limit(?:[ _-](?:reached|exceeded)|\s*[:·]|$)|"
    r"you(?:['’]re| are) out of (?:extra )?usage)", re.I
)


def parse_duration(value: str) -> timedelta:
    match = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([mhdw])", value.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError(
            f"expected a duration like 90m, 12h, 3d, 2w; got {value!r}"
        )
    return timedelta(seconds=float(match.group(1)) * DURATION_UNITS[match.group(2)])


def fmt_age(seconds: float) -> str:
    minutes = int(max(0.0, seconds) // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours}h{minutes:02d}m"
    days, hours = divmod(hours, 24)
    return f"{days}d{hours:02d}h"


def one_line(text: str, limit: int) -> str:
    flat = " ".join((text or "").split())
    return flat if len(flat) <= limit else flat[: limit - 1] + "…"


@dataclass
class Thread:
    thread_id: str
    project: str
    workspace_root: str
    title: str
    kind: str
    parent_id: str | None
    settled: bool
    pinned: bool
    run_status: str | None
    deleted: bool
    archived: bool
    created_at: str
    last_activity_at: str
    age_seconds: float
    last_role: str | None
    last_text: str
    task_status: str | None = None
    stall_state: str | None = None
    children: list[str] = field(default_factory=list)
    diagnostics: dict = field(default_factory=dict)

    @property
    def live(self) -> bool:
        return self.run_status in LIVE_RUN

    def as_dict(self) -> dict[str, object]:
        # Shape consumed by gitsync: keep these keys stable.
        return {
            "thread_id": self.thread_id,
            "short_id": short_id(self.thread_id),
            "project": self.project,
            "workspace_root": self.workspace_root,
            "title": self.title,
            "kind": self.kind,
            "parent_id": self.parent_id,
            "settled": self.settled,
            "pinned": self.pinned,
            "session_status": "running" if self.live else "idle",
            "run_status": self.run_status,
            "task_status": self.task_status,
            "created_at": self.created_at,
            "last_activity_at": self.last_activity_at,
            "age": fmt_age(self.age_seconds),
            "age_seconds": round(self.age_seconds),
            "last_role": self.last_role,
            "last_text": one_line(self.last_text, 400),
            "stalled": self.stall_state is not None,
            "stall_state": self.stall_state,
            "children": self.children,
            "deleted": self.deleted,
            "archived": self.archived,
            **self.diagnostics,
        }


def run_diagnostics(db) -> dict:
    """Keep latest submitted, latest executed, and first-run selection distinct."""
    result = {}
    for row in db.execute("""
        SELECT * FROM (
          SELECT *, ROW_NUMBER() OVER (PARTITION BY thread_id ORDER BY ordinal DESC) AS newest,
            ROW_NUMBER() OVER (PARTITION BY thread_id ORDER BY ordinal) AS first,
            ROW_NUMBER() OVER (PARTITION BY thread_id ORDER BY
              CASE WHEN status = 'queued' OR (status = 'cancelled' AND
                json_extract(payload_json, '$.startedAt') IS NULL) THEN 1 ELSE 0 END,
              completed_at IS NULL DESC, completed_at DESC, ordinal DESC, run_id DESC) AS executed
          FROM orchestration_v2_projection_runs
        ) WHERE newest = 1 OR first = 1 OR executed = 1
    """):
        data = dict(row)
        data["payload"] = json.loads(row["payload_json"])
        info = result.setdefault(row["thread_id"], {})
        if row["first"] == 1:
            info["first_run_selection"] = data["payload"].get("modelSelection")
        if row["executed"] == 1 and row["status"] != "queued" and not (
            row["status"] == "cancelled" and not data["payload"].get("startedAt")
        ):
            info["executed"] = data
    return result


def limit_diagnostic(db, thread, run, terminal, now) -> dict | None:
    if thread.settled or thread.deleted or thread.archived:
        return None
    # Queued submissions are held behind the failure; any executing run supersedes it.
    if run and run["status"] in LIVE_RUN:
        return None
    error = db.execute("""
        SELECT payload_json, updated_at FROM orchestration_v2_projection_turn_items
        WHERE thread_id = ? AND run_id = ? AND type = 'error' AND status = 'failed'
          AND node_id IS ? ORDER BY updated_at DESC, ordinal DESC, turn_item_id DESC LIMIT 1
    """, (thread.thread_id, run["run_id"], run["payload"].get("rootNodeId"))).fetchone() if run else None
    failure = (json.loads(error["payload_json"]).get("failure") or {}) if error else {}
    if run and run["status"] == "failed" and failure.get("class") == "usage_limit":
        reset = failure.get("resetAt")
        reset_time = maybe_time(reset)
        child = thread.kind in {"task", "subagent"}
        return {"status": "review_needed" if child else "actionable", "actionable": not child, "confidence": "high",
                **({"recovery_owner_id": thread.parent_id} if child else {}),
                "source": "root_error.failure.class", "run_id": run["run_id"],
                "limited_at": run["completed_at"] or error["updated_at"], "reset_at": reset,
                "reset_status": "unknown" if not reset_time else "due" if reset_time <= now else "waiting"}
    if terminal:
        at, role, text, run_id = terminal
        if (thread.kind == "subagent" and thread.task_status == "failed"
                and (not run or run["status"] == "failed")
                and (LIMIT_TEXT.search(text) or re.search(r"\brate[_ -]limit\b|\bHTTP\s*429\b", text, re.I))):
            return {"status": "review_needed", "actionable": False, "confidence": "low",
                    "source": "native_failed_child_text", "recovery_owner_id": thread.parent_id,
                    "run_id": run["run_id"] if run else None, "limited_at": at,
                    "reset_at": None, "reset_status": "unknown"}
        if not run:
            return None
        started = run["payload"].get("startedAt") or run["payload"].get("requestedAt")
        if (role == "assistant" and LIMIT_TEXT.search(text)
                and (run_id == run["run_id"] or (not run_id and started and at >= started))):
            return {"status": "suspected", "actionable": False, "confidence": "low",
                    "source": "terminal_assistant_text", "run_id": run["run_id"],
                    "limited_at": at, "reset_at": None, "reset_status": "unknown"}
    return None


def launch_evidence(db, parent_ids: set[str]) -> dict:
    """Corroborate known edges only, using actual tool results, never prompt text."""
    evidence = {}
    for row in db.execute("""
        SELECT thread_id, json_extract(payload_json, '$.toolName') AS tool,
          COALESCE(json_extract(payload_json, '$.output.structuredContent'),
                   json_extract(payload_json, '$.output')) AS output,
          COALESCE(json_extract(payload_json, '$.input.target'),
                   json_extract(payload_json, '$.input.modelSelection')) AS target
        FROM orchestration_v2_projection_turn_items WHERE type = 'dynamic_tool'
          AND thread_id IN (SELECT value FROM json_each(?))
          AND (payload_json LIKE '%t3_thread_launch%' OR payload_json LIKE '%delegate_task%')
          AND status = 'completed' AND (json_extract(payload_json, '$.toolName') LIKE '%t3_thread_launch'
            OR json_extract(payload_json, '$.toolName') LIKE '%delegate_task')
        ORDER BY updated_at, turn_item_id
    """, (json.dumps(sorted(parent_ids)),)):
        output = json.loads(row["output"] or "{}")
        if not isinstance(output, dict):
            continue
        child = output.get("childThreadId") or output.get("threadId")
        if child:
            selected = output.get("modelSelection") or {}
            requested = json.loads(row["target"] or "null")
            evidence.setdefault((row["thread_id"], child), {
                "source": row["tool"], "instance_id": selected.get("instanceId") or output.get("providerInstanceId") or output.get("instanceId"),
                "model": selected.get("model") or output.get("model"), "options": selected.get("options", output.get("options")),
                "requested_target": {k: requested[k] for k in ("providerInstanceId", "instanceId", "model", "options")
                                     if k in requested} if isinstance(requested, dict) else None})
    return evidence


def load_fleet(store: Path, now: datetime, *, corroborate: bool = False) -> dict[str, Thread]:
    with connect_readonly(store) as db:
        rows = db.execute("""
            SELECT t.thread_id, t.title, t.created_at, t.updated_at, t.deleted_at, t.archived_at,
                   json_extract(t.payload_json, '$.settledOverride') AS settled_override,
                   json_extract(t.payload_json, '$.pinnedAt') AS pinned_at,
                   json_extract(t.payload_json, '$.lineage.parentThreadId') AS lineage_parent,
                   t.provider_instance_id,
                   json_extract(t.payload_json, '$.modelSelection') AS model_selection,
                   p.title AS project, p.workspace_root
            FROM orchestration_v2_projection_threads t
            LEFT JOIN projection_projects p ON p.project_id = t.project_id
        """).fetchall()
        runs = {
            row["thread_id"]: row["status"]
            for row in db.execute("""
                SELECT thread_id, status FROM (
                  SELECT thread_id, status,
                         ROW_NUMBER() OVER (PARTITION BY thread_id ORDER BY ordinal DESC) AS n
                  FROM orchestration_v2_projection_runs) WHERE n = 1
            """)
        }
        last: dict[str, tuple[str, str, str]] = {}
        terminal = {}
        first: dict[str, str | None] = {}
        for row in db.execute("""
            SELECT thread_id, role, created_at,
                   substr(json_extract(payload_json, '$.text'), 1, 400) AS text,
                   substr(json_extract(payload_json, '$.text'), -400) AS tail, run_id,
                   json_extract(payload_json, '$.senderThreadId') AS sender
            FROM orchestration_v2_projection_messages
            ORDER BY thread_id, created_at, message_id
        """):
            tid = row["thread_id"]
            last[tid] = (row["created_at"], row["role"], row["text"] or "")
            terminal[tid] = (row["created_at"], row["role"], row["tail"] or "", row["run_id"])
            if row["role"] == "user":
                first.setdefault(tid, row["sender"])
        tasks = {
            row["child_thread_id"]: row
            for row in db.execute("""
                SELECT child_thread_id, thread_id AS parent, origin, status,
                       json_extract(payload_json, '$.completionDelivery.state') AS delivery
                FROM orchestration_v2_projection_subagents WHERE child_thread_id IS NOT NULL
            """)
        }

        run_info = run_diagnostics(db)
        parents = {p for p in [*first.values(), *(r["lineage_parent"] for r in rows),
                               *(t["parent"] for t in tasks.values())] if p}
        launches = launch_evidence(db, parents) if corroborate else {}
        threads: dict[str, Thread] = {}
        for row in rows:
            tid = row["thread_id"]
            last_at, last_role, last_text = last.get(tid, (row["created_at"], None, ""))
            moment = maybe_time(last_at) or maybe_time(row["updated_at"]) or now
            task = tasks.get(tid)
            sender = first.get(tid)
            if task is not None:
                kind = "task" if task["origin"] == "app_owned" else "subagent"
                parent = task["parent"]
            elif row["lineage_parent"]:
                kind, parent = "subagent", row["lineage_parent"]
            elif sender and sender != tid:
                kind, parent = "launched", sender
            else:
                kind, parent = "top", None
            thread = Thread(
                thread_id=tid,
                project=row["project"] or "?",
                workspace_root=row["workspace_root"] or "",
                title=row["title"],
                kind=kind,
                parent_id=parent,
                settled=row["settled_override"] == "settled",
                pinned=row["pinned_at"] is not None,
                run_status=runs.get(tid),
                deleted=row["deleted_at"] is not None,
                archived=row["archived_at"] is not None,
                created_at=row["created_at"],
                last_activity_at=iso(moment),
                age_seconds=(now - moment).total_seconds(),
                last_role=last_role,
                last_text=last_text,
                task_status=task["status"] if task is not None else None,
            )
            thread.stall_state = stall_state(thread, task)
            info = run_info.get(tid, {})
            executed = info.get("executed")
            selection = json.loads(row["model_selection"] or "{}")
            source = ("projection_subagents" if task is not None else "thread.lineage" if row["lineage_parent"]
                      else "first_user_message.senderThreadId" if parent else None)
            corroboration = launches.get((parent, tid))
            thread.diagnostics = {
                "provider_instance_id": selection.get("instanceId") or row["provider_instance_id"],
                "model": selection.get("model"), "options": selection.get("options", []),
                "first_run_selection": info.get("first_run_selection"),
                "parent_evidence": {"source": source, "confidence": "high" if parent else "unknown",
                                    "corroboration": corroboration},
                "latest_executed_run_id": executed["run_id"] if executed else None,
                "latest_executed_status": executed["status"] if executed else None,
                "limit": limit_diagnostic(db, thread, executed, terminal.get(tid), now),
            }
            threads[tid] = thread
    for thread in threads.values():
        if thread.parent_id in threads:
            threads[thread.parent_id].children.append(thread.thread_id)
    return threads


def stall_state(thread: Thread, task) -> str | None:
    if thread.kind != "task" or thread.live:
        return None
    if thread.age_seconds < STUCK_AFTER.total_seconds():
        return None
    if task["status"] in ("running", "waiting"):
        return "stuck"
    if task["status"] == "completed" and task["delivery"] in ("pending", "claimed"):
        return "undelivered"
    return None


def git_root() -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        raise SystemExit("--here requires the current directory to be in a git repo")
    return result.stdout.strip()


def select(args: argparse.Namespace, threads: dict[str, Thread]) -> list[Thread]:
    rows = list(threads.values())
    if not args.all:
        rows = [t for t in rows if not t.deleted and not t.archived]
    if not (args.subagents or args.parent or args.stalled or args.limited or args.lineage or args.descendants):
        rows = [t for t in rows if t.kind in ("top", "launched")]
    if args.recent is not None:
        rows = [t for t in rows if t.age_seconds <= args.recent.total_seconds()]
    if args.older_than is not None:
        rows = [t for t in rows if t.age_seconds >= args.older_than.total_seconds()]
    if args.title_prefix:
        rows = [t for t in rows if t.title.strip().startswith(args.title_prefix)]
    needle = git_root() if args.here else args.project
    if needle:
        low = needle.casefold()
        rows = [
            t
            for t in rows
            if low in t.project.casefold() or low in t.workspace_root.casefold()
        ]
    if args.parent:
        parent = resolve_id(threads, args.parent)
        rows = [t for t in rows if t.parent_id == parent]
    if args.descendants:
        root = resolve_id(threads, args.descendants)
        descendants, pending = set(), list(threads[root].children)
        while pending:
            child = pending.pop()
            if child == root or child in descendants:
                continue
            descendants.add(child)
            pending.extend(threads[child].children)
        rows = [t for t in rows if t.thread_id in descendants]
    if args.status:
        rows = [t for t in rows if (t.run_status or "idle") == args.status]
    if args.settled is not None:
        rows = [t for t in rows if t.settled is args.settled]
    if args.stalled:
        rows = [t for t in rows if t.stall_state]
    if args.limited:
        rows = [t for t in rows if t.diagnostics.get("limit")]
    return sorted(rows, key=lambda t: (t.age_seconds, t.thread_id))


def cmd_list(args: argparse.Namespace, threads: dict[str, Thread]) -> int:
    rows = select(args, threads)
    limit = args.limit if args.limit is not None else (None if args.limited or args.lineage or args.descendants else 50)
    shown = rows[:limit]
    if len(rows) > len(shown):
        print(f"WARNING: truncated: showing {len(shown)} of {len(rows)} threads (raise --limit)", file=sys.stderr)
    if args.json:
        print(json.dumps([t.as_dict() for t in shown], ensure_ascii=False, indent=2))
        return 0
    if not shown:
        print("No matching threads.")
        return 0
    for t in shown:
        if args.limited or args.lineage or args.descendants:
            d = t.diagnostics
            selection = f"{d['provider_instance_id']}/{d['model']} {json.dumps(d['options'], separators=(',', ':'))}"
            evidence = d["parent_evidence"]
            edge = f"parent={t.parent_id or '?'} ({evidence['confidence']}:{evidence['source'] or 'none'})"
            limited = d["limit"]
            detail = (f"limit={limited['status']} at={limited['limited_at']} reset={limited['reset_at'] or '?'} "
                      f"({limited['reset_status']}; {limited['confidence']}:{limited['source']})") if limited else ""
            if limited and limited.get("recovery_owner_id"):
                detail += f" recovery_owner={limited['recovery_owner_id']}"
            print(f"{short_id(t.thread_id)} {t.kind} {one_line(t.title, TITLE_CHARS)} "
                  f"created={t.created_at} run={t.run_status or 'idle'} executed={d['latest_executed_status'] or 'none'} "
                  f"{selection} {edge} {detail}".rstrip())
            continue
        state = t.stall_state or t.run_status or "idle"
        print(
            f"{short_id(t.thread_id)}  {t.kind[:8]:<8}  {one_line(t.project, PROJECT_CHARS):<{PROJECT_CHARS}}  "
            f"{one_line(t.title, TITLE_CHARS):<{TITLE_CHARS}}  {state[:11]:<11}  "
            f"{'✓' if t.settled else '·'}  {fmt_age(t.age_seconds):>7}  "
            f"{(t.last_role or '-')[:9]}: {one_line(t.last_text, PREVIEW_CHARS)}"
        )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--store", type=Path, default=DEFAULT_STORE, help=argparse.SUPPRESS
    )
    sub = parser.add_subparsers(dest="command", required=True)
    listing = sub.add_parser("list", help="one line per thread, newest activity first")
    listing.add_argument(
        "--recent", type=parse_duration, help="max age, e.g. 12h or 3d"
    )
    listing.add_argument("--older-than", type=parse_duration, help="min age, e.g. 30d")
    listing.add_argument("--title-prefix", help="literal title prefix, e.g. 📤")
    listing.add_argument("--project", help="project name or workspace-root substring")
    listing.add_argument(
        "--here", action="store_true", help="only the current git root"
    )
    listing.add_argument(
        "--parent", help="children (tasks, sub-agents, launches) of this id"
    )
    listing.add_argument("--descendants", help="all descendants of this id; compact lineage output")
    listing.add_argument("--lineage", action="store_true", help="compact selection/parent evidence; includes children")
    listing.add_argument("--limited", action="store_true", help="structured usage limits and suspected terminal limit text; includes children")
    listing.add_argument(
        "--subagents", action="store_true", help="include tasks and sub-agents"
    )
    listing.add_argument(
        "--status", help="latest run status: running|completed|failed|idle|…"
    )
    listing.add_argument("--settled", dest="settled", action="store_true", default=None)
    listing.add_argument("--unsettled", dest="settled", action="store_false")
    listing.add_argument(
        "--stalled",
        action="store_true",
        help="stuck or undelivered delegate_task children",
    )
    listing.add_argument("--all", action="store_true", help="include deleted/archived")
    listing.add_argument("--limit", type=int, help="row cap (default 50; diagnostics unbounded); warns on stderr")
    listing.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return cmd_list(args, load_fleet(args.store, datetime.now(UTC),
                                   corroborate=bool(args.lineage or args.descendants or args.limited)))


if __name__ == "__main__":
    raise SystemExit(main())
