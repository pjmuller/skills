#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["websockets>=13"]
# ///
"""Free the RAM held by T3 Code browser-preview tabs (macOS desktop app).

Every preview tab is a <webview> guest of the T3 window, one `T3 Code Helper
(Renderer)` process each. Tabs of settled threads stay mounted until closed
(t3code #15579), and agents don't always call `t3_preview_close`. With --apply this
closes every tab idle past --idle-hours whose thread has no running turn (settled,
archived or waiting for the user) through the server RPC `preview.close`: the same path
as `t3_preview_close`, and since T3 0.1 it frees the renderer (verified 2026-10-21 on
v0.1.1). An agent that needs the page again reopens it. Tabs of running threads are
never touched. Dry-run unless --apply. Log: ~/.local/state/t3-maintenance/preview-gc.log
"""

from __future__ import annotations

import argparse
import asyncio
import json
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import websockets

sys.path.insert(0, str(Path(__file__).resolve().parent))
from t3_store import DEFAULT_STORE, LIVE_RUN, connect_readonly

APP_BINARY = re.compile(r"/Applications/(T3 Code[^/]*)\.app/Contents/MacOS/\1")
RENDERER_MARK = "Helper (Renderer)"
GUEST_FLAG = "--enable-blink-features"  # webview guests carry it, the UI renderer does not
LOG = Path.home() / ".local/state/t3-maintenance/preview-gc.log"


def log(line: str) -> None:
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(line)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as handle:
        handle.write(f"{stamp} {line}\n")


# --- processes ---------------------------------------------------------------
def etime_seconds(etime: str) -> int:
    days, _, clock = etime.strip().rpartition("-")
    seconds = 0
    for part in clock.split(":"):
        seconds = seconds * 60 + int(part)
    return seconds + int(days or 0) * 86400


def renderers() -> tuple[bool, list[int]]:
    """(T3 app running, its tab renderers), only used for the log's before/after metrics.

    Only renderers younger than the UI renderer count: a few older ones (other windows)
    survive every window reload, so they are not ours to free. With several UI-like
    renderers (a transient spare one), all guests count."""
    table = subprocess.run(["ps", "-ax", "-ww", "-o", "pid=,ppid=,etime=,args="],
                           capture_output=True, text=True, check=True).stdout
    rows = [re.match(r"\s*(\d+)\s+(\d+)\s+(\S+)\s+(.*)", line).groups() for line in table.splitlines() if line.strip()]
    app = [int(pid) for pid, _ppid, _etime, args in rows if APP_BINARY.fullmatch(args)]
    if len(app) != 1:
        return False, []
    ui, guests = [], []
    for pid, ppid, etime, args in rows:
        if int(ppid) == app[0] and RENDERER_MARK in args and "--type=renderer" in args:
            (guests if GUEST_FLAG in args else ui).append((int(pid), etime_seconds(etime)))
    if len(ui) != 1:
        return True, [pid for pid, _age in guests]
    ui_age = ui[0][1]
    return True, [pid for pid, age in guests if age < ui_age]


def footprint_mb(pids: list[int]) -> int:
    if not pids:
        return 0
    wanted = {str(pid) for pid in pids}
    out = subprocess.run(["top", "-l", "1", "-stats", "pid,mem"], capture_output=True, text=True).stdout
    total = 0.0
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] in wanted:
            match = re.match(r"([\d.]+)([KMG]?)", parts[1])
            if match:
                value, unit = float(match.group(1)), match.group(2)
                total += value / 1024 if unit == "K" else value * 1024 if unit == "G" else value
    return round(total)


# --- T3 server ---------------------------------------------------------------
def t3_connection() -> tuple[str, str, list[str]]:
    """origin, base dir and bundled t3 CLI, via the t3-manage-thread bootstrap."""
    helper = shutil.which("t3-pick-instance")
    if not helper:
        sys.exit("t3-pick-instance not on PATH; install the t3-manage-thread helpers")
    common = Path(helper).resolve().parent / "lib/t3-common.sh"
    script = f'source "{common}"; t3_bootstrap >&2; printf "%s\\0%s\\0" "$t3_origin" "$t3_base_dir"; printf "%s\\0" "${{t3_cli[@]}}"'
    out = subprocess.run(["bash", "-c", script], capture_output=True, text=True, check=True).stdout
    origin, base_dir, *cli = out.rstrip("\0").split("\0")
    return origin, base_dir, cli


class Session:
    def __init__(self) -> None:
        self.origin, self.base_dir, self.cli = t3_connection()
        issued = json.loads(subprocess.run(
            [*self.cli, "auth", "session", "issue", "--base-dir", self.base_dir, "--ttl", "10m",
             "--label", "t3-preview-gc", "--subject", "local-skill", "--json"],
            capture_output=True, text=True, check=True).stdout)
        self.session_id, self.token = issued["sessionId"], issued["token"]

    def close(self) -> None:
        subprocess.run([*self.cli, "auth", "session", "revoke", "--base-dir", self.base_dir, self.session_id],
                       capture_output=True, timeout=15, check=False)

    def rpc(self, method: str, payloads: list[dict]) -> list[dict]:
        """Batch one Effect-RPC method over /ws; returns the Exit per payload, in order."""
        return asyncio.run(self._rpc(method, payloads)) if payloads else []

    async def _rpc(self, method: str, payloads: list[dict]) -> list[dict]:
        url = self.origin.replace("http", "ws", 1) + "/ws?orchestrationProtocol=2"
        exits: dict[str, dict] = {}
        async with websockets.connect(url, additional_headers={"Authorization": f"Bearer {self.token}"},
                                      max_size=None) as socket:
            for index, payload in enumerate(payloads):
                await socket.send(json.dumps({"_tag": "Request", "id": str(index), "tag": method,
                                              "payload": payload, "headers": []}))
            async with asyncio.timeout(60):
                while len(exits) < len(payloads):
                    messages = json.loads(await socket.recv())
                    for message in messages if isinstance(messages, list) else [messages]:
                        if message.get("_tag") == "Ping":
                            await socket.send(json.dumps({"_tag": "Pong"}))
                        elif message.get("_tag") == "Exit":
                            exits[message["requestId"]] = message["exit"]
        return [exits[str(index)] for index in range(len(payloads))]


def age_hours(stamp: str) -> float:
    return (datetime.now(timezone.utc) - datetime.fromisoformat(stamp.replace("Z", "+00:00"))).total_seconds() / 3600


# --- main --------------------------------------------------------------------
def load_threads() -> dict[str, dict]:
    """thread id -> {finished: settled/archived, running: latest run still live}."""
    with connect_readonly(DEFAULT_STORE) as db:
        rows = db.execute("""
            SELECT t.thread_id,
                   json_extract(t.payload_json, '$.settledOverride') = 'settled'
                     OR t.archived_at IS NOT NULL AS finished,
                   (SELECT r.status FROM orchestration_v2_projection_runs r
                    WHERE r.thread_id = t.thread_id ORDER BY r.ordinal DESC LIMIT 1) AS run
            FROM orchestration_v2_projection_threads t WHERE t.deleted_at IS NULL
        """).fetchall()
    return {row["thread_id"]: {"finished": bool(row["finished"]), "running": row["run"] in LIVE_RUN}
            for row in rows}


def survey(session: Session, idle_hours: float) -> tuple[list[dict], list[dict], list[dict]]:
    """(all tabs, closable tabs, tabs a running agent may be using).

    A tab's updatedAt moves on open/navigate/resize only, not on clicks, typing or
    snapshots, so every tab of a running thread counts as busy, whatever its age."""
    threads = load_threads()
    tabs = [tab for exit_ in session.rpc("preview.list", [{"threadId": tid} for tid in threads])
            if exit_.get("_tag") == "Success" for tab in exit_["value"]["sessions"]]
    busy = [tab for tab in tabs
            if not threads[tab["threadId"]]["finished"] and threads[tab["threadId"]]["running"]]
    stale = [tab for tab in tabs if tab not in busy and age_hours(tab["updatedAt"]) >= idle_hours]
    return tabs, stale, busy


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--apply", action="store_true", help="close the tabs; default is a dry run")
    parser.add_argument("--idle-hours", type=float, default=1.0, help="close idle tabs of threads without a running turn")
    args = parser.parse_args()
    mode = "apply" if args.apply else "dry-run"

    running, guests = renderers()
    if not running:
        log(f"{mode} SKIP T3 not running")
        return 0

    session = Session()
    try:
        tabs, stale, busy = survey(session, args.idle_hours)
        closed = 0
        if args.apply and stale:
            exits = session.rpc("preview.close", [{"threadId": t["threadId"], "tabId": t["tabId"]} for t in stale])
            closed = sum(exit_.get("_tag") == "Success" for exit_ in exits)
    finally:
        session.close()
    before = len(guests)
    if closed:
        time.sleep(5)  # close does not wait for the renderer to exit
        guests = renderers()[1]
    after = f" -> {len(guests)}" if closed else ""
    log(f"{mode} sessions={len(tabs)} stale={len(stale)} closed={closed} busy={len(busy)} "
        f"guests={before}{after} guest_mb={footprint_mb(guests)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
