#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Searchable backup archive of T3 threads, so purged threads stay findable.

  sync        archive every thread whose copy is missing or stale (read-only on T3's store)
  import      fold old `purged-threads-*.sqlite` slim backups in (0.0.x or V2 shape)
  scrub       re-redact the whole archive under the current rules (rebuild + verify + atomic swap);
              `--dry-run` only counts what it would redact
  stats       size and contents
  check       stdin holds a secret the archive would redact? prints true/false (+ categories on
              stderr), exit 0 = true, 1 = false; never prints values or touches the archive

Every write redacts secrets first (t3_redact.py: rules, limits). Output shows counts per
category, never values.

`t3-purge-threads apply` archives its cohort itself; `t3-find-thread` falls back to the archive.
Archive: $T3_ARCHIVE, default ~/.t3/backups/t3-archive.sqlite (mode 600). Schema: t3_archive.py.
"""

from __future__ import annotations

import argparse
import sqlite3
import sys
from pathlib import Path
from urllib.parse import quote

sys.path.insert(0, str(Path(__file__).resolve().parent))
from collections import Counter

from t3_archive import ARCHIVE, archive_threads, import_backup, open_archive, redacted, scan, scrub
from t3_store import DEFAULT_STORE, connect_readonly


def cmd_sync(args: argparse.Namespace) -> int:
    db = open_archive(args.archive)
    hits = Counter()
    with connect_readonly(args.store) as src, db:
        written = archive_threads(src, db, args.ids or None, changed_only=not args.force, hits=hits)
    print(f"archived {written} threads → {args.archive}; {summary(hits)}")
    return 0


def summary(hits: Counter) -> str:
    if not hits:
        return "nothing redacted"
    return f"redacted {sum(hits.values())} values (" + ", ".join(f"{k} {n}" for k, n in hits.most_common()) + ")"


def cmd_scrub(args: argparse.Namespace) -> int:
    if not args.archive.exists():
        raise SystemExit(f"no archive at {args.archive}")
    if args.dry_run:
        hits, threads = scan(args.archive)
        print(f"would redact in {threads} threads: {summary(hits)}")
        return 0
    hits = scrub(args.archive, step=lambda msg: print(msg, flush=True))
    print(summary(hits))
    return 0


def cmd_import(args: argparse.Namespace) -> int:
    db = open_archive(args.archive)
    for path in args.backups:
        hits = Counter()
        with db:
            written = import_backup(path, db, args.store, hits)
        print(f"imported {written} threads from {path.name} → {args.archive}; {summary(hits)}")
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    hits = Counter()
    redacted(sys.stdin.buffer.read().decode(errors="replace"), hits)  # the call every archive write makes
    print("true" if hits else "false")
    if hits:
        print(", ".join(f"{k} {n}" for k, n in hits.most_common()), file=sys.stderr)
    return 0 if hits else 1


def cmd_stats(args: argparse.Namespace) -> int:
    if not args.archive.exists():
        raise SystemExit(f"no archive at {args.archive}")
    db = sqlite3.connect(f"file:{quote(str(args.archive), safe='/')}?mode=ro", uri=True)
    size = args.archive.stat().st_size
    threads, oldest, newest = db.execute("SELECT COUNT(*), min(created_at), max(updated_at) FROM threads").fetchone()
    print(f"{args.archive}  {size / 1_048_576:.1f} MB · {threads} threads · {oldest} → {newest}")
    for source, n in db.execute("SELECT source, COUNT(*) FROM threads GROUP BY source"):
        print(f"  source {source}: {n} threads")
    if "redaction" in {row[1] for row in db.execute("PRAGMA table_info(threads)")}:
        for version, n in db.execute("SELECT redaction, COUNT(*) FROM threads GROUP BY 1 ORDER BY 1"):
            print(f"  redaction {'none' if version is None else f'v{version}'}: {n} threads")
    for role, n, chars in db.execute("SELECT role, COUNT(*), sum(length(text)) FROM entries GROUP BY role ORDER BY 3 DESC"):
        print(f"  {role:<10} {n:>8} entries  {chars / 1_048_576:>7.1f} MB text")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--archive", type=Path, default=ARCHIVE, help="archive path (default %(default)s)")
    parser.add_argument("--store", type=Path, default=DEFAULT_STORE, help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", required=True)
    sync = sub.add_parser("sync", help="archive missing or changed threads")
    sync.add_argument("ids", nargs="*", help="only these full thread ids")
    sync.add_argument("--force", action="store_true", help="rewrite unchanged threads too")
    sync.set_defaults(func=cmd_sync)
    imp = sub.add_parser("import", help="fold old purged-threads-*.sqlite backups in")
    imp.add_argument("backups", type=Path, nargs="+")
    imp.set_defaults(func=cmd_import)
    scr = sub.add_parser("scrub", help="re-redact the whole archive (rebuild, verify, swap)")
    scr.add_argument("--dry-run", action="store_true", help="only count what would be redacted")
    scr.set_defaults(func=cmd_scrub)
    sub.add_parser("stats", help="size and contents").set_defaults(func=cmd_stats)
    sub.add_parser("check", help="stdin: would the archive redact anything? true/false").set_defaults(func=cmd_check)
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
