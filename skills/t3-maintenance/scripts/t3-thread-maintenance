#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Audit and repair T3 Code thread-settlement state without editing its database."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import uuid
from collections.abc import Sequence
from dataclasses import asdict, dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from t3_store import (
    DEFAULT_STORE,
    connect_readonly,
    iso,
    maybe_time,
    parse_time,
)

DEFAULT_LOG_DIR = Path(
    os.environ.get(
        "T3_MAINTENANCE_STATE_DIR",
        Path.home() / ".local" / "state" / "t3-maintenance" / "actions",
    )
)
IDLE_STATUSES = {None, "ready", "stopped"}
DEFAULT_AUTO_SETTLE_DAYS = 3


@dataclass(frozen=True)
class Thread:
    thread_id: str
    project: str
    title: str
    last_activity_at: str
    age_days: float
    settled_override: str | None
    settled_at: str | None
    session_status: str | None
    pinned: bool
    pending_approval_count: int
    pending_user_input_count: int
    auto_settled: bool

    @property
    def blocked(self) -> bool:
        return (
            self.session_status not in IDLE_STATUSES
            or self.pending_approval_count > 0
            or self.pending_user_input_count > 0
        )

    def serializable(self) -> dict[str, object]:
        data = asdict(self)
        data["age_days"] = round(self.age_days, 2)
        data["blocked"] = self.blocked
        return data


def latest_timestamp(*values: str | None) -> datetime | None:
    parsed = [
        value for value in (maybe_time(item) for item in values) if value is not None
    ]
    return max(parsed) if parsed else None


def latest_settle_was_automatic(connection: sqlite3.Connection, thread_id: str) -> bool:
    row = connection.execute(
        """
        SELECT command_id
        FROM orchestration_events
        WHERE aggregate_kind = 'thread' AND stream_id = ? AND event_type = 'thread.settled'
        ORDER BY sequence DESC
        LIMIT 1
        """,
        (thread_id,),
    ).fetchone()
    return bool(row and (row["command_id"] or "").startswith("server:auto-settle:"))


def load_threads(
    store: Path, now: datetime, thread_id: str | None = None
) -> list[Thread]:
    query = """
        SELECT t.thread_id, p.title AS project, t.title,
               t.created_at, t.latest_user_message_at,
               (SELECT MAX(m.created_at) FROM projection_thread_messages m
                WHERE m.thread_id = t.thread_id) AS latest_message_at,
               lt.requested_at, lt.started_at, lt.completed_at,
               t.settled_override, t.settled_at, t.pinned_at,
               t.pending_approval_count, t.pending_user_input_count,
               s.status AS session_status
        FROM projection_threads t
        JOIN projection_projects p ON p.project_id = t.project_id
        LEFT JOIN projection_turns lt
          ON lt.thread_id = t.thread_id AND lt.turn_id = t.latest_turn_id
        LEFT JOIN projection_thread_sessions s ON s.thread_id = t.thread_id
        WHERE t.deleted_at IS NULL AND t.archived_at IS NULL
          AND p.deleted_at IS NULL
          AND (? IS NULL OR t.thread_id = ?)
        ORDER BY t.created_at DESC, t.thread_id
    """
    threads: list[Thread] = []
    with connect_readonly(store) as connection:
        for row in connection.execute(query, (thread_id, thread_id)):
            last = (
                latest_timestamp(
                    row["latest_user_message_at"],
                    row["latest_message_at"],
                    row["requested_at"],
                    row["started_at"],
                    row["completed_at"],
                    row["created_at"],
                )
                or now
            )
            settled_override = row["settled_override"]
            auto_settled = (
                settled_override == "settled"
                and latest_settle_was_automatic(connection, row["thread_id"])
            )
            threads.append(
                Thread(
                    thread_id=row["thread_id"],
                    project=row["project"],
                    title=row["title"],
                    last_activity_at=iso(last),
                    age_days=max(0.0, (now - last).total_seconds() / 86_400),
                    settled_override=settled_override,
                    settled_at=row["settled_at"],
                    session_status=row["session_status"],
                    pinned=row["pinned_at"] is not None,
                    pending_approval_count=row["pending_approval_count"],
                    pending_user_input_count=row["pending_user_input_count"],
                    auto_settled=auto_settled,
                )
            )
    return threads


def auto_settle_config(store: Path) -> tuple[float | None, str]:
    settings = store.parent / "settings.json"
    if not settings.exists():
        return DEFAULT_AUTO_SETTLE_DAYS, "default"
    try:
        payload = json.loads(settings.read_text())
    except (OSError, json.JSONDecodeError):
        return None, "unreadable"
    if "sidebarAutoSettleAfterDays" not in payload:
        return DEFAULT_AUTO_SETTLE_DAYS, "default"
    value = payload["sidebarAutoSettleAfterDays"]
    return (
        (float(value), "explicit")
        if isinstance(value, (int, float))
        else (None, "disabled")
    )


def filtered(
    threads: Sequence[Thread], project: str | None, title: str | None
) -> list[Thread]:
    project_needle = project.casefold() if project else None
    title_needle = title.casefold() if title else None
    return [
        thread
        for thread in threads
        if (project_needle is None or project_needle in thread.project.casefold())
        and (title_needle is None or title_needle in thread.title.casefold())
    ]


def trim(threads: Sequence[Thread], limit: int) -> list[Thread]:
    return list(
        sorted(threads, key=lambda item: (-item.age_days, item.project, item.title))[
            :limit
        ]
    )


def print_threads(threads: Sequence[Thread], output_format: str, limit: int) -> None:
    rows = trim(threads, limit)
    if output_format == "ids":
        for thread in rows:
            print(thread.thread_id)
        return
    if output_format == "json":
        print(
            json.dumps(
                [thread.serializable() for thread in rows], ensure_ascii=False, indent=2
            )
        )
        return
    if not rows:
        print("No matching threads.")
        return
    print(f"{'ID':8}  {'AGE':>5}  {'STATE':8}  {'STATUS':8}  {'PROJECT':24}  TITLE")
    for thread in rows:
        state = thread.settled_override or "legacy"
        status = thread.session_status or "-"
        print(
            f"{thread.thread_id[:8]:8}  {thread.age_days:5.1f}  {state:8}  {status:8}  "
            f"{thread.project[:24]:24}  {thread.title}"
        )
    if len(threads) > len(rows):
        print(
            f"... {len(threads) - len(rows)} more; raise --limit or use --format json"
        )


def audit(
    args: argparse.Namespace, threads: Sequence[Thread], now: datetime, store: Path
) -> None:
    scoped = filtered(threads, args.project, args.title)
    legacy_old = [
        thread
        for thread in scoped
        if thread.settled_override is None
        and thread.age_days >= args.older_than
        and not thread.pinned
        and not thread.blocked
    ]
    recent_auto = [
        thread
        for thread in scoped
        if thread.auto_settled and thread.age_days < args.recent_days
    ]
    settle_days, settle_source = auto_settle_config(store)
    summary = {
        "generated_at": iso(now),
        "live_threads": len(scoped),
        "active_or_legacy": sum(item.settled_override != "settled" for item in scoped),
        "settled": sum(item.settled_override == "settled" for item in scoped),
        "non_idle_sessions": sum(
            item.session_status not in IDLE_STATUSES for item in scoped
        ),
        "pinned": sum(item.pinned for item in scoped),
        "auto_settle_after_days": settle_days,
        "auto_settle_setting": settle_source,
        "legacy_active_older_than_days": args.older_than,
        "legacy_active_candidates": len(legacy_old),
        "recent_days": args.recent_days,
        "recent_auto_settled": len(recent_auto),
    }
    if args.format == "json":
        print(
            json.dumps(
                {
                    "summary": summary,
                    "legacy_active_candidates": [
                        item.serializable() for item in trim(legacy_old, args.limit)
                    ],
                    "recent_auto_settled": [
                        item.serializable() for item in trim(recent_auto, args.limit)
                    ],
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return
    print(" ".join(f"{key}={value}" for key, value in summary.items()))
    print(f"\nLegacy active >= {args.older_than:g}d ({len(legacy_old)})")
    print_threads(legacy_old, args.format, args.limit)
    print(f"\nAuto-settled with activity < {args.recent_days:g}d ({len(recent_auto)})")
    print_threads(recent_auto, args.format, args.limit)


def list_threads(args: argparse.Namespace, threads: Sequence[Thread]) -> None:
    matches = filtered(threads, args.project, args.title)
    if args.state == "active":
        matches = [item for item in matches if item.settled_override != "settled"]
    elif args.state == "settled":
        matches = [item for item in matches if item.settled_override == "settled"]
    if args.older_than is not None:
        matches = [item for item in matches if item.age_days >= args.older_than]
    if args.newer_than is not None:
        matches = [item for item in matches if item.age_days < args.newer_than]
    print_threads(matches, args.format, args.limit)


def settle_old_candidates(
    args: argparse.Namespace, threads: Sequence[Thread]
) -> list[Thread]:
    return [
        thread
        for thread in filtered(threads, args.project, args.title)
        if thread.settled_override is None
        and thread.age_days >= args.older_than
        and not thread.pinned
        and not thread.blocked
    ]


def revive_auto_candidates(
    args: argparse.Namespace,
    threads: Sequence[Thread],
    now: datetime,
) -> list[Thread]:
    since = parse_time(args.since) if args.since else now - timedelta(hours=24)
    return [
        thread
        for thread in filtered(threads, args.project, args.title)
        if thread.auto_settled
        and thread.age_days < args.newer_than
        and maybe_time(thread.settled_at) is not None
        and maybe_time(thread.settled_at) >= since
        and not thread.blocked
    ]


def persist_action_log(path: Path, payload: dict[str, object]) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
    temporary.replace(path)


def apply_mutation(
    operation: str,
    candidates: Sequence[Thread],
    args: argparse.Namespace,
    store: Path,
    now: datetime,
) -> None:
    ordered = trim(candidates, len(candidates))
    print(f"Plan: {operation} {len(ordered)} thread(s)")
    print_threads(ordered, args.format, args.limit)
    if not args.apply:
        print("Dry run only; repeat with --apply after reviewing the exact cohort.")
        return
    if len(ordered) > args.max:
        raise SystemExit(f"Refusing {len(ordered)} mutations; --max is {args.max}")
    helper = shutil.which("t3-settle-thread")
    if not helper:
        raise SystemExit(
            "t3-settle-thread is not on PATH; install t3-manage-thread first"
        )
    DEFAULT_LOG_DIR.mkdir(parents=True, exist_ok=True)
    unique = uuid.uuid4().hex[:8]
    log_path = (
        DEFAULT_LOG_DIR
        / f"{now.strftime('%Y%m%dT%H%M%S.%fZ')}-{operation}-{unique}.json"
    )
    actions: list[dict[str, object]] = []
    action_log: dict[str, object] = {
        "started_at": iso(now),
        "operation": operation,
        "store": str(store),
        "filters": {
            key: value
            for key, value in vars(args).items()
            if key not in {"func", "store"}
        },
        "actions": actions,
    }
    persist_action_log(log_path, action_log)
    failures = 0
    skipped = 0
    dispatched: list[Thread] = []
    for planned in ordered:
        revalidated_at = datetime.now(timezone.utc)
        fresh = load_threads(store, revalidated_at, planned.thread_id)
        eligible = (
            settle_old_candidates(args, fresh)
            if operation == "settle"
            else revive_auto_candidates(args, fresh, revalidated_at)
        )
        if not eligible:
            skipped += 1
            actions.append(
                {
                    "thread": planned.serializable(),
                    "ok": False,
                    "skipped": "no longer eligible at dispatch time",
                }
            )
            persist_action_log(log_path, action_log)
            print(f"SKIP {planned.thread_id[:8]} changed since plan · {planned.title}")
            continue
        thread = fresh[0]
        if operation == "settle":
            command = [helper, thread.thread_id]
        else:
            assert thread.settled_at is not None
            command = [
                helper,
                "--unsettle",
                "--only-settled-at",
                thread.settled_at,
                thread.thread_id,
            ]
        dispatched.append(thread)
        action: dict[str, object] = {
            "thread": thread.serializable(),
            "command": command[1:],
            "status": "dispatching",
        }
        actions.append(action)
        persist_action_log(log_path, action_log)
        result = subprocess.run(command, text=True, capture_output=True, check=False)
        ok = result.returncode == 0
        failures += not ok
        action.update(
            {
                "status": "complete",
                "ok": ok,
                "returncode": result.returncode,
                "stdout": result.stdout.strip(),
                "stderr": result.stderr.strip(),
            }
        )
        persist_action_log(log_path, action_log)
        print(
            f"{'ok' if ok else 'FAILED'} {thread.thread_id[:8]} {thread.project} · {thread.title}"
        )

    projected = {
        item.thread_id: item for item in load_threads(store, datetime.now(timezone.utc))
    }
    expected = "settled" if operation == "settle" else "active"
    mismatches = [
        item.thread_id
        for item in dispatched
        if item.thread_id not in projected
        or projected[item.thread_id].settled_override != expected
    ]
    print(f"Action log: {log_path}")
    print(
        f"Verified: {len(dispatched) - len(mismatches)}/{len(dispatched)} projected as {expected}; "
        f"skipped_after_revalidation={skipped}"
    )
    if failures or mismatches:
        raise SystemExit(
            f"Mutation incomplete: failures={failures} verification_mismatches={len(mismatches)}"
        )


def common_filters(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--project", help="case-insensitive project substring")
    parser.add_argument("--title", help="case-insensitive title substring")
    parser.add_argument("--format", choices=("table", "json", "ids"), default="table")
    parser.add_argument(
        "--limit", type=int, default=200, help="maximum displayed rows (default: 200)"
    )


def mutation_options(parser: argparse.ArgumentParser) -> None:
    common_filters(parser)
    parser.add_argument(
        "--apply", action="store_true", help="perform the planned operations"
    )
    parser.add_argument(
        "--max", type=int, default=100, help="mutation safety cap (default: 100)"
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--store", type=Path, default=DEFAULT_STORE, help=argparse.SUPPRESS
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    audit_parser = subparsers.add_parser(
        "audit", help="summarize state anomalies and repair candidates"
    )
    common_filters(audit_parser)
    audit_parser.add_argument("--older-than", type=float, default=30)
    audit_parser.add_argument("--recent-days", type=float, default=14)

    list_parser = subparsers.add_parser("list", help="list live threads with filters")
    common_filters(list_parser)
    list_parser.add_argument(
        "--state", choices=("active", "settled", "all"), default="all"
    )
    list_parser.add_argument("--older-than", type=float)
    list_parser.add_argument("--newer-than", type=float)

    settle_parser = subparsers.add_parser(
        "settle-old", help="settle idle legacy null-override threads"
    )
    mutation_options(settle_parser)
    settle_parser.add_argument("--older-than", type=float, default=30)

    revive_parser = subparsers.add_parser(
        "revive-auto", help="unsettle a recent server-auto-settled cohort"
    )
    mutation_options(revive_parser)
    revive_parser.add_argument(
        "--since", help="settled-at lower bound; default: 24 hours ago"
    )
    revive_parser.add_argument("--newer-than", type=float, default=14)
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.limit <= 0:
        parser.error("--limit must be positive")
    for name in ("older_than", "newer_than", "recent_days", "max"):
        value = getattr(args, name, None)
        if value is not None and value <= 0:
            parser.error(f"--{name.replace('_', '-')} must be positive")
    now = datetime.now(timezone.utc)
    threads = load_threads(args.store, now)
    if args.command == "audit":
        audit(args, threads, now, args.store)
    elif args.command == "list":
        list_threads(args, threads)
    elif args.command == "settle-old":
        apply_mutation(
            "settle", settle_old_candidates(args, threads), args, args.store, now
        )
    elif args.command == "revive-auto":
        apply_mutation(
            "unsettle",
            revive_auto_candidates(args, threads, now),
            args,
            args.store,
            now,
        )


if __name__ == "__main__":
    main()
