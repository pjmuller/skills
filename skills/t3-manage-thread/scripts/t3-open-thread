#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Open a T3 thread in the desktop app via its native deep link.

    t3-open-thread c811b689              # short id (>=8 chars) or full thread id
    t3-open-thread c811b689 --link       # [title](t3-thread://v1/<threadId>) for T3 chat
    t3-open-thread c811b689 --dry-run    # print the t3code:// URL (use it in HTML reports)

Reads $T3CODE_HOME/userdata/statev2.sqlite read-only; the environment id comes from the running
server (server-runtime.json origin + /.well-known/t3/environment).
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import urllib.request
from pathlib import Path
from urllib.parse import quote

STORE = Path(os.environ.get("T3CODE_HOME", Path.home() / ".t3")) / "userdata" / "statev2.sqlite"
RUNTIME_FILE = STORE.parent / "server-runtime.json"
FALLBACK_ORIGIN = "http://127.0.0.1:3773"

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from thread_ids import id_key, short_id  # noqa: E402


def lookup(ident: str) -> tuple[str, str]:
    """Exact full id, else a >=8-char prefix of the id_key."""
    if not STORE.exists():
        sys.exit(f"T3 store not found at {STORE}")
    db = sqlite3.connect(f"file:{quote(str(STORE), safe='/')}?mode=ro", uri=True)
    try:
        rows = db.execute(
            "SELECT thread_id, title FROM orchestration_v2_projection_threads WHERE deleted_at IS NULL"
        ).fetchall()
    finally:
        db.close()
    exact = [row for row in rows if row[0] == ident]
    if exact:
        return exact[0]
    needle = ident.strip().lower()
    if len(needle) < 8:
        sys.exit(f"thread id {ident!r} too short; use at least 8 characters")
    matches = [row for row in rows if id_key(row[0]).startswith(needle)]
    if not matches:
        sys.exit(f"no thread matching {ident!r}")
    if len(matches) > 1:
        sys.exit(f"ambiguous thread id {ident!r}: {', '.join(id_key(r[0])[:12] for r in matches)}")
    return matches[0]


def environment_id() -> str:
    try:
        origin = json.loads(RUNTIME_FILE.read_text())["origin"]
    except Exception:
        origin = FALLBACK_ORIGIN
    try:
        with urllib.request.urlopen(f"{origin}/.well-known/t3/environment", timeout=2) as response:
            env = json.loads(response.read()).get("environmentId")
    except Exception:
        env = None
    if not env:
        sys.exit(f"T3 server not reachable at {origin}; cannot resolve the environment id")
    return env


def desktop_url(env: str, thread_id: str) -> str:
    return f"t3code://threads/{env}/{quote(thread_id, safe='')}"


def markdown_link(title: str, thread_id: str) -> str:
    label = title.replace("[", "(").replace("]", ")").replace("|", "/")
    return f"[{label}](t3-thread://v1/{thread_id})"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Open a T3 thread in the desktop app.")
    parser.add_argument("target", help="short id (>=8 chars) or full thread id")
    parser.add_argument("--link", action="store_true", help="print a T3 chat markdown link and exit")
    parser.add_argument("--dry-run", action="store_true", help="print the t3code:// URL, do not open")
    args = parser.parse_args(argv)

    thread_id, title = lookup(args.target)
    if args.link:
        print(markdown_link(title, thread_id))
        return 0
    url = desktop_url(environment_id(), thread_id)
    if args.dry_run:
        print(f"would open: {title} ({short_id(thread_id)}) {url}")
        return 0
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    result = subprocess.run([opener, url], check=False)
    if result.returncode:
        return result.returncode
    print(f"opened: {title} ({short_id(thread_id)})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
