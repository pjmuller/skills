#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""t3-relay: let a script OUTSIDE T3 (launchd job, poller) start or message a T3 thread.

Agents inside T3 never need this: they call the T3 MCP tools directly.

    t3-relay launch --project PATH --title TITLE [--model M] [--instance ID] [--effort E]
                    [--allow-small-model] [--settle-when-done] [--wait SECS] -- PROMPT
    t3-relay send   --thread ID [--mode auto|queue|steer] [--wait SECS] -- MESSAGE
    t3-relay status RID   # ok <ids> | failed <why> | pending
    t3-relay check        # T3 reachable, MCP client approved

How: calls T3's own MCP endpoint (loopback /mcp, the tools agents use) as an approved MCP
client "t3-relay" with full-access ceiling. The client token comes from T3's OAuth flow, approved
with a one-time pairing code from the local `t3 auth pairing create` (no human step), cached 0600
and renewed before its 30-day expiry. No relay host thread, no webhook, no model in the path.
Read-only statev2.sqlite lookups remain only for `status` after a lost response.
Exit: 0 done (prints `accepted: relay <rid>`; without --wait also when T3's answer was lost: ask
`status`); 1 failed (T3 refused or unreachable, nothing ran); 2 usage; 3 still unknown after --wait.
"""
import argparse
import base64
import fcntl
import http.client
import hashlib
import json
import os
import secrets
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

LEGACY_HOST_TITLE = "⚙️ T3 relay"   # webhook host tasks from before 2026-10-21: `check` flags them
# A standalone thread orchestrates, so it runs on a frontier model. Small models stay
# sub-agents/workers unless the caller passes --allow-small-model (orchestration already done).
DEFAULT_MODELS = ("opus", "astra")    # first one t3-pick-instance can route wins
SMALL_MODELS = ("haiku", "luna")    # substrings of the resolved model id
HOME = Path(os.environ.get("T3CODE_HOME", Path.home() / ".t3")) / "userdata"
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "lib"))
from profile_registry import registry, family
REQUESTS = HOME / "t3-relay"        # one record per request, for `status`
TOKEN_FILE = REQUESTS / "mcp-client.secret"   # not *.json: request cleanup must not eat it
KEEP_DAYS = 7
RENEW = timedelta(days=3)           # re-approve when the 30-day client token is this close to expiry
CALL_TIMEOUT = 60                   # launch/send answer in ~1 s; callers kill t3-relay at 180 s
GIVE_UP = timedelta(minutes=10)     # a lost response whose effect is still absent by now never ran
CLIENT = "t3-relay"
REDIRECT = "http://127.0.0.1/t3-relay/callback"   # never opened: the code comes back in the JSON reply
# full-access ceiling (scheduled jobs run unattended); the pairing code must hold every scope it grants
SCOPES = ("orchestration:read", "orchestration:operate", "settings:write", "source-control:write")


def die(msg: str, code: int = 1) -> None:
    print(f"t3-relay: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now() -> datetime:
    return datetime.now(timezone.utc)


def ts(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def store() -> sqlite3.Connection:
    db = HOME / "statev2.sqlite"
    if not db.exists():
        die(f"{db} not found: T3 Code >= 0.1 must have run on this machine")
    return sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)


def origin() -> str:
    for f in (HOME / "server-runtime.json", HOME / "last-server-origin"):
        if f.exists():
            text = f.read_text().strip()
            url = json.loads(text)["origin"] if f.suffix == ".json" else text
            host = urllib.parse.urlparse(url).hostname
            if host not in ("127.0.0.1", "localhost", "::1"):
                die(f"refusing non-loopback T3 origin {url}")
            return url
    die("T3 Code is not running (no server-runtime.json)")



def t3_cli() -> str:
    """The desktop app's own CLI (~/.t3/bin/t3, matches the running server); a global `t3` can lag."""
    for cand in (os.environ.get("T3CODE_CLI_PATH"), str(HOME.parent / "bin" / "t3"), shutil.which("t3")):
        if cand and os.access(cand, os.X_OK):
            return cand
    die("t3 CLI not found (open T3 Code once: it writes ~/.t3/bin/t3)")


def fetch(base: str, path: str, body: dict, headers: dict | None = None, form: bool = False,
         timeout: float = 30) -> tuple[dict | None, dict]:
    data = urllib.parse.urlencode(body).encode() if form else json.dumps(body).encode()
    h = {"Content-Type": "application/x-www-form-urlencoded" if form else "application/json", **(headers or {})}
    with urllib.request.urlopen(urllib.request.Request(base + path, data, h), timeout=timeout) as resp:
        raw = resp.read()
        return (json.loads(raw) if raw else None), dict(resp.headers)


def approve(base: str) -> dict:
    """OAuth (PKCE) as MCP client CLIENT, approved by a one-time pairing code minted locally."""
    try:
        client, _ = fetch(base, "/oauth/mcp/register", {"client_name": CLIENT, "redirect_uris": [REDIRECT]})
        verifier = secrets.token_urlsafe(48)
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
        pairing = subprocess.run([t3_cli(), "auth", "pairing", "create", "--ttl", "2m", "--json",
                                  "--label", f"{CLIENT} MCP approval", *[a for s in SCOPES for a in ("--scope", s)]],
                                 capture_output=True, text=True, timeout=60)
        if pairing.returncode:
            die(f"t3 auth pairing create failed: {pairing.stderr.strip()[-300:]}")
        auth = {"response_type": "code", "client_id": client["client_id"], "redirect_uri": REDIRECT,
                "code_challenge": challenge, "code_challenge_method": "S256",
                "state": secrets.token_hex(8), "resource": base + "/mcp"}
        decision, _ = fetch(base, "/oauth/mcp/decision", {"authorization": auth, "decision": {
            "_tag": "pairing-code", "access": "full-access", "code": json.loads(pairing.stdout)["credential"]}})
        query = dict(urllib.parse.parse_qsl(urllib.parse.urlparse(decision["redirectTo"]).query))
        if "code" not in query:
            die(f"MCP approval refused: {query.get('error')} {query.get('error_description', '')}")
        token, _ = fetch(base, "/oauth/mcp/token", {"grant_type": "authorization_code", "code": query["code"],
                                                   "redirect_uri": REDIRECT, "client_id": client["client_id"],
                                                   "code_verifier": verifier, "resource": base + "/mcp"}, form=True)
    except urllib.error.HTTPError as exc:  # bodies carry no secrets, but keep them short
        die(f"MCP approval failed: HTTP {exc.code} at {urllib.parse.urlparse(exc.url).path}: {exc.read()[:200]!r}")
    return save_token({"token": token["access_token"], "origin": base,
                       "expires_at": stamp(now() + timedelta(seconds=token["expires_in"]))})


def save_token(rec: dict) -> dict:
    fd, tmp = tempfile.mkstemp(dir=TOKEN_FILE.parent, prefix=".mcp-client-")   # 0600, unique per writer
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(rec))
    os.replace(tmp, TOKEN_FILE)
    return rec


def cached_token(base: str, reject: str | None = None) -> dict | None:
    try:
        rec = json.loads(TOKEN_FILE.read_text())
    except (OSError, ValueError):
        return None
    ok = rec.get("origin") == base and rec.get("token") != reject and ts(rec["expires_at"]) - now() > RENEW
    return rec if ok else None


def client_token(base: str, reject: str | None = None) -> dict:
    """Cached token, else approve once; jobs renewing together serialize and reuse the winner's token.
    `reject` = a token T3 just answered 401 to."""
    rec = cached_token(base, reject)
    if rec:
        return rec
    REQUESTS.mkdir(parents=True, exist_ok=True)
    with open(REQUESTS / ".mcp-client.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return cached_token(base, reject) or approve(base)


class Unknown(Exception):
    """The request may have reached T3, but its answer was lost."""


class Mcp:
    def __init__(self, base: str):
        self.base, self.sid = base, None
        self.token = client_token(base)["token"]
        try:
            self._open()
        except urllib.error.HTTPError as exc:
            if exc.code != 401:  # revoked or T3's store was reset: approve once more
                raise
            self.token = client_token(base, reject=self.token)["token"]
            self._open()

    def _rpc(self, method: str, params: dict | None = None, id: int | None = 1, timeout: float = 30):
        body = {"jsonrpc": "2.0", "method": method, **({"id": id} if id is not None else {}),
                **({"params": params} if params is not None else {})}
        h = {"Authorization": f"Bearer {self.token}", "Accept": "application/json, text/event-stream",
             "MCP-Protocol-Version": "2025-06-18", **({"Mcp-Session-Id": self.sid} if self.sid else {})}
        reply, headers = fetch(self.base, "/mcp", body, h, timeout=timeout)
        self.sid = self.sid or {k.lower(): v for k, v in headers.items()}.get("mcp-session-id")
        return reply

    def _open(self) -> None:
        self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": CLIENT, "version": "1"}})
        self._rpc("notifications/initialized", id=None)

    def call(self, tool: str, args: dict) -> dict:
        """Tool result; die() when T3 refused (nothing ran); Unknown when the answer was lost
        (timeout, reset, truncated or unparsable reply: T3 may have acted)."""
        try:
            reply = self._rpc("tools/call", {"name": tool, "arguments": args}, id=2, timeout=CALL_TIMEOUT)
        except urllib.error.HTTPError as exc:
            if exc.code < 500:
                die(f"{tool}: HTTP {exc.code}")
            raise Unknown(f"{tool}: HTTP {exc.code}") from exc
        except (OSError, http.client.HTTPException, ValueError) as exc:
            raise Unknown(f"{tool}: {type(exc).__name__}") from exc
        if "error" in reply:
            die(f"{tool}: {reply['error'].get('message', reply['error'])}"[:500])
        result = reply["result"]
        text = "".join(c.get("text", "") for c in result.get("content", []))
        if result.get("isError"):
            die(f"{tool} refused: {text}"[:500])
        try:
            return result.get("structuredContent") or json.loads(text or "{}")
        except ValueError:
            return {"text": text}


def connect(base: str) -> Mcp:
    try:
        return Mcp(base)
    except (OSError, urllib.error.URLError) as exc:  # never echo headers: they carry the token
        die(f"T3 MCP unreachable on {base}: {type(exc).__name__} {getattr(exc, 'code', '')}".rstrip())


def project_id(mcp: Mcp, path: str) -> str:
    root = str(Path(path).expanduser().resolve())
    for p in mcp.call("t3_project_list", {}).get("projects", []):
        if p.get("workspaceRoot") == root and not p.get("deletedAt"):
            return p["id"]
    die(f"no T3 project for {root}; add it in T3 first")


def completion_footer() -> str:
    """The canonical fire-and-forget footer: the fenced block in settle-thread.md (single source)."""
    doc = (HERE.parent / "settle-thread.md").read_text()
    section = doc.split("## Completion footer for `t3_thread_launch`", 1)[-1]
    try:
        return section.split("```text\n", 1)[1].split("\n```", 1)[0].strip()
    except IndexError:
        die("completion footer not found in settle-thread.md")


def is_small(model_id: str) -> bool:
    return any(s in model_id for s in SMALL_MODELS)


def pick(models: tuple[str, ...], instance: str | None = None) -> tuple[str, str, str]:
    """(instanceId, modelId, house effort or '-') of the first model t3-pick-instance can route."""
    for model in models:
        constrained = False
        if instance:
            resolved = subprocess.run([str(HERE / "t3-pick-instance"), "--resolve", model],
                                      capture_output=True, text=True)
            if resolved.returncode:
                die(resolved.stderr.strip(), 2)
            model = resolved.stdout.strip()
            constrained = model.startswith(("gpt-", "claude-"))
        out = subprocess.run([str(HERE / "t3-pick-instance"), model,
                              *([instance] if constrained else [])], capture_output=True, text=True)
        if out.stderr.strip():
            print(out.stderr.strip(), file=sys.stderr)
        fields = out.stdout.split()
        if out.returncode == 0 and len(fields) == 3:
            return (instance if instance and not constrained else fields[0]), fields[1], fields[2]
    die(f"t3-pick-instance {','.join(models)} failed: {out.stderr.strip()[-300:]}", 2)


def launch_models(model: str | None, instance: str | None) -> tuple[str, ...]:
    if model:
        return (model,)  # Explicit Sol reviews and scoped workers stay explicit.
    if not instance:
        return DEFAULT_MODELS
    try:
        provider = family(registry(HOME / "settings.json").get(instance, {}))
    except (OSError, ValueError) as error:
        die(f"cannot read provider for {instance}: {error}", 2)
    if provider not in ("codex", "claude"):
        die(f"--instance {instance}: unknown provider default; pass --model", 2)
    return (provider,)  # Provider aliases resolve through t3-pick-instance.



def stamp(at: datetime) -> str:
    """statev2's timestamp format (sortable as text)."""
    return at.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def save(rec: dict) -> None:
    REQUESTS.mkdir(parents=True, exist_ok=True)
    cutoff = time.time() - KEEP_DAYS * 86400
    for old in REQUESTS.glob("*.json"):
        if old.stat().st_mtime < cutoff:
            old.unlink(missing_ok=True)
    (REQUESTS / f"{rec['rid']}.json").write_text(json.dumps(rec) + "\n")



def request_status(con: sqlite3.Connection, rec: dict, at: datetime | None = None) -> tuple[str, str]:
    """A recorded outcome wins. After a lost answer the effect decides: the thread with that title
    launched since the request / the message with clientRequestId relay-<rid>; still absent after
    GIVE_UP = it never ran (T3 creates both synchronously), so a retry cannot duplicate."""
    if rec.get("outcome"):
        return rec["outcome"], rec.get("detail", "")
    since = rec["posted_at"]
    if rec["kind"] == "launch":
        row = con.execute("select thread_id from orchestration_v2_projection_threads where project_id = ? "
                          "and title = ? and created_at >= ? and deleted_at is null order by created_at limit 1",
                          (rec["project_id"], rec["title"], since)).fetchone()
    else:  # t3_thread_send derives the message id from clientRequestId relay-<rid>
        row = con.execute("select thread_id from orchestration_v2_projection_messages where message_id like ? "
                          "and created_at >= ?", (f"%:thread-send:relay-{rec['rid']}", since)).fetchone()
    if row:
        return "ok", row[0]
    if (at or now()) - ts(since) > GIVE_UP:
        return "failed", f"answer lost ({rec.get('detail', '?')}) and no effect after {GIVE_UP}"
    return "pending", f"answer lost ({rec.get('detail', '?')}); looking for the effect"


def wait_for(rid: str, seconds: float) -> int:
    """Print the outcome; exit code 0 ok, 1 failed, 3 pending. A lookup error (store locked,
    schema drift) is never 'failed': the request may still run, so a retry could duplicate it."""
    path = REQUESTS / f"{rid}.json"
    if not path.exists():
        die(f"unknown relay request {rid} (records kept {KEEP_DAYS} days)", 2)
    rec = json.loads(path.read_text())
    deadline = time.monotonic() + seconds
    while True:
        try:
            con = None if rec.get("outcome") else store()
            state, detail = request_status(con, rec)
        except (sqlite3.Error, SystemExit) as exc:
            state, detail = "pending", f"lookup error: {exc}"
        if state != "pending" or time.monotonic() >= deadline:
            print(f"{state} {detail}")
            return {"ok": 0, "failed": 1}.get(state, 3)
        time.sleep(3)


def cmd_check(base: str) -> None:
    mcp = connect(base)
    mcp._rpc("ping", {}, id=3)
    expires = json.loads(TOKEN_FILE.read_text())["expires_at"][:10]
    print(f"ok: T3 MCP on {base} as client {CLIENT!r} (full-access, token expires {expires}, renewed automatically)")
    try:
        legacy = store().execute("select task_id from scheduled_tasks where title like ? and enabled = 1",
                                 (LEGACY_HOST_TITLE + "%",)).fetchall()
    except sqlite3.Error:
        legacy = []
    for (task,) in legacy:
        print(f"  obsolete webhook relay host {task}: delete_scheduled_task it, settle its thread (relay.md)")


def main() -> None:
    ap = argparse.ArgumentParser(prog="t3-relay", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    la = sub.add_parser("launch")
    la.add_argument("--project", required=True)
    la.add_argument("--title", required=True)
    la.add_argument("--model", help="model id, alias or provider (openai/codex, claude); omit = instance default or opus, else astra")
    la.add_argument("--allow-small-model", action="store_true",
                    help="permit haiku/luna as the standalone thread's model (default: refused)")
    la.add_argument("--instance", help="provider instance id; default: t3-pick-instance MODEL")
    la.add_argument("--effort", help="reasoning effort option value")
    la.add_argument("--settle-when-done", action="store_true",
                    help="append the completion footer: the thread settles itself after a clean delivery")
    se = sub.add_parser("send")
    se.add_argument("--thread", required=True)
    se.add_argument("--mode", default="auto", choices=["auto", "queue", "steer"])
    for p in (la, se):
        p.add_argument("--wait", type=float, default=0, metavar="SECS",
                       help="kept for callers: the effect exists on exit 0; prints `ok <threadId>`")
    la.add_argument("prompt", nargs="+")
    se.add_argument("message", nargs="+")
    st = sub.add_parser("status")
    st.add_argument("rid")
    st.add_argument("--wait", type=float, default=0, metavar="SECS")
    sub.add_parser("check")
    a = ap.parse_args()
    if a.cmd == "launch" and not a.model and not a.instance and a.effort:
        die("--effort needs --model or --instance", 2)
    if a.cmd == "status":
        raise SystemExit(wait_for(a.rid, a.wait))

    base = origin()
    if a.cmd == "check":
        cmd_check(base)
        return
    rid = uuid.uuid4().hex[:12]
    rec = {"rid": rid, "kind": a.cmd}
    if a.cmd == "launch":
        instance, model, effort = pick(launch_models(a.model, a.instance), a.instance)
        if is_small(model) and not a.allow_small_model:
            die(f"refusing standalone thread on {model}: launch a frontier model (opus/astra) that uses "
                "small models as sub-agents, or pass --allow-small-model if orchestration is already done", 2)
        mcp = connect(base)
        message = " ".join(a.prompt) + ("\n\n" + completion_footer() if a.settle_when_done else "")
        sel = {"instanceId": instance, "model": model}
        effort = a.effort or (effort if effort != "-" else None)
        if effort:
            key = "reasoningEffort" if model.startswith("gpt-") else "effort"
            sel["options"] = [{"id": key, "value": effort}]
        tool, args = "t3_thread_launch", {"projectId": project_id(mcp, a.project), "title": a.title,
                                          "message": message, "modelSelection": sel,
                                          "workspaceStrategy": {"type": "root"}, "runtimeMode": "full-access"}
        rec.update(project_id=args["projectId"], title=a.title)
    else:
        mcp = connect(base)
        tool, args = "t3_thread_send", {"threadId": a.thread, "message": " ".join(a.message), "mode": a.mode,
                                        "clientRequestId": f"relay-{rid}"}
        rec.update(thread=a.thread)
    rec["posted_at"] = stamp(now())
    started = time.monotonic()
    try:
        result = mcp.call(tool, args)
    except Unknown as exc:
        rec["detail"] = str(exc)
        save(rec)
        print(f"accepted: relay {rid} via mcp (answer lost: {exc}; `t3-relay status {rid}`)", flush=True)
        if a.wait:  # --wait bounds the whole run: callers time t3-relay out just above it
            raise SystemExit(wait_for(rid, max(0, a.wait - (time.monotonic() - started))))
        return
    thread = result.get("threadId") or getattr(a, "thread", None) or "?"
    rec.update(outcome="ok", detail=thread)
    save(rec)
    print(f"accepted: relay {rid} via mcp ({thread})")
    if a.wait:
        print(f"ok {thread}")


if __name__ == "__main__":
    main()
