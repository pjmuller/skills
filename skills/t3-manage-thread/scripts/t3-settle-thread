#!/usr/bin/env bash
# t3-settle-thread: retired. T3 >= 0.1.0 (Orchestrator V2) settles through its own MCP tool,
# which also does what --self/--detach used to emulate: a self-settle takes effect when the
# calling turn ends. Kept as a pointer so stale prompts get the native call, not a dead end.
set -euo pipefail

mode=self target=""
while (($#)); do
  case "$1" in
    -h|--help) mode=help ;;
    --self) mode=self ;;
    --unsettle) mode=unsettle ;;
    --wait|--detach) mode=other ;;
    --wait=*|--detach=*) mode=other; target="${1#*=}" ;;
    --*) ;;
    *) [[ "$1" =~ ^[0-9]+$ ]] || { target="$1"; [[ "$mode" == self ]] && mode=other; } ;;
  esac
  shift
done

tool='t3_thread_organize (Claude: mcp__t3-code__t3_thread_organize · Codex: t3_code.t3_thread_organize)'
case "$mode" in
  help|self)
    cat >&2 <<EOF
NOT settled: t3-settle-thread is retired (T3 >= 0.1.0).
Do this instead, as your LAST tool call: call the T3 MCP tool
  $tool
with {"action":"settle"} and no threadId. It settles this thread when your turn ends
(a failed/interrupted turn or a queued message keeps it open). Then give your final answer.
EOF
    ;;
  unsettle)
    printf 'NOT unsettled: t3-settle-thread is retired (T3 >= 0.1.0).\nCall %s\nwith {"action":"unsettle","threadId":"%s"}.\n' "$tool" "${target:-<id>}" >&2 ;;
  other)
    printf 'NOT settled: t3-settle-thread is retired (T3 >= 0.1.0).\nAfter verifying the thread, call %s\nwith {"action":"settle","threadId":"%s"}.\nA delegate_task child needs no settle.\n' "$tool" "${target:-<id>}" >&2 ;;
esac
[[ "$mode" == help ]] && exit 0
exit 3
