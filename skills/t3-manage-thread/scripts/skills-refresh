#!/usr/bin/env bash
# Apply the newest pjmuller/skills release tag to managed copies under ~/.agents/skills.
# Release tag = distribution unit; never main HEAD. Docs: ../skills-refresh.md
set -euo pipefail

HOME_="${SKILLS_REFRESH_HOME:-$HOME/.agents}"
REPO="${SKILLS_REFRESH_REPO:-https://github.com/pjmuller/skills.git}"
SKILLS="$HOME_/skills" STAMP="$HOME_/pjmuller-skills.version" STATE="$HOME_/pjmuller-skills"
LOCK="$STATE/lock" ACTIONS="$STATE/actions.$$"
MIN_VERIFYING_RELEASE='v0.5.5'
# Bootstrap trust is the installed script, never the fetched release. No env override.
ALLOWED_SIGNERS='pjmuller namespaces="git" ssh-rsa '

usage() {
  cat <<'USAGE'
Usage:
  skills-refresh                 apply the newest release tag vX.Y.Z, check the scheduler can fire
                                 exit 0 = already current, 10 = applied, 1 = failure (nothing new active)
                                 "ACTION NEEDED" lines at the end = something only you can fix
  skills-refresh --job [--quiet] same, then settle (0) or surface (10, 1) the T3 thread it runs in;
                                 --quiet also settles on 10 (no changelog thread)
  skills-refresh --apply         unattended, no T3 (the scheduled job's --pre-command): apply, save the
                                 report for the next --job thread; exit 0 = fine, 1 = needs the user
  skills-refresh --version       installed tag + date
  skills-refresh --verify-tag REPO TAG   verify with this installed pin; print commit SHA
  skills-refresh schedule [--project DIR] [--at HH:MM] [--quiet]   daily job (idempotent)
Env: SKILLS_REFRESH_HOME (~/.agents), SKILLS_REFRESH_REPO (GitHub URL or local path),
     SKILLS_REFRESH_TAG (force a tag)
USAGE
}
die() { echo "skills-refresh: $*" >&2; exit 1; }
# Things only the user can fix. Collected across the run (also from the refresh subshell) and
# printed as one block right before the thread line, so they never scroll away above a changelog.
action() { mkdir -p "$STATE"; printf '%s\n' "$*" >> "$ACTIONS"; }
actions_block() { # true when there was a block
  [[ -s "$ACTIONS" ]] || return 1
  printf '\nACTION NEEDED:\n'; sed 's/^/- /' "$ACTIONS"; rm -f "$ACTIONS"
}
# Release files of a managed copy (cksum per file); bytecode and files added later don't count.
fingerprint() {
  (cd "$1" && find . -type f ! -path '*/__pycache__/*' ! -name '*.pyc' -print0 | LC_ALL=C sort -z | xargs -0 cksum)
}
edited_files() { # skill: release files changed or deleted since its install, space-separated
  [[ -s "$STATE/manifest/$1" ]] || return 0
  comm -23 <(LC_ALL=C sort "$STATE/manifest/$1") <(fingerprint "$SKILLS/$1" | LC_ALL=C sort) |
    cut -d' ' -f3- | sed 's#^\./##' | tr '\n' ' '
}
version_at_least() {
  [[ "$(printf '%s\n' "${1#v}" "${2#v}" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" == "${1#v}" ]]
}

# Subshell keeps the temporary trust file and trap independent of refresh's lock.
verify_release() (
  local repo="$1" tag="$2" object body trust major minor
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid release tag: $tag"
  read -r major minor < <(git --version | sed -E 's/.* ([0-9]+)\.([0-9]+).*/\1 \2/')
  [[ "$major" -gt 2 || ( "$major" == 2 && "$minor" -ge 34 ) ]] ||
    die "signature verification needs Git >= 2.34 and OpenSSH with ssh-keygen -Y"
  command -v ssh-keygen >/dev/null || die "signature verification needs ssh-keygen"
  object="$(git -C "$repo" rev-parse --verify "refs/tags/$tag")" || exit 1
  body="$(git -C "$repo" cat-file tag "$object")" || die "$tag is not an annotated signed tag"
  [[ "$(printf '%s\n' "$body" | sed -n '2p')" == "type commit" &&
     "$(printf '%s\n' "$body" | sed -n '3p')" == "tag $tag" &&
     "$body" == *'-----BEGIN SSH SIGNATURE-----'* &&
     "$body" != *'-----BEGIN PGP SIGNATURE-----'* &&
     "$body" != *'-----BEGIN SIGNED MESSAGE-----'* ]] ||
    die "$tag: expected an SSH-signed commit tag with matching name"
  trust="$(mktemp)" || exit 1
  trap 'rm -f "$trust"' EXIT
  printf '%s\n' "$ALLOWED_SIGNERS" > "$trust" || exit 1
  git -C "$repo" -c gpg.format=ssh -c gpg.ssh.program=ssh-keygen \
    -c gpg.minTrustLevel=fully -c gpg.ssh.allowedSignersFile="$trust" \
    verify-tag "$object" >&2 || die "$tag: signature rejected by the installed signing pin"
  git -C "$repo" rev-parse --verify "$object^{commit}"
)

version() {
  local dir="$SKILLS/t3-manage-thread" top
  # Source checkout only when the (symlinked) dir is <repo>/skills/t3-manage-thread of the repo
  # itself: a managed copy inside some other repo (a setup repo's ai/skills) reads the stamp.
  if [[ -d "$dir" ]] && top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" &&
    [[ "$top" == "$(cd -P "$dir/../.." && pwd -P)" ]]; then
    echo "source checkout $(git -C "$dir" describe --tags --always)"
  elif [[ -s "$STAMP" ]]; then
    read -r tag day _ < "$STAMP" || true; echo "$tag (applied $day)"
  else
    echo "unknown (run skills-refresh)"
  fi
}

# CHANGELOG sections from the first "## v" heading down to (excluding) "## <old tag>".
changelog() {
  awk -v old="$2" '
    /^## / { if (started && (old == "none" || $0 == "## " old || index($0, "## " old " ") == 1)) exit
             if ($0 ~ /^## v/) started = 1 }
    started' "$1"
}

run_install() { # skill [args]; returns install's exit code
  local script="$SKILLS/$1/scripts/install"; shift
  [[ -x "$script" ]] || return 0
  "$script" "$@"
}

# Undo a partial activation: skills moved aside in THIS run come back from last-good (a stale
# last-good from an earlier run is never restored), staged copies are dropped.
rollback() { # reason
  local n
  echo "skills-refresh: $1; rolling back to $installed" >&2
  for n in ${moved[@]+"${moved[@]}"}; do
    rm -rf "${SKILLS:?}/$n"; mv "$STATE/last-good/$n" "$SKILLS/$n"
    run_install "$n" >/dev/null 2>&1 || echo "skills-refresh: $n: reinstall after rollback failed" >&2
  done
  for n in "${managed[@]}"; do rm -rf "$SKILLS/.$n.new"; done
  rm -rf "$stage"; exit 1
}

refresh() {
  mkdir -p "$STATE"
  if ! mkdir "$LOCK" 2>/dev/null; then
    if [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
      rm -rf "$LOCK"; mkdir "$LOCK"
    else
      die "another run holds $LOCK (pid $(cat "$LOCK/pid" 2>/dev/null || echo ?))"
    fi
  fi
  echo $$ > "$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT

  local new tag_list
  installed=none
  [[ -s "$STAMP" ]] && { read -r installed _ < "$STAMP" || true; }
  if [[ -n "${SKILLS_REFRESH_TAG:-}" ]]; then
    new="$SKILLS_REFRESH_TAG"
  else
    tag_list="$(git ls-remote --tags --refs "$REPO" 'refs/tags/v*' 2>/dev/null)" || die "cannot reach $REPO"
    new="$(printf '%s\n' "$tag_list" | sed -n 's#.*refs/tags/v\([0-9]*\.[0-9]*\.[0-9]*\)$#\1#p' |
      sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
    [[ -n "$new" ]] || die "no vX.Y.Z tags at $REPO"
    new="v$new"
  fi
  [[ "$new" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid release tag: $new"
  version_at_least "$new" "$MIN_VERIFYING_RELEASE" ||
    die "$new predates mandatory verification ($MIN_VERIFYING_RELEASE); refusing to restore an unsafe updater"
  [[ "$new" != "$installed" ]] || { echo "up to date: $new"; return 0; }
  if [[ -z "${SKILLS_REFRESH_TAG:-}" && "$installed" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    version_at_least "$new" "$installed" ||
      die "refusing downgrade from $installed to $new (explicit SKILLS_REFRESH_TAG still requires a signature)"
  fi
  # Releases since v0.5.0 need T3 Code >= 0.1 (statev2.sqlite); never land them on a 0.0.x machine.
  local t3_data="${T3CODE_HOME:-$HOME/.t3}/userdata"
  if [[ -e "$t3_data/state.sqlite" && ! -e "$t3_data/statev2.sqlite" ]]; then
    die "$new needs T3 Code >= 0.1.0: update the T3 app first, then rerun (staying on $installed)"
  fi

  local candidates=() name
  for name in "$SKILLS"/*; do
    [[ -d "$name" && ! -L "$name" ]] && candidates+=("${name##*/}")
  done
  ((${#candidates[@]})) || { echo "up to date: nothing to manage (all copies under $SKILLS are symlinks to a source checkout)"; return 0; }

  stage="$STATE/staging/$new"
  rm -rf "$stage"; mkdir -p "$STATE/staging" "$STATE/last-good"
  git init -q "$stage" &&
    git -C "$stage" fetch -q --depth 1 "$REPO" "refs/tags/$new:refs/tags/$new" ||
    { rm -rf "$stage"; die "cannot fetch $new from $REPO"; }
  local verified_commit
  verified_commit="$(verify_release "$stage" "$new")" ||
    { rm -rf "$stage"; die "$new: verification failed; staying on $installed"; }
  git -C "$stage" -c core.hooksPath=/dev/null checkout -q --detach "$verified_commit" ||
    { rm -rf "$stage"; die "$new: cannot check out verified commit"; }
  echo "verified $new $verified_commit (installed signing pin)"
  managed=() moved=()
  for name in "${candidates[@]}"; do [[ -d "$stage/skills/$name" ]] && managed+=("$name"); done
  if ((${#managed[@]} == 0)); then
    rm -rf "$stage"; echo "up to date: nothing to manage (no copy under $SKILLS exists at $new)"; return 0
  fi

  local file
  for name in "${managed[@]}"; do
    while IFS= read -r file; do
      head -1 "$file" | grep -Eq '^#!.*(bash|/sh)' || continue
      bash -n "$file" 2>/dev/null || { rm -rf "$stage"; die "$new: syntax error in skills/$name/${file#"$stage/skills/$name/"}; nothing activated"; }
    done < <(find "$stage/skills/$name/scripts" -maxdepth 2 -type f 2>/dev/null)
  done

  # A copy edited since its install would be silently replaced (last-good keeps it one release).
  local edited="" changed
  for name in "${managed[@]}"; do
    [[ -s "$STATE/manifest/$name" ]] || continue
    changed="$(edited_files "$name")"
    [[ -z "$changed" ]] || edited+="  $name: $changed"$'\n'
  done
  if [[ -n "$edited" ]]; then
    rm -rf "$stage"
    die "local edits in managed copies, $new not activated (staying on $installed):
$edited  Move what you need into your own skill, then discard: rm $STATE/manifest/<skill> and rerun skills-refresh."
  fi

  # Stage a complete replacement next to the live copy first; the live directory is only
  # moved once its successor exists, and any failure from here on restores every skill.
  for name in "${managed[@]}"; do
    rm -rf "$SKILLS/.$name.new" "$STATE/last-good/$name" 2>/dev/null || rollback "$name: cannot clear last-good"
    cp -R "$stage/skills/$name" "$SKILLS/.$name.new" || rollback "$name: staging copy failed"
  done
  for name in "${managed[@]}"; do
    mv "$SKILLS/$name" "$STATE/last-good/$name" || rollback "$name: cannot move the live copy aside"
    moved+=("$name")
    mv "$SKILLS/.$name.new" "$SKILLS/$name" || rollback "$name: cannot activate"
  done
  for name in "${managed[@]}"; do
    run_install "$name" >/dev/null || rollback "$name: scripts/install failed on $new"
  done
  local check
  for name in "${managed[@]}"; do
    check="$(run_install "$name" --check 2>&1)" && continue
    printf '%s\n' "$check" | grep -Ev '^(ok |source |version )' | sed "s/^/warning: $name: /" || true
    echo "warning: $name: run scripts/install --check"
  done
  if [[ " ${managed[*]} " == *" t3-schedule "* ]] && command -v t3-schedule >/dev/null; then
    check="$(t3-schedule refresh 2>&1)" || echo "warning: t3-schedule refresh failed"
    printf '%s\n' "$check" | grep '^skipped' | sed 's/^/warning: /' || true
  fi

  mkdir -p "$STATE/manifest"
  # From the staged release, not the live dir: files installs or runs add later (.venv) never count.
  for name in "${managed[@]}"; do fingerprint "$stage/skills/$name" > "$STATE/manifest/$name"; done

  echo "$new $(date +%F) $verified_commit" > "$STAMP"
  echo "applied $new (was $installed)"
  [[ -f "$stage/CHANGELOG.md" ]] && changelog "$stage/CHANGELOG.md" "$installed"
  removed_refs "$new"
  rm -rf "$stage"
  return 10
}

# Commands this release dropped (in last-good, gone now) that the user's global prompt or own
# skills still call. Advisory: lists file:line, never rewrites. Removed flags stay changelog-only.
removed_refs() { # new tag
  local n f b removed=() names pattern prompt repo="" real line path
  for n in "${managed[@]}"; do
    for f in "$STATE/last-good/$n/scripts"/*; do
      b="${f##*/}"
      [[ -f "$f" && -x "$f" && "$b" != *.* && "$b" != test_* && "$b" != install &&
         ! -e "$SKILLS/$n/scripts/$b" ]] && removed+=("$b")
    done
  done
  ((${#removed[@]})) || return 0
  echo "removed commands: ${removed[*]}"
  # Command names contain "-": grep -w would also hit t3-foo-v2, so use an explicit boundary.
  names="$(IFS='|'; echo "${removed[*]}")" pattern="(^|[^[:alnum:]_-])($names)([^[:alnum:]_-]|$)"
  prompt="$(global_prompt)" || true
  [[ -n "$prompt" ]] || return 0
  repo="$(git -C "$(dirname "$prompt")" rev-parse --show-toplevel 2>/dev/null)" || repo=""
  real="$(cd -P "$SKILLS" && pwd -P)"
  {
    grep -nE "$pattern" "$prompt" | while IFS= read -r line; do printf '%s:%s\n' "$prompt" "$line"; done
    [[ -z "$repo" ]] || git -C "$repo" grep -nE "$pattern" -- ':(glob)**/skills/**' |
      while IFS= read -r line; do printf '%s/%s\n' "$repo" "$line"; done
  } 2>/dev/null | head -40 | while IFS= read -r line; do
    path="${line%%:*}"
    for n in "${managed[@]}"; do [[ "$path" == "$real/$n/"* ]] && continue 2; done
    line="${line#*:}"
    action "\`$(grep -oE "$pattern" <<<"${line#*:}" | head -1 | grep -oE "$names")\` was removed in $1 (see the changelog) but $path:${line%%:*} still uses it"
  done || true
}

# Managed copies inside a git repo (a setup repo's ai/skills): the refresh owns exactly the skill
# dirs whose content still equals the release it installed, so it commits those and nothing else.
# Runs every time (not only on apply): a failed commit or push is retried and reported until fixed.
publish_managed() {
  local real root n f files=() branch remote merge unpushed sha
  local mine='skills-refresh: pjmuller/skills '
  [[ -d "$STATE/manifest" && -s "$STAMP" ]] || return 0
  real="$(cd -P "$SKILLS" 2>/dev/null && pwd -P)" || return 0
  root="$(git -C "$real" rev-parse --show-toplevel 2>/dev/null)" || return 0
  local -x GIT_LITERAL_PATHSPECS=1 # file names are not pathspec magic; scoped to this function
  # Release files plus tracked files the swap removed; never files the user added beside them.
  for n in "$STATE/manifest"/*; do
    n="${n##*/}"
    [[ -d "$real/$n" && ! -L "$SKILLS/$n" ]] || continue
    [[ -z "$(edited_files "$n")" ]] || continue # the user's edits: never commit them as ours
    env -u GIT_LITERAL_PATHSPECS git -C "$root" check-ignore -q "$real/$n" && continue # no literal support
    while IFS= read -r f; do files+=("$real/$n/${f#./}"); done < <(cut -d' ' -f3- "$STATE/manifest/$n")
    while IFS= read -r f; do files+=("$root/$f"); done < <(git -C "$root" ls-files -d --full-name -- "$real/$n")
  done
  ((${#files[@]})) || return 0
  if [[ -n "$(git -C "$root" status --porcelain -- "${files[@]}" 2>/dev/null)" ]]; then
    branch="$(git -C "$root" symbolic-ref -q --short HEAD)" ||
      { action "commit the refreshed skills in $root yourself: it is on a detached HEAD"; return 0; }
    if ! git -C "$root" add -A -- "${files[@]}" >/dev/null 2>&1 ||
       ! git -C "$root" commit -q --only -m "$mine$(read -r t _ < "$STAMP"; echo "$t")" -- "${files[@]}" >/dev/null 2>&1; then
      action "commit the refreshed skills in $root yourself (automatic commit failed, e.g. a git lock or hook)"
      return 0
    fi
    echo "committed $(git -C "$root" rev-parse --short HEAD) in $root (refreshed skills only)"
  fi
  branch="$(git -C "$root" symbolic-ref -q --short HEAD)" || return 0
  git -C "$root" log -1 --format=%s | grep -q "^$mine" || return 0 # nothing of ours waiting
  remote="$(git -C "$root" config "branch.$branch.remote")" || true
  merge="$(git -C "$root" config "branch.$branch.merge")" || true
  if [[ -z "$remote" || -z "$merge" ]]; then
    [[ -z "$(git -C "$root" remote)" ]] || action "push $root yourself: branch $branch has no upstream"
    return 0
  fi
  if ! unpushed="$(git -C "$root" log --format=%s '@{u}..HEAD' 2>/dev/null)"; then
    action "push $root yourself: upstream of $branch ($remote $merge) is not fetched or does not exist"
  elif [[ -z "$unpushed" ]]; then
    return 0
  elif grep -vq "^$mine" <<<"$unpushed"; then
    # Push only when every unpushed commit is ours, and only this branch (push.default may be "matching").
    action "push $root when ready: the refreshed skills are committed, not pushed, because $(grep -vc "^$mine" <<<"$unpushed") commit(s) of yours there are unpushed too"
  elif sha="$(git -C "$root" rev-parse --short HEAD)" && git -C "$root" push -q "$remote" "HEAD:$merge" >/dev/null 2>&1; then
    echo "pushed $sha to $remote"
  else
    action "push $root: the refreshed skills are committed, push failed (git -C $root pull --no-rebase && git -C $root push)"
  fi
}

# Can scheduled jobs (this one included) still fire? Checked on every run, not only on updates:
# otherwise a broken runner shows up only in its log and a once-a-day notification.
health() {
  local check="$SKILLS/t3-schedule/scripts/install" out line
  [[ -x "$check" ]] || return 0
  out="$("$check" --check 2>&1)" ||
    action "scheduled jobs (this refresh included) cannot fire: $(tail -1 <<<"$out") (details: $check --check)"
  while IFS= read -r line; do
    [[ "$line" == *'obsolete webhook relay host'* ]] && action "${line#"${line%%[![:space:]]*}"}"
  done <<<"$out"
  return 0
}

# Manual runs never merge the template; say when a --job run would.
template_hint() {
  local tag="" prompt marker
  [[ "$(version)" == "source checkout"* ]] && return 0
  [[ -s "$STAMP" ]] && { read -r tag _ < "$STAMP" || true; }
  [[ "$tag" == v* ]] || return 0
  prompt="$(global_prompt)" || return 0
  [[ -n "$prompt" ]] || return 0
  marker="$(grep -oE 'template: pjmuller/skills@[0-9A-Za-z._-]+' "$prompt" | tail -1 | sed 's/.*@//')" || true
  [[ "$marker" == "$tag" ]] && return 0
  echo "template: $prompt is marked ${marker:-(no marker)}, installed $tag. Manual runs never merge it: ask a T3 agent to run \`skills-refresh --job\` and follow its last line (no-op when the template did not change)."
}

manual() {
  local rc=0
  (refresh) || rc=$?
  if [[ "$rc" == 0 || "$rc" == 10 ]]; then template_hint; publish_managed; migrate_schedule; health; fi
  actions_block || true
  return "$rc"
}

# Global prompt re-sync (agents-md global.md "Re-sync later"): a script decides whether the shared
# template changed between the prompt's marker and the installed tag; a frontier child does the merge.
TEMPLATE=skills/agents-md/global-template.md

global_prompt() { # the user's live global prompt: first resolved target carrying a marker, else the first
  local c f first="" seen=" "
  for c in ${SKILLS_REFRESH_PROMPT:-"$HOME/.claude/CLAUDE.md" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md" "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"}; do
    [[ -f "$c" ]] || continue
    f="$(realpath "$c")"; [[ "$seen" == *" $f "* ]] && continue; seen+="$f "
    grep -q 'template: pjmuller/skills@' "$f" && { echo "$f"; return; }
    [[ -n "$first" ]] || first="$f"
  done
  [[ -n "$first" ]] && echo "$first"
}

template_cache() { # blobless bare clone with history, for markers that are commits on main
  local cache="$STATE/repo.git"
  [[ -d "$cache" ]] || git clone -q --bare --filter=blob:none "$REPO" "$cache" 2>/dev/null || return 1
  git -C "$cache" fetch -q --filter=blob:none --tags origin '+refs/heads/*:refs/heads/*' 2>/dev/null || return 1
  echo "$cache"
}

# Prints a report; sets sync_line to a lifecycle line when the thread must not settle silently.
prompt_sync() {
  sync_line=""
  [[ "$(version)" == "source checkout"* ]] && return 0 # template author's machine
  local tag="" prompt marker cache base tag_sha="" day repo how dirty pick basetag="" ctag cat now
  [[ -s "$STAMP" ]] && { read -r tag day tag_sha < "$STAMP" || true; }
  [[ "$tag" == v* ]] || return 0
  # Old stamps never proved authenticity. Wait for a verified apply before delegating code.
  [[ "$tag_sha" =~ ^[0-9a-f]{40}$ || "$tag_sha" =~ ^[0-9a-f]{64}$ ]] || return 0
  prompt="$(global_prompt)" || return 0
  [[ -n "$prompt" ]] || return 0
  marker="$(grep -oE 'template: pjmuller/skills@[0-9A-Za-z._-]+' "$prompt" | tail -1 | sed 's/.*@//')" || true
  [[ "$marker" == "$tag" ]] && return 0 # steady state: no network
  cache="$(template_cache)" || { echo "template check: cannot fetch $REPO history (retrying tomorrow)"; sync_line="thread: KEEP OPEN (the user should see this)"; return 0; }
  git -C "$cache" cat-file -e "$tag_sha^{commit}" 2>/dev/null ||
    { echo "template check: verified commit $tag_sha unavailable"; sync_line="thread: KEEP OPEN (the user should see this)"; return 0; }
  git -C "$cache" cat-file -e "$tag_sha:$TEMPLATE" 2>/dev/null || return 0
  if [[ -n "$marker" ]] && base="$(git -C "$cache" rev-parse -q --verify "$marker^{commit}")"; then
    git -C "$cache" merge-base --is-ancestor "$tag_sha" "$base" && return 0 # marker at or past the release
    [[ "$(git -C "$cache" rev-parse -q "$base:$TEMPLATE" 2>/dev/null)" == "$(git -C "$cache" rev-parse "$tag_sha:$TEMPLATE")" ]] && return 0
    how="marker $marker"
  fi
  if ! repo="$(git -C "$(dirname "$prompt")" rev-parse --show-toplevel 2>/dev/null)" ||
      [[ -z "$(git -C "$repo" log -1 --format=%h -- "$prompt" 2>/dev/null)" ]]; then
    echo "template check: $prompt is not committed in a git repository; commit it in your setup repo so a re-sync can be reviewed and reverted"
    sync_line="thread: KEEP OPEN (the user should see this)"; return 0
  fi
  if [[ -z "${how:-}" ]]; then # no usable marker: base = template just before the file first entered git
    local since; since="$(git -C "$repo" log --follow --format=%cI -- "$prompt" | tail -1)"
    base="$(git -C "$cache" rev-list -1 --before="$since" "$tag_sha" -- "$TEMPLATE")"
    how="no marker; base inferred from the file's first commit ($since)"
    [[ -n "$base" ]] || how="no marker and no template before $since: compare against the full released template"
  fi
  dirty="$(git -C "$repo" status --porcelain -- "$prompt")"
  # One merge per release: a catch-up or manual --job run must not start a second one beside it.
  now="$(date +%s)"
  if read -r ctag cat < "$STATE/template-sync.claim" 2>/dev/null && [[ "$ctag" == "$tag" && "$cat" =~ ^[0-9]+$ ]] &&
      ((now - cat < 86400)); then
    echo "template check: a re-sync to $tag was delegated $(( (now - cat) / 3600 ))h ago; not starting a second merge"
    return 0
  fi
  [[ -z "${base:-}" ]] || basetag="$(git -C "$cache" describe --tags --abbrev=0 "$base" 2>/dev/null)" || true
  {
    echo "# Global prompt re-sync to pjmuller/skills $tag"
    echo
    echo "- Prompt: \`$prompt\` (git repo \`$repo\`)."
    echo "- Released template: \`$tag\` = \`$tag_sha\`. Base: \`${base:-none}\` ($how)."
    echo "- Template history (blobless clone, read-only): \`git -C $cache log -p ${base:+$base..}$tag_sha -- $TEMPLATE\`;"
    echo "  procedure: \`git -C $cache show $tag_sha:skills/agents-md/global.md\` → \"Merge the template\" rules + \"Re-sync later\"."
    echo "- Why each change was made: CHANGELOG entries newer than ${basetag:-the base} in \`git -C $cache show $tag_sha:CHANGELOG.md\`; judge adopt/skip by that rationale."
    if [[ -n "$dirty" ]]; then
      echo "- **The prompt has uncommitted edits: change nothing.** Read \`git -C $repo diff -- $prompt\`, then report what"
      echo "  those edits do and recommend how to proceed (commit them as …, then merge template changes …). The user decides."
    fi
    cat <<BRIEF

Rules (clean file):
1. Read the decisions log \`template-decisions.md\` beside the prompt (may not exist). Never re-propose a change it records as skipped, also when reworded.
2. Three-way merge: base template, released template, their file. Apply what is a clear improvement for this person in their wording; their facts, rules and deliberate deletions win; drop parts for tools they lack. Not sure → don't apply, list it as a question.
3. End the file with \`<!-- template: pjmuller/skills@$tag -->\` (replace the old marker; also when everything was skipped). Append one line per skipped change to the decisions log: \`$tag: <change> — <reason>\`.
4. Pointer check: \`git -C $cache show $tag_sha:skills/agents-md/scripts/check-pointers | bash -s -- $prompt\`; missing pointer → drop or fix that line.
5. Read released content only by the verified commit \`$tag_sha\`, never by the mutable tag ref. Re-check \`git status\` of the prompt right before writing; if it changed meanwhile, stop and report. Commit only the prompt and the decisions log, pull (merge, never rebase/reset/stash) and push under the repo's rules.
6. Final answer, terse: applied (one line each), skipped, questions for the user, commit sha (rollback: \`git revert <sha>\`).
BRIEF
  } > "$STATE/template-sync.md"
  echo "template check: $TEMPLATE changed since ${base:-its first version} ($how)${dirty:+; prompt has uncommitted edits}"
  if command -v t3-pick-instance >/dev/null && pick="$(t3-pick-instance claude 2>/dev/null || t3-pick-instance openai 2>/dev/null)"; then
    local instance model effort opts="" task="Read and execute $STATE/template-sync.md"
    task="${task//\\/\\\\}"; task="${task//\"/\\\"}"
    read -r instance model effort <<<"$(tail -1 <<<"$pick")"
    if [[ "$effort" != - ]]; then
      [[ "$model" == claude* ]] && opts=",\"options\":{\"effort\":\"$effort\"}" || opts=",\"options\":{\"reasoningEffort\":\"$effort\"}"
    fi
    echo "$tag $now" > "$STATE/template-sync.claim"
    sync_line="thread: DELEGATE (template re-sync; overrides any older line in this prompt): call the T3 MCP tool delegate_task with {\"task\":\"$task\",\"title\":\"Template re-sync $tag\",\"role\":\"implementation\",\"mode\":\"async\",\"clientRequestId\":\"skills-refresh-template-$tag-$(date +%F)\",\"target\":{\"providerInstanceId\":\"$instance\",\"model\":\"$model\"$opts}}, end the turn with this output, and when the result arrives answer with it verbatim. Never settle this thread."
  else
    echo "template check: t3-pick-instance unavailable; ask a frontier agent: Read and execute $STATE/template-sync.md"
    sync_line="thread: KEEP OPEN (the user should see this)"
  fi
}

# The scheduled thread's lifecycle is decided here, not by the (cheap) model reading a prompt:
# nothing new → settle silently; applied (unless --quiet), failed or a template re-sync → surface once.
# Runs from the scheduler before T3 is even checked, so a release that repairs T3 tooling (t3-relay,
# t3-schedule) still lands when that tooling is broken. Its report waits in LAST_APPLY for --job.
LAST_APPLY="$STATE/last-apply"
apply() {
  local rc=0 out
  out="$( (refresh) 2>&1 )" || rc=$?
  printf '%s\n' "$out"
  mkdir -p "$STATE"
  [[ "$rc" == 0 || "$rc" == 10 ]] || exit 1
  publish_managed
  t3_up && health  # T3 still starting (just woke): the job thread runs health later
  local acts
  acts="$(actions_block)" || true
  printf '%s' "$acts"
  # The thread reports it later; release-specific actions (removed commands) would not recur there.
  [[ "$rc" == 10 ]] && { echo "installed $(date '+%F %H:%M') by the scheduler, before this thread started:"
                         printf '%s\n%s\n' "$out" "$acts"; } > "$LAST_APPLY"
  [[ -z "$acts" ]]
}

t3_up() {
  local origin
  origin="$(sed -n 's/.*"origin": *"\([^"]*\)".*/\1/p' "${T3CODE_HOME:-$HOME/.t3}/userdata/server-runtime.json" 2>/dev/null)"
  [[ -n "$origin" ]] && curl -sf --max-time 5 "$origin/.well-known/t3/environment" >/dev/null
}

# Jobs armed before --apply existed install through their T3 thread only: add the pre-command once.
migrate_schedule() {
  local pointer="$HOME/.t3/userdata/scheduled/t3-schedule/skills-refresh.json" spec
  local py=(python3); command -v python3 >/dev/null || py=(uv run -q --no-project python)
  [[ -f "$pointer" ]] && command -v t3-schedule >/dev/null || return 0
  spec="$("${py[@]}" - "$pointer" <<'PY'
import json, sys
pointer = sys.argv[1]
target = json.load(open(pointer)).get("source") or pointer
spec = json.load(open(target))
if not spec.get("pre_command"):
    spec["pre_command"] = "skills-refresh --apply"
    open(target, "w").write(json.dumps(spec, indent=2, ensure_ascii=False) + "\n")
    print(target)
PY
)" || return 0
  [[ -n "$spec" ]] || return 0
  t3-schedule refresh >/dev/null 2>&1 || true
  echo "scheduled job now installs updates before (and without) T3: --pre-command 'skills-refresh --apply'"
  [[ "$spec" == "$pointer" ]] || action "commit $spec in your setup repo (skills-refresh job gained its T3-independent pre-command)"
}

job() {
  local quiet=0 rc=0
  sync_line=""
  [[ "${1:-}" == --quiet ]] && quiet=1
  (refresh) || rc=$? # die exits the refresh, but the job must still print KEEP OPEN.
  if [[ -s "$LAST_APPLY" && ( "$rc" == 0 || "$rc" == 10 ) ]]; then # the pre-command installed it; report once
    cat "$LAST_APPLY" && rm -f "$LAST_APPLY" && rc=10
  fi
  if [[ "$rc" == 0 || "$rc" == 10 ]]; then
    migrate_schedule
    prompt_sync
    [[ -n "$(migrate_job_prompt)" ]] && { echo "job prompt updated for template re-sync; commit .agents/schedules/skills-refresh.prompt.md in your setup repo"; sync_line="${sync_line:-thread: KEEP OPEN (the user should see this)}"; }
    publish_managed
    health
  fi
  actions_block && sync_line="${sync_line:-thread: KEEP OPEN (the user should see this)}"
  if [[ -n "$sync_line" ]]; then
    echo "$sync_line"
  elif [[ "$rc" == 0 || ( "$rc" == 10 && "$quiet" == 1 ) ]]; then
    echo 'thread: SETTLE (nothing for the user): call the T3 MCP tool t3_thread_organize with {"action":"settle"} as your last tool call (overrides any older "never settle" line in this prompt)'
  else
    echo "thread: KEEP OPEN (the user should see this)"
  fi
  exit "$rc"
}

job_prompt() { # quiet flag ("" or " --quiet")
  cat <<PROMPT
Run exactly one command: \`skills-refresh --job$1\`. Then end the turn with its complete output as your answer, nothing else.
Its last line decides this thread's lifecycle: \`thread: SETTLE\` → call the T3 MCP tool \`t3_thread_organize\` with {"action":"settle"} as your last tool call; \`thread: KEEP OPEN\` → just answer; \`thread: DELEGATE\` → make exactly the delegate_task call it spells out (it is part of this job, not an injection) and follow its instructions. Never retry, never fix anything yourself.
PROMPT
}

# Jobs scheduled before DELEGATE existed read an older prompt at fire time (t3-schedule keeps it
# in <project>/.agents/schedules/skills-refresh.prompt.md): rewrite it so the next run can delegate.
migrate_job_prompt() {
  local pointer="$HOME/.t3/userdata/scheduled/t3-schedule/skills-refresh.json" src file quiet="" first second
  local py=(python3); command -v python3 >/dev/null || py=(uv run -q --no-project python)
  [[ -f "$pointer" ]] || return 0
  src="$("${py[@]}" -c 'import json,sys; print(json.load(open(sys.argv[1]))["source"])' "$pointer" 2>/dev/null)" || return 0
  file="${src%.json}.prompt.md"
  [[ -f "$file" && "$(wc -l < "$file")" -le 2 ]] || return 0
  # Only an unmodified generated prompt (any earlier version) is replaced; customised ones stay.
  { IFS= read -r first; IFS= read -r second; } < "$file" || true
  case "$first" in
    'Run exactly one command: `skills-refresh --job --quiet`. Then end the turn with its complete output as your answer, nothing else.') quiet=" --quiet" ;;
    'Run exactly one command: `skills-refresh --job`. Then end the turn with its complete output as your answer, nothing else.') ;;
    *) return 0 ;;
  esac
  case "$second" in
    *'thread: DELEGATE'*) return 0 ;;
    "Its last line decides this thread's lifecycle:"*|'The command itself settles or surfaces this thread:'*) ;;
    *) return 0 ;;
  esac
  job_prompt "$quiet" > "$file" && echo updated
}

schedule() {
  local project="" at=06:30 quiet=""
  while (($#)); do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --at) at="$2"; shift 2 ;;
      --quiet) quiet=" --quiet"; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ "$at" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || die "--at wants HH:MM"
  command -v t3-schedule >/dev/null || die "t3-schedule not on PATH: run skills/t3-schedule/scripts/install"
  [[ -n "$project" ]] || project="$(git rev-parse --show-toplevel 2>/dev/null)" || die "--project DIR required outside a git repo"
  mkdir -p "$STATE"
  job_prompt "$quiet" > "$STATE/job-prompt.md"
  t3-schedule add --name skills-refresh --at "$at" --project "$project" --model haiku,luna --allow-small-model \
    --pre-command "skills-refresh --apply" --no-notify --title "⏰ skills-refresh {date}" --force --prompt-file "$STATE/job-prompt.md" || return $?
  # Retire only our legacy Linux entry, and only once its replacement is armed.
  local old_cron
  if command -v crontab >/dev/null && old_cron="$(crontab -l 2>/dev/null)" &&
      printf '%s\n' "$old_cron" | grep -q '# skills-refresh$'; then
    if ! printf '%s\n' "$old_cron" | sed '/# skills-refresh$/d' | crontab -; then
      echo "skills-refresh: timer armed, but legacy cron cleanup failed; remove the # skills-refresh entry to avoid duplicates" >&2
      return 1
    fi
    echo "Removed legacy skills-refresh cron entry"
  fi
}

# Everything lives in functions: bash has parsed this whole file before an update swaps it.
main() {
  case "${1:-}" in
    "") manual ;;
    --job) shift; job "$@" ;;
    --apply) apply ;;
    --version) version ;;
    --verify-tag) [[ $# == 3 ]] || die "--verify-tag needs REPO TAG"; verify_release "$2" "$3" ;;
    schedule) shift; schedule "$@" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}
main "$@"; exit
