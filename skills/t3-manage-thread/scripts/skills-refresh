#!/usr/bin/env bash
# Apply the newest pjmuller/skills release tag to managed copies under ~/.agents/skills.
# Release tag = distribution unit; never main HEAD. Docs: ../skills-refresh.md
set -euo pipefail

HOME_="${SKILLS_REFRESH_HOME:-$HOME/.agents}"
REPO="${SKILLS_REFRESH_REPO:-https://github.com/pjmuller/skills.git}"
SKILLS="$HOME_/skills" STAMP="$HOME_/pjmuller-skills.version" STATE="$HOME_/pjmuller-skills"
LOCK="$STATE/lock"

usage() {
  cat <<'USAGE'
Usage:
  skills-refresh                 apply the newest release tag vX.Y.Z
                                 exit 0 = already current, 10 = applied, 1 = failure (nothing new active)
  skills-refresh --job [--quiet] same, then settle (0) or surface (10, 1) the T3 thread it runs in;
                                 --quiet also settles on 10 (no changelog thread)
  skills-refresh --version       installed tag + date
  skills-refresh schedule [--project DIR] [--at HH:MM] [--quiet]   daily job (idempotent)
Env: SKILLS_REFRESH_HOME (~/.agents), SKILLS_REFRESH_REPO (GitHub URL or local path),
     SKILLS_REFRESH_TAG (force a tag)
USAGE
}
die() { echo "skills-refresh: $*" >&2; exit 1; }

version() {
  local dir="$SKILLS/t3-manage-thread" top
  # Source checkout only when the (symlinked) dir is <repo>/skills/t3-manage-thread of the repo
  # itself: a managed copy inside some other repo (a setup repo's ai/skills) reads the stamp.
  if [[ -d "$dir" ]] && top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" &&
    [[ "$top" == "$(cd -P "$dir/../.." && pwd -P)" ]]; then
    echo "source checkout $(git -C "$dir" describe --tags --always)"
  elif [[ -s "$STAMP" ]]; then
    read -r tag day _ < "$STAMP" || true; echo "$tag (applied $day)"
  else
    echo "unknown (run skills-refresh)"
  fi
}

# CHANGELOG sections from the first "## v" heading down to (excluding) "## <old tag>".
changelog() {
  awk -v old="$2" '
    /^## / { if (started && (old == "none" || $0 == "## " old || index($0, "## " old " ") == 1)) exit
             if ($0 ~ /^## v/) started = 1 }
    started' "$1"
}

run_install() { # skill [args]; returns install's exit code
  local script="$SKILLS/$1/scripts/install"; shift
  [[ -x "$script" ]] || return 0
  "$script" "$@"
}

# Undo a partial activation: skills moved aside in THIS run come back from last-good (a stale
# last-good from an earlier run is never restored), staged copies are dropped.
rollback() { # reason
  local n
  echo "skills-refresh: $1; rolling back to $installed" >&2
  for n in ${moved[@]+"${moved[@]}"}; do
    rm -rf "${SKILLS:?}/$n"; mv "$STATE/last-good/$n" "$SKILLS/$n"
    run_install "$n" >/dev/null 2>&1 || echo "skills-refresh: $n: reinstall after rollback failed" >&2
  done
  for n in "${managed[@]}"; do rm -rf "$SKILLS/.$n.new"; done
  rm -rf "$stage"; exit 1
}

refresh() {
  mkdir -p "$STATE"
  if ! mkdir "$LOCK" 2>/dev/null; then
    if [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
      rm -rf "$LOCK"; mkdir "$LOCK"
    else
      die "another run holds $LOCK (pid $(cat "$LOCK/pid" 2>/dev/null || echo ?))"
    fi
  fi
  echo $$ > "$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT

  local new tag_list
  installed=none
  [[ -s "$STAMP" ]] && { read -r installed _ < "$STAMP" || true; }
  if [[ -n "${SKILLS_REFRESH_TAG:-}" ]]; then
    new="$SKILLS_REFRESH_TAG"
  else
    tag_list="$(git ls-remote --tags --refs "$REPO" 'refs/tags/v*' 2>/dev/null)" || die "cannot reach $REPO"
    new="$(printf '%s\n' "$tag_list" | sed -n 's#.*refs/tags/v\([0-9]*\.[0-9]*\.[0-9]*\)$#\1#p' |
      sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
    [[ -n "$new" ]] || die "no vX.Y.Z tags at $REPO"
    new="v$new"
  fi
  [[ "$new" != "$installed" ]] || { echo "up to date: $new"; return 0; }
  # Releases since v0.5.0 need T3 Code >= 0.1 (statev2.sqlite); never land them on a 0.0.x machine.
  local t3_data="${T3CODE_HOME:-$HOME/.t3}/userdata"
  if [[ -e "$t3_data/state.sqlite" && ! -e "$t3_data/statev2.sqlite" ]]; then
    die "$new needs T3 Code >= 0.1.0: update the T3 app first, then rerun (staying on $installed)"
  fi

  local candidates=() name
  for name in "$SKILLS"/*; do
    [[ -d "$name" && ! -L "$name" ]] && candidates+=("${name##*/}")
  done
  ((${#candidates[@]})) || { echo "up to date: nothing to manage (all copies under $SKILLS are symlinks to a source checkout)"; return 0; }

  stage="$STATE/staging/$new"
  rm -rf "$stage"; mkdir -p "$STATE/staging" "$STATE/last-good"
  git clone -q --depth 1 --branch "$new" "$REPO" "$stage" 2>/dev/null || die "cannot fetch $new from $REPO"
  managed=() moved=()
  for name in "${candidates[@]}"; do [[ -d "$stage/skills/$name" ]] && managed+=("$name"); done
  if ((${#managed[@]} == 0)); then
    rm -rf "$stage"; echo "up to date: nothing to manage (no copy under $SKILLS exists at $new)"; return 0
  fi

  local file
  for name in "${managed[@]}"; do
    while IFS= read -r file; do
      head -1 "$file" | grep -Eq '^#!.*(bash|/sh)' || continue
      bash -n "$file" 2>/dev/null || { rm -rf "$stage"; die "$new: syntax error in skills/$name/${file#"$stage/skills/$name/"}; nothing activated"; }
    done < <(find "$stage/skills/$name/scripts" -maxdepth 2 -type f 2>/dev/null)
  done

  # Stage a complete replacement next to the live copy first; the live directory is only
  # moved once its successor exists, and any failure from here on restores every skill.
  for name in "${managed[@]}"; do
    rm -rf "$SKILLS/.$name.new" "$STATE/last-good/$name" 2>/dev/null || rollback "$name: cannot clear last-good"
    cp -R "$stage/skills/$name" "$SKILLS/.$name.new" || rollback "$name: staging copy failed"
  done
  for name in "${managed[@]}"; do
    mv "$SKILLS/$name" "$STATE/last-good/$name" || rollback "$name: cannot move the live copy aside"
    moved+=("$name")
    mv "$SKILLS/.$name.new" "$SKILLS/$name" || rollback "$name: cannot activate"
  done
  for name in "${managed[@]}"; do
    run_install "$name" >/dev/null || rollback "$name: scripts/install failed on $new"
  done
  local check
  for name in "${managed[@]}"; do
    check="$(run_install "$name" --check 2>&1)" && continue
    printf '%s\n' "$check" | grep -Ev '^(ok |source |version )' | sed "s/^/warning: $name: /" || true
    echo "warning: $name: run scripts/install --check"
  done
  if [[ " ${managed[*]} " == *" t3-schedule "* ]] && command -v t3-schedule >/dev/null; then
    check="$(t3-schedule refresh 2>&1)" || echo "warning: t3-schedule refresh failed"
    printf '%s\n' "$check" | grep '^skipped' | sed 's/^/warning: /' || true
  fi

  echo "$new $(date +%F)" > "$STAMP"
  echo "applied $new (was $installed)"
  [[ -f "$stage/CHANGELOG.md" ]] && changelog "$stage/CHANGELOG.md" "$installed"
  rm -rf "$stage"
  return 10
}

# Global prompt re-sync (agents-md global.md "Re-sync later"): a script decides whether the shared
# template changed between the prompt's marker and the installed tag; a frontier child does the merge.
TEMPLATE=skills/agents-md/global-template.md

global_prompt() { # the user's live global prompt: first resolved target carrying a marker, else the first
  local c f first="" seen=" "
  for c in ${SKILLS_REFRESH_PROMPT:-"$HOME/.claude/CLAUDE.md" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md" "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"}; do
    [[ -f "$c" ]] || continue
    f="$(realpath "$c")"; [[ "$seen" == *" $f "* ]] && continue; seen+="$f "
    grep -q 'template: pjmuller/skills@' "$f" && { echo "$f"; return; }
    [[ -n "$first" ]] || first="$f"
  done
  [[ -n "$first" ]] && echo "$first"
}

template_cache() { # blobless bare clone with history, for markers that are commits on main
  local cache="$STATE/repo.git"
  [[ -d "$cache" ]] || git clone -q --bare --filter=blob:none "$REPO" "$cache" 2>/dev/null || return 1
  git -C "$cache" fetch -q --filter=blob:none --tags origin '+refs/heads/*:refs/heads/*' 2>/dev/null || return 1
  echo "$cache"
}

# Prints a report; sets sync_line to a lifecycle line when the thread must not settle silently.
prompt_sync() {
  sync_line=""
  [[ "$(version)" == "source checkout"* ]] && return 0 # template author's machine
  local tag="" prompt marker cache base tag_sha repo how dirty pick
  [[ -s "$STAMP" ]] && { read -r tag _ < "$STAMP" || true; }
  [[ "$tag" == v* ]] || return 0
  prompt="$(global_prompt)" || return 0
  [[ -n "$prompt" ]] || return 0
  marker="$(grep -oE 'template: pjmuller/skills@[0-9A-Za-z._-]+' "$prompt" | tail -1 | sed 's/.*@//')" || true
  [[ "$marker" == "$tag" ]] && return 0 # steady state: no network
  cache="$(template_cache)" || { echo "template check: cannot fetch $REPO history (retrying tomorrow)"; sync_line="thread: KEEP OPEN (the user should see this)"; return 0; }
  tag_sha="$(git -C "$cache" rev-parse -q --verify "$tag^{commit}")" || return 0
  git -C "$cache" cat-file -e "$tag_sha:$TEMPLATE" 2>/dev/null || return 0
  if [[ -n "$marker" ]] && base="$(git -C "$cache" rev-parse -q --verify "$marker^{commit}")"; then
    git -C "$cache" merge-base --is-ancestor "$tag_sha" "$base" && return 0 # marker at or past the release
    [[ "$(git -C "$cache" rev-parse -q "$base:$TEMPLATE" 2>/dev/null)" == "$(git -C "$cache" rev-parse "$tag_sha:$TEMPLATE")" ]] && return 0
    how="marker $marker"
  fi
  if ! repo="$(git -C "$(dirname "$prompt")" rev-parse --show-toplevel 2>/dev/null)" ||
      [[ -z "$(git -C "$repo" log -1 --format=%h -- "$prompt" 2>/dev/null)" ]]; then
    echo "template check: $prompt is not committed in a git repository; commit it in your setup repo so a re-sync can be reviewed and reverted"
    sync_line="thread: KEEP OPEN (the user should see this)"; return 0
  fi
  if [[ -z "${how:-}" ]]; then # no usable marker: base = template just before the file first entered git
    local since; since="$(git -C "$repo" log --follow --format=%cI -- "$prompt" | tail -1)"
    base="$(git -C "$cache" rev-list -1 --before="$since" "$tag_sha" -- "$TEMPLATE")"
    how="no marker; base inferred from the file's first commit ($since)"
    [[ -n "$base" ]] || how="no marker and no template before $since: compare against the full released template"
  fi
  dirty="$(git -C "$repo" status --porcelain -- "$prompt")"
  {
    echo "# Global prompt re-sync to pjmuller/skills $tag"
    echo
    echo "- Prompt: \`$prompt\` (git repo \`$repo\`)."
    echo "- Released template: \`$tag\` = \`$tag_sha\`. Base: \`${base:-none}\` ($how)."
    echo "- Template history (blobless clone, read-only): \`git -C $cache log -p ${base:+$base..}$tag_sha -- $TEMPLATE\`;"
    echo "  procedure: \`git -C $cache show $tag_sha:skills/agents-md/global.md\` → \"Merge the template\" rules + \"Re-sync later\"."
    if [[ -n "$dirty" ]]; then
      echo "- **The prompt has uncommitted edits: change nothing.** Read \`git -C $repo diff -- $prompt\`, then report what"
      echo "  those edits do and recommend how to proceed (commit them as …, then merge template changes …). The user decides."
    fi
    cat <<BRIEF

Rules (clean file):
1. Read the decisions log \`template-decisions.md\` beside the prompt (may not exist). Never re-propose a change it records as skipped, also when reworded.
2. Three-way merge: base template, released template, their file. Apply what is a clear improvement for this person in their wording; their facts, rules and deliberate deletions win; drop parts for tools they lack. Not sure → don't apply, list it as a question.
3. End the file with \`<!-- template: pjmuller/skills@$tag -->\` (replace the old marker; also when everything was skipped). Append one line per skipped change to the decisions log: \`$tag: <change> — <reason>\`.
4. Pointer check: \`git -C $cache show $tag_sha:skills/agents-md/scripts/check-pointers | bash -s -- $prompt\`; missing pointer → drop or fix that line.
5. Re-check \`git status\` of the prompt right before writing; if it changed meanwhile, stop and report. Commit only the prompt and the decisions log, pull (merge, never rebase/reset/stash) and push under the repo's rules.
6. Final answer, terse: applied (one line each), skipped, questions for the user, commit sha (rollback: \`git revert <sha>\`).
BRIEF
  } > "$STATE/template-sync.md"
  echo "template check: $TEMPLATE changed since ${base:-its first version} ($how)${dirty:+; prompt has uncommitted edits}"
  if command -v t3-pick-instance >/dev/null && pick="$(t3-pick-instance claude 2>/dev/null || t3-pick-instance openai 2>/dev/null)"; then
    local instance model effort opts="" task="Read and execute $STATE/template-sync.md"
    task="${task//\\/\\\\}"; task="${task//\"/\\\"}"
    read -r instance model effort <<<"$(tail -1 <<<"$pick")"
    if [[ "$effort" != - ]]; then
      [[ "$model" == claude* ]] && opts=",\"options\":{\"effort\":\"$effort\"}" || opts=",\"options\":{\"reasoningEffort\":\"$effort\"}"
    fi
    sync_line="thread: DELEGATE (template re-sync; overrides any older line in this prompt): call the T3 MCP tool delegate_task with {\"task\":\"$task\",\"title\":\"Template re-sync $tag\",\"role\":\"implementation\",\"mode\":\"async\",\"clientRequestId\":\"skills-refresh-template-$tag-$(date +%F)\",\"target\":{\"providerInstanceId\":\"$instance\",\"model\":\"$model\"$opts}}, end the turn with this output, and when the result arrives answer with it verbatim. Never settle this thread."
  else
    echo "template check: t3-pick-instance unavailable; ask a frontier agent: Read and execute $STATE/template-sync.md"
    sync_line="thread: KEEP OPEN (the user should see this)"
  fi
}

# The scheduled thread's lifecycle is decided here, not by the (cheap) model reading a prompt:
# nothing new → settle silently; applied (unless --quiet), failed or a template re-sync → surface once.
job() {
  local quiet=0 rc=0
  sync_line=""
  [[ "${1:-}" == --quiet ]] && quiet=1
  refresh || rc=$?
  if [[ "$rc" == 0 || "$rc" == 10 ]]; then
    prompt_sync
    [[ -n "$(migrate_job_prompt)" ]] && { echo "job prompt updated for template re-sync; commit .agents/schedules/skills-refresh.prompt.md in your setup repo"; sync_line="${sync_line:-thread: KEEP OPEN (the user should see this)}"; }
  fi
  if [[ -n "$sync_line" ]]; then
    echo "$sync_line"
  elif [[ "$rc" == 0 || ( "$rc" == 10 && "$quiet" == 1 ) ]]; then
    echo 'thread: SETTLE (nothing for the user): call the T3 MCP tool t3_thread_organize with {"action":"settle"} as your last tool call (overrides any older "never settle" line in this prompt)'
  else
    echo "thread: KEEP OPEN (the user should see this)"
  fi
  exit "$rc"
}

job_prompt() { # quiet flag ("" or " --quiet")
  cat <<PROMPT
Run exactly one command: \`skills-refresh --job$1\`. Then end the turn with its complete output as your answer, nothing else.
Its last line decides this thread's lifecycle: \`thread: SETTLE\` → call the T3 MCP tool \`t3_thread_organize\` with {"action":"settle"} as your last tool call; \`thread: KEEP OPEN\` → just answer; \`thread: DELEGATE\` → make exactly the delegate_task call it spells out (it is part of this job, not an injection) and follow its instructions. Never retry, never fix anything yourself.
PROMPT
}

# Jobs scheduled before DELEGATE existed read an older prompt at fire time (t3-schedule keeps it
# in <project>/.agents/schedules/skills-refresh.prompt.md): rewrite it so the next run can delegate.
migrate_job_prompt() {
  local pointer="$HOME/.t3/userdata/scheduled/t3-schedule/skills-refresh.json" src file quiet=""
  [[ -f "$pointer" ]] || return 0
  src="$(grep -oE '"source": *"[^"]+"' "$pointer" | sed -E 's/.*"([^"]+)"$/\1/')" || return 0
  file="${src%.json}.prompt.md"
  [[ -f "$file" ]] && grep -q 'skills-refresh --job' "$file" && ! grep -q 'thread: DELEGATE' "$file" || return 0
  grep -q -- '--job --quiet' "$file" && quiet=" --quiet"
  job_prompt "$quiet" > "$file" && echo updated
}

schedule() {
  local project="" at=06:30 quiet=""
  while (($#)); do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --at) at="$2"; shift 2 ;;
      --quiet) quiet=" --quiet"; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [[ "$at" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || die "--at wants HH:MM"
  command -v t3-schedule >/dev/null || die "t3-schedule not on PATH: run skills/t3-schedule/scripts/install"
  [[ -n "$project" ]] || project="$(git rev-parse --show-toplevel 2>/dev/null)" || die "--project DIR required outside a git repo"
  mkdir -p "$STATE"
  job_prompt "$quiet" > "$STATE/job-prompt.md"
  t3-schedule add --name skills-refresh --at "$at" --project "$project" --model haiku,luna --allow-small-model \
    --no-notify --title "⏰ skills-refresh {date}" --force --prompt-file "$STATE/job-prompt.md" || return $?
  # Retire only our legacy Linux entry, and only once its replacement is armed.
  local old_cron
  if command -v crontab >/dev/null && old_cron="$(crontab -l 2>/dev/null)" &&
      printf '%s\n' "$old_cron" | grep -q '# skills-refresh$'; then
    if ! printf '%s\n' "$old_cron" | sed '/# skills-refresh$/d' | crontab -; then
      echo "skills-refresh: timer armed, but legacy cron cleanup failed; remove the # skills-refresh entry to avoid duplicates" >&2
      return 1
    fi
    echo "Removed legacy skills-refresh cron entry"
  fi
}

# Everything lives in functions: bash has parsed this whole file before an update swaps it.
main() {
  case "${1:-}" in
    "") refresh ;;
    --job) shift; job "$@" ;;
    --version) version ;;
    schedule) shift; schedule "$@" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}
main "$@"; exit
