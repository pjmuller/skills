#!/bin/bash
# Build the official release until upstream publishes its native binaries/PyPI wheel.
set -euo pipefail
cd "$(dirname "$0")/.."
# Library name = what neonize/utils/platform.py generated_name() loads.
cgo_flags=()
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) lib=neonize-darwin-arm64.dylib
    cgo_flags=(CGO_CFLAGS=-mmacosx-version-min=13.0 CGO_LDFLAGS=-mmacosx-version-min=13.0) ;;
  Linux/x86_64) lib=neonize-linux-amd64.so ;;
  Linux/aarch64) lib=neonize-linux-arm64.so ;;
  *) echo 'Supported builds: Apple Silicon macOS, Linux x86_64/arm64 (incl. WSL2).' >&2; exit 1 ;;
esac
command -v cc >/dev/null || { echo 'Install a C compiler first (Ubuntu: sudo apt-get install -y build-essential)' >&2; exit 1; }
revision=d5d17b8579db56e66bf396e2d5a77ac72f391e7d
mkdir -p .build
if [[ ! -d .build/neonize ]]; then
  git clone --depth 1 --branch 0.4.7 https://github.com/krypton-byte/neonize.git .build/neonize
fi
[[ "$(git -C .build/neonize rev-parse HEAD)" == "$revision" ]] || {
  echo 'Unexpected Neonize checkout revision; refusing to build.' >&2; exit 1;
}
# Only our committed patches may differ from upstream: NEONIZE_BOT_TAG=always (AI badge in groups too)
# and peer requests to our own phone (resend old messages with their media keys).
git -C .build/neonize checkout -q -- .
for patch in scripts/neonize-bot-tag-always.patch scripts/neonize-peer-request.patch; do
  git -C .build/neonize apply "$PWD/$patch"
done
mise install
(
  cd .build/neonize/goneonize
  mise exec go@1.26.0 -- env GOTOOLCHAIN=local CGO_ENABLED=1 "${cgo_flags[@]}" \
    go build -buildmode=c-shared -ldflags=-s -o "../neonize/$lib" .
)
echo 'Built Neonize 0.4.7 + patches. Run uv sync to install.'
