#!/bin/sh
set -eu
case "${1:-}" in ""|--check) mode="${1:-}";; *) echo "usage: $0 [--check]" >&2; exit 2;; esac
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "$mode" ]; then echo "source: $root"; fi
command -v uv >/dev/null || { echo "Install uv first (https://docs.astral.sh/uv/)" >&2; exit 1; }
command -v mise >/dev/null || { echo "Install mise first (https://mise.jdx.dev); it pins Go/Python for the Neonize build" >&2; exit 1; }
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) lib=neonize-darwin-arm64.dylib
    brew list libmagic >/dev/null 2>&1 || { echo "Install libmagic first: brew install libmagic" >&2; exit 1; } ;;
  Linux/x86_64|Linux/aarch64) lib=neonize-linux-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/').so
    ldconfig -p 2>/dev/null | grep -q 'libmagic\.so\.1' || { echo "Install libmagic first: sudo apt-get install -y libmagic1" >&2; exit 1; } ;;
  *) echo "Unsupported platform $(uname -s)/$(uname -m); see README.md" >&2; exit 1 ;;
esac
lib="$root/.build/neonize/neonize/$lib"
if [ ! -f "$lib" ]; then
  if [ -n "$mode" ]; then
    echo "Neonize 0.4.7 is not built ($lib missing); run scripts/install" >&2
    exit 1
  fi
  "$root/scripts/build-neonize"
fi
uv sync --project "$root" --locked
uv run --project "$root" python -c 'import whatsapp_bridge'
uv run --project "$root" wa --help >/dev/null
login="wa login --window"; [ "$(uname -s)" = Darwin ] || login="wa login (in a terminal the human can see)"
printf '%s\n' "whatsapp-bridge ready; run \`uv run --project $root $login\` to pair (no global command links)"
