#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
install_dir="${HOME}/.local/bin"
commands=(tls_trust_audit.sh tls_trust_remediate.sh)
[[ $# == 0 || ( $# == 1 && ( "$1" == --check || "$1" == --relink ) ) ]] || { echo 'Usage: install [--check|--relink]' >&2; exit 2; }
[[ "${1:-}" != --check ]] || echo "source $script_dir"
if [[ "${1:-}" == "--check" ]]; then
  for dependency in bash openssl curl git find; do
    command -v "$dependency" >/dev/null || { echo "missing $dependency; install this prerequisite with your package manager, then rerun scripts/install --check" >&2; exit 1; }
    echo "ok      $dependency ($(command -v "$dependency"))"
  done
  # The audit enumerates bundle subjects through crl2pkcs7 | pkcs7. LibreSSL's openssl on macOS
  # ships both, but a stripped build can omit them, and then every bundle silently reads as safe.
  # Exercise the real pipeline on empty input rather than parsing -help: LibreSSL has no -help,
  # and `... | grep -q` would SIGPIPE openssl and trip pipefail.
  openssl crl2pkcs7 -nocrl -certfile /dev/null 2>/dev/null \
    | openssl pkcs7 -print_certs -noout >/dev/null 2>&1 \
    || { echo "openssl lacks crl2pkcs7/pkcs7; install a full openssl (brew install openssl) and rerun --check" >&2; exit 1; }
  echo "ok      openssl crl2pkcs7 | pkcs7"
  for advisory in "$script_dir"/../advisories/*.conf; do
    [[ -r "$advisory" ]] || { echo "missing advisory data in $script_dir/../advisories" >&2; exit 1; }
    echo "ok      advisory $(basename "$advisory")"
  done
  for helper in "${commands[@]}"; do
    [[ "$(readlink -f "$install_dir/$helper")" == "$script_dir/$helper" ]] || { echo "missing or stale $helper; run $script_dir/install" >&2; exit 1; }
    echo "ok      $helper"
  done
  exit 0
fi
# Preflight every link before changing any command.
project_copy=false
case "$script_dir" in
  "$HOME"/.agents/skills/*|"$HOME"/.claude/skills/*) ;;
  */.agents/skills/*|*/.claude/skills/*) project_copy=true ;;
esac
warn_project=false
[[ ! -d "$HOME/.agents/skills/tls-trust-audit" ]] || warn_project=true
for command_name in "${commands[@]}"; do
  existing="$(readlink -f "$install_dir/$command_name" 2>/dev/null || true)"
  if [[ -n "$existing" && -e "$existing" && "$(dirname "$existing")" != "$script_dir" ]]; then
    warn_project=true
    if [[ "${1:-}" != --relink ]]; then
      echo "refusing checkout change: $existing -> $script_dir/$command_name; re-run from the checkout you want to be canonical, or pass --relink" >&2
      exit 1
    fi
  fi
done
if $project_copy && $warn_project; then
  echo "warning: project copy $script_dir is being made global" >&2
fi

mkdir -p "$install_dir"
for helper in "${commands[@]}"; do
  ln -sfn "$script_dir/$helper" "$install_dir/$helper"
  echo "installed $install_dir/$helper"
done
