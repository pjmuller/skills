#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Poll Fathom / Leexi / Monologue for new calls this machine owns; spawn one T3 follow-up thread per call.

Deterministic: no LLM here. Python lists, elects the owner, routes and writes the transcript; the
spawned thread does the judgement. Everything personal (self, roster, keys, workspaces, briefs) lives in
the machine's config (../config.md), never in this replaceable install.
"""
import argparse
import fcntl
import http.client
import json
import os
import re
import signal
import subprocess
import sys
import time
from base64 import b64encode
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path
from string import Template
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent))
import recording_owner  # noqa: E402

TZ = ZoneInfo("Europe/Brussels")
SKILL_DIR = Path(__file__).resolve().parent.parent
CONFIG = Path(os.environ.get("RECORDING_WATCHER_CONFIG", "~/.config/recording-watcher/config.json")).expanduser()
STATE_DIR = Path(os.environ.get("RECORDING_WATCHER_STATE", "~/.local/state/recording-watcher")).expanduser()
FATHOM_API = "https://api.fathom.ai/external/v1"
LEEXI_API = "https://public-api.leexi.ai/v1"
MONOLOGUE_API = "https://api.monologue.to/v1/public-api"
MAX_SPAWNS = 6                         # per poll; the rest waits for the next poll
LOOKBACK_DAYS = 3                      # first run without a watermark
MIN_WORDS = 150                        # shorter transcripts are false starts (skipped:too-short)
NO_TRANSCRIPT_GIVE_UP = timedelta(hours=6)
WORK_DAYS, WORK_HOURS = range(0, 5), range(9, 18)
FINAL = ("spawned", "skipped:")
RELAY_PENDING = "relay-pending"        # accepted by t3-relay, launch not yet confirmed: never respawn
RELAY_WAIT = 120                       # seconds a spawn waits for t3-relay to confirm the thread exists
PENDING_ALERT = timedelta(hours=1)     # an unconfirmed spawn older than this is reported
VISUAL_TIMEOUT = timedelta(minutes=45)  # download + detect-screenshare per call; later -> "not assessed"
MAX_VISUAL_JOBS = 3                     # concurrent background video checks (bandwidth, disk)
MEDIA_KEEP = timedelta(days=1)          # local video copies go this long after the call's final status
VIDEO_SUFFIXES = (".mp4", ".webm", ".mkv")
# Seconds; the job kills each step's process group at its limit, so 30 + 10 min < VISUAL_TIMEOUT frees the slot
# for real. A ~50 min Fathom HLS download took ~11 min.
DOWNLOAD_TIMEOUT, DETECT_TIMEOUT = 30 * 60, 10 * 60


@dataclass
class Config:
    self_id: str
    roster: dict
    sources: dict                     # name -> {"env_file", optional "workspace", "personal"}
    workspace: str                    # default T3 project
    routes: list = field(default_factory=list)          # [{"workspace", "names" regex, "emails" suffixes}]
    model: str | None = None
    briefs_dir: Path | None = None
    followups_skill: str = ""
    speaker_aliases: dict = field(default_factory=dict)


def load_config(path=CONFIG):
    """Read and validate the machine config; problems stop the poll loudly instead of skipping calls."""
    if not path.exists():
        raise SystemExit(f"no config at {path}: see {SKILL_DIR / 'config.md'}")
    raw = json.loads(path.read_text())
    roster = raw.get("roster")
    if isinstance(roster, str):
        roster = json.loads(Path(roster).expanduser().read_text())
    roster = recording_owner.validate_roster(roster) if roster else None
    if not roster or raw.get("self") not in roster["people"]:
        raise SystemExit(f"{path}: `self` must be a person in `roster` (got {raw.get('self')!r})")
    if not raw.get("workspace"):
        raise SystemExit(f"{path}: `workspace` (default T3 project for follow-up threads) is required")
    unknown = set(raw.get("sources") or {}) - set(SOURCES)
    if unknown or not raw.get("sources"):
        raise SystemExit(f"{path}: `sources` must name some of {sorted(SOURCES)} (unknown: {sorted(unknown)})")
    home = lambda p: str(Path(p).expanduser()) if p else p   # noqa: E731
    sources = {name: {**spec, "workspace": home(spec.get("workspace"))} for name, spec in raw["sources"].items()}
    return Config(self_id=raw["self"], roster=roster, sources=sources, workspace=home(raw["workspace"]),
                  routes=[{**r, "workspace": home(r["workspace"])} for r in raw.get("routes") or []], model=raw.get("model"),
                  briefs_dir=Path(raw["briefs_dir"]).expanduser() if raw.get("briefs_dir") else None,
                  followups_skill=home(raw.get("followups_skill")) or str(SKILL_DIR.parent / "recording-followups" / "SKILL.md"),
                  speaker_aliases={k.lower(): v for k, v in (raw.get("speaker_aliases") or {}).items()})


@dataclass
class Call:
    source: str
    id: str
    title: str
    start: datetime
    created: datetime
    duration_s: float
    url: str
    invitees: list = field(default_factory=list)       # [(name, email)]
    recorder: str = ""
    has_video: bool = True
    segments: list | None = None                      # [(timestamp, speaker, text, identity)] see speaker_identity
    decision: recording_owner.Decision | None = None  # set by evaluate

    @property
    def key(self):
        return f"{self.source}:{self.id}"


# ---------- env + http ----------

def load_env(path, keys):
    values = {}
    p = Path(path or "/nonexistent").expanduser()
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.removeprefix("export ").strip()
            if k in keys:
                values[k] = v.strip().strip("'\"")
    values.update({k: os.environ[k] for k in keys if os.environ.get(k)})
    missing = [k for k in keys if not values.get(k)]
    if missing:
        raise SystemExit(f"missing {', '.join(missing)} (env or {path})")
    return values


def http_json(url, headers, attempts=4):
    for attempt in range(attempts):
        try:
            with urlopen(Request(url, headers={"User-Agent": "recording-watcher/1.0", "Accept": "application/json", **headers}),
                         timeout=60) as response:
                return json.load(response)
        except HTTPError as exc:
            if exc.code not in (429, 500, 502, 503, 504) or attempt == attempts - 1:
                raise
            if exc.code == 429:   # Fathom: 60 requests/minute, Leexi 50
                time.sleep(min(int(exc.headers.get("Retry-After") or 20), 60))
                continue
        except (URLError, http.client.RemoteDisconnected, TimeoutError, ConnectionError):
            if attempt == attempts - 1:
                raise
        time.sleep(2 ** attempt * 2)


def parse_ts(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00")) if value else None


def utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def clock(seconds):
    total = int(float(seconds or 0))
    h, rest = divmod(total, 3600)
    m, s = divmod(rest, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


# ---------- sources ----------

class Fathom:
    name = "fathom"

    def __init__(self, cfg):
        self.cfg = cfg
        key = load_env(cfg.sources["fathom"].get("env_file"), ["FATHOM_API_KEY"])["FATHOM_API_KEY"]
        self.headers = {"X-Api-Key": key}

    def list(self, since):
        calls, cursor, seen = [], None, set()
        while True:
            params = {"created_after": utc(since)}
            if cursor:
                params["cursor"] = cursor
            data = http_json(f"{FATHOM_API}/meetings?{urlencode(params)}", self.headers)
            for m in data.get("items") or []:
                start, end = parse_ts(m.get("recording_start_time")), parse_ts(m.get("recording_end_time"))
                calls.append(Call(
                    source="fathom", id=str(m["recording_id"]), title=m.get("title") or m.get("meeting_title") or "",
                    start=start or parse_ts(m["created_at"]), created=parse_ts(m["created_at"]),
                    duration_s=(end - start).total_seconds() if start and end else 0,
                    url=m.get("share_url") or m.get("url") or "",
                    invitees=[(i.get("name") or "", (i.get("email") or "").lower()) for i in m.get("calendar_invitees") or []],
                    recorder=((m.get("recorded_by") or {}).get("email") or "").lower()))
            cursor = data.get("next_cursor")
            if not cursor or cursor in seen:
                return calls
            seen.add(cursor)

    def load(self, call):
        data = http_json(f"{FATHOM_API}/recordings/{call.id}/transcript", self.headers)
        call.segments = [(s.get("timestamp") or "", speaker_name(self.cfg, (s.get("speaker") or {}).get("display_name")),
                          s.get("text") or "", speaker_identity((s.get("speaker") or {}).get("matched_calendar_invitee_email"),
                                                                 (s.get("speaker") or {}).get("display_name")))
                         for s in data.get("transcript") or []]


class Leexi:
    name = "leexi"

    def __init__(self, cfg):
        self.cfg = cfg
        env = load_env(cfg.sources["leexi"].get("env_file"), ["LEEXI_KEY_ID", "LEEXI_KEY_SECRET"])
        token = b64encode(f"{env['LEEXI_KEY_ID']}:{env['LEEXI_KEY_SECRET']}".encode()).decode()
        self.headers = {"Authorization": f"Basic {token}"}

    def list(self, since):
        calls, page = [], 1
        while True:
            params = {"order": "performed_at desc", "items": 100, "page": page,
                      "from": since.astimezone(timezone.utc).isoformat(), "to": datetime.now(timezone.utc).isoformat()}
            data = http_json(f"{LEEXI_API}/calls?{urlencode(params)}", self.headers)   # filters on created_at
            for c in data.get("data") or []:
                calls.append(Call(
                    source="leexi", id=c["uuid"], title=c.get("title") or "", start=parse_ts(c["performed_at"]),
                    created=parse_ts(c["created_at"]), duration_s=float(c.get("duration") or 0), url=c.get("leexi_url") or "",
                    invitees=[(x.get("name") or "", (x.get("email") or "").lower())
                              for x in (c.get("customers") or []) + (c.get("participating_users") or []) if isinstance(x, dict)],
                    recorder=((c.get("owner") or {}).get("email") or "").lower(), has_video=bool(c.get("is_video"))))
            if page >= int((data.get("pagination") or {}).get("pages") or 1):
                return calls
            page += 1

    def load(self, call):
        data = http_json(f"{LEEXI_API}/calls/{call.id}", self.headers)
        data = data.get("data", data)
        speakers = {s.get("index"): s for s in data.get("speakers") or []}
        call.segments = []
        for para in data.get("transcript") or []:
            sp = speakers.get(para.get("speaker_index")) or {}
            text = " ".join((i.get("content") or "").strip() for i in para.get("items") or []).strip()
            call.segments.append((clock(para.get("start_time")), speaker_name(self.cfg, sp.get("name")), text,
                                  speaker_identity(sp.get("email_address"), sp.get("name"))))


class Monologue:
    """The operator's own Monologue account: personal recordings, neutral speaker ids, no identities."""
    name = "monologue"

    def __init__(self, cfg):
        self.cfg = cfg
        key = load_env(cfg.sources["monologue"].get("env_file"), ["MONOLOGUE_API_KEY"])["MONOLOGUE_API_KEY"]
        self.headers = {"Authorization": f"Bearer {key}"}

    def list(self, since):
        calls, cursor, seen = [], None, set()
        while True:
            params = {"limit": 100, "created_after": utc(since)}
            if cursor:
                params["cursor"] = cursor
            data = http_json(f"{MONOLOGUE_API}/notes?{urlencode(params)}", self.headers)
            for n in data.get("items") or []:
                created = parse_ts(n["created_at"])
                calls.append(Call(source="monologue", id=n["note_id"], title=n.get("title") or "",
                                  start=parse_ts(n.get("recorded_at")) or created, created=created, duration_s=0,
                                  url=f"monologue note {n['note_id']}", has_video=False))
            cursor = data.get("next_cursor")
            if not cursor or cursor in seen:
                return calls
            seen.add(cursor)

    def load(self, call):
        data = http_json(f"{MONOLOGUE_API}/notes/{call.id}", self.headers)
        segs = data.get("transcript_segments") or []
        call.segments = [(clock(s.get("start")), s.get("speaker_id") or "Unknown", s.get("text") or "", "") for s in segs]
        if not segs and data.get("transcript"):
            call.segments = [("00:00:00", "Unknown", data["transcript"], "")]
        call.duration_s = float(segs[-1].get("end") or 0) if segs else 0


SOURCES = {"fathom": Fathom, "leexi": Leexi, "monologue": Monologue}


# ---------- pure logic (tested) ----------

def in_hours(now):
    local = now.astimezone(TZ)
    return local.weekday() in WORK_DAYS and local.hour in WORK_HOURS


def speaker_name(cfg, display_name):
    """Vendor display name -> the person (shared recorder accounts resolved via config speaker_aliases)."""
    name = display_name or "Unknown"
    return cfg.speaker_aliases.get(name.lower(), name)


def speaker_identity(email, display_name):
    """Vendor-verified email, else `name:<display name>` (matches only a roster identity spelled that way)."""
    return (email or (f"name:{display_name}" if display_name else "")).lower()


def is_self(cfg, call, email):
    return recording_owner.person_of(cfg.roster, call.source, email) == cfg.self_id


def speaker_words(segments):
    """{speaker: [words, email]} in order of first appearance."""
    out = {}
    for _, name, text, email in segments:
        entry = out.setdefault(name, [0, email])
        entry[0] += len(text.split())
        entry[1] = entry[1] or email
    return out


def self_share(cfg, call):
    words = speaker_words(call.segments or [])
    total = sum(w for w, _ in words.values())
    return (sum(w for w, e in words.values() if is_self(cfg, call, e)) / total) if total else 0.0


def route_of(cfg, name, email):
    text, email = (name or "").lower(), (email or "").lower()
    for r in cfg.routes:
        if (r.get("names") and re.search(r["names"], text, re.I)) or (email and any(email.endswith(s) for s in r.get("emails") or [])):
            return r["workspace"]
    return None


def route(cfg, call):
    """Workspace root. A source with its own `workspace` always goes there. Otherwise known non-self speakers
    vote by word count; no known speaker -> invitees (minus self and the recorder account) vote; tie -> default."""
    if ws := cfg.sources[call.source].get("workspace"):
        return ws
    scores = {}
    for name, (words, email) in speaker_words(call.segments or []).items():
        if not is_self(cfg, call, email) and (ws := route_of(cfg, name, email)):
            scores[ws] = scores.get(ws, 0) + words
    if not scores:
        for name, email in call.invitees:
            if not is_self(cfg, call, email) and email != call.recorder and (ws := route_of(cfg, name, email)):
                scores[ws] = scores.get(ws, 0) + 1
    if not scores:
        return cfg.workspace
    best = max(scores.values())
    winners = [ws for ws, s in scores.items() if s == best]
    return winners[0] if len(winners) == 1 else cfg.workspace


def mmss(seconds):
    m, s = divmod(int(seconds), 60)
    return f"{m}:{s:02d}"


def visual_line(visual):
    """One-line verdict for the transcript header, state and log."""
    status = visual.get("status")
    if status == "audio-only":
        return "no video (audio-only recording)"
    if status != "done":
        return f"not assessed ({visual.get('reason') or status})"
    if visual.get("method") == "full-fallback":
        return "not assessed (not a Google Meet layout: the detector cannot tell)"
    ranges = visual.get("ranges") or []
    if not ranges:
        return "none detected (video checked every second)"
    spans = ", ".join(f"{mmss(r['start'])}-{mmss(r['end'])}" for r in ranges[:8]) + (" …" if len(ranges) > 8 else "")
    return f"{len(ranges)} range(s), {visual.get('share_seconds', 0) / 60:.0f} min: {spans}"


def evaluate(cfg, call, now):
    """'qualifies' | 'pending' | 'skipped:<reason>'. Elects the owner before any expensive step."""
    if not call.segments:
        return "skipped:no-transcript" if now - call.created > NO_TRANSCRIPT_GIVE_UP else "pending"
    if sum(len(t.split()) for _, _, t, _ in call.segments) < MIN_WORDS:
        return "skipped:too-short"
    if cfg.sources[call.source].get("personal"):
        call.decision = recording_owner.Decision("process", "personal", cfg.self_id, None)
    else:
        call.decision = recording_owner.elect(cfg.roster, cfg.self_id, call.source, call.recorder,
                                              [(email, len(text.split())) for _, _, text, email in call.segments])
    return "qualifies" if call.decision.action == "process" else f"skipped:{call.decision.reason}"


def others(cfg, call):
    names = [n for n, (w, e) in sorted(speaker_words(call.segments or []).items(), key=lambda kv: -kv[1][0])
             if not is_self(cfg, call, e) and not re.fullmatch(r"(speaker[ _]?\d+|unknown)", n, re.I)]
    return list(dict.fromkeys(names))


def thread_title(cfg, call):
    firsts = []
    for n in others(cfg, call):
        first = re.sub(r"[^\w-]", "", n.split()[0]) if n.split() else ""
        if first and first.lower() not in {f.lower() for f in firsts}:
            firsts.append(first)
    words = firsts[:2] or [w for w in re.findall(r"[\w-]+", call.title) if not re.fullmatch(r"pj|and|en|x", w, re.I)][:3]
    return " ".join(["Call", *words, call.start.astimezone(TZ).strftime("%m-%d")])


def election_line(call):
    return call.decision.evidence() if call.decision else "not run"


def render_transcript(cfg, call, visual):
    local = call.start.astimezone(TZ)
    words = speaker_words(call.segments)
    total = sum(w for w, _ in words.values()) or 1
    lines = [f"# {call.title or call.key}", "",
             f"- Source: {call.source} · {call.url}",
             f"- When: {local:%Y-%m-%d %H:%M} Europe/Brussels · {round(call.duration_s / 60)} min",
             f"- Owner election: {election_line(call)}",
             "- Speakers: " + ", ".join(f"{n} {w / total:.0%}" for n, (w, _) in sorted(words.items(), key=lambda kv: -kv[1][0])),
             f"- Screen share: {visual_line(visual)}",
             f"- Raw {call.source} ASR, not verified against audio/video.", "", "## Transcript", ""]
    prev = None
    for ts, name, text, _ in call.segments:
        if name == prev:
            lines[-2] += " " + text
            continue
        lines += [f"**[{ts}] {name}:** {text}", ""]
        prev = name
    return "\n".join(lines).rstrip() + "\n"


def visual_media(call, visual, transcript_path):
    """The brief's $media sentence: what the video check found and what the thread does with the video."""
    skill = f"{SKILL_DIR.parent}/video-shrink-for-gemini/SKILL.md"
    status, media = visual.get("status"), media_dir(call.key)
    store = (f"store it beside the transcript in {transcript_path.parent}. Then run the follow-ups on transcript + "
             f"narration; every downstream brief points at that verified narration file (it carries a provenance "
             f"header), never at the raw transcript.md, so no later thread watches the video again.")
    if status == "audio-only":
        return "Audio-only recording: work from the transcript."
    meet = status == "done" and visual.get("method") == "meet-layout"
    if meet and not visual.get("ranges"):
        return ("No screen share in the video (detect-screenshare checked one frame per second): work from the "
                "transcript; the video is not needed.")
    if meet:
        return (f"Screen shared at {visual_line(visual).split(': ', 1)[1]} (detect-screenshare). Video and ranges are "
                f"ready: {visual['video']} and {visual['plan']}. Get a visual narration of those ranges first per "
                f"{skill} (shrink-video --crop with that plan, transcribe-gemini --ranges); " + store)
    late = f" A late result may still land in {media / 'visual.json'}." if status == "timeout" else ""
    get = (f"The video is already at {visual['video']}; inspect a few frames, narrate what was shown per {skill} and "
           if visual.get("video") else
           f"Download the video per {skill} and run detect-screenshare first; if it finds shares, narrate those ranges and ")
    return (f"Visual coverage not assessed: {visual_line(visual)[len('not assessed ('):-1]}. Do not assume there was "
            f"no screen share.{late} " + get + store)


def build_brief(cfg, call, workspace, visual, transcript_path):
    local = call.start.astimezone(TZ)
    participants = ", ".join(others(cfg, call)) or "unnamed speakers"
    facts = (f"New {call.source.title()} call \"{call.title}\" on {local:%a %Y-%m-%d %H:%M} (Europe/Brussels), "
             f"{round(call.duration_s / 60)} min. Other speakers: {participants}. "
             f"Screen share: {visual_line(visual)}. Transcript: {transcript_path}. Source: {call.url}. "
             f"Recording id: {call.source}:{call.id}. Processed on {cfg.self_id}'s machine as elected owner: "
             f"{election_line(call)}. Routed to {workspace} by recording-watcher (deterministic; "
             f"if this is the wrong repo, say so first).")
    media = visual_media(call, visual, transcript_path)
    template = SKILL_DIR / "briefs" / "default.md"
    if cfg.briefs_dir:
        for candidate in (cfg.briefs_dir / f"{Path(workspace).name}.md", cfg.briefs_dir / "default.md"):
            if candidate.exists():
                template = candidate
                break
    return Template(template.read_text()).safe_substitute(
        facts=facts, media=media, transcript=str(transcript_path), workspace=workspace,
        followups=cfg.followups_skill).strip() + "\n"


def transcript_path(key):
    return STATE_DIR / "calls" / key.replace(":", "-", 1) / "transcript.md"


def write_transcript(cfg, call, visual=None):
    path = transcript_path(call.key)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.write_text(render_transcript(cfg, call, visual or {"status": "pending", "reason": "video check running"}))
    return path


# ---------- video check: download + detect-screenshare in a detached job, read by a later poll ----------

def media_dir(key):
    return transcript_path(key).parent / "media"


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def visual_check(cfg, call, now, dry_run=False, starter=None):
    """The call's video verdict, or None while its background check runs (the poll holds the call).
    Starts the check (at most MAX_VISUAL_JOBS at once); past VISUAL_TIMEOUT the verdict is 'timeout'."""
    if not call.has_video:
        return {"status": "audio-only"}
    media = media_dir(call.key)
    if done := read_json(media / "visual.json"):
        return done
    job = read_json(media / "job.json")
    if job:
        if now - parse_ts(job["started"]) > VISUAL_TIMEOUT:
            return {"status": "timeout", "reason": f"video check still running after {VISUAL_TIMEOUT.seconds // 60} min"}
        return None
    if dry_run:
        return {"status": "not-run", "reason": "dry run: no download"}
    calls_dir = STATE_DIR / "calls"
    running = sum(1 for j in calls_dir.glob("*/media/job.json") if not (j.parent / "visual.json").exists()
                  and now - parse_ts((read_json(j) or {}).get("started") or utc(now)) <= VISUAL_TIMEOUT)
    if running >= MAX_VISUAL_JOBS:
        return None
    media.mkdir(parents=True, exist_ok=True, mode=0o700)
    (media / "job.json").write_text(json.dumps({"key": call.key, "source": call.source, "id": call.id, "url": call.url,
                                                "started": now.isoformat()}) + "\n")
    (starter or start_visual_job)(call.key, media)
    return None


def start_visual_job(key, media):
    """Detached `recording-watcher visual KEY`: survives the poll, never holds its lock."""
    with open(media / "visual.log", "a") as log:
        subprocess.Popen([str(Path(__file__).resolve()), "visual", key], stdout=log, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, cwd=media, start_new_session=True)


def run_bounded(cmd, timeout, env=None):
    """subprocess.run(check=True) that kills the whole process group (yt-dlp, ffmpeg) on timeout."""
    proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            start_new_session=True)
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        raise
    if proc.returncode:
        raise subprocess.CalledProcessError(proc.returncode, cmd, out, err)


def visual_job(args):
    """Background: download the call's video, run detect-screenshare, write media/visual.json. A video without
    shares is deleted again (the brief says the transcript suffices); failures are recorded, never 'no share'."""
    media = media_dir(args.key)
    job = read_json(media / "job.json") or {}
    result = {"status": "failed"}
    try:
        cfg = load_config()
        keys = {"fathom": ["FATHOM_API_KEY"], "leexi": ["LEEXI_KEY_ID", "LEEXI_KEY_SECRET"]}[job["source"]]
        env = {**os.environ, **load_env(cfg.sources[job["source"]].get("env_file"), keys)}
        cmd = (["download-fathom", job["url"], "--out", str(media)] if job["source"] == "fathom"
               else ["download-leexi", job["id"], "--out", str(media)])
        run_bounded(cmd, DOWNLOAD_TIMEOUT, env)
        video = next((p for p in sorted(media.glob("source.*")) if p.suffix in (".mp4", ".webm", ".mkv")), None)
        if not video:
            raise RuntimeError("download produced no video")
        plan = media / "source.screenshare.json"
        run_bounded(["detect-screenshare", str(video), "--out", str(plan)], DETECT_TIMEOUT)
        out = json.loads(plan.read_text())
        result = {"status": "done", "method": out["method"], "ranges": out["ranges"],
                  "share_seconds": out.get("share_seconds", 0), "duration": out.get("duration"),
                  "video": str(video), "plan": str(plan)}
        if out["method"] == "meet-layout" and not out["ranges"]:
            video.unlink()
            result["video"] = None
    except subprocess.TimeoutExpired as exc:
        result["reason"] = f"{exc.cmd[0]} timed out after {int(exc.timeout // 60)} min"
    except subprocess.CalledProcessError as exc:
        result["reason"] = f"{exc.cmd[0]} exit {exc.returncode}: {(exc.stderr or '').strip()[-300:]}"
    except (Exception, SystemExit) as exc:
        result["reason"] = f"{type(exc).__name__}: {str(exc)[-300:]}"
    result["at"] = datetime.now(timezone.utc).isoformat()
    tmp = media / "visual.json.tmp"
    tmp.write_text(json.dumps(result, indent=1) + "\n")
    tmp.replace(media / "visual.json")
    print(f"{args.key}: {visual_line(result)}")
    return 0 if result["status"] == "done" else 1


# ---------- state ----------

def load_state():
    path = STATE_DIR / "state.json"
    return json.loads(path.read_text()) if path.exists() else {"sources": {}, "calls": {}}


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_DIR / "state.json.tmp"
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    tmp.replace(STATE_DIR / "state.json")


def is_final(entry):
    return bool(entry) and entry.get("status", "").startswith(FINAL)


def prune_media(state, now):
    """Delete local videos (download + shrunk copies) MEDIA_KEEP after the call went final: the follow-up thread
    has narrated them by then, and the source keeps the recording. Transcripts, plans and narrations stay."""
    removed = 0
    for d in (STATE_DIR / "calls").glob("*-*") if (STATE_DIR / "calls").exists() else []:
        source, _, id = d.name.partition("-")
        entry = state["calls"].get(f"{source}:{id}")
        if not is_final(entry) or now - (parse_ts(entry.get("at")) or now) < MEDIA_KEEP:
            continue
        for video in [*d.glob("*"), *d.glob("media/*")]:
            if video.suffix in VIDEO_SUFFIXES and video.is_file():
                video.unlink()
                removed += 1
    if removed:
        print(f"pruned {removed} local video file(s) older than {MEDIA_KEEP.days}d past their call's final status")


def unfinished_keys(state):
    """Calls whose transcript was written (qualified) but never reached a final status: over-cap or failed spawns."""
    keys = []
    for d in sorted((STATE_DIR / "calls").glob("*-*")) if (STATE_DIR / "calls").exists() else []:
        source, _, id = d.name.partition("-")
        if not is_final(state["calls"].get(f"{source}:{id}")):
            keys.append(f"{source}:{id}")
    return keys


def lock_poll(wait_s=0):
    """Exclusive poll lock; returns the handle or None when another poll holds it past wait_s."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = open(STATE_DIR / "poll.lock", "w")
    deadline = time.monotonic() + wait_s
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except BlockingIOError:
            if time.monotonic() >= deadline:
                return None
            time.sleep(1)


def next_watermark(old, listed, unfinished):
    """Never pass an unfinished call; otherwise advance to the newest listed creation time."""
    if unfinished:
        return min(c.created for c in unfinished) - timedelta(seconds=1)
    newest = max((c.created for c in listed), default=None)
    return max(filter(None, [old, newest]), default=old)


# ---------- spawn ----------

class RelayPending(Exception):
    """t3-relay accepted the launch but did not confirm it in time: it may still land."""


def relay_failed(result):
    """Only t3-relay's explicit verdict (or a usage/expired-record exit 2) proves a request will not run."""
    return result.returncode == 2 or result.returncode == 1 and bool(re.search(r"^failed ", result.stdout, re.M))


def spawn(cfg, workspace, title, brief):
    """Launch the thread via t3-relay and wait for it to exist; returns the relay request id.
    Raises RelayPending when accepted but unconfirmed, RuntimeError when it certainly did not launch."""
    cmd = ["t3-relay", "launch", "--project", workspace, "--title", title,
           *(["--model", cfg.model] if cfg.model else []), "--wait", str(RELAY_WAIT), "--", brief]
    result = subprocess.run(cmd, text=True, capture_output=True, timeout=RELAY_WAIT + 60, cwd=workspace)
    match = re.search(r"^accepted: relay (\S+)", result.stdout, re.M)
    if not match or relay_failed(result):
        raise RuntimeError(f"t3-relay exit {result.returncode}: {(result.stderr or result.stdout).strip()[-400:]}")
    if result.returncode:
        raise RelayPending(match[1])
    return match[1]


def relay_status(relay_id):
    """'ok' (thread exists), 'failed' (will not run: respawn) or 'pending'."""
    result = subprocess.run(["t3-relay", "status", relay_id], text=True, capture_output=True, timeout=60)
    return "ok" if result.returncode == 0 else "failed" if relay_failed(result) else "pending"


def resolve_pending_spawns(state, now, errors, checker):
    """Confirm or drop earlier accepted-but-unconfirmed spawns; a dropped call is re-elected and spawned again."""
    for key, entry in list(state["calls"].items()):
        if entry.get("status") != RELAY_PENDING:
            continue
        verdict = checker(entry["relay_id"])
        print(f"relay {entry['relay_id']} for {key}: {verdict}")
        if verdict == "ok":
            entry["status"] = "spawned"
        elif verdict == "failed":
            del state["calls"][key]
        elif now - parse_ts(entry["at"]) > PENDING_ALERT:
            errors.append(f"{key}: relay {entry['relay_id']} unconfirmed since {entry['at'][:16]}; "
                          "t3-relay status it, or recording-watcher ack")


# ---------- commands ----------

def default_sources(cfg, names=None, errors=None):
    """Configured sources; a source whose credentials are missing is reported (and appended to errors), not silent."""
    out = []
    for name in cfg.sources:
        if names is None or name in names:
            try:
                out.append(SOURCES[name](cfg))
            except SystemExit as exc:   # missing key: report, keep the other sources
                print(f"ERROR {name}: {exc}", file=sys.stderr)
                if errors is not None:
                    errors.append(f"{name}: {exc}")
    return out


def poll(args, cfg=None, sources=None, spawner=spawn, now=None, checker=relay_status, visual=visual_check):
    now = now or datetime.now(timezone.utc)
    if not args.force_hours and not in_hours(now):
        return 0
    cfg = cfg or load_config()
    lock = lock_poll()   # keep the handle: closing it releases the lock
    if not lock:
        print("another poll is running; exit")
        return 0
    print(f"=== poll {now.astimezone(TZ):%Y-%m-%d %H:%M} as {cfg.self_id}" + (" (dry run)" if args.dry_run else ""))
    state = load_state()
    since_override = datetime.fromisoformat(args.since).replace(tzinfo=TZ) if args.since else None
    errors = []
    if not args.dry_run:
        resolve_pending_spawns(state, now, errors, checker)
    sources = sources if sources is not None else default_sources(cfg, errors=errors)
    candidates, listed_by_source = [], {}
    for src in sources:
        wm = state["sources"].get(src.name, {}).get("watermark")
        since = since_override or (parse_ts(wm) if wm else now - timedelta(days=LOOKBACK_DAYS))
        try:
            listed = src.list(since)
        except Exception as exc:  # one source down must not block the other
            errors.append(f"{src.name}: list failed: {exc}")
            continue
        listed_by_source[src.name] = (listed, [])
        for call in listed:
            entry = state["calls"].get(call.key)
            if is_final(entry):
                continue
            if entry and entry["status"] == RELAY_PENDING:   # hold the watermark until it resolves
                listed_by_source[src.name][1].append(call)
                continue
            try:
                src.load(call)
            except Exception as exc:
                errors.append(f"{call.key}: transcript failed: {exc}")
                listed_by_source[src.name][1].append(call)
                continue
            verdict = evaluate(cfg, call, now)
            if verdict == "qualifies":
                candidates.append(call)
                continue
            why = f" · {call.decision.evidence()}" if call.decision else ""
            print(f"{verdict:30} {call.key:48} {call.start.astimezone(TZ):%m-%d %H:%M} {call.title[:50]}{why}")
            if verdict == "pending":
                listed_by_source[src.name][1].append(call)
            elif not args.dry_run:
                state["calls"][call.key] = {"status": verdict, "title": call.title, "self_share": round(self_share(cfg, call), 2),
                                            "start": call.start.isoformat(), "at": now.isoformat(),
                                            **({"owner": call.decision.owner, "election": call.decision.evidence()}
                                               if call.decision else {})}
    candidates.sort(key=lambda c: c.start, reverse=True)
    spawned = 0
    for call in candidates:
        workspace = route(cfg, call)
        seen = visual(cfg, call, now, args.dry_run)
        if seen is None:   # video check running (or queued): hold the call and the watermark
            print(f"{'visual-pending':30} {call.key:48} {call.start.astimezone(TZ):%m-%d %H:%M} {call.title[:50]}")
            listed_by_source[call.source][1].append(call)
            if not args.dry_run:
                entry = state["calls"].get(call.key) or {}
                state["calls"][call.key] = {**entry, "status": "visual-pending", "title": call.title,
                                            "start": call.start.isoformat(), "at": entry.get("at") or now.isoformat()}
            continue
        transcript = write_transcript(cfg, call, seen)
        title, brief = thread_title(cfg, call), build_brief(cfg, call, workspace, seen, transcript)
        over_cap = spawned >= MAX_SPAWNS
        head = f"{'over-cap' if over_cap else 'spawn'}: {title!r} -> {workspace} · screen={visual_line(seen)}"
        if args.dry_run:
            print(f"\n=== {head}\n{brief}")
            spawned += 1
            continue
        if over_cap:
            print(head + " (next poll)")
            listed_by_source[call.source][1].append(call)
            continue
        status = "spawned"
        try:
            relay_id = spawner(cfg, workspace, title, brief)
        except RelayPending as exc:
            relay_id, status = exc.args[0], RELAY_PENDING
            listed_by_source[call.source][1].append(call)
        except Exception as exc:
            errors.append(f"{call.key}: spawn failed: {exc}")
            listed_by_source[call.source][1].append(call)
            spawned = MAX_SPAWNS   # T3 likely down: defer the rest
            continue
        spawned += 1
        print(f"{head} · relay {relay_id}" + (" (accepted, unconfirmed: next poll checks)" if status == RELAY_PENDING else ""))
        state["calls"][call.key] = {"status": status, "title": call.title, "thread_title": title, "relay_id": relay_id,
                                    "project": workspace, "self_share": round(self_share(cfg, call), 2), "screen_share": visual_line(seen),
                                    "start": call.start.isoformat(), "at": now.isoformat(), "transcript": str(transcript),
                                    "election": election_line(call)}
        save_state(state)   # persist each spawn immediately: a crash must never cause a re-spawn
    for line in errors:
        print("ERROR " + line, file=sys.stderr)
    if args.dry_run:
        print(f"\ndry run: {len(candidates)} qualifying, cap {MAX_SPAWNS}/poll; state untouched")
        return 1 if errors else 0
    for name, (listed, unfinished) in listed_by_source.items():
        if args.since:
            continue   # an explicit window must not move the watermark backwards or forwards
        old = parse_ts(state["sources"].get(name, {}).get("watermark")) or now - timedelta(days=LOOKBACK_DAYS)
        state["sources"][name] = {"watermark": next_watermark(old, listed, unfinished).isoformat()}
    state["last_poll"] = now.isoformat()
    state["last_errors"] = errors
    save_state(state)
    prune_media(state, now)
    return 1 if errors else 0


def since_of(args, now):
    """--since YYYY-MM-DD (Brussels), default start of today Brussels."""
    if getattr(args, "since", None):
        return datetime.fromisoformat(args.since).replace(tzinfo=TZ)
    return now.astimezone(TZ).replace(hour=0, minute=0, second=0, microsecond=0)


def recent(sources, since):
    """{key: (source, call)} listed since; one source down must not block the other."""
    found = {}
    for src in sources:
        try:
            found.update({c.key: (src, c) for c in src.list(since)})
        except Exception as exc:
            print(f"ERROR {src.name}: list failed: {exc}", file=sys.stderr)
    return found


def list_calls(args, cfg=None, sources=None, now=None):
    """Read-only: recent calls with their state status, so an agent can find the key to ack."""
    now = now or datetime.now(timezone.utc)
    names = {args.source} if getattr(args, "source", None) else None
    calls = recent(sources if sources is not None else default_sources(cfg or load_config(), names), since_of(args, now))
    state = load_state()
    for key, (_, c) in sorted(calls.items(), key=lambda kv: kv[1][1].start, reverse=True):
        status = (state["calls"].get(key) or {}).get("status", "new")
        print(f"{key:48} {c.start.astimezone(TZ):%m-%d %H:%M} {round(c.duration_s / 60):>3} min  {status:24} {c.title}")
    return 0


def ack(args, cfg=None, now=None, sources=None):
    """Mark calls as handled without processing them (status skipped:acknowledged): never spawned later.
    No keys = every call dir without a final status (over-cap / failed spawns of the last polls).
    --match resolves one key by title; a missing transcript is fetched so the manual thread has evidence."""
    now = now or datetime.now(timezone.utc)
    keys, match, found = list(args.keys), getattr(args, "match", None), {}
    need = [k for k in keys if not transcript_path(k).exists()]
    if match or need:
        cfg = cfg or load_config()
        names = None if match else {k.partition(":")[0] for k in need}
        found = recent(sources if sources is not None else default_sources(cfg, names), since_of(args, now))
    if match:
        hits = [k for k, (_, c) in found.items() if match.lower() in c.title.lower()]
        if len(hits) != 1:
            print(f"--match {match!r}: {len(hits)} calls since {since_of(args, now):%Y-%m-%d}; candidates:", file=sys.stderr)
            for k in hits or found:
                print(f"  {k:48} {found[k][1].title}", file=sys.stderr)
            return 1
        keys += hits
    lock = lock_poll(wait_s=120)
    if not lock:
        print("another poll is running for >2 min; retry", file=sys.stderr)
        return 1
    state = load_state()
    keys = keys or unfinished_keys(state)
    if not keys:
        print("nothing unfinished to acknowledge")
        return 0
    backup = STATE_DIR / f"state.json.bak-{now:%Y%m%dT%H%M%SZ}"
    if (STATE_DIR / "state.json").exists():
        backup.write_bytes((STATE_DIR / "state.json").read_bytes())
    for key in keys:
        entry = state["calls"].get(key) or {}
        if entry.get("status") in ("spawned", RELAY_PENDING):
            print(f"keep     {key:48} already {entry['status']} -> {entry.get('thread_title')}")
            continue
        transcript = transcript_path(key)
        src, call = found.get(key, (None, None))
        if not transcript.exists() and call:
            try:
                src.load(call)
                if call.segments:
                    write_transcript(cfg, call)
            except Exception as exc:   # the ack itself must still land
                print(f"WARN     {key}: transcript fetch failed: {exc}", file=sys.stderr)
        title = (entry.get("title") or (call.title if call else "")
                 or (transcript.read_text().splitlines()[0].lstrip("# ").strip() if transcript.exists() else ""))
        state["calls"][key] = {**entry, "status": "skipped:acknowledged", "title": title, "at": now.isoformat(),
                               "note": "acknowledged without processing (recording-watcher ack)",
                               **({"transcript": str(transcript)} if transcript.exists() else {})}
        print(f"ack      {key:48} {title[:50]}")
        why = "API has none yet" if call else f"not listed since {since_of(args, now):%Y-%m-%d}; pass --since"
        print(f"         transcript: {transcript}" if transcript.exists() else f"         no transcript saved ({why})")
    save_state(state)
    print(f"snapshot {backup}")
    return 0


def status(_args):
    state = load_state()
    counts = {}
    for entry in state["calls"].values():
        counts[entry["status"]] = counts.get(entry["status"], 0) + 1
    print(f"config: {CONFIG}")
    print(f"state: {STATE_DIR / 'state.json'}")
    print(f"last poll: {state.get('last_poll', 'never')}")
    for name, src in state.get("sources", {}).items():
        print(f"watermark {name}: {src.get('watermark')}")
    print("counts: " + (", ".join(f"{k}={v}" for k, v in sorted(counts.items())) or "none"))
    for err in state.get("last_errors") or []:
        print(f"last error: {err}")
    spawns = sorted((e for e in state["calls"].values() if e["status"] == "spawned"), key=lambda e: e["at"], reverse=True)
    for e in spawns[:10]:
        print(f"spawned {e['at'][:16]} {e['thread_title']!r} -> {Path(e['project']).name} screen={e.get('screen_share')}")
    return 0


def forget(args, now=None):
    """Drop final skip entries so the next `poll --since <day>` re-elects them (e.g. after a roster fix).
    Spawned calls are never forgotten: that would spawn twice."""
    now = now or datetime.now(timezone.utc)
    lock = lock_poll(wait_s=120)
    if not lock:
        print("another poll is running for >2 min; retry", file=sys.stderr)
        return 1
    state = load_state()
    backup = STATE_DIR / f"state.json.bak-{now:%Y%m%dT%H%M%SZ}"
    if (STATE_DIR / "state.json").exists():
        backup.write_bytes((STATE_DIR / "state.json").read_bytes())
    rc = 0
    for key in args.keys:
        status = (state["calls"].get(key) or {}).get("status", "")
        if not status.startswith("skipped:"):
            print(f"keep     {key:48} {status or 'unknown key'}", file=sys.stderr)
            rc = 1
            continue
        del state["calls"][key]
        print(f"forgot   {key:48} was {status}; next `poll --since <its day>` re-evaluates it")
    save_state(state)
    return rc


def seed(_args, cfg=None, now=None):
    """Start from now: every enabled source's watermark := now, so a new machine never backfills old calls."""
    now = now or datetime.now(timezone.utc)
    cfg = cfg or load_config()
    lock = lock_poll(wait_s=120)
    if not lock:
        print("another poll is running for >2 min; retry", file=sys.stderr)
        return 1
    state = load_state()
    for name in cfg.sources:
        if name in state["sources"]:
            print(f"keep     {name} watermark {state['sources'][name]['watermark']}")
            continue
        state["sources"][name] = {"watermark": now.isoformat()}
        print(f"seeded   {name} watermark {now.isoformat()}")
    save_state(state)
    return 0


def check(_args):
    """Config + credentials readiness, values never printed."""
    cfg = load_config()
    print(f"ok   config {CONFIG} (self={cfg.self_id}, sources={', '.join(cfg.sources)})")
    ok = 0
    for name in cfg.sources:
        try:
            SOURCES[name](cfg)
            print(f"ok   {name} credentials")
        except SystemExit as exc:
            print(f"FAIL {name}: {exc}")
            ok = 1
    for ws in {cfg.workspace, *(r["workspace"] for r in cfg.routes), *(s.get("workspace") for s in cfg.sources.values())} - {None}:
        print(f"ok   workspace {ws}" if Path(ws).is_dir() else f"FAIL workspace missing: {ws}")
        ok = ok or (0 if Path(ws).is_dir() else 1)
    return ok


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("poll", help="list new calls and spawn follow-up threads for calls this machine owns")
    p.add_argument("--dry-run", action="store_true", help="print would-be spawns with full brief; no state change, no spawn")
    p.add_argument("--since", help="override the watermark, e.g. 2026-10-01 (Brussels); watermark is left unchanged")
    p.add_argument("--force-hours", action="store_true", help="run outside Mon-Fri 09:00-18:00 Brussels")
    sub.add_parser("status", help="print state summary")
    sub.add_parser("check", help="validate config, credentials and workspaces (no API calls)")
    f = sub.add_parser("forget", help="drop final skipped:* entries so `poll --since` re-evaluates them (never spawned ones)")
    f.add_argument("keys", nargs="+")
    sub.add_parser("seed", help="new machine: start from now (watermark per source := now); existing watermarks kept")
    a = sub.add_parser("ack", help="mark calls handled without processing; no keys = all unfinished (over-cap) calls")
    a.add_argument("keys", nargs="*", help="call keys like fathom:190388183 or leexi:<uuid>")
    a.add_argument("--match", help="case-insensitive title substring; must resolve to exactly one listed call")
    a.add_argument("--since", help="listing window for --match / transcript fetch, e.g. 2026-10-01 (default today Brussels)")
    ls = sub.add_parser("list", help="recent calls with key, start, title, duration, state status (read-only)")
    ls.add_argument("--since", help="e.g. 2026-10-01 (Brussels); default today")
    ls.add_argument("--source", choices=sorted(SOURCES))
    v = sub.add_parser("visual", help="internal, started by poll: download one call's video and run detect-screenshare")
    v.add_argument("key")
    args = parser.parse_args()
    return {"poll": poll, "status": status, "check": check, "seed": seed, "forget": forget, "ack": ack, "list": list_calls,
            "visual": visual_job}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
